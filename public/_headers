# ==========================================================================
# Cloudflare Pages — HTTP Headers
# ==========================================================================

# Security headers for all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Long cache for static assets with hashes (Astro adds them)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images, fonts, favicons
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000

# HTML: short cache, revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages are served at directory URLs (/x/y/), which /*.html never matched —
# they got Pages' default max-age=0 and the zone cache revalidated every request
# (cf-cache-status: EXPIRED on back-to-back hits, 2026-11-16; Ahrefs: 17 pages
# "Slow server response for AI crawlers"). Browsers still revalidate (max-age=0);
# the Cloudflare edge keeps a copy 10 min and serves it stale for up to a day while
# it refreshes in the background. Deploys that must show at once: scripts/cf-purge.py.
/*/
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

# Preview hosts must never be indexed. sdar-v2.pages.dev serves a full copy of production with 200;
# canonicals point to samedayappliance.repair, this makes it certain. Branch/deployment previews
# (<branch>.sdar-v2.pages.dev, <hash>.sdar-v2.pages.dev) already get X-Robots-Tag: noindex from
# Cloudflare; the second rule is belt-and-braces. Absolute-URL rules match only these hosts, so the
# production domain (samedayappliance.repair) is not affected.
https://sdar-v2.pages.dev/*
  X-Robots-Tag: noindex
https://:version.sdar-v2.pages.dev/*
  X-Robots-Tag: noindex
