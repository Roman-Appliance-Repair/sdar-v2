---
/**
 * ServiceHero.astro
 * Unified hero block for /services/* pages.
 *
 * Two render modes:
 *   MODE A — Full-bleed background photo + frosted-glass card overlay
 *            (mirrors v2 city HeroSection design). Triggered by `slug`
 *            prop when /public/images/services/{slug}/hero.webp exists
 *            on disk at build time, or when explicit image/imageWebp
 *            props are passed.
 *   MODE B — Split layout with placeholder text (legacy behavior).
 *            Used when no photo is available — graceful fallback so
 *            pages without deployed photos still render cleanly.
 *
 * Default posture: NEUTRAL multi-county (LA + Orange + Ventura + San
 * Bernardino + Riverside). NAP-compliant: the only public address is
 * West Hollywood (the one physical_pin); SAB branches show city +
 * phone only.
 */

import '../styles/v2-tokens.css';
import { existsSync } from 'node:fs';
import path from 'node:path';
import BranchesBlock from './BranchesBlock.astro';
import { MAIN_PHONE } from '../data/branches';

const MAIN_PHONE_HREF = 'tel:+1' + MAIN_PHONE.replace(/\D/g, '');

export interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  phone?: string;
  phoneHref?: string;
  bookingUrl?: string;
  heroImageTitle?: string;
  heroImageLocation?: string;
  trustBarItems?: string[];
  /** When true, render the 8-branch list inside the hero content column.
   *  Default true for the new neutral-hub posture. */
  showBranches?: boolean;
  /** Auto-derive photo path from slug; checked against disk at build time. */
  slug?: string;
  /** Override the brand-logo lookup key. Use when the page slug is a
   *  brand+category combo (e.g. 'electrolux-refrigerator-repair') but the
   *  gold logo overlay should resolve by brand ('electrolux'). Falls back
   *  to `slug` when omitted. */
  logoSlug?: string;
  /** Photo directory bucket. Default 'services' (residential). Use 'outdoor'
   *  for outdoor-section pages so photos resolve under
   *  public/images/outdoor/{slug}/. */
  section?: 'services' | 'commercial' | 'outdoor' | 'brands';
  /** Explicit overrides (rarely needed once slug auto-derive is in place). */
  image?: string;
  imageWebp?: string;
  imageWebpMobile?: string;
  imageAlt?: string;
}

const {
  eyebrow = 'LA · Orange · Ventura · San Bernardino · Riverside Counties',
  title,
  subtitle,
  phone = MAIN_PHONE,
  phoneHref = MAIN_PHONE_HREF,
  bookingUrl = '/contact/',
  heroImageTitle = title,
  heroImageLocation = 'Southern California',
  trustBarItems = [
    '🏅 BHGS #A49573',
    '🛡️ Fully Insured',
    '⚡ Same Day Available',
    '🔩 OEM Parts on Truck',
    '💬 $89 Diagnostic — Waived With Repair'
  ],
  showBranches = true,
  slug,
  logoSlug,
  section = 'services',
  image,
  imageWebp,
  imageWebpMobile,
  imageAlt
} = Astro.props;

const slugWebpPath = slug ? path.join('public', 'images', section, slug, 'hero.webp') : null;
const slugJpgPath = slug ? path.join('public', 'images', section, slug, 'hero.jpg') : null;
const slugPhotoExists = !!(slugWebpPath && slugJpgPath && existsSync(slugWebpPath) && existsSync(slugJpgPath));

const photoWebp = imageWebp ?? (slugPhotoExists ? `/images/${section}/${slug}/hero.webp` : null);
const photoJpg = image ?? (slugPhotoExists ? `/images/${section}/${slug}/hero.jpg` : null);
const photoWebp640 = slugPhotoExists ? `/images/${section}/${slug}/hero-640.webp` : null;
const photoJpg640 = slugPhotoExists ? `/images/${section}/${slug}/hero-640.jpg` : null;
const photoWebp960 = slugPhotoExists ? `/images/${section}/${slug}/hero-960.webp` : null;
const photoJpg960 = slugPhotoExists ? `/images/${section}/${slug}/hero-960.jpg` : null;
const photoMobileWebp = imageWebpMobile ?? null;
const photoAlt = imageAlt ?? `${heroImageTitle || title || 'Appliance repair'} ${heroImageLocation || ''}`.trim();
const photoMode = !!(photoWebp && photoJpg);

const logoKey = logoSlug ?? slug;
const logoSrc = section === 'brands' && logoKey && existsSync(path.join('public', 'brand-logos', `${logoKey}.webp`))
  ? `/brand-logos/${logoKey}.webp`
  : null;

/* Gold text wordmark fallback for brand pages that have a hero photo but NO
 * logo file. Keyed by base brand slug; combo slugs (e.g.
 * 'ge-profile-stove-repair') resolve by longest matching prefix so 'ge-profile'
 * wins over 'ge'. Exact written casing — deliberately NOT auto-title-cased
 * (ILVE, GE, AGA, CellarPro, WhisperKool, CaptiveAire, Le Cache, …). */
const BRAND_TEXT_FALLBACK: Record<string, string> = {
  'ge': 'GE',
  'ge-profile': 'GE Profile',
  'fulgor-milano': 'Fulgor Milano',
  'hestan': 'Hestan',
  'signature-kitchen-suite': 'Signature Kitchen Suite',
  'ilve': 'ILVE',
  'whisperkool': 'WhisperKool',
  'breezaire': 'Breezaire',
  'cellarpro': 'CellarPro',
  'captiveaire': 'CaptiveAire',
  'aga': 'AGA',
  'accurex': 'Accurex',
  'gaylord': 'Gaylord',
  'greenheck': 'Greenheck',
  'halton': 'Halton',
  'streivor': 'Streivor',
  'vent-master': 'Vent Master',
  'heatcraft': 'Heatcraft',
  'forno-bravo': 'Forno Bravo',
  'wood-stone': 'Wood Stone',
  'wine-guardian': 'Wine Guardian',
  'le-cache': 'Le Cache',
  'big-chill': 'Big Chill',
  'bull': 'Bull',
  'coyote': 'Coyote',
  'capital-bbq': 'Capital BBQ',
};

const brandTextName = (() => {
  if (!(photoMode && section === 'brands' && !logoSrc && logoKey)) return null;
  if (BRAND_TEXT_FALLBACK[logoKey]) return BRAND_TEXT_FALLBACK[logoKey];
  // longest-prefix match so 'ge-profile' beats 'ge'; '-' boundary required
  const keys = Object.keys(BRAND_TEXT_FALLBACK).sort((a, b) => b.length - a.length);
  for (const k of keys) {
    if (logoKey.startsWith(k + '-')) return BRAND_TEXT_FALLBACK[k];
  }
  return null;
})();
---

{photoMode ? (
  <section class="hero-photo">
    <div class="hero-photo__bg">
      <picture>
        {photoWebp640 && <source media="(max-width: 640px)" type="image/webp" srcset={photoWebp640} />}
        {photoJpg640 && <source media="(max-width: 640px)" type="image/jpeg" srcset={photoJpg640} />}
        {photoWebp960 && <source media="(max-width: 960px)" type="image/webp" srcset={photoWebp960} />}
        {photoJpg960 && <source media="(max-width: 960px)" type="image/jpeg" srcset={photoJpg960} />}
        {photoMobileWebp && (
          <source type="image/webp" media="(max-width: 768px)" srcset={photoMobileWebp} />
        )}
        <source srcset={photoWebp} type="image/webp" />
        <source srcset={photoJpg} type="image/jpeg" />
        <img
          src={photoJpg}
          alt={photoAlt}
          width="1920"
          height="900"
          loading="eager"
          fetchpriority="high"
        />
      </picture>
      <div class="hero-photo__overlay"></div>
      {logoSrc ? (
        <div class="hero-photo__logo">
          <img
            src={logoSrc}
            alt={`${title} logo`}
            width="240"
            height="80"
            loading="eager"
          />
        </div>
      ) : brandTextName ? (
        <div class="hero-photo__logo hero-photo__logo--text">
          <span>{brandTextName}</span>
        </div>
      ) : null}
    </div>
    <div class="v2-container hero-photo__inner">
      <div class="v2-glass hero-photo__panel">
        <p class="hero-photo__eyebrow">{eyebrow}</p>
        <h1 class="hero-photo__h1">{title}</h1>
        <p class="hero-photo__sub">{subtitle}</p>
        <div class="hero-photo__ctas">
          <a href={phoneHref} class="v2-btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.29h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Call {phone}
          </a>
          <a href={bookingUrl} class="v2-btn-secondary">Book Online</a>
        </div>
        {showBranches && (
          <div class="hero-photo__branches">
            <BranchesBlock title="Our Branches" layout="grid" showCount={true} />
          </div>
        )}
      </div>
    </div>
  </section>
) : (
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="hero-eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="hero-sub">{subtitle}</p>
        <div class="hero-ctas">
          <a href={phoneHref} class="btn-primary">☎ {phone}</a>
          <a href={bookingUrl} class="btn-outline">Book Online</a>
        </div>
        {showBranches && (
          <div class="hero-branches-wrap">
            <BranchesBlock title="Our Branches" layout="grid" showCount={true} />
          </div>
        )}
      </div>
      <div class="hero-img-wrap">
        <div class="hero-img-placeholder">
          <p>{heroImageTitle}</p>
          <p>{heroImageLocation}</p>
        </div>
      </div>
    </div>
  </section>
)}

<div class="trust-bar">
  <div class="trust-bar-inner">
    {trustBarItems.map((item) => {
      const match = item.match(/^(\S+)\s+(.*)$/);
      const icon = match ? match[1] : '';
      const text = match ? match[2] : item;
      return (
        <div class="trust-item"><span class="trust-icon">{icon}</span> {text}</div>
      );
    })}
  </div>
</div>

<style>
  /* ========================================================================
   * MODE A — Background photo + frosted-glass overlay
   * Mirrors v2 city HeroSection: min-height 580, gradient overlay,
   * .v2-glass panel max-width 620, Playfair display H1.
   * ====================================================================== */
  .hero-photo {
    position: relative;
    min-height: 580px;
    background: var(--v2-black);
    color: var(--v2-white);
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-photo__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-photo__bg picture,
  .hero-photo__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-photo__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.55) 60%, rgba(0,0,0,0.35) 100%);
    z-index: 1;
  }
  .hero-photo__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 80px;
    padding-bottom: 80px;
  }
  .hero-photo__panel {
    max-width: 620px;
    padding: 40px 36px;
    color: var(--v2-white);
  }
  .hero-photo__eyebrow {
    font-size: 13px;
    font-weight: 500;
    color: var(--v2-red);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .hero-photo__h1 {
    font-family: var(--v2-font-display);
    font-size: clamp(32px, 4.4vw, 46px);
    font-weight: 700;
    line-height: 1.12;
    margin: 0 0 18px;
    color: var(--v2-white);
    letter-spacing: -0.01em;
  }
  .hero-photo__sub {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 26px;
  }
  .hero-photo__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-photo__branches {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }
  @media (max-width: 768px) {
    .hero-photo { min-height: 520px; }
    .hero-photo__inner { padding-top: 56px; padding-bottom: 56px; }
    .hero-photo__panel { padding: 28px 22px; max-width: 100%; }
    .hero-photo__h1 { font-size: clamp(26px, 7vw, 34px); }
    .hero-photo__ctas { flex-direction: column; }
    .hero-photo__ctas .v2-btn-primary,
    .hero-photo__ctas .v2-btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  /* Brand logo overlay — top-aligned with text card on left, gold tint.
     Rendered only when section='brands' and slug is provided. */
  .hero-photo__logo {
    position: absolute;
    top: 8%;
    right: 0;
    width: 50%;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    pointer-events: none;
  }
  .hero-photo__logo img {
    display: block;
    width: auto;
    height: 400px;
    max-width: 92%;
    object-fit: contain;
    /* true aspect — no horizontal stretch (square logos like LG/Miele/GE were distorting) */
    transform: none;
    transform-origin: center;
    /* gold tint: filter trick — black logo → gold via brightness+sepia+hue-rotate */
    filter: brightness(0) saturate(100%) invert(72%) sepia(58%) saturate(620%) hue-rotate(8deg) brightness(95%) contrast(92%);
    opacity: 0.95;
  }
  /* Text wordmark fallback — gold Playfair, same slot as the logo image.
     Rendered when a brand has a hero photo but no logo file on disk. */
  .hero-photo__logo--text {
    top: 0;
    bottom: 0;
    align-items: center;
    padding: 0 16px;
  }
  .hero-photo__logo--text span {
    font-family: var(--v2-font-display);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.06;
    color: var(--v2-gold);
    text-align: center;
    letter-spacing: 0.01em;
    max-width: 100%;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.55);
  }
  @media (max-width: 768px) {
    .hero-photo__logo {
      top: auto;
      bottom: 20px;
      right: 50%;
      transform: translateX(50%);
      width: 80%;
    }
    .hero-photo__logo img {
      height: 140px;
    }
    .hero-photo__logo--text {
      top: auto;
      bottom: 16px;
      align-items: flex-end;
    }
    .hero-photo__logo--text span {
      font-size: clamp(26px, 8vw, 40px);
    }
  }

  /* ========================================================================
   * MODE B — Legacy split layout fallback (when no photo)
   * ====================================================================== */
  .hero {
    background: #0a0a0a;
    color: #fff;
    padding: 80px 24px 72px;
  }
  .hero-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #C8102E;
    margin-bottom: 16px;
  }
  .hero h1 {
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 700;
    line-height: 1.15;
    margin: 0 0 20px;
    letter-spacing: -.02em;
    color: #fff;
    max-width: none;
  }
  .hero-sub {
    font-size: 17px;
    color: rgba(255, 255, 255, .72);
    margin: 0 0 32px;
    line-height: 1.6;
  }
  .hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-primary {
    background: #C8102E;
    color: #fff;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
  }
  .btn-outline {
    border: 1.5px solid rgba(255, 255, 255, .35);
    color: #fff;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
  }
  .hero-branches-wrap {
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, .08);
  }
  .hero-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    background: #1a1a1a;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: start;
  }
  .hero-img-placeholder {
    color: rgba(255, 255, 255, .2);
    font-size: 13px;
    text-align: center;
  }
  .hero-img-placeholder p {
    margin: 0;
  }
  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-img-wrap {
      display: none;
    }
  }

  /* ========================================================================
   * Trust bar — preserved in both modes
   * ====================================================================== */
  .trust-bar {
    background: #C8102E;
    color: #fff;
    padding: 16px 24px;
  }
  .trust-bar-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
  }
  .trust-icon {
    font-size: 16px;
  }
</style>
