---
/** AsFeatured — press mentions (src/data/press.ts, rules at the top of that file).
 *  Outlet as a text wordmark + article title, linking to the live article.
 *  Renders nothing when the list is empty. */
import { pressMentions } from '../data/press';

export interface Props {
  tone?: 'white' | 'gray';
  id?: string;
}

const { tone = 'white', id = 'as-featured' } = Astro.props;
const items = pressMentions();

const monthYear = (ymd: string) =>
  new Date(`${ymd}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

{items.length > 0 && (
<section class:list={['af', `af--${tone}`]} id={id} aria-labelledby={`${id}-h`}>
  <div class="af__wrap">
    <h2 class="af__title" id={`${id}-h`}>As featured in</h2>
    <ul class="af__list" role="list">
      {items.map((p) => (
        <li class="af__item">
          <a class="af__link" href={p.url} target="_blank" rel="noopener">
            <span class="af__outlet">{p.outlet}</span>
            <span class="af__headline">“{p.title}”</span>
            <span class="af__meta">{monthYear(p.date)} · Roman Abysov, owner</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
)}

<style>
  .af { padding: 40px 0; background: var(--white); font-family: var(--font-body); }
  .af--gray { background: var(--gray); }
  .af__wrap { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--container-padding); box-sizing: border-box; }
  .af__title {
    margin: 0 0 16px; font-family: var(--font-body); font-size: 12px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); text-align: center;
  }
  .af__list {
    list-style: none; margin: 0 auto; padding: 0; max-width: 1000px;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;
  }
  .af__item { flex: 0 1 420px; min-width: 0; }
  .af__link {
    display: flex; flex-direction: column; align-items: center; gap: 4px; height: 100%;
    padding: 18px 20px; box-sizing: border-box; text-align: center; text-decoration: none;
    border: 1px solid var(--border); border-radius: 10px; background: var(--gray);
    transition: border-color 0.2s var(--ease);
  }
  .af--gray .af__link { background: var(--white); }
  .af__link:hover { border-color: var(--red); }
  .af__outlet { font-family: var(--font-display); font-size: 26px; font-weight: 700; line-height: 1.15; color: var(--black); }
  .af__headline { font-size: 15px; color: var(--text); line-height: 1.4; overflow-wrap: anywhere; }
  .af__link:hover .af__headline { text-decoration: underline; }
  .af__meta { font-size: 12px; color: var(--muted); }

  @media (max-width: 640px) {
    .af { padding: 32px 0; }
    .af__wrap { padding: 0 16px; }
    .af__outlet { font-size: 22px; }
    .af__headline { font-size: 14px; }
  }
</style>
