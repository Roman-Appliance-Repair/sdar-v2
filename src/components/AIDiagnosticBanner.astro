---
---
<a href="/ai-diagnostic/" class="ai-diagnostic-banner" aria-label="Not sure what's wrong with your appliance? Get a free AI-powered diagnosis.">
  <span class="ai-diagnostic-banner__inner">
    <span class="ai-diagnostic-banner__icon" aria-hidden="true">🤖</span>
    <span class="ai-diagnostic-banner__text">Not sure what's wrong? <strong>Free AI Diagnostic</strong></span>
    <span class="ai-diagnostic-banner__arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
/* Slim single-line strip: costs the first screen ~one thin line (was a ~170px stacked block).
   Semi-transparent dark glass so it reads as chrome, not a content block. */
.ai-diagnostic-banner {
  display: block;
  background: rgba(10, 10, 10, 0.85);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid rgba(200, 16, 46, 0.9);
  text-decoration: none;
}
.ai-diagnostic-banner__inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0.45rem 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
}
.ai-diagnostic-banner__icon {
  font-size: 1rem;
  flex-shrink: 0;
}
.ai-diagnostic-banner__text {
  color: #d0d0d0;
  font-size: 0.85rem;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
}
.ai-diagnostic-banner__text strong {
  color: #ffffff;
  font-weight: 700;
}
.ai-diagnostic-banner__arrow {
  color: #C8102E;
  font-weight: 700;
  font-size: 0.95rem;
  flex-shrink: 0;
}
.ai-diagnostic-banner:hover .ai-diagnostic-banner__text strong,
.ai-diagnostic-banner:hover .ai-diagnostic-banner__arrow {
  color: #ff3355;
}
@media (max-width: 640px) {
  .ai-diagnostic-banner__inner { padding: 0.4rem 0.75rem; }
  .ai-diagnostic-banner__text { font-size: 0.8rem; }
}
</style>
