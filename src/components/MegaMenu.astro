---
/**
 * MegaMenu — full-width frosted-glass multi-column panels.
 * Hover on a top-level item opens a 100vw panel pinned under the navbar.
 * Links generated dynamically from src/pages/* via import.meta.glob.
 */

import { counties as countyData, toSlug } from '../data/counties.ts';
import { MAIN_PHONE, BRANCHES } from '../data/branches.ts';
import { CITIES, COUNTIES } from '../data/cities.ts';
import { COMMERCIAL_BRAND_SLUGS } from '../data/commercial-brand-slugs.ts';

const ACRONYMS = new Set([
  'bbb', 'oem', 'epa', 'osha', 'bbq', 'cslb', 'hvac', 'ac', 'la', 'ca', 'cma', 'ge', 'lg', 'sks', 'zline'
]);

function pathToSlug(path: string): string {
  return (path.split('/').pop() ?? '').replace(/\.astro$/, '');
}

function slugToLabel(slug: string): string {
  return slug.split('-').map((w) =>
    ACRONYMS.has(w.toLowerCase())
      ? w.toUpperCase()
      : w.charAt(0).toUpperCase() + w.slice(1)
  ).join(' ');
}

function toLinks(glob: Record<string, unknown>, hrefPrefix: string) {
  return Object.keys(glob)
    .map(pathToSlug)
    .filter((slug) => slug !== 'index')
    .sort()
    .map((slug) => ({
      label: slugToLabel(slug),
      href: `${hrefPrefix}${slug}/`
    }));
}

// URLs that must be excluded from auto-glob menus because they 301-redirect
// elsewhere. Source .astro file still exists but page is unreachable at this
// URL — listing it in nav would generate stale links. Wave 40 link-discipline.
// Wave 61b Sprint 1 (2026-05-27): /commercial/dryer-repair/ removed from this
// Set — Wave 40b restored that page as a full content surface (6595 words,
// 316 outbound) but stale exclusion was never lifted, leaving it orphaned
// with 0 inbound. Set is currently empty but kept as architectural hook.
const REDIRECTED_URLS_EXCLUDE_FROM_NAV = new Set<string>([]);

const services    = toLinks(import.meta.glob('../pages/services/*.astro'),    '/services/')
  .filter((l) => !REDIRECTED_URLS_EXCLUDE_FROM_NAV.has(l.href));
const commercial  = toLinks(import.meta.glob('../pages/commercial/*.astro'),  '/commercial/')
  .filter((l) => !REDIRECTED_URLS_EXCLUDE_FROM_NAV.has(l.href));
const credentials = toLinks(import.meta.glob('../pages/credentials/*.astro'), '/credentials/')
  .filter((l) => !REDIRECTED_URLS_EXCLUDE_FROM_NAV.has(l.href));
const forBusiness = toLinks(import.meta.glob('../pages/for-business/*.astro'),'/for-business/')
  .filter((l) => !REDIRECTED_URLS_EXCLUDE_FROM_NAV.has(l.href));
// Slugs intentionally excluded from megamenu nav — pages stay live and are
// reached via internal links from their parent price-list page.
// Door spring is a sub-variant of /price-list/dishwasher-repair-cost/, not a peer.
const PRICE_LIST_EXCLUDE_FROM_NAV = new Set(['/price-list/dishwasher-door-spring-repair-cost/']);
const priceList   = toLinks(import.meta.glob('../pages/price-list/*.astro'),  '/price-list/')
  .filter((l) => !PRICE_LIST_EXCLUDE_FROM_NAV.has(l.href));

// Root pages: which city slugs actually have .astro files?
const existingSlugs = new Set(
  Object.keys(import.meta.glob('../pages/*.astro'))
    .map(pathToSlug)
    .filter((slug) => slug !== 'index' && !slug.endsWith('-county'))
);

// Enrich counties.ts data with per-city existence flag (legacy — retained
// only in case other code references `enrichedCounties` shape).
const enrichedCounties = countyData.map((county) => ({
  name: county.name,
  slug: county.slug,
  cities: county.cities.map((name) => {
    const slug = toSlug(name);
    return { name, slug, exists: existingSlugs.has(slug) };
  })
}));

// Areas panel v4 — county → branch → cities (matches /areas/ page reorg).
// Uses CITIES from cities.ts (canonical city pillars only — guarantees no
// 404 links). Branch list filtered by primaryCounty; cities filtered by
// primaryBranch on each city. Aligns megamenu source-of-truth with /areas/.
const COUNTY_ORDER = [
  'los-angeles',
  'orange',
  'ventura',
  'san-bernardino',
  'riverside'
] as const;

const countiesWithBranches = COUNTY_ORDER.map((countySlug) => {
  const county = COUNTIES[countySlug];
  const branches = BRANCHES
    .filter((b) => b.primaryCounty === countySlug)
    .map((b) => ({
      slug: b.slug,
      displayCity: b.displayCity,
      phone: b.phone,
      cities: CITIES
        .filter((c) => c.primaryBranch === b.slug)
        .map((c) => ({ slug: c.slug, name: c.name }))
    }));
  return {
    name: county.name,
    hubUrl: county.hubUrl,
    branches
  };
});

// Price list — strip "Cost" suffix for cleaner labels and split res/com.
// All glob'd items exist (built from actual .astro files), so exists: true.
// `missing` styling stays in the renderer for forward compatibility (future canonical list).
const stripCost = (label: string) => label.replace(/\s+Cost$/i, '');
const priceCommercial  = priceList
  .filter((l) => l.label.startsWith('Commercial'))
  .map((l) => ({ ...l, label: stripCost(l.label).replace(/^Commercial\s+/, ''), exists: true }));
const priceResidential = priceList
  .filter((l) => !l.label.startsWith('Commercial'))
  .map((l) => ({ ...l, label: stripCost(l.label), exists: true }));

// Credentials split for two columns
const credHalf = Math.ceil(credentials.length / 2);
const credA = credentials.slice(0, credHalf);
const credB = credentials.slice(credHalf);

const mainPhone = MAIN_PHONE;
const mainPhoneTel = `+1${MAIN_PHONE.replace(/\D/g, '')}`;

// Header promo diagnostic fee follows page scope: commercial pages = $120, everything
// else (residential, outdoor, residential brand pages) = $89. $120 zones: the canonical
// /commercial/* tree, plus the allowlist of commercial-grade /brands/ pages (foodservice
// equipment) that carry a $120 fee on the page itself (see commercial-brand-slugs.ts).
const _path = Astro.url.pathname;
const _brandSlug = _path.startsWith('/brands/') ? _path.replace(/^\/brands\//, '').replace(/\/$/, '') : null;
const isCommercialFee = _path.startsWith('/commercial/') || (_brandSlug !== null && COMMERCIAL_BRAND_SLUGS.has(_brandSlug));
const diagnosticFee = isCommercialFee ? '$120' : '$89';

type Link = { label: string; href: string };
type Column = { title?: string; links?: Link[]; html?: string };
type AreasCity = { slug: string; name: string };
type AreasBranch = { slug: string; displayCity: string; phone: string; cities: AreasCity[] };
type AreasCounty = { name: string; hubUrl: string; branches: AreasBranch[] };
type PriceCell = { label: string; href: string; exists: boolean };
type Panel =
  | { kind: 'flow'; links: Link[] }
  | { kind: 'grouped'; columns: Column[]; align?: 'center'; cols?: 3 | 4 | 5 | 6 }
  | { kind: 'areas'; counties: AreasCounty[] }
  | { kind: 'pricelist'; residential: PriceCell[]; commercial: PriceCell[]; html: string };

// Brand pillar mega-menu (Wave 55, 2026-05-26). Hand-curated grouping —
// auto-glob would mix 416 brand combo pages with 35 pillars. We want only
// pillar pages here (one entry per real brand pillar), grouped by audience
// tier so the nav both teaches scope and distributes link equity from all
// 1054 pages to the top 32 brand pillars.
// Note: lynx + perlick excluded — pillars not yet created (Wave 53b backlog).
const brandResidentialPremium: Link[] = [
  { label: 'Sub-Zero',                 href: '/brands/sub-zero/' },
  { label: 'Wolf',                     href: '/brands/wolf/' },
  { label: 'Viking',                   href: '/brands/viking/' },
  { label: 'Thermador',                href: '/brands/thermador/' },
  { label: 'Miele',                    href: '/brands/miele/' },
  { label: 'Bosch',                    href: '/brands/bosch/' },
  { label: 'KitchenAid',               href: '/brands/kitchenaid/' },
  { label: 'Dacor',                    href: '/brands/dacor/' },
  { label: 'Fisher & Paykel',          href: '/brands/fisher-paykel/' },
  { label: 'Cove',                     href: '/brands/cove/' },
  { label: 'ILVE',                     href: '/brands/ilve/' },
  { label: 'Signature Kitchen Suite',  href: '/brands/signature-kitchen-suite/' },
  { label: 'Smeg',                     href: '/brands/smeg/' }
];

const brandResidentialMass: Link[] = [
  { label: 'LG',         href: '/brands/lg/' },
  { label: 'Samsung',    href: '/brands/samsung/' },
  { label: 'GE',         href: '/brands/ge/' },
  { label: 'Whirlpool',  href: '/brands/whirlpool/' },
  { label: 'Maytag',     href: '/brands/maytag/' },
  { label: 'Frigidaire', href: '/brands/frigidaire/' },
  { label: 'Amana',      href: '/brands/amana/' },
  { label: 'JennAir',    href: '/brands/jennair/' },
  { label: 'Sharp',      href: '/brands/sharp/' }
];

const brandSpecialtyWine: Link[] = [
  { label: 'U-Line',                    href: '/brands/u-line/' },
  { label: 'Marvel',                    href: '/brands/marvel/' },
  { label: 'Liebherr',                  href: '/brands/liebherr/' },
  { label: 'WhisperKool',               href: '/brands/whisperkool/' },
  { label: 'CellarPro',                 href: '/brands/cellarpro/' },
  { label: 'EuroCave',                  href: '/brands/eurocave/' },
  { label: 'Vinotemp',                  href: '/brands/vinotemp/' },
  { label: 'Danby Wine Cooler',         href: '/brands/danby-wine-cooler/' },
  { label: 'Summit Wine Cooler',        href: '/brands/summit-wine-cooler/' },
  { label: 'Wine Enthusiast Wine Cooler', href: '/brands/wine-enthusiast-wine-cooler/' }
];

// Wave 59 mega-nav expansion (2026-05-26) — Commercial column split into two
// sub-grouped columns to accommodate 10 new Wave 59 broad pillars (Scotsman,
// Hobart, Jackson, Champion, Rational, Garland, Imperial, Lang, Frymaster,
// Pitco) plus existing commercial pillars. Vulcan moved from old Commercial
// column to Cooking & Fryers (Vulcan ITW covers ranges + ovens + fryers).
// Total commercial pillars in nav: 6 → 16. Total mega nav brand pillars:
// 41 → 50. Hand-curated pattern preserved (Wave 55b decision).

const brandCommercialRefrigerationIce: Link[] = [
  { label: 'Scotsman',            href: '/brands/scotsman/' },
  { label: 'Hoshizaki',           href: '/brands/hoshizaki/' },
  { label: 'Manitowoc',           href: '/brands/manitowoc/' },
  { label: 'Beverage-Air',        href: '/brands/beverage-air/' },
  { label: 'True Manufacturing',  href: '/brands/true/' },
  { label: 'Traulsen',            href: '/brands/traulsen/' },
  { label: 'Delfield',            href: '/brands/delfield/' },
  { label: 'Perlick Commercial',  href: '/brands/perlick-commercial/' }
];

const brandCommercialCookingFryers: Link[] = [
  // Warewashing
  { label: 'Champion',            href: '/brands/champion/' },
  { label: 'Hobart',              href: '/brands/hobart/' },
  { label: 'Jackson',             href: '/brands/jackson/' },
  // Ranges / Ovens / Combi
  { label: 'Garland',             href: '/brands/garland/' },
  { label: 'Imperial',            href: '/brands/imperial/' },
  { label: 'Lang',                href: '/brands/lang/' },
  { label: 'Rational',            href: '/brands/rational/' },
  { label: 'Vulcan',              href: '/brands/vulcan/' },
  // Fryers
  { label: 'Frymaster',           href: '/brands/frymaster/' },
  { label: 'Pitco',               href: '/brands/pitco/' },
  // Ventilation / Hoods
  { label: 'CaptiveAire',         href: '/brands/captiveaire/' }
];

// Outdoor brand pillars live at /outdoor/brands/{slug}/ (not /brands/{slug}/).
// T1 audit 2026-05-26 confirmed all 7 exist with strong content (3,500-4,100w).
const brandOutdoor: Link[] = [
  { label: 'Lynx',         href: '/outdoor/brands/lynx/' },
  { label: 'Alfresco',     href: '/outdoor/brands/alfresco/' },
  { label: 'DCS',          href: '/outdoor/brands/dcs/' },
  { label: 'Twin Eagles',  href: '/outdoor/brands/twin-eagles/' },
  { label: 'Fire Magic',   href: '/outdoor/brands/fire-magic/' },
  { label: 'Hestan',       href: '/outdoor/brands/hestan/' },
  { label: 'Kalamazoo',    href: '/outdoor/brands/kalamazoo/' }
];

const menu: Array<{ label: string; href: string; panel: Panel }> = [
  {
    label: 'Services',
    href: '/services/',
    panel: { kind: 'flow', links: services }
  },
  {
    label: 'Commercial',
    href: '/commercial/',
    panel: { kind: 'flow', links: commercial }
  },
  {
    label: 'Brands',
    href: '/brands/',
    panel: {
      kind: 'grouped',
      cols: 6,
      columns: [
        { title: 'Residential Premium',              links: brandResidentialPremium },
        { title: 'Residential Mass Market',          links: brandResidentialMass },
        { title: 'Specialty & Wine',                 links: brandSpecialtyWine },
        { title: 'Commercial — Refrigeration & Ice', links: brandCommercialRefrigerationIce },
        { title: 'Commercial — Cooking & Fryers',    links: brandCommercialCookingFryers },
        { title: 'Outdoor & Grills',                 links: brandOutdoor }
      ]
    }
  },
  {
    label: 'For Business',
    href: '/for-business/',
    panel: { kind: 'flow', links: forBusiness }
  },
  {
    label: 'Price List',
    href: '/price-list/',
    panel: {
      kind: 'pricelist',
      residential: priceResidential,
      commercial: priceCommercial,
      html: `<strong>${diagnosticFee} diagnostic</strong> — waived with repair.<br/>OEM parts, 90-day warranty, no hidden fees.<br/><br/><a href="/price-list/">View full price list →</a>`
    }
  },
  {
    label: 'Areas',
    href: '/areas/',
    panel: { kind: 'areas', counties: countiesWithBranches }
  },
  {
    label: 'About',
    href: '/credentials/',
    panel: {
      kind: 'grouped',
      columns: [
        { title: 'Credentials', links: credA },
        { title: 'Trust & Quality', links: credB },
        {
          title: 'Contact Us',
          html: `<a href="tel:${mainPhoneTel}" class="panel-phone">${mainPhone}</a>Same-day service across LA, Orange &amp; Ventura counties.<br/><br/><a href="/book/">Book a visit →</a><br/><a href="/contact/">Contact &amp; all 8 branches →</a><br/><a href="/credentials/">All credentials →</a>`
        }
      ]
    }
  }
];
---

<nav class="mega-menu" aria-label="Main navigation">
  <ul class="mega-menu-list">
    {menu.map((item) => (
      <li class="mega-menu-item" data-has-panel>
        <a href={item.href} class="mega-menu-trigger">
          <span class="trigger-label">{item.label}</span>
          <span class="trigger-underline" aria-hidden="true"></span>
        </a>
        <div class="mega-panel" role="region" aria-label={`${item.label} menu`}>
          {item.panel.kind === 'flow' ? (
            <div class="mega-panel-inner">
              <ul class="panel-flow">
                {item.panel.links.map((link) => (
                  <li><a href={link.href}>{link.label}</a></li>
                ))}
              </ul>
            </div>
          ) : item.panel.kind === 'pricelist' ? (
            <div class="mega-panel-inner">
              <div class="price-list-grid">
                <div class="price-col">
                  <h4>Residential</h4>
                  <div class="price-items-grid">
                    {item.panel.residential.map((p) => (
                      p.exists ? (
                        <a href={p.href} class="price-link">{p.label}</a>
                      ) : (
                        <span class="price-link missing" title="Page not yet created">{p.label}</span>
                      )
                    ))}
                  </div>
                </div>
                <div class="price-col">
                  <h4>Commercial</h4>
                  <div class="price-items-grid">
                    {item.panel.commercial.map((p) => (
                      p.exists ? (
                        <a href={p.href} class="price-link">{p.label}</a>
                      ) : (
                        <span class="price-link missing" title="Page not yet created">{p.label}</span>
                      )
                    ))}
                  </div>
                </div>
                <div class="price-col">
                  <h4>Transparent Pricing</h4>
                  <div class="panel-message" set:html={item.panel.html} />
                </div>
              </div>
            </div>
          ) : item.panel.kind === 'areas' ? (
            <div class="mega-panel-inner panel-areas">
              {item.panel.counties.map((county) => (
                <div class="county-section">
                  <div class="county-header">
                    <span class="county-name">{county.name}</span>
                    <a href={county.hubUrl} class="county-hub-link">View all {county.name} →</a>
                  </div>
                  {county.branches.map((branch) => (
                    <div class="branch-block">
                      <div class="branch-header">
                        <a href={`/${branch.slug}/`} class="branch-name">{branch.displayCity} Branch</a>
                        <a href={`tel:+1${branch.phone.replace(/\D/g, '')}`} class="branch-phone">{branch.phone}</a>
                      </div>
                      {branch.cities.length > 0 && (
                        <div class="branch-cities">
                          {branch.cities.map((city) => (
                            <a href={`/${city.slug}/`} class="city-link">{city.name}</a>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ))}
            </div>
          ) : (
            <div class={`mega-panel-inner mega-panel-grid ${item.panel.align === 'center' ? 'is-center' : ''} ${item.panel.cols === 4 ? 'is-cols-4' : ''} ${item.panel.cols === 5 ? 'is-cols-5' : ''} ${item.panel.cols === 6 ? 'is-cols-6' : ''}`}>
              {item.panel.columns.map((col) => (
                <div class="panel-col">
                  {col.title && <h4>{col.title}</h4>}
                  {col.links && (
                    <ul class="panel-list">
                      {col.links.map((link) => (
                        <li><a href={link.href}>{link.label}</a></li>
                      ))}
                    </ul>
                  )}
                  {col.html && <div class="panel-message" set:html={col.html} />}
                </div>
              ))}
            </div>
          )}
        </div>
      </li>
    ))}
  </ul>
</nav>

<script is:inline>
  (function () {
    const items = Array.from(document.querySelectorAll('.mega-menu-item[data-has-panel]'));
    const isMobile = () => window.matchMedia('(max-width: 1024px)').matches;
    let closeTimer = null;

    function closeAll() {
      items.forEach((i) => i.classList.remove('is-open'));
    }

    items.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        if (isMobile()) return;
        clearTimeout(closeTimer);
        items.forEach((i) => { if (i !== item) i.classList.remove('is-open'); });
        item.classList.add('is-open');
      });
      item.addEventListener('mouseleave', () => {
        if (isMobile()) return;
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => item.classList.remove('is-open'), 150);
      });

      // Mobile accordion: tap trigger to toggle, prevent navigation on first tap
      const trigger = item.querySelector('.mega-menu-trigger');
      if (trigger) {
        trigger.addEventListener('click', (e) => {
          if (!isMobile()) return;
          if (!item.classList.contains('is-open')) {
            e.preventDefault();
            items.forEach((i) => { if (i !== item) i.classList.remove('is-open'); });
            item.classList.add('is-open');
          }
        });
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
    });
    document.addEventListener('click', (e) => {
      if (isMobile()) return;
      if (!e.target.closest('.mega-menu-item')) closeAll();
    });
  })();
</script>

<style>
  /* ===================== Top-level nav ===================== */
  .mega-menu {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .mega-menu-list {
    display: flex;
    list-style: none;
    gap: 4px;
    margin: 0;
    padding: 0;
  }

  .mega-menu-item {
    /* No position: relative — let .mega-panel position relative to the sticky .navbar */
  }

  .mega-menu-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 10px 14px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .mega-menu-trigger:hover { color: var(--black); }

  .trigger-underline {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s var(--ease);
    pointer-events: none;
  }
  .mega-menu-item:hover .trigger-underline,
  .mega-menu-item:focus-within .trigger-underline,
  .mega-menu-item.is-open .trigger-underline {
    transform: scaleX(1);
  }

  /* ===================== Full-width panel ===================== */
  .mega-panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background: rgba(10, 10, 10, 0.85);
    -webkit-backdrop-filter: blur(20px) saturate(1.8);
    backdrop-filter: blur(20px) saturate(1.8);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.4);
    color: #ffffff;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.25s ease-out,
      transform 0.25s ease-out,
      visibility 0s linear 0.25s;
    z-index: 5;
  }

  /* Fallback when backdrop-filter is unsupported */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mega-panel { background: rgba(10, 10, 10, 0.95); }
  }

  /* Invisible hover bridge between trigger and panel */
  .mega-panel::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
  }

  .mega-menu-item:hover .mega-panel,
  .mega-menu-item:focus-within .mega-panel,
  .mega-menu-item.is-open .mega-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity 0.25s ease-out,
      transform 0.25s ease-out,
      visibility 0s linear 0s;
  }

  .mega-panel-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 48px 64px;
  }

  /* ===================== Flow layout (auto vertical columns) ===================== */
  .panel-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    column-count: 3;
    column-gap: 64px;
  }
  .panel-flow li {
    break-inside: avoid;
  }

  /* ===================== Grid layout (explicit columns) ===================== */
  .mega-panel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 64px;
  }
  .mega-panel-grid.is-center {
    grid-template-columns: minmax(0, 560px);
    justify-content: center;
    text-align: center;
  }
  .mega-panel-grid.is-cols-4 {
    grid-template-columns: repeat(4, 1fr);
    gap: 32px 40px;
  }
  .mega-panel-grid.is-cols-5 {
    grid-template-columns: repeat(5, 1fr);
    gap: 24px 28px;
  }
  .mega-panel-grid.is-cols-6 {
    grid-template-columns: repeat(6, 1fr);
    gap: 20px 22px;
  }

  .panel-col h4 {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--red);
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(200, 16, 46, 0.2);
  }

  .panel-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Shared link styling for both layouts */
  .panel-flow a,
