---
// src/components/QuoteSheet.astro
//
// Full-screen quote sheet — one question per screen.
//
// QS-2: mounted once in Layout.astro, so it exists on every page. It reads its own
// page context from Astro.url (see quote-context.ts) and prefills what that page
// already tells us — never more than that.
//
// Shape: a native <dialog id="quote-sheet"> rendered empty (header + body slot +
// footer), plus a JSON blob of everything runtime-variable, plus a tiny loader
// that lazily imports the state machine on the first trigger click.
//
// Every string and every number arrives through src/data/quote-copy.ts. This file
// carries no currency literal of its own — scripts/check-quote-sheet.mjs enforces it.

import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import {
  DIAGNOSTIC_RES_DISPLAY,
  DIAGNOSTIC_COM_DISPLAY,
  DIAGNOSTIC_TERMS,
  SCOPE_LABELS,
  HOURS_LINE,
  CALLBACK_COPY,
  PRICE_COPY,
  STEP_COPY,
  TOTAL_STEPS,
  OUT_OF_ZONE_NOTE,
  ADDRESS_COPY,
  ZIP_COPY,
  VISIT_TIMES,
  PHOTOS_COPY,
  ERROR_COPY,
  PREFILL_COPY,
} from '../data/quote-copy';
import { APPLIANCES_BY_SCOPE } from '../data/quote-appliances';
import { getQuoteContext } from '../data/quote-context';
import { BRAND_PILLAR_MAP } from '../data/brand-pillar-map';
import { ZIP_EXACT, ZIP_PREFIX3, MAIN_BRANCH_SLUG } from '../data/service-zone';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../data/branches';

export interface Props {
  /** Display phone for the "call instead" affordances inside the sheet. */
  phone?: string;
}

const { phone = MAIN_PHONE } = Astro.props;

/**
 * QS-2: what this page already tells us. Derived from the URL inside the component
 * so no page has to opt in and no page can pass a context that contradicts its own
 * address. `null` everywhere is the normal case, not a failure — see quote-context.ts.
 */
const context = getQuoteContext(Astro.url.pathname);

/** Display name for the brand chip. BRAND_PILLAR_MAP is display -> slug, so take the
 *  shortest display name that maps to this slug ("GE" over "GE Appliances"). */
const brandLabel = context.brand
  ? Object.entries(BRAND_PILLAR_MAP)
      .filter(([, slug]) => slug === context.brand)
      .map(([display]) => display)
      .sort((a, b) => a.length - b.length)[0] || null
  : null;

/** The prefilled tile's own label, so the confirm heading reads "Is it your Dryer?"
 *  in exactly the words the tile uses. Resolved here; the island never guesses. */
const applianceLabel = (() => {
  if (!context.appliance) return null;
  for (const list of Object.values(APPLIANCES_BY_SCOPE)) {
    const hit = list.find((a) => a.id === context.appliance);
    if (hit) return hit.label;
  }
  return null;
})();

// slug -> { name, phone } for the done screen and for the Telegram card, which
// prints the branch by name, not by slug.
const branchDirectory = Object.fromEntries(
  BRANCHES.filter((b) => b.phoneStatus === 'active').map((b) => [b.slug, { name: b.name, phone: b.phone }])
);

/**
 * The Maps key, resolved at BUILD time — the site is output: 'static', so there is no
 * runtime to read an env var from. Cloudflare Pages exposes plain env vars to the build,
 * which is why GOOGLE_MAPS_KEY is a plain variable and not a secret (a secret would be
 * invisible here). The key is a browser key restricted by HTTP referrer, so shipping it
 * in the page is how it is meant to be used.
 *
 * With no key the address field stays an ordinary text input and the flow still submits —
 * the lead just arrives marked unverified.
 */
const mapsKey = (() => {
  const fromEnv = (process.env.GOOGLE_MAPS_KEY ?? process.env.PUBLIC_GOOGLE_MAPS_KEY ?? '').trim();
  if (fromEnv) return fromEnv;
  try {
    const p = resolve(process.cwd(), 'secrets/google-maps-key.txt');
    if (existsSync(p)) {
      const k = readFileSync(p, 'utf8').trim();
      if (k) return k;
    }
  } catch {
    /* no local key — plain text field, documented behaviour */
  }
  return '';
})();

const payload = {
  hasMaps: Boolean(mapsKey),
  // NOTE: the appliance/symptom tables are NOT here. QS-2 puts the sheet on all
  // 1197 pages, and inlining ~12 KB of tiles into every one of them costs ~3.7 KB
  // gzipped per page for data no visitor sees until they open the sheet. The island
  // imports them instead, so they arrive with the chunk, on the first click.
  price: {
    residential: DIAGNOSTIC_RES_DISPLAY,
    commercial: DIAGNOSTIC_COM_DISPLAY,
  },
  copy: {
    terms: DIAGNOSTIC_TERMS,
    scopeLabels: SCOPE_LABELS,
    hours: HOURS_LINE,
    callback: CALLBACK_COPY,
    price: PRICE_COPY,
    steps: STEP_COPY,
    totalSteps: TOTAL_STEPS,
    outOfZone: OUT_OF_ZONE_NOTE,
    address: ADDRESS_COPY,
    zip: ZIP_COPY,
    visitTimes: VISIT_TIMES,
    photos: PHOTOS_COPY,
    errors: ERROR_COPY,
    prefill: PREFILL_COPY,
  },
  // Null-heavy by design: most pages tell us nothing, and that is the honest answer.
  context: {
    scope: context.scope,
    appliance: applianceLabel ? context.appliance : null,
    applianceLabel,
    brand: context.brand,
    brandLabel,
    pageType: context.pageType,
  },
  zone: {
    exact: ZIP_EXACT,
    prefix3: ZIP_PREFIX3,
    mainSlug: MAIN_BRANCH_SLUG,
  },
  phones: { main: phone, mainTel: MAIN_PHONE_TEL, branches: branchDirectory },
};
---

{mapsKey && (
  <script
    is:inline
    type="application/json"
    data-quote-sheet-maps
    set:html={JSON.stringify({
      src: `https://maps.googleapis.com/maps/api/js?key=${mapsKey}&libraries=places&loading=async&callback=__quoteSheetMapsReady`,
    })}
  />
)}

<dialog id="quote-sheet" class="qs" aria-labelledby="qs-heading">
  <div class="qs-shell">
    <header class="qs-head">
      <button type="button" id="qs-back" class="qs-icon" aria-label="Back">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <span id="qs-counter" class="qs-counter" aria-live="polite"></span>
      <button type="button" id="qs-close" class="qs-icon" aria-label="Close">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <div id="qs-body" class="qs-body">
      <h2 id="qs-heading" class="qs-h"></h2>
    </div>

    <footer class="qs-foot">
      <div id="qs-foot-note" class="qs-foot-note"></div>
      <button type="button" id="qs-primary" class="qs-primary"></button>
    </footer>
  </div>
</dialog>

<script type="application/json" id="qs-data" set:html={JSON.stringify(payload)}></script>

<script>
  // Lazy loader. The state machine is a separate chunk; it is fetched on the first
  // pointerenter/touchstart over any trigger (prefetch) and imported for real on the
  // first click. Nothing of the sheet's logic is in the initial page bundle.
  //
  // QS-2: a trigger is now EITHER an explicit [data-quote-source] element OR any
  // ordinary link to /book/. The href is left alone, so with JS off — or before this
  // chunk has loaded — the link still navigates to the booking page and the visitor
  // gets the fallback form. Nothing on the page has to be rewritten to opt in.
  (() => {
    const EXPLICIT = '[data-quote-source]';
    let mod: Promise<typeof import('./QuoteSheet.client')> | null = null;

    const load = () => (mod ??= import('./QuoteSheet.client'));

    /** The /book/ link this event came from, if any. Compares resolved pathnames, so
     *  "/book/", "/book/#contact" and an absolute same-origin URL all count, while a
     *  tel:/mailto: link resolves to neither and is left alone. */
    const bookLink = (target: EventTarget | null): HTMLAnchorElement | null => {
      const a = (target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
      if (!a) return null;
      if (a.origin !== location.origin) return null;
      return a.pathname === '/book/' || a.pathname === '/book' ? a : null;
    };

    const triggerFor = (target: EventTarget | null): HTMLElement | null =>
      ((target as Element | null)?.closest?.(EXPLICIT) as HTMLElement | null) || bookLink(target);

    const sourceFor = (el: HTMLElement): string => {
      // An explicit data-quote-source always wins — those are hand-placed and name
      // the exact slot they sit in. Everything else is labelled by page type and path.
      const explicit = el.getAttribute('data-quote-source');
      if (explicit) return explicit;
      const cfg = document.getElementById('qs-data');
      let pageType = 'unknown';
      try {
        pageType = (JSON.parse(cfg?.textContent || '{}').context || {}).pageType || 'unknown';
      } catch { /* a malformed blob must not stop the sheet from opening */ }
      return pageType + ':' + location.pathname;
    };

    const open = async (ev: Event) => {
      // Never hijack a modified click — cmd/ctrl/shift/middle open a new tab, and the
      // href still points at a real page, so let the browser do its job.
      const m = ev as MouseEvent;
      if (m.defaultPrevented || m.button > 0 || m.metaKey || m.ctrlKey || m.shiftKey || m.altKey) return;
      const trigger = triggerFor(ev.target);
      if (!trigger) return;
      // Only hijack when a dialog is actually present and supported.
      const dlg = document.getElementById('quote-sheet') as HTMLDialogElement | null;
      if (!dlg || typeof dlg.showModal !== 'function') return;
      ev.preventDefault();
      const api = await load();
      api.openSheet(sourceFor(trigger));
    };

    const maybePrefetch = (e: Event) => { if (triggerFor(e.target)) load(); };

    document.addEventListener('pointerenter', maybePrefetch, { capture: true, passive: true });
    document.addEventListener('touchstart', maybePrefetch, { capture: true, passive: true });
    document.addEventListener('click', open);
  })();
</script>

<style>
  /* The sheet's inner nodes are built at runtime via innerHTML, so they never get
     Astro's scope attribute. Everything below the shell therefore goes through
     `.qs :global(...)`, which compiles to `.qs[data-astro-cid-…] .selector`. */

  .qs {
    padding: 0;
    border: none;
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    max-width: none;
    max-height: none;
    overflow: visible;
  }
  .qs::backdrop { background: rgba(10, 10, 10, 0.62); }
  .qs:not([open]) { display: none; }

  .qs-shell {
    display: flex;
    flex-direction: column;
    background: var(--white);
    width: 100%;
    /* dvh, never vh — vh is wrong under the mobile URL bar. */
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden;
  }

  .qs-head {
    flex: 0 0 auto;
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 8px;
    padding: max(8px, env(safe-area-inset-top)) 8px 8px;
    border-bottom: 1px solid var(--border);
    background: var(--white);
  }
  .qs-counter {
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .qs-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    border-radius: 4px;
  }
  .qs-icon:hover { background: var(--gray); }
  .qs-icon:focus-visible { outline: 2px solid var(--red); outline-offset: -2px; }
  .qs-icon[hidden] { visibility: hidden; display: inline-flex; }

  .qs-body {
    flex: 1 1 auto;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 20px 20px 8px;
  }
  .qs-h {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 5vw, 1.75rem);
    line-height: 1.2;
    margin: 0 0 6px;
    color: var(--black);
  }

  .qs-foot {
    flex: 0 0 auto;
    padding: 12px 20px calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: var(--white);
  }
  .qs-foot-note {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .qs-foot-note:empty { display: none; }
  .qs-primary {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: 16px 22px;
    background: var(--red);
    color: var(--white);
    border: none;
    border-radius: 4px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  .qs-primary:hover { background: var(--red-dark); }
  .qs-primary:disabled { opacity: 0.45; cursor: default; }
  .qs-primary:focus-visible { outline: 2px solid var(--black); outline-offset: 2px; }

  /* ── Runtime-built content ─────────────────────────────────────────────── */

  .qs :global(.qs-sub) {
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 18px;
  }

  .qs :global(.qs-tiles) {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr;
    margin: 0 0 16px;
  }
  .qs :global(.qs-tiles.qs-two) { grid-template-columns: 1fr 1fr; }
  /* Three across, for a list too long to fit two-wide inside one phone screen.
     At 360px that is a 101px tile — comfortably past the 44px touch floor. The
     desktop media query below only re-declares qs-two, so three columns carry
     through to the wide card, where there is more room, not less. */
  /* A third column means a third of the width for the same words, so the type and
     the padding come down with it. 101px wide by 44px tall is still a bigger target
     than the 44x44 floor, and the alternative — a step that scrolls — hides tiles
     from anyone who does not think to scroll a list that looks complete.
     Both selectors carry an extra class on purpose: .qs-compact is declared further
     down the file and would otherwise win on source order at equal specificity. */
  .qs :global(.qs-tiles.qs-three) { grid-template-columns: 1fr 1fr 1fr; }
  .qs :global(.qs-tiles.qs-three.qs-compact) { gap: 6px; }
  .qs :global(.qs-tiles.qs-three .qs-tile) {
    padding: 8px 6px;
    font-size: 14px;
    line-height: 1.2;
    text-align: center;
    align-items: center;
  }

  .qs :global(.qs-tile) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    /* ≥56px tall is the touch-target floor for every tile in the sheet. */
    min-height: 56px;
    width: 100%;
    padding: 14px 16px;
    text-align: left;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }
  .qs :global(.qs-tile:hover) { border-color: var(--black); }
  .qs :global(.qs-tile:focus-visible) { outline: 2px solid var(--red); outline-offset: 1px; }
  .qs :global(.qs-tile[aria-pressed='true']) {
    border-color: var(--red);
    box-shadow: inset 0 0 0 1px var(--red);
  }
  .qs :global(.qs-tile-hint) {
    font-size: 13px;
    font-weight: 400;
    color: var(--muted);
  }

  /* QS-2 prefill. The tile the page guessed is marked, but marked as a GUESS:
     grey ring on grey ground, not the red of a choice the visitor made. The moment
     they tap any tile — this one included — it becomes a normal red selection. */
  .qs :global(.qs-tile-prefill[aria-pressed='true']) {
    border-color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--muted);
    background: var(--gray);
  }

  /* Brand chip — what the page was about, carried to dispatch, never asked about. */
  .qs :global(.qs-chips) { margin: 0 0 10px; }
  .qs :global(.qs-chip) {
    display: inline-block;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--gray);
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  /* Compact tile — the appliance step only. Sixteen residential tiles plus the
     Continue button have to sit inside a 360×740 viewport without the sheet body
     scrolling, and the 56px tile does not get there. 44px is the touch-target
     floor, so this is as short as a tile is allowed to be. */
  .qs :global(.qs-tiles.qs-compact) { gap: 8px; }
  .qs :global(.qs-compact .qs-tile) {
    min-height: 44px;
    padding: 10px 12px;
    font-size: 15px;
    line-height: 1.25;
  }

  .qs :global(.qs-field) { display: block; margin: 0 0 14px; }
  .qs :global(.qs-field > span) {
    display: block;
    margin-bottom: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }
  .qs :global(.qs-field em) { font-style: normal; font-weight: 400; color: var(--muted); }
  .qs :global(.qs-input),
  .qs :global(.qs-textarea) {
    width: 100%;
    min-height: 48px;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--white);
    color: var(--text);
    font-family: inherit;
    /* 16px keeps iOS Safari from zooming the viewport on focus. */
    font-size: 16px;
  }
  .qs :global(.qs-textarea) { min-height: 84px; resize: vertical; }
  .qs :global(.qs-input:focus),
  .qs :global(.qs-textarea:focus) {
    outline: 2px solid var(--red);
    outline-offset: 1px;
    border-color: var(--red);
  }
  .qs :global(.qs-input[aria-invalid='true']) { border-color: var(--red); }
  .qs :global(.qs-err) {
    display: block;
    margin-top: 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--red);
  }

  /* Address verification. Green is confirmation, grey is a nudge, red is reserved for
     the lookup request failing — never for anything the visitor did. */
  .qs :global(.qs-ok) {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ok);
  }
  .qs :global(.qs-hint) {
    display: block;
    margin-top: 6px;
    font-size: 13px;
    color: var(--muted);
  }

  .qs :global(.qs-addr-wrap) { position: relative; }
  .qs :global(.qs-addr-list) {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--white);
    max-height: 232px;
    overflow-y: auto;
  }
  .qs :global(.qs-addr-list[hidden]) { display: none; }
  .qs :global(.qs-addr-item) {
    padding: 12px 14px;
    min-height: 48px;
    font-size: 15px;
    line-height: 1.35;
    cursor: pointer;
    border-bottom: 1px solid var(--border);
  }
  .qs :global(.qs-addr-item:last-child) { border-bottom: none; }
  .qs :global(.qs-addr-item:hover) { background: var(--gray); }
  .qs :global(.qs-addr-main) { font-weight: 600; color: var(--text); }
  .qs :global(.qs-addr-sec) { color: var(--muted); }

  /* Price step */
  .qs :global(.qs-price) {
    text-align: center;
    padding: 24px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--gray);
    margin: 0 0 16px;
  }
  .qs :global(.qs-price-eyebrow) {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
  }
  .qs :global(.qs-price-amount) {
    display: block;
    font-family: var(--font-display);
    /* The smoke test asserts a computed font-size of at least 28px here. */
    font-size: clamp(2.75rem, 12vw, 3.5rem);
    font-weight: 800;
    line-height: 1.05;
    color: var(--black);
    margin: 6px 0 4px;
  }
  .qs :global(.qs-terms) {
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
  }
  .qs :global(.qs-terms li) {
    position: relative;
    padding: 0 0 0 26px;
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text);
  }
  .qs :global(.qs-terms li::before) {
    content: '';
    position: absolute;
    left: 4px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--red);
  }
  .qs :global(.qs-price-note) {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin: 14px 0 0;
  }
  .qs :global(.qs-hours) {
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
    margin: 0 0 8px;
  }

  /* Photos step */
  .qs :global(.qs-photos) { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 14px; }
  .qs :global(.qs-thumb) {
    position: relative;
    width: 96px;
    height: 96px;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    background: var(--gray);
  }
  .qs :global(.qs-thumb img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .qs :global(.qs-thumb-badge) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3px 4px;
    background: rgba(10, 10, 10, 0.72);
    color: var(--white);
    font-size: 11px;
    font-weight: 600;
    text-align: center;
  }
  .qs :global(.qs-thumb-badge.qs-thumb-bad) { background: var(--red); }
  .qs :global(.qs-thumb-uploading img) { opacity: 0.55; }
  .qs :global(.qs-thumb button) {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.72);
    color: var(--white);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
  }
  .qs :global(.qs-skip) {
    display: block;
    width: 100%;
    min-height: 56px;
    margin-top: 4px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-family: inherit;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    cursor: pointer;
  }
  .qs :global(.qs-skip:hover) { border-color: var(--black); }

  /* Notes, confirms, out-of-zone */
  .qs :global(.qs-note) {
    padding: 12px 14px;
    border-radius: 4px;
    background: var(--gray);
    border: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .qs :global(.qs-note-warn) { color: var(--text); }
  .qs :global(.qs-confirm) {
    display: flex;
    gap: 10px;
    margin-top: 10px;
  }
  .qs :global(.qs-confirm button) {
    flex: 1;
    min-height: 48px;
    border-radius: 4px;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  .qs :global(.qs-confirm .qs-stay) { background: var(--white); border: 1px solid var(--border); color: var(--text); }
  .qs :global(.qs-confirm .qs-discard) { background: var(--red); border: none; color: var(--white); }

  /* Done step */
  .qs :global(.qs-done) { text-align: center; padding: 24px 0 8px; }
  .qs :global(.qs-done-mark) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--red);
    color: var(--white);
    font-size: 30px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .qs :global(.qs-done h3) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    margin: 0 0 8px;
    color: var(--black);
  }
  .qs :global(.qs-done p) { font-size: 15px; line-height: 1.6; color: var(--muted); margin: 0 0 10px; }
  .qs :global(.qs-call) {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--red);
    text-decoration: none;
  }

  /* ── Desktop ───────────────────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .qs {
      margin: auto;
      width: min(560px, calc(100vw - 48px));
