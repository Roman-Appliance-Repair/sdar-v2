    .qs :global(.qs-tiles.qs-two) { grid-template-columns: 1fr 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .qs[open] .qs-shell { animation: qs-in 0.18s var(--ease); }
    @keyframes qs-in {
      from { opacity: 0; transform: translateY(8px); }
