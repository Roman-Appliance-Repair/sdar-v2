---
// src/components/AIDiagnosticCard.astro
//
// AID-2. The diagnostic's front door, in the homepage hero.
// AID-3. The same front door in every service, city-service, brand, commercial and
//        outdoor hero — compact, and carrying what the page already knows.
//
// The feature converted when it had a page of its own and stopped when it was shrunk
// to a strip. This card is the compromise: it costs the hero one rectangle, it asks
// for nothing, and the thing a visitor types into it is carried straight into the
// diagnostic rather than thrown away and asked for again.
//
// The card is deliberately NOT a form that posts anywhere. The <input> is a doorway:
// focusing it, typing in it, or pressing the button opens the sheet and hands the
// text over as the initial free-text detail. With JS off, the button is an ordinary
// link to /ai-diagnostic/ and the input does nothing — no broken submit, no dead end.
//
// ── AID-3, two things and only two ──────────────────────────────────────────────
//
// 1. `variant`. 'hero' is the homepage card, unchanged to the pixel. 'compact' drops
//    the 26px display title (the eyebrow already says what this is) and tightens the
//    vertical rhythm, because these heroes already carry an H1, a subtitle, a CTA row
//    and — on most of them — an eight-branch block underneath.
//
// 2. `tone`. 'frame' is the AID-2 look: no fill at all, white text, a hairline border,
//    legibility from the hero's own photo overlay. 'light' is for the heroes with no
//    photograph behind them, where a white-on-nothing card would be white text on a
//    flat colour with no overlay to sit on: there the card takes var(--gray) with a
//    var(--border) hairline and dark text. There is deliberately no third option and
//    no dark fill — a dark rectangle inside a dark hero is the panel this design was
//    written to avoid.
//
// The PREFILL is not a prop either. The card reads its own address through
// getDiagnosticPrefill(), the same pure function the gate reads, so a page cannot
// describe itself wrongly and 830 page files need no edits. What it emits is three
// data attributes the sheet loader hands to the island — nothing more. The island's
// flow, copy and step order are untouched: the prefill only sets state a visitor
// could have set themselves by tapping the same tiles.

//
// A note on the <style> blocks below, because the obvious change is the wrong one:
// they are ordinary SCOPED styles, and Astro therefore bundles them through Vite into
// the stylesheet every page inlines (this project builds with inlineStylesheets
// 'always'). That means the ~190 pages with no card — /blog/, /book/, /contact/, the
// 99 city pillars, /price-list/ — carry about 0.8KB gz of rules they never use.
// `is:inline` removes exactly that, and was measured: it also removes Astro's CSS
// minifier, which costs the 1,006 pages that DO render a card about 1.7KB gz each.
// Trading 1.7KB on a thousand pages to save 0.8KB on two hundred is the wrong way
// round, so the rules stay scoped and the small leak stays. Re-measure before
// changing this; do not change it on principle.
import {
  getDiagnosticPrefill,
  diagnosticHeading,
  diagnosticPlaceholder,
} from '../data/aid-to-quote-map';
import AIDiagnosticSheet from './AIDiagnosticSheet.astro';
import { MAIN_PHONE } from '../data/branches';

export interface Props {
  /** 'hero' = the homepage card. 'compact' = the AID-3 one, no display title. */
  variant?: 'hero' | 'compact';
  /** 'frame' over a photo, 'light' over a hero that has none. Never a dark fill. */
  tone?: 'frame' | 'light';
  /** The number the diagnostic's verdict offers as the alternative to booking.
   *  Pass the hero's own, so the sheet and the call button agree. */
  phone?: string;
}

const { variant = 'hero', tone = 'frame', phone = MAIN_PHONE } = Astro.props;

const pre = getDiagnosticPrefill(Astro.url.pathname);
const heading = diagnosticHeading(Astro.url.pathname);
// The example in the field follows the page too. On the homepage and on any page
// that resolves nothing this is AID-2's dryer line, unchanged.
const placeholder = diagnosticPlaceholder(Astro.url.pathname);
const compact = variant === 'compact';
---

<div
  class:list={['aid-card', compact && 'aid-card--compact', tone === 'light' && 'aid-card--light']}
  data-aid-card
  data-aid-pre-category={pre.category ?? undefined}
  data-aid-pre-appliance={pre.appliance ?? undefined}
  data-aid-pre-brand={pre.brand ?? undefined}
>
  {compact ? (
    <p class="aid-card-eyebrow">AI Diagnostic · free · about a minute</p>
  ) : (
    <Fragment>
      <h2 class="aid-card-title">AI Diagnostic</h2>
      <p class="aid-card-eyebrow">Free · about a minute</p>
    </Fragment>
  )}
  <p class="aid-card-h">{heading}</p>
  <p class="aid-card-sub">
    Describe it in your own words — get the likely causes and a repair cost range before you book.
  </p>
  <div class="aid-card-row">
    <input
      type="text"
      id="aid-card-input"
      class="aid-card-input"
      aria-label="Describe what your appliance is doing"
      placeholder={placeholder}
      autocomplete="off"
      data-aid-open
    />
    <a href="/ai-diagnostic/" class="aid-card-btn" data-aid-open data-aid-submit>Diagnose it free</a>
  </div>
</div>

<!-- The sheet the card opens, emitted BY the card.
     AID-2 mounted it beside the hero and AID-3 first tried to mount it once in the
     layout. Both cost every page in the site the diagnostic's CSS: this project
     builds with inlineStylesheets 'always', so a component merely IMPORTED by
     Layout.astro has its styles inlined into all 1,198 pages — /blog/ and /book/
     were carrying 6.4KB of markup rules for a card and a dialog neither of them
     renders. Emitting it here ties the two together the only way that cannot
     drift: one card, one sheet, on exactly the pages that have a card, and not a
     byte on the pages that do not.
     The dialog is opened with showModal(), so it is painted in the browser's top
     layer and neither the hero's overflow:hidden nor the glass panel's
     backdrop-filter can clip it — the loader falls back to a plain link to
     /ai-diagnostic/ on anything without showModal. -->
<AIDiagnosticSheet phone={phone} />

<style>
  /* A frame on the photograph, not a panel over it. The card adds no backdrop of
     its own — what is behind its text is exactly what is behind the H1 on the left,
     the hero's own image overlay and nothing else — so the technicians and the van
     stay in the picture. The only opaque things inside it are the input and the
     button, which have to be opaque to be usable.
     Legibility comes from the text-shadow on each line, measured rather than
     assumed: see the contrast figures in the commit. */
  .aid-card {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 12px;
    padding: 20px;
    width: 100%;
    box-sizing: border-box;
  }
  /* The card's own name, in the site's display face — same family as the H1 above
     it, so the hero reads as one thing with two offers rather than a banner with a
     widget bolted to it. */
  .aid-card-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-h {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 6px;
    color: #fff;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-sub {
    font-size: 14px;
    line-height: 1.55;
    color: #fff;
    margin: 0 0 16px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* 16px, never smaller: anything under it makes iOS zoom the page on focus. */
  .aid-card-input {
    width: 100%;
    box-sizing: border-box;
    font-size: 16px;
    font-family: inherit;
    line-height: 1.4;
    padding: 14px 14px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #fff;
    color: var(--text, #1a1a1a);
    min-height: 52px;
  }
  .aid-card-input::placeholder { color: #767676; }
  .aid-card-input:focus-visible {
    outline: 2px solid var(--red, #c8102e);
    outline-offset: 2px;
  }
  .aid-card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 18px;
    border-radius: 8px;
    border: none;
    background: var(--red, #c8102e);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    text-align: center;
  }
  .aid-card-btn:hover { background: #a80d26; }
  .aid-card-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* The new title line costs about 40px, and on a 360x740 phone that is the
     difference between the input sitting on the fold and sitting under it. Bought
     back here rather than by shrinking type: padding and gaps, nothing a reader
     notices, and the button keeps its 52px. */
  @media (max-width: 900px) {
    .aid-card { padding: 16px; }
    .aid-card-title { font-size: 24px; margin: 0 0 4px; }
    .aid-card-eyebrow { margin: 0 0 10px; }
    .aid-card-sub { margin: 0 0 12px; }
  }

  @media (min-width: 1024px) {
    .aid-card { padding: 24px; }
    .aid-card-title { font-size: 30px; }
    .aid-card-h { font-size: 18px; }
  }

  /* ── AID-3: compact ──────────────────────────────────────────────────────────
     Same frame, same 52px targets, same 16px input — the two things that are
     actually load-bearing on a phone. What goes is the display title and about
     20px of vertical air, because on a service hero this card follows an H1, a
     subtitle and a CTA row instead of opening the page. */
  .aid-card--compact {
    padding: 16px;
    max-width: 460px;
  }
  .aid-card--compact .aid-card-eyebrow { margin: 0 0 8px; }
  .aid-card--compact .aid-card-h { font-size: 18px; margin: 0 0 6px; }
  .aid-card--compact .aid-card-sub { margin: 0 0 12px; }
  @media (min-width: 1024px) {
    .aid-card--compact { padding: 18px; }
    .aid-card--compact .aid-card-h { font-size: 19px; }
    /* Wide enough for the input and the button to sit side by side, which saves
       another row of height on the heroes that have the least to spare. */
    .aid-card--compact .aid-card-row { flex-direction: row; align-items: stretch; }
    .aid-card--compact .aid-card-input { flex: 1 1 auto; }
    .aid-card--compact .aid-card-btn { flex: 0 0 auto; white-space: nowrap; }
  }

  /* ── AID-3: light ────────────────────────────────────────────────────────────
     For heroes with no photograph. The frame variant's legibility comes from the
     photo overlay; with no photo there is nothing to sit on, so the card takes the
     site's own surface tokens and dark text. Not a dark fill: a dark rectangle
     inside a dark hero is the panel this whole design avoids. */
  .aid-card--light {
    background: var(--gray, #f5f5f5);
    border: 1.5px solid var(--border, #e2e2e2);
    color: var(--text, #1a1a1a);
  }
  .aid-card--light .aid-card-title,
  .aid-card--light .aid-card-eyebrow,
  .aid-card--light .aid-card-h,
  .aid-card--light .aid-card-sub {
    color: var(--text, #1a1a1a);
    text-shadow: none;
  }
  .aid-card--light .aid-card-sub { color: var(--muted, #5a5a5a); }
  .aid-card--light .aid-card-input {
    border: 1px solid var(--border, #d4d4d4);
    background: var(--white, #fff);
  }
</style>
