---
// src/components/AIDiagnosticCard.astro
//
// AID-2. The diagnostic's front door, in the homepage hero.
//
// The feature converted when it had a page of its own and stopped when it was shrunk
// to a strip. This card is the compromise: it costs the hero one dark rectangle, it
// asks for nothing, and the thing a visitor types into it is carried straight into
// the diagnostic rather than thrown away and asked for again.
//
// The card is deliberately NOT a form that posts anywhere. The <input> is a doorway:
// focusing it, typing in it, or pressing the button opens the sheet and hands the
// text over as the initial free-text detail. With JS off, the button is an ordinary
// link to /ai-diagnostic/ and the input does nothing — no broken submit, no dead end.
---

<div class="aid-card" data-aid-card>
  <h2 class="aid-card-title">AI Diagnostic</h2>
  <p class="aid-card-eyebrow">Free · about a minute</p>
  <p class="aid-card-h">Not sure what's wrong?</p>
  <p class="aid-card-sub">
    Describe it in your own words — get the likely causes and a repair cost range before you book.
  </p>
  <div class="aid-card-row">
    <input
      type="text"
      id="aid-card-input"
      class="aid-card-input"
      aria-label="Describe what your appliance is doing"
      placeholder="My dryer runs but doesn't heat…"
      autocomplete="off"
      data-aid-open
    />
    <a href="/ai-diagnostic/" class="aid-card-btn" data-aid-open data-aid-submit>Diagnose it free</a>
  </div>
</div>

<style>
  /* A frame on the photograph, not a panel over it. The card adds no backdrop of
     its own — what is behind its text is exactly what is behind the H1 on the left,
     the hero's own image overlay and nothing else — so the technicians and the van
     stay in the picture. The only opaque things inside it are the input and the
     button, which have to be opaque to be usable.
     Legibility comes from the text-shadow on each line, measured rather than
     assumed: see the contrast figures in the commit. */
  .aid-card {
    background: transparent;
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.55);
    border-radius: 12px;
    padding: 20px;
    width: 100%;
    box-sizing: border-box;
  }
  /* The card's own name, in the site's display face — same family as the H1 above
     it, so the hero reads as one thing with two offers rather than a banner with a
     widget bolted to it. */
  .aid-card-title {
    font-family: var(--font-display, Georgia, serif);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin: 0 0 12px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-h {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 6px;
    color: #fff;
    letter-spacing: -0.01em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-sub {
    font-size: 14px;
    line-height: 1.55;
    color: #fff;
    margin: 0 0 16px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }
  .aid-card-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* 16px, never smaller: anything under it makes iOS zoom the page on focus. */
  .aid-card-input {
    width: 100%;
    box-sizing: border-box;
    font-size: 16px;
    font-family: inherit;
    line-height: 1.4;
    padding: 14px 14px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: #fff;
    color: var(--text, #1a1a1a);
    min-height: 52px;
  }
  .aid-card-input::placeholder { color: #767676; }
  .aid-card-input:focus-visible {
    outline: 2px solid var(--red, #c8102e);
    outline-offset: 2px;
  }
  .aid-card-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 18px;
    border-radius: 8px;
    border: none;
    background: var(--red, #c8102e);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    font-family: inherit;
    text-decoration: none;
    cursor: pointer;
    text-align: center;
  }
  .aid-card-btn:hover { background: #a80d26; }
  .aid-card-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  /* The new title line costs about 40px, and on a 360x740 phone that is the
     difference between the input sitting on the fold and sitting under it. Bought
     back here rather than by shrinking type: padding and gaps, nothing a reader
     notices, and the button keeps its 52px. */
  @media (max-width: 900px) {
    .aid-card { padding: 16px; }
    .aid-card-title { font-size: 24px; margin: 0 0 4px; }
    .aid-card-eyebrow { margin: 0 0 10px; }
    .aid-card-sub { margin: 0 0 12px; }
  }

  @media (min-width: 1024px) {
    .aid-card { padding: 24px; }
    .aid-card-title { font-size: 30px; }
    .aid-card-h { font-size: 18px; }
  }
</style>
