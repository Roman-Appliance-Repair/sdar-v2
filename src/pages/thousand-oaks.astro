---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Thousand Oaks, CA"
    subheadline="Conejo Valley's mix of luxury estates and established suburban homes — Sub-Zero, Thermador, Miele alongside Samsung and LG. Local Thousand Oaks branch, same-day service, OEM parts, 90-day warranty. Gated communities welcome. Weekends available."
    zips={zips}
    tier={2}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Thousand Oaks — The Conejo Valley Difference"
    paragraphs={introParagraphs}
    bookingTitle="Thousand Oaks Branch"
    bookingSub="Local office · All Conejo Valley · Same day"
  />

  <CustomNarrative
    eyebrow={communitiesNarrative.eyebrow}
    headline={communitiesNarrative.headline}
    paragraphs={communitiesNarrative.paragraphs}
    subSections={communitiesNarrative.subSections}
    background="gray"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Thousand Oaks"
    subhead="Luxury & standard brands · Conejo Valley climate aware · All ZIP codes"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Thousand Oaks Commercial Kitchen Service"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Thousand Oaks Outdoor Kitchens, Wind and Oak Litter"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    brandPills={outdoorBrands}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Thousand Oaks Areas We Service"
    subheadline="All of 91360, 91361, 91362, and 91320 — Dos Vientos, Lynn Ranch, Newbury Park, North Ranch."
    zips={zips}
    neighborhoods={neighborhoods}
