const pricingTiers = [
  { appliance: 'Sub-Zero / Wolf / Gaggenau', range: '$300 – $800+', note: 'OEM parts · Conejo Valley coil inspection · Gated access', featured: true },
  { appliance: 'Thermador / Miele / Viking', range: '$250 – $600+', note: 'OEM parts · Pro-style ranges · Panel-ready dishwashers', featured: true },
