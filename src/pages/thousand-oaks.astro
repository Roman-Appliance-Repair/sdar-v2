---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CustomNarrative from '../components/cities/v2/CustomNarrative.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'thousand-oaks';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Thousand Oaks";
const zips = ["91360", "91361", "91362", "91320"];

const phone = branch.phone;
const phoneRaw = `+1${phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Thousand Oaks CA — Same-Day $89`;
const description = `Same-day appliance repair in Thousand Oaks — Dos Vientos, Lynn Ranch, Newbury Park, Westlake Village. Sub-Zero, Wolf, Miele. $89 diagnostic, waived with repair.`;
const canonical = "https://samedayappliance.repair/thousand-oaks/";

const localBusinessSchema = mergeCredentials({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: branch.fullName,
  image: "https://samedayappliance.repair/images/logo.webp",
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { "@type": "City", name: "Thousand Oaks", sameAs: "https://en.wikipedia.org/wiki/Thousand_Oaks,_California" },
    { "@type": "Neighborhood", name: "Dos Vientos" },
    { "@type": "Neighborhood", name: "Newbury Park" },
    { "@type": "Neighborhood", name: "Lynn Ranch" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: "$$",
  license: "BHGS #A49573",
  sameAs: [...(branch.sameAs ?? [])],
  hasOfferCatalog: { '@id': 'https://samedayappliance.repair/#service-catalog' }
});

const introParagraphs = [
  "<strong>When an appliance fails in Thousand Oaks, our techs at Same Day Appliance Repair trace it to a handful of patterns: Sub-Zero built-ins running longer cycles because dry Conejo Valley dust has packed the condenser coils on hillside properties, Thermador pro-range star burners clicking without flame from cracked igniter electrodes, Miele dishwasher F11 water-intake faults from a sediment-clogged inlet valve, and LG washers throwing UE errors from worn rear shock absorbers. Built-in Sub-Zero, Wolf, and Gaggenau repairs run $300–$800+ with OEM parts and gate coordination. We dispatch same-day across Dos Vientos, North Ranch, Lynn Ranch, and Central Thousand Oaks. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Thousand Oaks is one of the most consistently well-kept communities in Southern California — and the appliances inside these homes reflect that. The Dos Vientos and North Ranch estates have Sub-Zero built-ins, Thermador pro ranges, and Miele dishwashers as standard. The established neighborhoods throughout the rest of 91360 and 91361 have LG, Samsung, GE, and Whirlpool machines that need the same reliable same-day service.",
  "One environmental factor that matters here but rarely gets mentioned: the Conejo Valley's hot, dry summers push significant particulate through the air — particularly in hillside properties with mature landscaping. Refrigerator condenser coils accumulate dust and debris faster than in coastal or urban environments. We check condenser coils on every Thousand Oaks refrigerator call. A coil that's loaded with dusty buildup runs the compressor harder, drives up energy costs, and shortens the unit's life. It's a consistent finding here.",
  "We're familiar with the gate access protocols for Dos Vientos and other gated communities throughout Thousand Oaks. Estate managers, household staff, and property managers are all part of our normal workflow in this area.",
  "Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong>. Weekends available.",
  "<strong>Conejo Valley climate tip:</strong> Thousand Oaks summers are hot and dry, and hillside properties see significant dust load through the condenser. If your refrigerator has been running longer cycles than usual — particularly after a dry, windy stretch or after landscaping work — dusty condenser coils are almost certainly the cause. Clean coils every 6–9 months in this environment, not the 12-month recommendation written for temperate climates."
];

const communitiesNarrative = {
  eyebrow: "Conejo Valley Coverage",
  headline: "Thousand Oaks — Every Community",
  paragraphs: [
    "From Dos Vientos estates to Lynn Ranch to central TO — same same-day commitment."
  ],
  subSections: [
    {
      title: "Dos Vientos",
      paragraphs: [
        "Gated · Sub-Zero / Thermador estates · Estate manager coordination · Gate access arranged."
      ]
    },
    {
      title: "North Ranch",
      paragraphs: [
        "Luxury hillside · Wolf / Miele common · Large format kitchens · Outdoor kitchen service."
      ]
    },
    {
      title: "Lynn Ranch",
      paragraphs: [
        "Equestrian estates · Large lot properties · Mix of luxury and standard brands."
      ]
    },
    {
      title: "Newbury Park",
      paragraphs: [
        "91320 · Established suburban · LG, Samsung, GE common."
      ]
    },
    {
      title: "Lang Ranch",
      paragraphs: [
        "91362 · Newer construction · KitchenAid, Bosch common."
      ]
    },
    {
      title: "Central Thousand Oaks",
      paragraphs: [
        "91360 · All brands · Townhomes & single-family."
      ]
    },
    {
      title: "Westlake Village adjacent",
      paragraphs: [
        "91361 · Premium homes · Sub-Zero and Wolf frequent."
      ]
    },
    {
      title: "Oak Park / Agoura Hills",
      paragraphs: [
        "Adjacent coverage · All brands · Same-day route."
      ]
    },
    {
      title: "Moorpark",
      paragraphs: [
        "93021 · Adjacent Ventura County · Same-day covered."
      ]
    }
  ]
};

// Commercial + outdoor: both written new — no commercial prose, links or pricing phrase
// existed anywhere on the page.
// OUTDOOR CARE: the raw HTML section at the bottom of this page already stakes out two outdoor
// angles — the dual-zone refrigerator under summer ambient, and side-burner failure modes —
// for North Ranch / Lake Sherwood / Sunset Hills. This section takes neither, so that two
// blocks on one page are not making the same argument. The angle here is wind and oak litter.
// Premium pills carried by the page's own prose: intro p[1] puts Sub-Zero built-ins, Thermador
// pro ranges and Miele dishwashers in Dos Vientos and North Ranch as standard, whyReasons names
// Sub-Zero/Thermador/Wolf/Miele/Gaggenau/Viking, and both featured pricing tiers are luxury.
const commercialParagraphs = [
  "Commercial work in the Conejo Valley is quieter than the LA basin version and it runs on a different clock. The restaurant rows around the Oaks and along Thousand Oaks Boulevard, the Westlake corridor dining, the business-park cafeterias, and the club and banquet kitchens up toward North Ranch — these are kitchens with real volume and almost no tolerance for an emergency, because a private event or a banquet has one date and no second one. The other thing the valley does is heat: it runs meaningfully hotter than the coast twenty minutes away, and a condensing unit on a flat roof in August is doing work the same model never does in Malibu. We check the rooftop and condenser side on Conejo accounts before the summer, because the failures here cluster into the same six weeks every year."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map — it does ICONS[e.icon] with no
// fallback, so a wrong key renders an empty <path> silently. Valid keys:
// snowflake, pizza-oven, fryer, oven, droplet, laundry.
const commercialEquipment = [
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

const outdoorParagraphs = [
  "Two things work on an outdoor kitchen up here that do not much bother one down on the coast, and neither of them is heat. The first is wind. The Conejo grade funnels it, and a Santa Ana event will lift a grill cover, push debris under it and blow out a pilot or a low burner flame in the middle of cooking — the call comes in as a grill that will not stay lit, and the fix is upstream of the igniter. The second is the oak canopy that makes these neighborhoods what they are. Leaf litter and acorn debris drop into open burner ports, collect under the firebox and pack the intake side of anything with a fan; it is organic, it is constant, and it is why a grill in North Ranch clogs on a schedule a grill in Oxnard never keeps. Our techs pull and clear the burners and intakes before diagnosing anything electrical, because on most of these calls that is the whole repair."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const outdoorBrands = [
  { name: 'Lynx', href: '/outdoor/brands/lynx/' },
  { name: 'Twin Eagles', href: '/outdoor/brands/twin-eagles/' },
  { name: 'Kalamazoo', href: '/outdoor/brands/kalamazoo/' },
  { name: 'Wolf', href: '/outdoor/brands/wolf/' },
  { name: 'DCS', href: '/outdoor/brands/dcs/' }
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Dusty coil inspection · Sub-Zero built-in · Not cooling · Ice maker', brands: 'Sub-Zero · Samsung · LG · GE · Thermador · Bosch' },
  { icon: '🔥', name: 'Oven, Range & Pro Range', slug: 'oven', issues: 'Thermador pro-style · Wolf dual-fuel · Gas igniter · Temperature off', brands: 'Wolf · Thermador · Gaggenau · Viking · GE · Samsung' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Miele · Bosch · Panel-ready · Not draining · Error codes', brands: 'Miele · Bosch · Thermador · KitchenAid · Samsung · GE' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'OE / UE error · Not draining · Not spinning · Error codes', brands: 'LG · Samsung · Whirlpool · Maytag · Bosch · Speed Queen' },
  { icon: '♨️', name: 'Dryer Repair + Vent Cleaning', slug: 'dryer', issues: 'Not heating · Thermal fuse · Vent buildup · Gas & electric', brands: 'LG · Samsung · GE · Maytag · Whirlpool · Miele' },
  { icon: '❄️', name: 'Freezer & Ice Maker Repair', slug: 'freezer', issues: 'Not freezing · Ice stopped · Frost buildup · Sub-Zero', brands: 'Sub-Zero · Samsung · LG · GE · True · Whirlpool' },
  { icon: '🍷', name: 'Wine Cellar & Cooler Repair', slug: 'wine-cooler', issues: 'Temperature off · WhisperKOOL · Sub-Zero wine · Compressor', brands: 'Sub-Zero · EuroCave · True · WhisperKOOL · Liebherr' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Thermador star burner · Wolf igniter · Induction · Hood motor', brands: 'Wolf · Thermador · Gaggenau · Miele · Viking · Dacor' }
