---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';

// City stage 2 (2026-10-08): new hub — Santa Clarita is a city we do real work in
// (Fixar jobs since July 2026) but had no page. Content is specific to this city;
// facts we could not confirm (named water supplier, hardness figures) are left out.
// Recent repairs and reviews are REAL and selected by src/lib/recent-repairs.ts and
// src/lib/reviews.ts — nothing on this page is hand-written as a customer story.
const citySlug = 'santa-clarita';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Santa Clarita";
const zips = ["91321", "91350", "91351", "91354", "91355", "91381", "91387", "91390"];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Santa Clarita CA — Same Day Service`;
const description = "Same-day appliance repair in Santa Clarita, CA — Valencia, Saugus, Newhall, Canyon Country. $89 diagnostic, waived with repair. BHGS #A49573.";
const canonical = 'https://samedayappliance.repair/santa-clarita/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: "Santa Clarita", sameAs: "https://en.wikipedia.org/wiki/Santa_Clarita,_California" },
    { '@type': 'Place', name: "Valencia" },
    { '@type': 'Place', name: "Saugus" },
    { '@type': 'Place', name: "Newhall" },
    { '@type': 'Place', name: "Canyon Country" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
});

const introParagraphs = [
  "<strong>Same Day Appliance Repair works across the Santa Clarita Valley — Valencia, Saugus, Newhall and Canyon Country — for refrigerators, washers, ovens and commercial equipment. Recent jobs here include a Valencia refrigerator that needed its evaporator coil defrosted and its fan replaced, and a Canyon Country washer that was leaking from the bottom. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "Santa Clarita incorporated in 1987 from four communities, and each still has its own character. Valencia is the master-planned part, with neighborhoods and HOAs built from the late 1960s onward; Saugus and Canyon Country grew with subdivisions through the 1970s to the 2000s; Newhall, the oldest, has the original downtown and older homes. Most of the housing is single-family homes and townhomes, many with the laundry in a garage or an upstairs closet.",
  "Water in the valley is supplied by SCV Water (the Santa Clarita Valley Water Agency), and it is hard. Hard water leaves scale in dishwashers, ice makers, refrigerator water valves and washer inlet screens, and it is a common reason an ice maker slows down or a dishwasher stops cleaning well. The valley is also hotter than the LA basin in summer, which is hard on refrigerators and dryers in garages.",
  `Santa Clarita is covered by our Los Angeles branch. Same $89 residential diagnostic as anywhere we work, no distance surcharge, and the fee is waived when you go ahead with the repair. Call <a href="tel:${phoneRaw}">${branch.phone}</a>.`
];

const commercialParagraphs = [
  "The Santa Clarita Valley has a dense run of restaurants and food businesses along Valencia Boulevard, Magic Mountain Parkway, Soledad Canyon Road and Lyons Avenue, plus the business parks around Valencia. For those kitchens we repair reach-in and walk-in refrigeration, ice machines, ovens, ranges, fryers, mixers and commercial dishwashers. The commercial diagnostic is $120, waived when you approve the repair, with a written estimate before any work starts."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map (snowflake, pizza-oven, fryer,
// oven, droplet, laundry) — a wrong key renders an empty <path> silently.
const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// No outdoor brand pills: nothing in our records for this city names an outdoor brand.
const outdoorParagraphs = [
  "Santa Clarita backyards are made for outdoor cooking — many homes in Valencia and Saugus have a built-in grill island, some with an outdoor refrigerator, and the valley's summer heat and dry wind are hard on both. Outdoor refrigerators lose efficiency fast when the condenser clogs with dust, and grill burners and igniters corrode out in the weather. We check the gas supply, regulator and airflow before replacing major parts."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '❄️', name: 'Refrigerator Repair', slug: 'refrigerator' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer' },
  { icon: '💨', name: 'Dryer Repair', slug: 'dryer' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven' },
  { icon: '🍳', name: 'Stove Repair', slug: 'stove' },
  { icon: '📻', name: 'Microwave Repair', slug: 'microwave' },
  { icon: '🧊', name: 'Ice Maker Repair', slug: 'ice-maker' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler' },
  { icon: '🧊', name: 'Freezer Repair', slug: 'freezer' },
  { icon: '🗑️', name: 'Garbage Disposal Repair', slug: 'garbage-disposal' },
  { icon: '♨️', name: 'Cooktop Repair', slug: 'cooktop' }
];

const neighborhoods = [
  { name: "Valencia", zip: "91355" },
  { name: "Valencia (north)", zip: "91354" },
  { name: "Valencia / Westridge area", zip: "91381" },
  { name: "Saugus", zip: "91350" },
  { name: "Newhall", zip: "91321" },
  { name: "Canyon Country", zip: "91351" },
  { name: "Canyon Country (Sand Canyon)", zip: "91387" }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: "Real valley jobs",
    body: "The repairs on this page are real Santa Clarita Valley visits from our records, labelled with the community they were in — Valencia, Canyon Country — and the month."
  },
  {
    iconKey: 'shield' as const,
    title: "Hard water, known problems",
    body: "SCV Water's hard water leaves scale in ice makers, dishwashers and water valves. Our technicians check for it as part of the diagnosis instead of replacing parts that only need cleaning."
  },
  {
    iconKey: 'parts' as const,
    title: "Home and commercial",
    body: "Refrigerators, washers and ovens at home; refrigeration, ice machines and kitchen equipment for businesses — we have done both in the valley this year."
  },
  {
    iconKey: 'clock' as const,
    title: "All four communities",
    body: "Valencia, Saugus, Newhall and Canyon Country — same dispatch, $89 diagnostic and 90-day warranty on parts and labor."
  }
];

const pricingTiers = [
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Residential · Waived with repair · Written estimate' },
  { appliance: 'Commercial Diagnostic', range: '$120', note: 'Restaurants & businesses · Waived with repair' },
  { appliance: 'Standard Repair', range: '$150–$350', note: 'Parts + labor · OEM parts · 90-day warranty' },
  { appliance: 'Warranty', range: '90 Days', note: 'All repairs · Parts & labor · No-charge callback', featured: true }
];

const faqs = [
  {
    question: "Do you offer same-day appliance repair in Santa Clarita?",
    answer: "Yes. Santa Clarita is covered by our Los Angeles branch, and same-day visits are possible when a technician is free — call early in the day for the best chance. We cover Valencia, Saugus, Newhall and Canyon Country."
  },
  {
    question: "Do you service Valencia?",
    answer: "Yes — Valencia is part of the City of Santa Clarita and one of the areas we work in most there. A recent Valencia job was a refrigerator that was cold but not cooling properly; the technician defrosted the evaporator coil, replaced the evaporator fan and cleaned the drain."
  },
  {
    question: "Does Santa Clarita's hard water affect my appliances?",
    answer: "It can. SCV Water supplies hard water, and the mineral scale builds up in ice makers, dishwashers, refrigerator water valves and washer inlet screens. If an ice maker is slowing down or a dishwasher has stopped cleaning well, scale is one of the first things we check."
  },
  {
    question: "How much is the diagnostic in Santa Clarita?",
    answer: "$89 residential and $120 commercial, waived when you approve the repair, with a written estimate first. No distance surcharge."
  },
  {
    question: "What is your warranty on Santa Clarita repairs?",
    answer: "Every repair carries a 90-day warranty on parts and labor. If the same problem returns within 90 days, we come back at no charge."
  },
  {
    question: "Are your Santa Clarita appliance repairs licensed and insured?",
    answer: "Yes. Same Day Appliance Repair is BHGS #A49573, EPA 608 Universal certified (#1346255700410), licensed and insured, with a 90-day warranty on parts and labor on every Santa Clarita repair. $89 residential diagnostic, waived with repair."
  }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair in"
    headlineCity="Santa Clarita, CA"
    subheadline="Same-day service across Valencia, Saugus, Newhall and Canyon Country. Refrigerators, washers, ovens and commercial equipment — all major brands. $89 diagnostic, waived with repair."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Santa Clarita — Valencia, Saugus, Newhall and Canyon Country"
    paragraphs={introParagraphs}
    bookingTitle="Santa Clarita Service"
    bookingSub="Available Today"
  />

  <ServicesGrid
    cityName={cityName}
    headline="Appliance Repair Services in Santa Clarita"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Santa Clarita Restaurants and Commercial Kitchens"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Santa Clarita Backyards and Outdoor Kitchens"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Santa Clarita Neighborhoods We Service"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={["Valencia Blvd", "Soledad Canyon Rd", "Bouquet Canyon Rd", "Lyons Ave", "McBean Pkwy", "Sierra Hwy"]}
  />

  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Repairs in Santa Clarita" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Santa Clarita Calls Us"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Santa Clarita"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Santa Clarita"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Schedule Your Santa Clarita Repair Today"
    body="Same-day service across Valencia, Saugus, Newhall and Canyon Country. All major brands."
  />
</CityLayoutV2>
