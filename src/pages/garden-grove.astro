---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';

// City stage 2 (2026-10-08): new hub — Garden Grove is a city we do real work in
// (Fixar jobs since July 2026) but had no page. Content is specific to this city;
// facts we could not confirm (named water supplier, hardness figures) are left out.
// Recent repairs and reviews are REAL and selected by src/lib/recent-repairs.ts and
// src/lib/reviews.ts — nothing on this page is hand-written as a customer story.
const citySlug = 'garden-grove';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Garden Grove";
const zips = ["92840", "92841", "92843", "92844", "92845"];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Garden Grove CA — Same Day Service`;
const description = "Same-day appliance repair in Garden Grove, CA — home appliances and commercial refrigeration. $89 diagnostic, waived with repair. BHGS #A49573.";
const canonical = 'https://samedayappliance.repair/garden-grove/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: "Garden Grove", sameAs: "https://en.wikipedia.org/wiki/Garden_Grove,_California" },
    { '@type': 'Place', name: "Historic Main Street" },
    { '@type': 'Place', name: "Little Saigon" },
    { '@type': 'Place', name: "West Garden Grove" },
    { '@type': 'Place', name: "The Grove District" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
});

const introParagraphs = [
  "<strong>Same Day Appliance Repair covers all of Garden Grove — 92840, 92841, 92843, 92844 and 92845 — for home appliances and commercial kitchen equipment. One recent Garden Grove job was a Traulsen commercial freezer that would not get cold enough; the defrost system had failed and the defrost timer assembly was replaced. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "Garden Grove incorporated in 1956 and most of its homes are single-family houses from the 1950s and 1960s, with apartments and newer townhomes along the main corridors. The city has distinct areas: the historic Main Street downtown, the Little Saigon district it shares with Westminster, quiet residential West Garden Grove, and the Grove District hotel area near Harbor Boulevard.",
  "At home we repair the full list — refrigerators, washers, dryers, dishwashers, ovens and ranges, all major brands. Garden Grove also has a large restaurant scene, so commercial refrigeration and kitchen equipment are part of our work here too.",
  `Garden Grove is covered by our Irvine branch together with Anaheim and Cypress. Same $89 residential diagnostic as anywhere we work, no distance surcharge, and the fee is waived when you go ahead with the repair. Call <a href="tel:${phoneRaw}">${branch.phone}</a>.`
];

const commercialParagraphs = [
  "Restaurants line Garden Grove Boulevard, Brookhurst Street and Harbor Boulevard, from family dining rooms and bakeries in Little Saigon to the hotel kitchens of the Grove District. Their equipment works long hours: reach-in and walk-in refrigeration opened hundreds of times a shift, ice machines, wok and gas ranges, fryers and dishwashers. We have repaired commercial freezers in Garden Grove this year. The commercial diagnostic is $120, waived when you approve the repair, with a written estimate before any work starts."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map (snowflake, pizza-oven, fryer,
// oven, droplet, laundry) — a wrong key renders an empty <path> silently.
const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// No outdoor brand pills: nothing in our records for this city names an outdoor brand.
const outdoorParagraphs = [
  "Garden Grove's postwar lots usually have a patio and a garage, and plenty of homes have a gas grill outside and a spare refrigerator or freezer in the garage. Outdoor grills come to us with igniters that stop sparking and burners that burn low; garage units with the strain of summer heat on the condenser and fans. We check the gas supply and airflow before replacing major parts."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '❄️', name: 'Refrigerator Repair', slug: 'refrigerator' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer' },
  { icon: '💨', name: 'Dryer Repair', slug: 'dryer' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven' },
  { icon: '🍳', name: 'Stove Repair', slug: 'stove' },
  { icon: '📻', name: 'Microwave Repair', slug: 'microwave' },
  { icon: '🧊', name: 'Ice Maker Repair', slug: 'ice-maker' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler' },
  { icon: '🧊', name: 'Freezer Repair', slug: 'freezer' },
  { icon: '🗑️', name: 'Garbage Disposal Repair', slug: 'garbage-disposal' },
  { icon: '♨️', name: 'Cooktop Repair', slug: 'cooktop' }
];

const neighborhoods = [
  { name: "Historic Main Street / Downtown", zip: "92840" },
  { name: "The Grove District", zip: "92840" },
  { name: "Central Garden Grove", zip: "92841" },
  { name: "Little Saigon area", zip: "92843" },
  { name: "Little Saigon / west of Brookhurst", zip: "92844" },
  { name: "West Garden Grove", zip: "92845" }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: "Home and commercial",
    body: "We repair kitchen and laundry appliances in Garden Grove homes and refrigeration and cooking equipment in its restaurants — the commercial freezer repair on this page is a real Garden Grove job."
  },
  {
    iconKey: 'shield' as const,
    title: "Written estimate first",
    body: "Every visit starts with a diagnosis and a written price. Nothing is replaced until you approve it."
  },
  {
    iconKey: 'parts' as const,
    title: "Commercial refrigeration",
    body: "Defrost systems, fans, controls and condensing units — the faults that stop a reach-in or walk-in from holding temperature are what we look for first."
  },
  {
    iconKey: 'clock' as const,
    title: "All five ZIP codes",
    body: "92840, 92841, 92843, 92844 and 92845 — same dispatch, $89 diagnostic and 90-day warranty on parts and labor."
  }
];

const pricingTiers = [
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Residential · Waived with repair · Written estimate' },
  { appliance: 'Commercial Diagnostic', range: '$120', note: 'Restaurants & businesses · Waived with repair' },
  { appliance: 'Standard Repair', range: '$150–$350', note: 'Parts + labor · OEM parts · 90-day warranty' },
  { appliance: 'Warranty', range: '90 Days', note: 'All repairs · Parts & labor · No-charge callback', featured: true }
];

const faqs = [
  {
    question: "Do you offer same-day appliance repair in Garden Grove?",
    answer: "Yes. Garden Grove is covered by our Irvine branch together with Anaheim and Cypress, and same-day visits are possible when a technician is free — call early in the day for the best chance. We cover all five ZIP codes."
  },
  {
    question: "Do you repair commercial refrigeration in Garden Grove?",
    answer: "Yes — reach-in and walk-in coolers and freezers, ice machines and the rest of the kitchen line. A recent Garden Grove job was a Traulsen freezer with a failed defrost system; the defrost timer assembly was replaced. The commercial diagnostic is $120, waived with repair."
  },
  {
    question: "Do you cover Little Saigon and the Grove District?",
    answer: "Yes. We cover all of Garden Grove, including the Little Saigon area, the Grove District near Harbor Boulevard, historic Main Street and West Garden Grove."
  },
  {
    question: "How much is the diagnostic in Garden Grove?",
    answer: "$89 residential and $120 commercial, waived when you approve the repair, with a written estimate first. No distance surcharge."
  },
  {
    question: "What is your warranty on Garden Grove repairs?",
    answer: "Every repair carries a 90-day warranty on parts and labor. If the same problem returns within 90 days, we come back at no charge."
  },
  {
    question: "Are your Garden Grove appliance repairs licensed and insured?",
    answer: "Yes. Same Day Appliance Repair is BHGS #A49573, EPA 608 Universal certified (#1346255700410), licensed and insured, with a 90-day warranty on parts and labor on every Garden Grove repair. $89 residential diagnostic, waived with repair."
  }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair in"
    headlineCity="Garden Grove, CA"
    subheadline="Same-day service across Garden Grove — Main Street, Little Saigon, West Garden Grove and the Grove District. Home and commercial appliances. $89 diagnostic, waived with repair."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Garden Grove — family homes and a big restaurant city"
    paragraphs={introParagraphs}
    bookingTitle="Garden Grove Service"
    bookingSub="Available Today"
  />

  <ServicesGrid
    cityName={cityName}
    headline="Appliance Repair Services in Garden Grove"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Garden Grove Restaurants and Commercial Kitchens"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Garden Grove Patios and Garage Refrigerators"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Garden Grove Neighborhoods We Service"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={["Garden Grove Blvd", "Brookhurst St", "Harbor Blvd", "Chapman Ave", "Westminster Ave", "Magnolia St"]}
  />

  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Repairs in Garden Grove" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Garden Grove Calls Us"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Garden Grove"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Garden Grove"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Orange County Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Schedule Your Garden Grove Repair Today"
    body="Same-day service across all five Garden Grove ZIP codes. Home appliances and commercial equipment."
  />
</CityLayoutV2>
