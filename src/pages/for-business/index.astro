---
import Layout from '../../layouts/Layout.astro';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

function slugFromPath(p: string) { return (p.split('/').pop() ?? '').replace(/\.astro$/, ''); }
function slugToLabel(slug: string) {
  return slug.split('-').map((w) =>
    w.charAt(0).toUpperCase() + w.slice(1)
  ).join(' ');
}

const files = Object.keys(import.meta.glob('./*.astro'));
const items = files
  .map(slugFromPath)
  .filter((s) => s !== 'index')
  .sort()
  .map((slug) => ({ slug, label: slugToLabel(slug), href: `/for-business/${slug}/` }));

const title = 'Appliance Repair for Business';
const description = 'Commercial appliance repair programs for hotels, restaurants, property management, short-term rentals, bars & nightclubs, retail grocery. COI available.';

const wave47GeoNeutralLb = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://samedayappliance.repair/#business',
  name: 'Same Day Appliance Repair',
  url: 'https://samedayappliance.repair/',
  telephone: '+1-424-325-0520',
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL

});
---

<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave47GeoNeutralLb)} />
  </Fragment>
  <section class="hub-hero">
    <div class="hub-hero-bg">
      <picture>
        <source media="(max-width: 768px)" type="image/webp" srcset="/images/for-business/index/hero-mobile.webp" />
      <source media="(max-width: 768px)" type="image/jpeg" srcset="/images/for-business/index/hero-mobile.jpg" />
      <source media="(max-width: 640px)" type="image/webp" srcset="/images/for-business/index/hero-640.webp" />
        <source media="(max-width: 640px)" type="image/jpeg" srcset="/images/for-business/index/hero-640.jpg" />
        <source media="(max-width: 960px)" type="image/webp" srcset="/images/for-business/index/hero-960.webp" />
        <source media="(max-width: 960px)" type="image/jpeg" srcset="/images/for-business/index/hero-960.jpg" />
        <source type="image/webp" srcset="/images/for-business/index/hero.webp" />
        <img src="/images/for-business/index/hero.jpg" alt="Commercial appliance repair for Los Angeles businesses" width="1920" height="840" loading="eager" fetchpriority="high" />
      </picture>
      <div class="hub-hero-overlay"></div>
    </div>
    <div class="container hub-hero-inner">
      <p class="hub-eyebrow">For Business</p>
      <h1 class="hub-title">Appliance Repair for Business</h1>
      <p class="hub-intro">
        Dedicated service programs for {items.length} industries — from hospitality to property management. COI on file, commercial rates, priority dispatch.
      </p>
    </div>
  </section>

  <section class="hub">
    <div class="container">
      <div class="card-grid">
        {items.map((item) => (
          <a href={item.href} class="card">
            <h3>{item.label}</h3>
            <span class="card-cta">View →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hub { padding: 64px 0 80px; }
  .hub-hero { position: relative; overflow: hidden; background: var(--black); color: #fff; padding: 80px 0; min-height: 380px; display: flex; align-items: center; }
  .hub-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hub-hero-bg picture, .hub-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 70% center; display: block; }
  .hub-hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(100deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.88) 30%, rgba(10,10,10,0.58) 60%, rgba(10,10,10,0.25) 100%); }
  .hub-hero-inner { position: relative; z-index: 2; }
  .hub-hero .hub-title { color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6); }
  .hub-hero .hub-intro { color: rgba(255,255,255,0.85); margin-bottom: 0; text-shadow: 0 1px 10px rgba(0,0,0,0.5); }
  .hub-eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--red); margin-bottom: 12px;
  }
  .hub-title { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 20px; }
  .hub-intro {
    max-width: 680px; font-size: 17px; line-height: 1.6; color: var(--muted);
    margin-bottom: 48px;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 24px;
    background: var(--gray);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s var(--ease);
    min-height: 120px;
  }
  .card:hover {
    background: var(--white);
    border-color: var(--black);
    transform: translateY(-2px);
    color: var(--black);
  }
  .card h3 {
    font-size: 18px; font-weight: 600;
    font-family: var(--font-body); letter-spacing: -0.01em;
    margin: 0 0 12px; color: var(--black);
  }
  .card-cta {
    font-size: 13px; font-weight: 600; color: var(--red);
    letter-spacing: 0.05em;
  }
</style>
