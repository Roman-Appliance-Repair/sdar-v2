---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Westlake Village, CA"
    subheadline="Lakefront luxury, gated estates, and Conejo Valley living — Sub-Zero, Wolf, Thermador, Miele specialists. LVMWD hard water aware. Same-day, OEM parts, 90-day warranty across 91361 and 91362."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Westlake Village — What This Community Calls For"
    paragraphs={introParagraphs}
    bookingTitle="Westlake Village Service"
    bookingSub="91361 · 91362 · Local TO branch · Same day"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Westlake Village"
    services={services}
  />

  <LuxurySpecialists
    citySlug={citySlug}
    cityName={cityName}
    headline={luxuryNarrative.headline}
    paragraphs={luxuryNarrative.paragraphs}
    brands={getLuxuryBrands(citySlug)}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Westlake Village Corporate & Restaurant Kitchen Service"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Westlake Village Patios on the Waterline"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Westlake Village Communities We Service"
    subheadline="From the Westlake Lake waterfront to Lake Sherwood and North Ranch — every part of 91361 and 91362."
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={['Lakeview Canyon Rd', 'Thousand Oaks Blvd', 'Westlake Blvd', 'Lake Sherwood Dr', 'Lindero Canyon Rd', 'Via Colinas']}
    bgImage="/images/cities/westlake-village/neighborhood.webp"
  />

  <RecentRepairs
    citySlug={citySlug}
    cityName={cityName}
    headline="Recent Repairs in Westlake Village"
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Westlake Village Homeowners Call Us"
    reasons={whyReasons}
  />

  <ReviewsBlock
    cityName={cityName}
    headline="What Westlake Village Clients Say"
    testimonials={testimonials}
  />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Westlake Village"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Westlake Village"
    faqs={faqs}
  />

  <AlsoServingNearby
    nearbyCities={nearbyCities}
    headline="Also Serving Nearby Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance broken in Westlake Village?"
    body="Westlake Lake · Lake Sherwood · North Ranch · LVMWD · Sub-Zero · Wolf · Miele. $89 diagnostic waived with repair. 90-day warranty. OEM parts."
  />
</CityLayoutV2>
