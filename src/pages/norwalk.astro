---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';

// City stage 2 (2026-10-08): new hub — Norwalk is a city we do real work in
// (Fixar jobs since July 2026) but had no page. Content is specific to this city;
// facts we could not confirm (named water supplier, hardness figures) are left out.
// Recent repairs and reviews are REAL and selected by src/lib/recent-repairs.ts and
// src/lib/reviews.ts — nothing on this page is hand-written as a customer story.
const citySlug = 'norwalk';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Norwalk";
const zips = ["90650"];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Norwalk CA — Same Day Service`;
const description = "Same-day appliance repair in Norwalk, CA: washers, ovens, refrigerators, dryers. $89 diagnostic, waived with repair. BHGS #A49573, EPA 608.";
const canonical = 'https://samedayappliance.repair/norwalk/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: "Norwalk", sameAs: "https://en.wikipedia.org/wiki/Norwalk,_California" },
    { '@type': 'Place', name: "North Norwalk" },
    { '@type': 'Place', name: "South Norwalk" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
});

const introParagraphs = [
  "<strong>Our technicians at Same Day Appliance Repair have been working in Norwalk since summer 2026 — washers most often, then ovens and refrigerators. One of the latest was a Frigidaire gas oven that would not turn on; the ignition system was repaired on the same visit. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "Norwalk grew almost all at once after the Second World War — it incorporated in 1957 — and the city is still mostly single-family tract homes from that era, with apartments and condos along the main boulevards. Kitchens and laundry areas in those homes have usually been remodelled at least once, so we see everything from older top-loaders and gas ranges to current front-loaders and French-door refrigerators, often in the same house.",
  "The calls here are practical ones: a washer whose door lock has failed so the cycle never starts, a gas oven that will not light, a refrigerator that stops cooling, a dryer that runs cold. We diagnose first, give a written estimate, and only then replace parts.",
  `Norwalk is covered by our Los Angeles branch together with Lakewood and Long Beach. Same $89 residential diagnostic as anywhere we work, no distance surcharge, and the fee is waived when you go ahead with the repair. Call <a href="tel:${phoneRaw}">${branch.phone}</a>.`
];

const commercialParagraphs = [
  "Firestone Boulevard, Imperial Highway, Rosecrans Avenue and Pioneer Boulevard carry most of Norwalk's restaurants, markets and food businesses. For those kitchens we repair reach-in and walk-in refrigeration, ice machines, ovens, ranges, fryers and commercial dishwashers, and commercial laundry equipment. Commercial calls carry a $120 diagnostic, waived when you approve the repair, with a written estimate before any work starts."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map (snowflake, pizza-oven, fryer,
// oven, droplet, laundry) — a wrong key renders an empty <path> silently.
const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// No outdoor brand pills: nothing in our records for this city names an outdoor brand.
const outdoorParagraphs = [
  "Norwalk's tract-home lots usually leave room for a patio with a gas grill and a garage with a spare refrigerator or chest freezer. The grills come to us with the usual outdoor problems — igniters that stop sparking, burners that burn low or uneven — and the garage units with the problems summer heat causes. We check the gas supply before replacing burners, and the condenser and fans before condemning a compressor."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '❄️', name: 'Refrigerator Repair', slug: 'refrigerator' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer' },
  { icon: '💨', name: 'Dryer Repair', slug: 'dryer' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven' },
  { icon: '🍳', name: 'Stove Repair', slug: 'stove' },
  { icon: '📻', name: 'Microwave Repair', slug: 'microwave' },
  { icon: '🧊', name: 'Ice Maker Repair', slug: 'ice-maker' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler' },
  { icon: '🧊', name: 'Freezer Repair', slug: 'freezer' },
  { icon: '🗑️', name: 'Garbage Disposal Repair', slug: 'garbage-disposal' },
  { icon: '♨️', name: 'Cooktop Repair', slug: 'cooktop' }
];

const neighborhoods = [
  { name: "North Norwalk (north of Firestone)", zip: "90650" },
  { name: "Central Norwalk", zip: "90650" },
  { name: "South Norwalk (south of Imperial)", zip: "90650" },
  { name: "East Norwalk (San Gabriel River side)", zip: "90650" },
  { name: "West Norwalk", zip: "90650" }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: "Real Norwalk jobs",
    body: "The repairs listed on this page are real Norwalk visits from our records, with the month they happened."
  },
  {
    iconKey: 'shield' as const,
    title: "Diagnosis before parts",
    body: "A washer that will not start is often a door lock, not a control board; an oven that will not light is often the ignition, not the valve. We test before we replace."
  },
  {
    iconKey: 'parts' as const,
    title: "Old and new under one roof",
    body: "Norwalk homes often mix a decades-old range with a new front-loader. Our technicians work on both, gas and electric, all major brands."
  },
  {
    iconKey: 'clock' as const,
    title: "Whole city, one ZIP",
    body: "All of 90650 — same dispatch, $89 diagnostic and 90-day warranty on parts and labor."
  }
];

const pricingTiers = [
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Residential · Waived with repair · Written estimate' },
  { appliance: 'Commercial Diagnostic', range: '$120', note: 'Restaurants & businesses · Waived with repair' },
  { appliance: 'Standard Repair', range: '$150–$350', note: 'Parts + labor · OEM parts · 90-day warranty' },
  { appliance: 'Warranty', range: '90 Days', note: 'All repairs · Parts & labor · No-charge callback', featured: true }
];

const faqs = [
  {
    question: "Do you offer same-day appliance repair in Norwalk?",
    answer: "Yes. Norwalk is covered by our Los Angeles branch, and same-day visits are possible when a technician is free — calling early in the day gives the best chance. We cover the whole city, ZIP 90650."
  },
  {
    question: "What do you repair most often in Norwalk?",
    answer: "Washers, then ovens and refrigerators. Recent Norwalk calls include a washer with a broken door lock and a gas oven that would not turn on, whose ignition system was repaired on the same visit."
  },
  {
    question: "How much is the diagnostic in Norwalk?",
    answer: "$89 for residential and $120 for commercial, waived when you approve the repair. You get a written estimate before any work starts, and there is no extra charge for Norwalk."
  },
  {
    question: "Do you repair gas ovens and ranges?",
    answer: "Yes — gas and electric ovens, ranges and cooktops. On a gas unit that will not light, the technician checks the igniter and the ignition system first, which is the most common cause."
  },
  {
    question: "What is your warranty on Norwalk repairs?",
    answer: "Every repair carries a 90-day warranty on parts and labor. If the same problem returns within 90 days, we come back at no charge."
  },
  {
    question: "Are your Norwalk appliance repairs licensed and insured?",
    answer: "Yes. Same Day Appliance Repair is BHGS #A49573, EPA 608 Universal certified (#1346255700410), licensed and insured, with a 90-day warranty on parts and labor on every Norwalk repair. $89 residential diagnostic, waived with repair."
  }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair in"
    headlineCity="Norwalk, CA"
    subheadline="Same-day service across Norwalk, ZIP 90650 — washers, dryers, refrigerators, ovens and ranges. All major brands. $89 diagnostic, waived with repair."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Norwalk — 1950s tract homes and appliances that work every day"
    paragraphs={introParagraphs}
    bookingTitle="Norwalk Service"
    bookingSub="Available Today"
  />

  <ServicesGrid
    cityName={cityName}
    headline="Appliance Repair Services in Norwalk"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Norwalk Restaurants and Commercial Kitchens"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Norwalk Patios, Grills and Garage Freezers"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Norwalk Neighborhoods We Service"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={["Firestone Blvd", "Imperial Hwy", "Rosecrans Ave", "Pioneer Blvd", "Studebaker Rd", "Norwalk Blvd"]}
  />

  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Repairs in Norwalk" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Norwalk Calls Us"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Norwalk"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Norwalk"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Schedule Your Norwalk Repair Today"
    body="Same-day service across Norwalk, ZIP 90650. Laundry, cooking, refrigeration — all major brands."
  />
</CityLayoutV2>
