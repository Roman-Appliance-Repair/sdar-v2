---
// Wave 63 Sprint 2A — Auto-generated brand-index hub page.
// Restores breadcrumb chain Home > Commercial > <Category> > Brands > <Brand>
// (or Outdoor parent for outdoor categories).
// $120 commercial diagnostic only (no $89 — commercial scope per factual-accuracy.md §9).
import Layout from '../../../../layouts/Layout.astro';
import { MAIN_PHONE } from '../../../../data/branches';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/commercial/ice-machines/brands/";
const title = "Commercial Ice Machine Brands Repair LA — Same Day";
const description = "Commercial ice machine repair across LA — Hoshizaki, Manitowoc, Scotsman, Ice-O-Matic, Follett. Low-ice, harvest, water faults. $120 diagnostic, waived.";

const breadcrumbSchema = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/"}, {"@type": "ListItem", "position": 2, "name": "Commercial", "item": "https://samedayappliance.repair/commercial/"}, {"@type": "ListItem", "position": 3, "name": "Commercial Ice Machine", "item": "https://samedayappliance.repair/commercial/ice-machines/"}, {"@type": "ListItem", "position": 4, "name": "Brands", "item": "https://samedayappliance.repair/commercial/ice-machines/brands/"}]};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <section class="hub-hero">
    <div class="container">
      <p class="eyebrow">Los Angeles · Commercial · Same-Day</p>
      <h1>Commercial Ice Machine Brands We Service in LA</h1>
      <p class="hub-lede">Five brands cover most of LA's commercial ice-machine service load: Hoshizaki, Manitowoc, Scotsman, Ice-O-Matic, and Follett. Each runs a different cycle architecture (Hoshizaki hot-gas defrost, Manitowoc gravity-feed, Scotsman flake-cycle, Ice-O-Matic Pearl nugget, Follett Chewblet nugget for healthcare) and the failure modes differ accordingly. We're EPA 608 Universal certified with R-290 supplemental for the post-2020 propane-refrigerant generation, which most major manufacturers transitioned to for environmental compliance.</p>
      <div class="cta-row">
        <a href={phoneHref} class="btn-primary">Call {phone}</a>
        <a href="/book/" class="btn-secondary">Book Online</a>
      </div>
      <p class="hub-foot">$120 commercial diagnostic · Applied to repair · BHGS #A49573 · EPA 608 Universal #1346255700410 · BBB Accredited</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="container">
      <h2>5 commercial ice machine brands we work on</h2>
      <div class="brand-grid">
        <a href="/commercial/ice-machines/brands/follett/" class="brand-card">
          <h3>Follett</h3>
          <p>Follett ice machine repair across SoCal. Healthcare + restaurants.</p>
          <span class="card-cta">Follett repair details →</span>
        </a>
        <a href="/commercial/ice-machines/brands/hoshizaki/" class="brand-card">
          <h3>Hoshizaki</h3>
          <p>Hoshizaki ice machine repair across SoCal. KM-340MAJ, KM-650MAJ, KM-901MAJ, F-450MAH, F-801MWH, Cubelet DCM.</p>
          <span class="card-cta">Hoshizaki repair details →</span>
        </a>
        <a href="/commercial/ice-machines/brands/ice-o-matic/" class="brand-card">
          <h3>Ice-O-Matic</h3>
          <p>Ice-O-Matic ice machine repair across SoCal. ICE0250, ICE0320, ICE0500, ICE0606 cube + Pearl Ice nugget.</p>
          <span class="card-cta">Ice-O-Matic repair details →</span>
        </a>
        <a href="/commercial/ice-machines/brands/manitowoc/" class="brand-card">
          <h3>Manitowoc</h3>
          <p>Manitowoc ice machine repair across SoCal. Indigo NXT IY-0454A, IY-0696A, IB-0420A, ID-0322A, R-Series nugget.</p>
          <span class="card-cta">Manitowoc repair details →</span>
        </a>
        <a href="/commercial/ice-machines/brands/scotsman/" class="brand-card">
          <h3>Scotsman</h3>
          <p>Scotsman ice machine repair across SoCal: Prodigy ELITE C0322, C0530, C0630, C1030 cube + Brilliance nugget. Ali Group.</p>
          <span class="card-cta">Scotsman repair details →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="hub-section hub-section-gray">
    <div class="container narrow">
      <h2>How our techs approach commercial ice machines</h2>
      <p>Ice-machine failures cluster in a few predictable categories: low ice production (almost always condenser-coil fouling from kitchen grease — we clean before quoting parts), no ice production (water-inlet valve, ice-thickness probe, or refrigerant), water leaks (drain-line clog or inlet-valve solenoid), and bin-control failures (sensor adjustment). Hard-water descaling is non-optional in LA — we include a full cleaning cycle and bin-sanitization on every service visit, not as an upsell. On R-290 propane-refrigerant units (post-2020 generation), service requires R-290 certification beyond standard EPA 608 — we have it.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="container narrow">
      <h2>Common questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>Why is my ice machine making less ice than it used to?</summary>
          <p>Almost always condenser-coil fouling. Kitchen grease and dust accumulate on the coil over months, the compressor has to work harder, head pressure rises, ice production drops. A thorough coil cleaning typically restores 30-50% of production capacity at no parts cost. We do this on every service visit before quoting parts replacement.</p>
        </details>
        <details class="faq-item">
          <summary>My machine is leaking water from the bottom. What's wrong?</summary>
          <p>Three common causes: drain-line clog (most common, usually clears with a snake), water-inlet solenoid leaking, or a cracked water-distribution tube. We diagnose by visual inspection and trace the water path. Drain-clearance is typically a $145 service call, inlet valve replacement $185-$245, water-tube replacement $245-$345.</p>
        </details>
        <details class="faq-item">
          <summary>Do you handle R-290 propane refrigerant units?</summary>
          <p>Yes. Many post-2020 Hoshizaki, Scotsman, Ice-O-Matic, and Manitowoc models use R-290 (propane) refrigerant for environmental compliance. R-290 service requires specific certification beyond standard EPA 608 Universal — we hold it. Check the rating label on your unit: if it shows R-290 or Propane, you need an R-290-certified technician.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="bottom-cta">
    <div class="container">
      <h2>Commercial Ice Machine brand service across LA, same-day priority</h2>
      <p>$120 commercial diagnostic, applied to repair when approved. BHGS #A49573, EPA 608 Universal certified, BBB Accredited Business.</p>
      <div class="cta-row">
        <a href={phoneHref} class="btn-primary">Call {phone}</a>
        <a href="/book/" class="btn-secondary">Book Online</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :root { --red: #C8102E; --black: #0a0a0a; --text: #1a1a1a; --muted: #6b6b6b; --border: #e2e2e2; }
  .hub-hero { background: var(--black); color: #fff; padding: 80px 24px 60px; text-align: center; }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .container.narrow { max-width: 820px; }
  .hub-hero .eyebrow { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--red); margin: 0 0 14px; font-weight: 700; }
  .hub-hero h1 { font-size: clamp(28px, 4vw, 44px); font-weight: 800; margin: 0 0 18px; letter-spacing: -0.02em; }
  .hub-lede { font-size: 1.05rem; line-height: 1.7; max-width: 820px; margin: 0 auto 26px; color: #ddd; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
  .btn-primary { background: var(--red); color: #fff; padding: 13px 24px; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 0.95rem; }
  .btn-secondary { background: transparent; color: #fff; padding: 13px 24px; border: 1.5px solid #fff; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 0.95rem; }
  .hub-foot { font-size: 0.84rem; color: #888; margin-top: 18px; }
  .hub-section { padding: 56px 0; }
  .hub-section-gray { background: #f7f7f7; }
  .hub-section h2 { font-size: clamp(1.5rem, 2.6vw, 1.9rem); font-weight: 800; margin: 0 0 28px; color: var(--text); letter-spacing: -0.01em; }
  .hub-section.narrow p { font-size: 1rem; line-height: 1.75; color: var(--text); }
  .brand-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 18px; }
  .brand-card { display: block; background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 22px 20px; text-decoration: none; color: inherit; transition: border-color .15s, transform .15s; }
  .brand-card:hover { border-color: var(--red); transform: translateY(-2px); }
  .brand-card h3 { font-size: 1.1rem; font-weight: 700; margin: 0 0 10px; color: var(--text); }
  .brand-card p { font-size: 0.9rem; line-height: 1.6; color: var(--muted); margin: 0 0 14px; }
  .card-cta { font-size: 0.85rem; font-weight: 700; color: var(--red); }
  .faq-list { margin-top: 18px; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 18px 0; }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-item summary { font-size: 1rem; font-weight: 700; cursor: pointer; list-style: none; color: var(--text); }
