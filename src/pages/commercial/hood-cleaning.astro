---
// src/pages/commercial/hood-cleaning.astro
// 2026-10-04: restaurant hood cleaning gets its own page at /commercial/hood-cleaning/
// (replaces the old exhaust-hood-repair/hood-cleaning-service sub-page, 301 in _redirects
// and astro.config.mjs). Content follows the owner's facts only:
//   - we clean the whole exhaust system ourselves: hood, filters, ductwork to the roof,
//     rooftop exhaust fan;
//   - method: steam cleaning plus chemical degreasers;
//   - commercial from $320, exact price only on site after we see the system;
//   - home range hood cleaning from $280, estimate on site, depends on grease buildup.
// Not confirmed, so NOT claimed here: NFPA 96 certificates or stickers, photo packages,
// IKECA, insurance-audit packages, per-foot or per-panel pricing, schedule pricing,
// fire-suppression (Ansul) service.

import Layout from '../../layouts/Layout.astro';
import CommercialHero from '../../components/CommercialHero.astro';
import { MAIN_PHONE, toE164 } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/commercial/hood-cleaning/";

const title = "Restaurant Hood Cleaning Los Angeles — Kitchen Exhaust Cleaning";
const description = "Restaurant hood and kitchen exhaust cleaning across LA and SoCal: hood, filters, ducts and rooftop fan, steam and degreaser. From $320, exact price on site.";

const faqs = [
  {
    q: "How much does restaurant hood cleaning cost?",
    a: "Commercial hood cleaning starts at $320. Every system is different (hood length, number of hoods, duct run to the roof, how much grease has built up), so the exact price is set on site after we see the hood and ducts."
  },
  {
    q: "What do you clean?",
    a: "The whole kitchen exhaust system, and we do all of it ourselves: the hood interior and plenum, the baffle filters, the grease cups and troughs, the ductwork all the way to the roof, and the rooftop exhaust fan."
  },
  {
    q: "How do you clean a kitchen exhaust hood?",
    a: "Steam cleaning plus chemical degreasers. The degreaser breaks down baked-on grease, and steam carries it off the hood, filters, ducts and fan. We cover and protect the cooking line and the kitchen before we start."
  },
  {
    q: "How often should a restaurant hood be cleaned?",
    a: "It depends on how much you cook and what you cook. Kitchens with heavy grease (charbroilers, woks, fryers running all day) usually clean monthly or quarterly. Most full-service restaurants clean every six months. Light-cooking kitchens may clean once or twice a year. We can set up a regular schedule for your kitchen."
  },
  {
    q: "Do you clean home range hoods too?",
    a: "Yes. Home range hood cleaning starts at $280. We give the estimate on site, because the price depends on how much grease has built up in the hood, filters and duct."
  },
  {
    q: "Are you licensed and insured?",
    a: "Yes. We're registered with California's Bureau of Household Goods and Services under BHGS #A49573, our technicians hold EPA 608 Universal certification #1346255700410, and we carry general liability and workers' comp insurance."
  },
  {
    q: "Do you service the fire-suppression system?",
    a: "No. The fire-suppression system (Ansul and similar) is serviced by a fire-suppression company. We clean around it and do not touch its nozzles, links or tank."
  }
];

const areaServed = [
  { "@type": "AdministrativeArea", "name": "Los Angeles County" },
  { "@type": "AdministrativeArea", "name": "Orange County" },
  { "@type": "AdministrativeArea", "name": "Ventura County" },
  { "@type": "AdministrativeArea", "name": "Santa Barbara County" },
  { "@type": "AdministrativeArea", "name": "San Bernardino County" },
  { "@type": "AdministrativeArea", "name": "Riverside County" },
  { "@type": "AdministrativeArea", "name": "San Diego County" }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": toE164(phone),
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "postalCode": "90048",
      "addressCountry": "US"
    },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" }
    ],
    "areaServed": areaServed,
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "location": BRANCH_LOCATIONS_GEO_NEUTRAL
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Restaurant Hood Cleaning",
    "name": "Restaurant Hood and Kitchen Exhaust Cleaning",
    "url": canonical,
    "description": "Restaurant hood and kitchen exhaust cleaning across Southern California: hood, baffle filters, grease cups, ductwork to the roof and rooftop exhaust fan, cleaned with steam and chemical degreasers. From $320; the exact price is set on site after we see the system.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": areaServed,
    "offers": {
      "@type": "AggregateOffer",
      "lowPrice": "320",
      "priceCurrency": "USD",
      "description": "Commercial hood cleaning starting price. Exact price set on site."
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial", "item": "https://samedayappliance.repair/commercial/" },
      { "@type": "ListItem", "position": 3, "name": "Restaurant Hood Cleaning", "item": canonical }
    ]
  }
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<CommercialHero
  slug="exhaust-hood-repair"
  eyebrow="Restaurants · Commercial Kitchens · Hood and Exhaust Cleaning"
  title="Restaurant Hood Cleaning in Los Angeles"
  subtitle={`Hood, filters, ductwork to the roof and the rooftop exhaust fan, cleaned with steam and degreasers. From $320, exact price on site. Call ${phone}`}
  heroImageTitle="Restaurant Hood Cleaning"
  showBranches={true}
/>

<!-- 01 WHAT WE CLEAN -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">What we clean</p>
    <h2>The whole exhaust system, from the hood to the roof.</h2>

    <p>We clean everything on a kitchen exhaust system ourselves. No part of the job is handed off to another crew.</p>

    <ul class="plain-list">
      <li><strong>Hood.</strong> The hood interior, the plenum behind the filters and the outside surfaces.</li>
      <li><strong>Baffle filters.</strong> Pulled, degreased and put back.</li>
      <li><strong>Grease cups and troughs.</strong> Emptied and cleaned.</li>
      <li><strong>Ductwork to the roof.</strong> The duct run from the hood all the way up to the roof.</li>
      <li><strong>Rooftop exhaust fan.</strong> Fan housing and fan wheel.</li>
    </ul>
  </div>
</section>

<!-- 02 HOW -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">How we do it</p>
    <h2>Steam cleaning plus chemical degreasers.</h2>

    <p>The degreaser breaks down baked-on grease, and steam carries it off the metal. Before we start, the cooking line and the kitchen are covered and protected. The visit is scheduled around your service hours, inside our visit hours of Monday to Saturday, 8 AM to 6 PM. Phones are answered 24/7.</p>
  </div>
</section>

<!-- 03 WHY -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">Why it matters</p>
    <h2>Grease in the hood and ducts is a fire risk.</h2>

    <p>Every service leaves a layer of grease inside the hood, the filters and the ducts. It builds up until it becomes fuel for a kitchen fire. It also slows the airflow: the hood stops pulling well, smoke and heat stay in the kitchen, and the fan works harder. Fire and health inspectors look at the hood and how clean it is, so a dirty system can also mean trouble at inspection.</p>
  </div>
</section>

<!-- 04 HOW OFTEN -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">How often</p>
    <h2>How often a restaurant hood is usually cleaned.</h2>

    <p>Restaurants usually clean on a schedule, and the interval depends on cooking volume:</p>
    <ul class="plain-list">
      <li><strong>Heavy grease</strong> (charbroilers, woks, fryers running all day): monthly to quarterly.</li>
      <li><strong>Typical full-service restaurant:</strong> every six months.</li>
      <li><strong>Light cooking:</strong> once or twice a year.</li>
    </ul>
    <p>We can set up a regular cleaning schedule for your kitchen.</p>
  </div>
</section>

<!-- 05 PRICE -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">Price</p>
    <h2>Commercial hood cleaning starts at $320.</h2>

    <p>Commercial hood cleaning starts at $320. Every system is different, so the exact price is set on site after we see the hood and ducts.</p>
  </div>
</section>

<!-- 06 HOME RANGE HOODS -->
<section class="section section-gray" id="home">
  <div class="container narrow">
    <p class="section-number">Home range hoods</p>
    <h2>Home range hood cleaning from $280.</h2>

    <p>We clean home range hoods too. Home range hood cleaning starts at $280, with the estimate given on site: the price depends on how much grease has built up. If the hood itself is not working (fan, lights, controls), see <a href="/services/range-hood-repair/">range hood repair</a>.</p>
  </div>
</section>

<!-- 07 REPAIRS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">Repairs</p>
    <h2>Problems we find while cleaning.</h2>

    <p>A cleaning puts us inside the hood and up on the roof, so we see the fan and the controls up close. If something is broken, we repair it too: <a href="/commercial/exhaust-hood-repair/fan-not-working/">exhaust fan not working</a>, <a href="/commercial/exhaust-hood-repair/make-up-air-system-repair/">make-up air problems</a> and the rest of <a href="/commercial/exhaust-hood-repair/">commercial exhaust hood repair</a>. Repairs carry the $120 commercial diagnostic, waived with repair, and a 90-day warranty on parts and labor.</p>
  </div>
</section>

<!-- 08 WHAT WE DON'T DO -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">Scope</p>
    <h2>What is not part of the cleaning.</h2>

    <ul class="plain-list">
      <li><strong>Fire-suppression systems.</strong> We don't service fire-suppression systems (Ansul and similar); a fire-suppression company does. We clean around them.</li>
      <li><strong>Structural duct changes.</strong> Rerouting, resizing or adding duct runs is not part of a cleaning.</li>
    </ul>
  </div>
</section>

<!-- 09 FAQ -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">FAQ</p>
    <h2>Restaurant hood cleaning questions.</h2>

    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 10 RELATED -->
<section class="section section-gray">
  <div class="container">
    <p class="section-number">Related</p>
    <h2>More for restaurant kitchens.</h2>

    <div class="related-grid">
      <a href="/commercial/exhaust-hood-repair/" class="related-card">
        <h3>Exhaust Hood Repair</h3>
        <p>Exhaust fan, motor, belt, controls and make-up air repair for commercial kitchens.</p>
      </a>
      <a href="/commercial/exhaust-hood-repair/make-up-air-system-repair/" class="related-card">
        <h3>Make-Up Air System Repair</h3>
        <p>The unit that brings fresh air back into the kitchen when the hood pulls air out.</p>
      </a>
      <a href="/for-business/restaurants/" class="related-card">
        <h3>Restaurants</h3>
        <p>Repair for the whole restaurant line: refrigeration, ice machines, cooking equipment and hoods.</p>
      </a>
      <a href="/services/range-hood-repair/" class="related-card">
        <h3>Home Range Hood Repair</h3>
        <p>Fan, lights or controls not working on a home range hood.</p>
      </a>
    </div>
  </div>
</section>

<!-- 11 BOTTOM CTA -->
<section class="bottom-cta">
  <div class="container">
    <h2>Hood cleaning due? Call 24/7.</h2>
    <p>Commercial hood cleaning from $320, exact price on site. Visits Monday to Saturday, 8 AM to 6 PM. BHGS #A49573 and EPA 608 Universal #1346255700410.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/contact/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  .section h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; margin: 0 0 18px; color: var(--text); line-height: 1.2; }
  .section p { font-size: 1rem; line-height: 1.75; margin: 0 0 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }

  .plain-list { padding-left: 22px; margin: 14px 0 16px; }
  .plain-list li { font-size: 1rem; line-height: 1.7; color: var(--text); margin-bottom: 10px; }
  .plain-list strong { color: var(--text); }

  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 18px 22px; margin-bottom: 12px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 1rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.95rem; color: var(--text); line-height: 1.75; margin: 14px 0 0; }

  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 22px; }
  .related-card { display: block; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px; text-decoration: none; color: var(--text); transition: all 0.2s; }
  .related-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,0.06); }
  .related-card h3 { font-size: 1rem; font-weight: 800; margin: 0 0 8px; color: var(--text); }
  .related-card p { font-size: 0.85rem; color: var(--muted); margin: 0; line-height: 1.6; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; margin: 0 0 14px; font-size: 1.7rem; }
  .bottom-cta p { color: #c9c9c9; margin: 0 0 26px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.35); font-weight: 600; text-decoration: none; }
</style>
