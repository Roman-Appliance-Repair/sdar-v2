---
import { CSLB_CREDENTIALS } from '../../../data/credentials-schema';
// src/pages/commercial/refrigeration/walk-in-cooler-installation.astro
// 2026-10-03 — walk-in cooler / freezer installation (owner: "we install").
// Demand (Ahrefs US): "walk in cooler installation" 350/mo, CPC $350; no page on
// the site answered it. No price ranges on purpose: an install is quoted after a
// site visit, and invented numbers would be worse than none. Electrical circuit and
// floor drain are other trades (owner scope list) — the page says we coordinate them.

import Layout from '../../../layouts/Layout.astro';
import CommercialHero from '../../../components/CommercialHero.astro';
import { MAIN_PHONE, toE164 } from '../../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../../lib/build-location-array';

const phone = MAIN_PHONE;
const phoneHref = `tel:+1${MAIN_PHONE.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/commercial/refrigeration/walk-in-cooler-installation/";

const title = "Walk-In Cooler & Freezer Installation Los Angeles";
const description = "Walk-in cooler and freezer installation across LA and SoCal: new boxes, used walk-in relocation, condensing unit and evaporator replacement, start-up and temperature check. Written quote after a site visit.";

const faqs = [
  {
    q: "Do you install new walk-in coolers and freezers?",
    a: "Yes. We assemble the panels and door, mount the evaporator, set the condensing unit, run and braze the refrigerant lines, pull a vacuum, charge the system and start it up. Before we leave, the box is pulled down to temperature and the controller, defrost and alarms are set. Kolpak, U.S. Cooler, Master-Bilt, Nor-Lake and other panel brands, with Heatcraft, Bohn and similar refrigeration systems."
  },
  {
    q: "Can you move a used walk-in to a new location?",
    a: "Yes, and it is one of the most common jobs we see from restaurants opening a second location. We recover the refrigerant, take the box apart panel by panel, move it, reassemble it, replace gaskets and anything damaged in transport, and recommission the refrigeration. A used box is often a good deal; a used condensing unit that sat outside for a year is not always, and we tell you which parts are worth keeping before you pay to move them."
  },
  {
    q: "What do I need to have ready before installation?",
    a: "A level floor (or an insulated floor kit in the plan), a dedicated electrical circuit sized for the condensing unit, a floor drain or drain path for the evaporator condensate, and a spot for the condensing unit with airflow around it. The electrical circuit and drain are done by an electrician and a plumber; we give them the exact specs and coordinate the schedule so the box is not sitting unfinished."
  },
  {
    q: "How long does a walk-in installation take?",
    a: "A standard pre-fab walk-in with a remote or top-mount system usually takes one to two days on site once the circuit and drain are ready. Relocations take longer because of disassembly and recovery. We give you the timeline in the written quote."
  },
  {
    q: "Do I need a permit or a Health Department review?",
    a: "Often, yes. A new walk-in in a food facility in Los Angeles County usually goes through the Health Department plan check, and the electrical work may need a permit from the city. We provide the equipment specifications and cut sheets those reviews ask for."
  },
  {
    q: "How much does walk-in installation cost?",
    a: "It depends on the size of the box, indoor or outdoor placement, whether it is new or relocated, and the refrigeration system. We quote after seeing the space and the equipment, in writing, with labor, parts and refrigerant as separate lines. For repair prices on an existing walk-in, see our walk-in cooler repair cost guide."
  },
];

const schemaJsons = [
  {
    "@context": "https://schema.org", "@type": "LocalBusiness", "@id": canonical + "#business",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "name": "Same Day Appliance Repair", "url": canonical, "telephone": toE164(phone), "priceRange": "$$",
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
    ],
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "location": BRANCH_LOCATIONS_GEO_NEUTRAL
  },
  {
    "@context": "https://schema.org", "@type": "Service", "@id": canonical + "#service",
    "serviceType": "Walk-in Cooler and Freezer Installation",
    "name": "Walk-In Cooler & Freezer Installation",
    "url": canonical,
    "description": "Walk-in cooler and freezer installation across Southern California: new pre-fab boxes, used walk-in relocation, condensing unit and evaporator replacement, refrigerant piping, evacuation, charge, start-up and temperature verification. EPA 608 Universal certified technicians.",
    "provider": { "@id": canonical + "#business" }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial", "item": "https://samedayappliance.repair/commercial/" },
      { "@type": "ListItem", "position": 3, "name": "Commercial Refrigeration", "item": "https://samedayappliance.repair/commercial/refrigeration/" },
      { "@type": "ListItem", "position": 4, "name": "Walk-In Cooler Installation", "item": canonical }
    ]
  }
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<CommercialHero
  slug="walk-in-cooler-repair"
  eyebrow="Walk-In Coolers & Freezers · Installation"
  title="Walk-In Cooler & Freezer Installation in Los Angeles"
  subtitle={`New walk-ins, used boxes moved to a new location, condensing units and evaporators replaced. Installed, charged, started up and pulled down to temperature by the same team that repairs walk-ins every day. ${phone}`}
  heroImageTitle="Walk-In Cooler Installation"
  showBranches={true}
/>

<section class="section">
  <div class="container narrow">
    <p class="section-number">Why it matters who installs it</p>
    <h2>Most walk-in breakdowns we get called to were built in on install day.</h2>
    <p><strong>A walk-in that short-cycles, ices the coil or sweats at the door usually was not unlucky.</strong> The condensing unit was set where it breathes its own exhaust, the lines were not evacuated long enough, the evaporator was sized for a different box, or the door was hung out of square and has leaked since day one. We see the result on repair calls every week, so we install the way we would want to find it on a service call.</p>
    <p>We work across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties for restaurants, bars and breweries, grocery and convenience stores, florists, catering kitchens and cold storage. Phones are answered 24/7.</p>
  </div>
</section>

<section class="section section-gray">
  <div class="container">
    <p class="section-number">What we do</p>
    <h2>Walk-in installation services</h2>
    <div class="related-grid">
      <div class="related-card static">
        <h3>New walk-in coolers and freezers</h3>
        <p>Panel and door assembly, evaporator and condensing unit, refrigerant piping, vacuum, charge, start-up, controller and defrost setup.</p>
      </div>
      <div class="related-card static">
        <h3>Relocating a used walk-in</h3>
        <p>Refrigerant recovery, disassembly, transport-ready panels, reassembly, new gaskets and sweeps, recommissioning.</p>
      </div>
      <div class="related-card static">
        <h3>Condensing unit and evaporator replacement</h3>
        <p>When the box is fine but the refrigeration is worn out. Sized to the box and the load, not to whatever was in stock.</p>
      </div>
      <div class="related-card static">
        <h3>Doors, strip curtains and heaters</h3>
        <p>New doors and frames, door closers, strip curtains, and door and frame heaters on freezers.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <p class="section-number">How an install goes</p>
    <h2>From site visit to a box holding temperature</h2>
    <ol class="steps">
      <li><strong>Site visit and written quote.</strong> We measure the space, check the floor, where the condensing unit can go, power and drain. You get labor, parts and refrigerant as separate lines.</li>
      <li><strong>Trades lined up.</strong> The dedicated circuit and condensate drain are done by an electrician and a plumber. We give them the specs and set the dates so nothing waits on anyone.</li>
      <li><strong>Installation.</strong> Panels, door, evaporator, condensing unit, line set. Lines are pressure-tested and evacuated before any refrigerant goes in.</li>
      <li><strong>Start-up and pull-down.</strong> We charge the system, set the controller, defrost schedule and alarms, and stay until the box reaches its set temperature.</li>
      <li><strong>Handover.</strong> You get the settings, the maintenance schedule and our number. Repairs carry our 90-day warranty on parts and labor.</li>
    </ol>
  </div>
</section>

<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">FAQ</p>
    <h2>Walk-in installation questions</h2>
    <div class="faq-list">
      {faqs.map(f => (<details class="faq-item"><summary>{f.q}</summary><p set:html={f.a}></p></details>))}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <p class="section-number">Related</p>
    <h2>Already have a walk-in?</h2>
    <div class="related-grid">
      <a href="/commercial/refrigeration/walk-in-cooler-repair/" class="related-card">
        <h3>Walk-In Cooler Repair</h3>
        <p>Same-day repair: compressors, evaporator fans, defrost, door seals, refrigerant leaks.</p>
      </a>
      <a href="/commercial/refrigeration/walk-in-freezer-repair/" class="related-card">
        <h3>Walk-In Freezer Repair</h3>
        <p>Freezer above 0°F, iced-up coil, defrost failures, door heaters.</p>
      </a>
      <a href="/commercial/refrigeration/walk-in-door-repair/" class="related-card">
        <h3>Walk-In Door Repair</h3>
        <p>Gaskets, hinges, closers, latches and heater wire.</p>
      </a>
      <a href="/price-list/walk-in-cooler-repair-cost/" class="related-card">
        <h3>Walk-In Repair Prices</h3>
        <p>What common walk-in repairs cost in Los Angeles.</p>
      </a>
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Planning a walk-in? Get a site visit and a written quote.</h2>
    <p>New box, a used one to move, or a worn-out refrigeration system to replace. Phones answered 24/7, visits Mon–Sat.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/contact/" class="btn-secondary">Request a Quote</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  .section h2 { font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; margin: 0 0 18px; line-height: 1.2; }
  .section p { font-size: 1rem; line-height: 1.75; margin: 0 0 16px; }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .steps { padding-left: 22px; margin: 14px 0 0; }
  .steps li { font-size: 1rem; line-height: 1.7; margin-bottom: 14px; color: var(--text); }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 18px 22px; margin-bottom: 12px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 1rem; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.95rem; line-height: 1.75; margin: 14px 0 0; }
  .related-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-top: 22px; }
  .related-card { display: block; background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px; text-decoration: none; color: var(--text); transition: all 0.2s; }
  a.related-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,0.06); }
  .related-card h3 { font-size: 1rem; font-weight: 800; margin: 0 0 8px; color: var(--text); }
  .related-card p { font-size: 0.88rem; color: var(--muted); margin: 0; line-height: 1.6; }
  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; margin: 0 0 14px; font-size: 1.7rem; }
  .bottom-cta p { color: #c9c9c9; margin: 0 0 26px; max-width: 720px; margin-left: auto; margin-right: auto; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.35); font-weight: 600; text-decoration: none; }
</style>
