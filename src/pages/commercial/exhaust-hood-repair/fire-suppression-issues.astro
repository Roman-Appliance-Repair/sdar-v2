    "serviceType": "Commercial Kitchen Hood Fire Suppression Coordination", "name": "Hood-Side Fire Suppression Integration Service", "url": canonical,
    "description": "Commercial kitchen exhaust hood fire suppression integration service across all seven SoCal counties. Hood-side coordination with Ansul R-102, Pyro-Chem KitchenGard, Amerex KP, Buckeye Kitchen Mister wet-chemical UL-300 suppression systems. Gas shut-off valve operational test, fusible link inspection (180°F low-temp, 220°F high-temp ratings), manual pull station accessibility verification, NFPA 96 vs UL-300 inspection cycle coordination, California State Fire Marshal compliance documentation. We do not do suppression installation, recharge after discharge, or UL-300 certification (those require California State Fire Marshal contractor license). $120 commercial diagnostic, applied toward repair. BHGS #A49573, EPA 608 Universal certified #1346255700410.  scope.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },{ "@type": "AdministrativeArea", "name": "Orange County" },{ "@type": "AdministrativeArea", "name": "Ventura County" },{ "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },{ "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Commercial diagnostic fee, applied toward repair" } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Commercial", "item": "https://samedayappliance.repair/commercial/" },
      { "@type": "ListItem", "position": 3, "name": "Exhaust Hood Repair", "item": "https://samedayappliance.repair/commercial/exhaust-hood-repair/" },
      { "@type": "ListItem", "position": 4, "name": "Fire Suppression Issues", "item": canonical }
    ]
