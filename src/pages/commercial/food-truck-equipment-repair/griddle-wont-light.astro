import { mergeCredentials } from '../../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const hub = "https://samedayappliance.repair/commercial/food-truck-equipment-repair/";
const canonical = hub + "griddle-wont-light/";

const title = "Food Truck Griddle Won't Light LA — Same Day";
const description = "Food truck griddle won't light or stay lit? We check LP supply, pilot, thermocouple, safety valve and gas conversion. $120 diagnostic, waived with repair.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const faqs = [
  {
    q: "Why does my griddle pilot light but go out when I let go of the knob?",
    a: "The pilot heats a thermocouple, and the thermocouple's small voltage holds the safety valve open. When the pilot dies on release, the thermocouple isn't making enough voltage, the flame isn't wrapping its tip, or the safety valve magnet is weak. We read the thermocouple with a meter, open-circuit with the pilot lit. Below 25 mV we replace it rather than clean it."
  },
  {
    q: "Can I run a natural gas griddle on propane?",
    a: "Not without converting it. Propane needs smaller orifices and higher manifold pressure than natural gas, so an unconverted griddle burns an oversized, yellow, sooty flame and can overheat. The right fix is the manufacturer's LP conversion kit for that model. We don't drill or swap orifices by guesswork, and if no factory kit exists, we'll tell you."
  },
  {
    q: "The griddle lights, but the flame is yellow and leaves soot. What's wrong?",
    a: "On a truck the usual causes are a griddle that was never converted from natural gas, burner ports clogged with grease and carbon, or wrong supply pressure. We check the data plate and orifices against the gas you run, clean the burners, and put a manometer on the griddle inlet to confirm pressure before replacing anything."
  },
  {
    q: "Do you fix the propane regulator or the tank on the truck?",
    a: "No. Cylinders, regulators and the LP line outside the appliance are work for a licensed propane contractor. We measure pressure at the griddle inlet with the other burners running, and if the griddle is being starved, we tell you it's a supply problem instead of selling you griddle parts."
  },
  {
    q: "How fast can you get to the truck, and what does it cost?",
    a: "Same-day service is available across Los Angeles, usually at your commissary. The diagnostic is $120 and it's waived when you approve the repair. You get a written quote before we order parts, and phones are answered 24/7."
  }
];

// TODO(recent-repairs): fill from REAL HouseCall Pro jobs only — never invent a case.
const recentRepairs: { title: string; body: string; area: string }[] = [];
const showRepairsSlot = recentRepairs.length > 0 || import.meta.env.DEV;

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Food Truck Griddle Repair",
    "name": "Food Truck Griddle Won't Light Diagnostic and Repair",
    "url": canonical,
    "description": "Diagnosis and repair of food truck griddles that won't light or won't stay lit: LP supply pressure at the appliance inlet, pilot orifice and tubing, thermocouple, safety valve, thermostat, and factory LP conversion of natural gas griddles.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Commercial diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro
  // (visible trail + matching JSON-LD), so it is not duplicated here.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<CommercialHero
  slug="food-truck-equipment-repair/griddle-wont-light"
