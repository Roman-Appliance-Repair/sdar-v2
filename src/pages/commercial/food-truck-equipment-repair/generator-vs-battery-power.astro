// src/pages/commercial/food-truck-equipment-repair/generator-vs-battery-power.astro
// Food truck informational sub: generator vs battery (LiFePO4 + inverter) vs rooftop solar.
// Angle: honest comparison. We do NOT design or install battery/solar systems; we repair the
// kitchen and refrigeration equipment that fails after a conversion. Conversion block → refrigeration-not-cooling.
// $120 commercial diagnostic, waived with repair.
// Schema per docs/seo-policies.md (mergeCredentials + buildBranchLocation + OPENING_HOURS_SCHEMA).
// BreadcrumbList comes from Layout → Breadcrumbs.astro. NO aggregateRating.
import Layout from '../../../layouts/Layout.astro';
import CommercialHero from '../../../components/CommercialHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../../data/branches';
import { buildBranchLocation } from '../../../lib/build-location-array';
import { mergeCredentials } from '../../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const hub = "https://samedayappliance.repair/commercial/food-truck-equipment-repair/";
const canonical = hub + "generator-vs-battery-power/";

const title = "Food Truck Generator vs Battery Power — LA";
const description = "Generator, battery bank or solar on a food truck? Real numbers on roof solar, LiFePO4 banks and cost, and what breaks after a switch. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const faqs = [
  {
    q: "Can solar panels alone run a food truck?",
    a: "No. A 16 to 22 foot truck roof fits roughly 600 to 1,200 watts of panels, which makes about 3 to 5 kWh on a typical Los Angeles day. A working shift on a truck uses 15 to 40 kWh. Solar covers somewhere around 10 to 25 percent of that at best. What runs the truck is the battery bank, charged from shore power at the commissary; the panels only top it up."
  },
  {
    q: "Is a battery system allowed where generators aren't?",
    a: "A battery bank with an inverter is quiet and has no exhaust, which is the whole reason operators look at it for events and farmers markets that restrict or ban generators. The rules belong to each market, event organizer or property, though, so confirm with them before you spend the money. We repair equipment; we can't tell you what a given organizer allows."
  },
  {
    q: "My fridge started failing after we switched to batteries. Is it the fridge?",
    a: "Often it isn't. The usual causes are an inverter putting out a modified sine wave, an inverter too small for the compressor's starting current, or voltage sagging as the bank drains under load. Our diagnostic starts with a voltmeter at the outlet during a compressor start, not with a new compressor. If the power is the cause, we show you the readings to take to your installer."
  },
  {
    q: "Do you install battery banks, inverters or solar panels on food trucks?",
    a: "No. We don't design, sell or install battery systems, inverters, charge controllers or solar panels, and we don't service them. We repair the cooking and refrigeration equipment on the truck, including when the failure was caused by the power system, and we tell you plainly when the fix belongs to your installer."
  },
  {
    q: "What does a diagnostic cost if something on the truck stops working?",
    a: "The diagnostic is $120, and it's waived when you approve the repair. Same-day service is available across Los Angeles, usually at your commissary, and phones are answered 24/7. You get a written quote before any part is ordered."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Food Truck Equipment Repair",
    "name": "Food Truck Equipment Repair After Power System Failures",
    "url": canonical,
    "description": "Repair of food truck refrigeration and kitchen equipment damaged or disrupted by generator or battery-inverter power: voltage under load, inverter starting-current limits, modified sine wave damage to controls and fan motors. Battery, inverter and solar systems themselves are not designed, installed or serviced.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Commercial diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
