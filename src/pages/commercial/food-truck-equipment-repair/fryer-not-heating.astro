// $120 commercial diagnostic, waived with repair. Price ranges reused from /commercial/fryer-repair/not-heating/.
// Schema per docs/seo-policies.md (mergeCredentials + buildBranchLocation + OPENING_HOURS_SCHEMA). NO aggregateRating.
import Layout from '../../../layouts/Layout.astro';
import CommercialHero from '../../../components/CommercialHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../../data/branches';
import { buildBranchLocation } from '../../../lib/build-location-array';
import { mergeCredentials } from '../../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const hub = "https://samedayappliance.repair/commercial/food-truck-equipment-repair/";
const canonical = hub + "fryer-not-heating/";

const title = "Food Truck Fryer Not Heating LA — Same Day";
const description = "Food truck fryer not heating or slow to recover? High-limit trips, pilot and thermopile, LP pressure under load, electric fryers on generators. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const faqs = [
  {
    q: "My fryer's high-limit keeps tripping. Can I just keep resetting it?",
    a: "No. Reset it once. The high-limit is the safety cutoff that stops the burner when oil overheats, and it trips for a reason: low oil, a thermostat stuck calling for heat, or a vat fired without enough oil. If it trips again, shut the fryer down and call. Resetting a high-limit over and over, or jumpering it, is how fryer fires start."
  },
  {
    q: "The pilot stays lit but the main burner won't come on. Why?",
    a: "On a millivolt fryer, the pilot heats a thermopile that powers the gas valve. A lit pilot with a dead burner usually means the thermopile isn't making enough output, its leads have vibrated loose at the gas valve terminals, the high-limit is open, or the thermostat or valve has failed. We check them in that order with a meter, because a loose terminal costs nothing to fix."
  },
  {
    q: "Why is there frost on the propane cylinder when the fryer is slow?",
    a: "Frost means the cylinder is being drawn hard and propane can't vaporize fast enough to keep up. Pressure drops, every burner on the truck weakens, and the fryer recovers slowly. We confirm it with a manometer at the fryer inlet with everything running. The fix is on the supply side, like cylinder size or setup, which is work for your propane contractor."
  },
  {
    q: "My electric fryer is slow on the generator but fine at the commissary. Is it the fryer?",
    a: "Often it's the voltage. An element's heat output falls faster than the voltage does, so a modest sag on a loaded generator makes a noticeably weaker fryer. We measure voltage at the receptacle while the fryer is firing, then test the elements and contactor. A burned element or pitted contactor is ours to fix; a generator that can't carry the load is a generator shop's."
  },
  {
    q: "What does it cost, and how soon can you come?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. Same-day service is available across Los Angeles, usually at your commissary, with phones answered 24/7. You get a written quote before any parts are ordered."
  }
];

// TODO(recent-repairs): fill from REAL HouseCall Pro jobs only — never invent a case.
const recentRepairs: { title: string; body: string; area: string }[] = [];
const showRepairsSlot = recentRepairs.length > 0 || import.meta.env.DEV;

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Food Truck Fryer Repair",
    "name": "Food Truck Fryer Not Heating Diagnostic and Repair",
    "url": canonical,
    "description": "Diagnosis and repair of food truck fryers that won't heat or recover slowly: high-limit, pilot, thermopile and millivolt gas valve, thermostat, LP pressure at the appliance inlet, factory LP conversion, and electric fryer elements and contactors on generator power.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Commercial diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro
  // (visible trail + matching JSON-LD), so it is not duplicated here.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<CommercialHero
  slug="food-truck-equipment-repair/fryer-not-heating"
