        <h3>"{r.title}"</h3>
        <p>{r.body}</p>
        <p class="story-area">{r.area}</p>
      </div>
    )) : [1, 2].map((n) => (
      <div class="story story-todo">
        <h3>TODO: fryer case {n} from a real HCP job</h3>
        <p>Title as the customer said it, the model, what we found, what we did, one human detail. Never invented. This placeholder renders only in dev.</p>
      </div>
    ))}
  </div>
</section>
)}

<!-- 06 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06 · FAQ</p>
    <h2 class="section-title">Food truck fryer questions.</h2>
    <div class="faq-list">
