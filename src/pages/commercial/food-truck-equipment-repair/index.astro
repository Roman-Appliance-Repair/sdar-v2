// city-level West Hollywood address (no streetAddress). Hours from OPENING_HOURS_SCHEMA.
// NO aggregateRating.
import Layout from '../../../layouts/Layout.astro';
import CommercialHero from '../../../components/CommercialHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../../data/branches';
import { buildBranchLocation } from '../../../lib/build-location-array';
import { mergeCredentials } from '../../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/commercial/food-truck-equipment-repair/";

const title = "Food Truck Equipment Repair Los Angeles — Same Day";
const description = "Food truck equipment repair in Los Angeles: LP griddles and fryers, undercounter refrigeration, prep tables, ice machines. $120 diagnostic, waived with repair.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const faqs = [
  {
    q: "Do you come to the food truck, or does the truck come to you?",
    a: "We come to the truck. Most calls we meet it at the commissary, where it's parked, level and plugged in, which makes testing faster. If the truck is down at a lunch spot or an event lot and can safely stay put, our guys can work there too. Same-day service is available across Los Angeles County and the rest of Southern California; phones are answered 24/7."
  },
  {
    q: "How much does a food truck repair visit cost?",
    a: "The diagnostic is $120, and it comes off the bill as soon as you approve the repair. After the diagnostic you get a written quote before any part is ordered, and the number on the quote is the number on the invoice. No emergency surcharge."
  },
  {
    q: "Can you convert a natural gas griddle or fryer to propane?",
    a: "When the manufacturer makes an LP conversion kit for that model, yes. The kit brings the correct orifices and sets the valve or regulator for LP pressure. We don't drill out or swap in random orifices, and if no factory kit exists for your unit, we'll tell you that straight instead of improvising a conversion on a gas appliance."
  },
  {
    q: "My fridge cools fine at the commissary but warms up at events. Is the fridge broken?",
    a: "Often it isn't. When a refrigerator holds temperature on commissary power and struggles on a generator, the first suspect is the power: voltage sagging when the compressor starts, a long thin extension cord, or a generator carrying more load than it can start. Our diagnostic starts with a voltmeter under load, and we show you the readings before we quote any refrigeration parts."
  },
  {
    q: "Do you work on propane tanks, regulators, or the hood fire suppression system?",
    a: "No. Propane cylinders, regulators and the LP line outside the appliance belong to a licensed propane contractor, and the hood fire suppression system belongs to a licensed fire protection contractor. We check gas pressure at the appliance inlet and tell you whether the problem is upstream, then fix what's inside the cooking or refrigeration equipment."
  },
  {
    q: "What warranty comes with the repair?",
    a: "Our repairs carry a 90-day labor warranty on the work we performed. Brand component warranties, where they apply, are handled separately."
  },
  {
    q: "Can you help my truck pass a health inspection?",
    a: "We can fix the equipment that's causing the problem, like a prep table that won't hold 41°F or an ice machine that needs cleaning, and we document the repair on the invoice. Plan check, permits and inspections for mobile food facilities are handled by LA County Environmental Health, not by us."
  }
];

// TODO(recent-repairs): fill from REAL HouseCall Pro jobs only — never invent a case.
