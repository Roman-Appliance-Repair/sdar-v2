  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/images/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Carpinteria', sameAs: 'https://en.wikipedia.org/wiki/Carpinteria,_California' },
    { '@type': 'Place', name: 'Linden Avenue' },
    { '@type': 'Place', name: 'Padaro Lane' },
    { '@type': 'Place', name: 'Sandyland Cove' }
