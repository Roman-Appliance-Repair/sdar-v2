    outcome: '✓ Condenser serviced · Airflow verified · Annual schedule set'
  }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: 'Stocked for the Brands Carlsbad Owns',
    body: 'LG, Samsung, Whirlpool, GE — the high-turnover parts ride on the truck, because same-day only counts when the repair finishes same-day. Built-in brands covered where the upper tracts carry them.'
  },
  {
    iconKey: 'clock' as const,
    title: 'Rental-Rhythm Scheduling',
    body: 'Turnover windows, occupied-guest priority, pre-season checkouts, batched multi-unit visits. Carlsbad runs on rental stock; our calendar knows it.'
  },
  {
    iconKey: 'parts' as const,
    title: 'Honest Repair-vs-Replace Math',
