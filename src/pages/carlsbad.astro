---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Carlsbad, CA"
    subheadline="The Village, La Costa, Bressi Ranch, Aviara — family kitchens, rental stock, and the built-ins of the upper tracts. Stocked for the brands Carlsbad actually owns. $89 diagnostic, waived with repair."
    zips={zips}
    tier={2}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Carlsbad — How We Actually Work Here"
    paragraphs={introParagraphs}
    bookingTitle="Carlsbad Service Team"
    bookingSub="92008–92011 · Village · La Costa · Aviara"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Carlsbad"
    subhead="Workhorse brands · Rental stock · Upper-tract built-ins"
    services={services}
  />

  <CustomNarrative
    eyebrow={housingNarrative.eyebrow}
    headline={housingNarrative.headline}
    paragraphs={housingNarrative.paragraphs}
    subSections={housingNarrative.subSections}
