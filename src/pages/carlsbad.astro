---
/**
 * Carlsbad, CA — volume-market pillar of the San Diego Wave-1 cluster.
 * Branch: San Diego — service_area (no public street address).
 *
 * Angle: the VOLUME play, not the luxury play. ~115k people, three housing
 * populations: older coastal stock in the Village, large master-planned
 * inland tracts (La Costa, Bressi Ranch, Aviara), and resort/vacation-rental
 * pockets near the coast. Mass-market brands carry the page; built-ins appear
 * only where the newer luxury tracts genuinely have them.
 *
 * Positioning per recon: $89 once; no factory-authorization implication;
 * NO technician names. Zero-invention: repair cases reuse site-established
 * patterns only (Samsung ice maker defrost, Whirlpool-platform dryer thermal
 * fuse + vent, Frigidaire i20, KitchenAid counter-depth airflow).
 * No ReviewsBlock.
 */

import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CustomNarrative from '../components/cities/v2/CustomNarrative.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
import { mergeCredentials } from '../data/credentials-schema';

const citySlug = 'carlsbad';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Carlsbad';
const zips = ['92008', '92009', '92010', '92011'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Carlsbad CA — Same Day Service`;
const description = "Appliance repair in Carlsbad — the Village, La Costa, Bressi Ranch, Aviara. LG, Samsung, Whirlpool, GE. Vacation rentals welcome. $89 dx. (858) 667-7237.";
const canonical = 'https://samedayappliance.repair/carlsbad/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.fullName,
  image: 'https://samedayappliance.repair/images/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Carlsbad', sameAs: 'https://en.wikipedia.org/wiki/Carlsbad,_California' },
    { '@type': 'Place', name: 'Carlsbad Village' },
    { '@type': 'Place', name: 'La Costa' },
    { '@type': 'Place', name: 'Bressi Ranch' },
    { '@type': 'Place', name: 'Aviara' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
  license: 'BHGS #A49573'
});

const introParagraphs = [
  "<strong>Carlsbad is the working heart of our San Diego territory — a real city of 115,000 where the calls are family refrigerators, hard-run laundry pairs, and dishwashers that do a full shift every night. Our San Diego technicians stock the parts these homes actually use: LG and Samsung for the newer tracts, Whirlpool and GE for the older streets, and the built-in brands where Aviara and La Costa kitchens carry them. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "The city splits cleanly by construction era, and the appliance population follows. The Village and the streets near the coast run older — cottages and remodels where a twelve-year-old Whirlpool set is still earning its keep, and where repair beats replacement almost every time the math is run honestly. The master-planned east — La Costa, Bressi Ranch, Aviara, the Calavera Hills side — runs newer: LG and Samsung with sensors and error codes, plus genuine built-in kitchens in the upper tracts. Two diagnostic styles, one truck.",
  "The coastal strip adds a third population: vacation rentals and resort-adjacent homes whose appliances live an odd rhythm — quiet for weeks, then hammered by a full house through a holiday week. Machines fail at check-in here, not gradually, because idle time dries seals and settles debris that the first heavy weekend then exposes all at once. We schedule around bookings, prioritize occupied-rental calls, and do pre-season checkouts that catch the quiet failures before a guest does.",
  "And because Carlsbad sits on the same hard imported water as the rest of the corridor, scale is the constant across all three populations: dishwashers filming glassware, ice makers slowing down, washer inlet screens crusting shut on a year-3-to-5 schedule. Most of it is a service visit, not a replacement — and we'll tell you plainly which one you're looking at before anything is spent beyond the diagnostic.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for same-day service across 92008–92011 — and the rest of the <a href="/san-diego-county/">North Coastal corridor</a>.`
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Not cooling · Ice makers · French-door units · Built-ins in Aviara', brands: 'LG · Samsung · Whirlpool · GE · KitchenAid · Sub-Zero' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'Not draining · Not spinning · Error codes · Rental wear', brands: 'LG · Samsung · Whirlpool · Maytag · GE' },
  { icon: '💨', name: 'Dryer Repair', slug: 'dryer', issues: 'Not heating · Vent airflow · Thermal fuses · Coastal lint', brands: 'Samsung · LG · Whirlpool · Maytag · GE' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Hard-water scale · Drain codes · Not cleaning', brands: 'Whirlpool · Bosch · KitchenAid · Samsung · GE' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven', issues: 'Not heating · Elements · Igniters · Calibration', brands: 'GE · Whirlpool · Samsung · LG · Wolf · Viking' },
  { icon: '🧊', name: 'Ice Maker Repair', slug: 'ice-maker', issues: 'Frozen assemblies · Scale in fill valves · Slow production', brands: 'Samsung · LG · GE · Whirlpool · U-Line' },
  { icon: '❄️', name: 'Freezer Repair', slug: 'freezer', issues: 'Garage units · Frost buildup · Not freezing', brands: 'Frigidaire · GE · Whirlpool · Kenmore' },
  { icon: '🔆', name: 'BBQ & Grill Repair', slug: 'bbq', issues: 'Coastal igniter wear · Burners · Patio kitchens', brands: 'Weber · Lynx · Fire Magic · Bull · DCS' }
];

const housingNarrative = {
  eyebrow: 'THREE CARLSBADS, ONE TRUCK',
  headline: 'The Village, the Master Plans, and the Rental Strip',
  paragraphs: [
    "Knowing which Carlsbad is calling tells us most of the diagnosis before we arrive — and which parts belong on the truck."
  ],
  subSections: [
    {
      title: 'The Village & the older coastal streets',
      paragraphs: [
        'Cottages, remodels, and mid-century homes within walking distance of the beach. The machines here are veterans — Whirlpool and GE platforms with simple architectures and cheap, available parts. This is where repair-versus-replace math lands hardest on the repair side: a drain pump or bake element buys years. Salt exposure is real this close to the water, so refrigeration coils and patio grills get the coastal inspection habit.'
      ]
    },
    {
      title: 'La Costa, Bressi Ranch & Aviara',
      paragraphs: [
        'The master-planned east side, built in waves from the 1980s through the 2010s. Newer LG and Samsung dominate — sensor-driven machines that announce problems in error codes, which point at systems rather than parts and reward verification over parts-cannon guessing. The upper tracts add true built-in kitchens: counter-depth and column refrigeration, panel-front dishwashers, pro-style ranges. Aviara and the newer Bressi builds are where our luxury-brand parts see Carlsbad daylight.'
      ]
    },
    {
      title: 'The resort corridor & vacation rentals',
      paragraphs: [
        'From the flower-fields overlook down through the coastal rental pockets, appliances work a feast-or-famine schedule. We support hosts and managers with pre-season checkouts, priority scheduling when guests are in the house, remote-approval estimates, and per-property records — the machinery of keeping reviews about the beach rather than the refrigerator.'
      ]
    }
  ]
};

const rentalNarrative = {
  eyebrow: 'LANDLORDS, HOSTS & PROPERTY MANAGERS',
  headline: 'Volume Service, Run Like Volume Service',
  paragraphs: [
    "A city this size runs on rental stock as much as owner-occupied homes, and we service it accordingly. Multi-unit owners get batched visits — the urgent machine plus the list — with one invoice to the office. Vacation-rental managers get turnover-window scheduling and a straight answer on whether a machine has one more season of guest duty left in it. Long-term landlords get the boring, valuable thing: a technician who shows up inside the window, fixes the machine the tenant actually complained about, and leaves paperwork the bookkeeper can file.",
    "For the mass-market platforms that fill Carlsbad's rental stock, our trucks carry the high-turnover parts — drain pumps, lid locks, thermal fuses, heating elements, igniters — because a second visit to finish a simple repair is a failure of stocking, not of diagnosis. Same-day intent only means something if the part is already on board.",
    "Details for hosts live on our <a href=\"/for-business/airbnb-short-term-rentals/\">short-term rental service</a> page; portfolio owners can start at <a href=\"/for-business/property-management/\">property management service</a>."
  ]
};

const neighborhoods = [
  { name: 'Carlsbad Village', zip: '92008', featured: true },
  { name: 'La Costa', zip: '92009', featured: true },
  { name: 'Bressi Ranch', zip: '92009', featured: true },
  { name: 'Aviara', zip: '92011' },
  { name: 'Calavera Hills', zip: '92010' },
