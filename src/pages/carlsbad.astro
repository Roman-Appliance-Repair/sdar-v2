  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Carlsbad Homeowners & Landlords Call Us"
    reasons={whyReasons}
  />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in Carlsbad"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair. OEM parts."
    tiers={pricingTiers}
