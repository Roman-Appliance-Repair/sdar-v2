const pricingTiers = [
  { appliance: 'Refrigerator', range: '$200–$450', note: 'Ice makers · Fans · Defrost systems · French-door units', featured: true },
  { appliance: 'Washer / Dryer', range: '$150–$350', note: 'Pumps · Fuses · Elements · Vent airflow checked' },
  { appliance: 'Dishwasher', range: '$150–$320', note: 'Drain paths · Scale · Filters · Spray arms' },
