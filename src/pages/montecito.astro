const pricingTiers = [
  { appliance: 'Built-In Refrigeration (Sub-Zero era units)', range: '$300–$700+', note: 'OEM parts · Defrost systems · Evaporator fans · Gaskets', featured: true },
  { appliance: 'Range / Oven', range: '$175–$500', note: 'Wolf, Viking, Thermador · Igniters · Calibration' },
