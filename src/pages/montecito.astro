    cityName={cityName}
    headline="Jobs Our Team Did in Montecito"
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Montecito Estates Call Us"
    reasons={whyReasons}
  />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in Montecito"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair. OEM parts only."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions Montecito Clients Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
