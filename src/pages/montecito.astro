    outcome: '✓ Same day · OEM Viking parts · Hazard cleared'
  },
  {
    appliance: 'Wine Cellar Cooling',
    location: 'Cold Spring area, 93108',
    quote: 'Wine room creeping from 55 toward 60 — collection at risk',
    description: "Dedicated wine room with a through-wall cooling unit drifting warm over two weeks. Found the condenser side choked with dust in an equipment closet nobody opened, and a refrigerant system otherwise healthy — a cleaning and airflow correction, not a compressor. Temperature back at setpoint the same visit, and the estate manager set a reminder for annual service. The collection never left the racks.",
    outcome: '✓ Same day · Setpoint restored · No refrigerant work needed'
  }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: 'Aging Built-In Specialists',
    body: "Sub-Zero 500- and 600-series units that outlived their installers are our daily work, not an exotic call. We diagnose the unit as it is, service it with OEM parts, and leave a written record — so the next fifteen years have a paper trail."
  },
  {
    iconKey: 'clock' as const,
    title: 'Estate-Manager Fluent',
    body: 'Forwardable written estimates, household-calendar scheduling, management-office invoicing, access notes kept on file, discretion by default. Most of our Montecito calls come from professionals — our process is built for them.'
  },
  {
    iconKey: 'parts' as const,
    title: 'The Whole Property',
    body: 'Indoor kitchen, outdoor kitchen, wine room, laundry. Viking grills on the terrace and the Sub-Zero in the butler’s pantry are one phone call, not four vendors.'
  },
  {
    iconKey: 'shield' as const,
    title: '90-Day Warranty, OEM Only',
    body: 'Every repair backed by 90 days on parts and labor, with genuine OEM parts throughout — which matters most on decades-old built-ins where the wrong part shortens the life of the machine. $89 diagnostic waived with repair.'
