---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Montecito, CA"
    subheadline="Aging Sub-Zero built-ins, Wolf ranges, Viking outdoor kitchens, wine rooms — the estate belt's appliances, serviced properly. Estate managers welcome. $89 diagnostic, waived with repair."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Montecito — How We Actually Work Here"
    paragraphs={introParagraphs}
    bookingTitle="Montecito Service Team"
    bookingSub="93108 · Estate · Outdoor Kitchen · Wine Room"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Montecito"
    subhead="Built-in refrigeration · Estate kitchens · Outdoor & wine · 93108"
    services={services}
  />

  <CustomNarrative
    eyebrow={estateNarrative.eyebrow}
    headline={estateNarrative.headline}
    paragraphs={estateNarrative.paragraphs}
    background="white"
  />

  <ServiceArea
    cityName={cityName}
    headline="Montecito Areas We Service"
