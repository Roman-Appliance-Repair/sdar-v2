  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Hard-water scale · Drain paths · Compact cottage units', brands: 'Bosch · Whirlpool · KitchenAid · GE' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven', issues: 'Elements · Igniters · Calibration', brands: 'GE · Whirlpool · Samsung · Wolf · Viking' },
  { icon: '🔆', name: 'BBQ, Grill & Smoker Repair', slug: 'bbq', issues: 'Pellet cookers · Igniters · Acreage outdoor kitchens', brands: 'Traeger · Weber · Lynx · Fire Magic · Bull' },
  { icon: '❄️', name: 'Freezer Repair', slug: 'freezer', issues: 'Garage and workshop units · Summer heat alarms', brands: 'Frigidaire · GE · Whirlpool · Kenmore' },
