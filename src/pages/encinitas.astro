const communitiesNarrative = {
  eyebrow: 'FIVE COMMUNITIES, FIVE APPLIANCE POPULATIONS',
  headline: 'Old Encinitas, Leucadia, Cardiff, Olivenhain, Village Park',
  paragraphs: [
    "The city merged five real places, and the merge never flattened them. Each one still calls us about different machines failing in different ways."
