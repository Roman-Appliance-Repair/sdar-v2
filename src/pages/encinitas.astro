/**
 * Encinitas, CA — city pillar (San Diego Wave-1, Stage C).
 * Branch: San Diego — service_area (no public street address).
 *
 * Angle: five genuinely different communities under one city name — Old
 * Encinitas, Leucadia, Cardiff-by-the-Sea (92007), Olivenhain, New Encinitas /
 * Village Park. Brand mix honestly spans mass-market to built-in by pocket.
 * Olivenhain = the SECOND large-lot angle, deliberately NOT Rancho Santa Fe:
 * semi-rural, horsey, owner-run acreage — no gates, no estate managers.
 *
 * Positioning: $89 once; no factory-authorization implication; no tech names.
 * Zero-invention: Maytag 10-yr warranty framing (W1), Samsung UR unbalance
 * (W-FINAL), Traeger LEr low-temp code (O-1 OEM-verified), Frigidaire garage
 * false-alarm pattern (W-FINAL). No ReviewsBlock.
 */

import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
