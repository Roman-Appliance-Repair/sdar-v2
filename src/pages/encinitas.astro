import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
import { mergeCredentials } from '../data/credentials-schema';

const citySlug = 'encinitas';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Encinitas';
const zips = ['92024', '92007'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Encinitas CA — Same Day Service`;
const description = "Appliance repair in Encinitas & Cardiff — Leucadia, Olivenhain, Village Park. From surf-town bungalows to horse-country kitchens. $89 dx. (858) 667-7237.";
const canonical = 'https://samedayappliance.repair/encinitas/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.fullName,
  image: 'https://samedayappliance.repair/images/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Encinitas', sameAs: 'https://en.wikipedia.org/wiki/Encinitas,_California' },
    { '@type': 'Place', name: 'Leucadia' },
    { '@type': 'Place', name: 'Cardiff-by-the-Sea' },
    { '@type': 'Place', name: 'Olivenhain' },
    { '@type': 'Place', name: 'Village Park' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
  license: 'BHGS #A49573'
});

const introParagraphs = [
  "<strong>Encinitas is five towns wearing one name, and our San Diego technicians pack the truck accordingly: a Leucadia bungalow's twenty-year-old laundry pair, a Cardiff cottage's compact kitchen, an Olivenhain ranch property's outdoor cooker and garage freezer, and a Village Park tract home's sensor-driven Samsung all live within the same fifteen-minute drive. We service every one of those machines across 92024 and 92007. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Honesty about the brand mix, because it genuinely varies by pocket: Old Encinitas and Leucadia run on veteran mass-market machines — Whirlpool, Maytag, GE platforms that reward simple repairs and punish premature replacement. Cardiff and the newer coastal remodels mix in Bosch and KitchenAid. Village Park and New Encinitas skew toward recent LG and Samsung machines that flag their own faults on the display. And Olivenhain's larger properties add built-in refrigeration, serious outdoor cooking, and the occasional wine setup. No single sales pitch fits this city, so we don't bring one.",
  "Olivenhain deserves its own sentence, because it's large-lot country with none of the estate-belt machinery. There's no gate code and no house manager — there's an owner with acreage, horses down the trail, a workshop, a garage freezer doing real work, and an outdoor cooking setup that gets used hard. It's semi-rural self-reliance, and the service style matches: straight talk, one visit that covers the outbuildings while we're there, and honest math on machines that live in dusty, unconditioned spaces.",
  "The coastal pockets carry the corridor's usual physics — salt exposure near the water in Leucadia and Cardiff, hard imported water everywhere — but the failure profile here skews practical: hard-working family machines, surf-town towel loads, garage refrigerators that see summer heat. It's volume-market service with a few luxury pockets, and we're honest about which street is which.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for same-day service across 92024 and 92007 — and the rest of the <a href="/san-diego-county/">North Coastal corridor</a>.`
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Not cooling · Ice makers · Garage units · Built-ins in Olivenhain', brands: 'Whirlpool · GE · LG · Samsung · KitchenAid · Sub-Zero' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'Unbalance codes · Not draining · Surf-town towel loads', brands: 'Samsung · LG · Whirlpool · Maytag · GE' },
