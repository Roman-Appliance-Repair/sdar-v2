---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'temple-city';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Temple City";
const zips = ["91780"];

const phone = branch.phone;
const phoneRaw = `+1${phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Temple City CA — Same Day Service`;
const description = `Same-day appliance repair in Temple City, CA 91780. Samsung, LG, GE, Whirlpool, all brands. Licensed, OEM parts Weekends available.`;
const canonical = "https://samedayappliance.repair/temple-city/";

const localBusinessSchema = mergeCredentials({
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  name: branch.gbpName,
  image: "https://samedayappliance.repair/logo.webp",
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { "@type": "City", name: "Temple City", sameAs: "https://en.wikipedia.org/wiki/Temple_City,_California" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: "$$",

});

const introParagraphs = [
  "<strong>When an appliance fails in Temple City, our techs at Same Day Appliance Repair trace it to a handful of patterns: SGVMWD hard-water scale blocking LG ice maker inlet valves, mineral-clogged Samsung dishwasher spray arms, Whirlpool dryer thermal fuses blown from obstructed vent runs, and GE oven igniters glowing but not lighting. We dispatch same-day across the Live Oak Ave corridor, Las Tunas Drive, the Longden Ave neighborhood, and the Broadway corridor. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Temple City is one of the quieter, more residential cities in the San Gabriel Valley — predominantly single-family homes, well-maintained, family-oriented. The appliance calls here are straightforward: a refrigerator not cooling on Live Oak Avenue, a dishwasher leaving spots on Longden, a dryer that stopped heating on a Saturday morning before family plans. Nothing complicated about what you need — same-day, done right, transparent invoice.",
  "Hard water is a consistent factor. Temple City is served by the San Gabriel Valley Municipal Water District, drawing from the mineral-rich San Gabriel Valley groundwater basin. Ice maker inlet valves and dishwasher spray arms accumulate scale faster here than in softer-water cities. We test for this on every relevant Temple City call involving ice makers and dishwashers — it's a recurring pattern throughout the San Gabriel Valley, and Temple City is no exception.",
  "Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Available <strong>Saturdays and Sundays</strong>.",
  "<strong>Hard water tip for Temple City:</strong> SGVMWD groundwater accelerates mineral scale on refrigerator ice maker inlet valves and dishwasher spray arms. If your ice output has been declining gradually — not a sudden stop, but a slow decrease over months — the inlet valve is almost certainly the cause. Replacing your refrigerator's in-door filter every 6 months instead of 12 makes a meaningful difference in San Gabriel Valley hard water cities like Temple City."
];

// Commercial: written new — this page had no commercial prose. The only prior
// commercial material, where any existed, was an FAQ answer feeding FAQPage schema
// and therefore not liftable; nothing was moved.
const commercialParagraphs = [
  "Temple City's commercial kitchens are neighborhood kitchens — the Las Tunas Drive blocks, the Rosemead corridor, the bakeries, cafes and family restaurants that serve the people living two streets away. They are small operations, most of them owner-run, and the equipment is expected to last because replacing it is a real expense against a real margin. The city's water is the constant. Temple City draws the same mineral-heavy San Gabriel Valley supply as its neighbors, and on a commercial ice machine or a dish machine running all day that scale is not a slow nuisance — it is a measurable loss of production every week, and it is the reason behind a large share of the calls we get here. We treat the water path as part of the diagnosis on Temple City accounts rather than as an afterthought."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map — it does ICONS[e.icon] with no
// fallback, so a wrong key renders an empty <path> silently. Valid keys:
// snowflake, pizza-oven, fryer, oven, droplet, laundry.
const commercialEquipment = [
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// NO premium outdoor brand pills anywhere in wave 5: not one of these 28 pages names a
// single outdoor brand (Lynx/DCS/Twin Eagles/Alfresco/Coyote/Bull = 0 occurrences across
// the whole set). The $$$ pages have heavy premium evidence but all of it is indoor estate
// brands. Pills would assert an outdoor install base no page here claims. Pasadena precedent.
const outdoorParagraphs = [
  "Temple City's outdoor equipment fights the same water the kitchen inside does, and it fights it worse. The grills and patio setups here are ordinary and well kept — this is a city of tidy yards — but anything outside with a water line on it is running mineral-heavy San Gabriel Valley supply on a seasonal schedule, which is the exact combination that scales a valve shut. The water sits in the line all winter, the minerals settle out, and the outdoor ice maker or fridge dispenser that worked in September will not run in May. It presents as a dead unit and it is usually a blocked path. The grills have a simpler story: flat lots, no wind, no salt, and failures that are honestly just age and spiders in the venturis. Our techs check the water side first on anything plumbed here, and we tell Temple City owners the filter interval that actually applies to this water rather than the one in the manual."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Hard water ice maker · Not cooling · Fan motor · Temperature off', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Bosch' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Hard water spray arm · Not draining · Spots on glasses · Error codes', brands: 'Bosch · KitchenAid · Samsung · LG · GE · Miele' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'Hard water inlet screens · Not draining · Not spinning · Error codes', brands: 'LG · Samsung · Whirlpool · Maytag · Bosch · Speed Queen' },
  { icon: '♨️', name: 'Dryer Repair + Vent Cleaning', slug: 'dryer', issues: 'Not heating · Thermal fuse · Vent lint buildup · Gas & electric', brands: 'LG · Samsung · GE · Maytag · Whirlpool · Electrolux' },
  { icon: '🔥', name: 'Oven, Range & Stove', slug: 'oven', issues: 'Not heating · Gas igniter · Temperature off · Gas & electric', brands: 'GE · Samsung · Bosch · Wolf · Viking · KitchenAid' },
  { icon: '❄️', name: 'Freezer & Ice Maker Repair', slug: 'freezer', issues: 'Hard water inlet valve · Not freezing · Ice stopped · Frost', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Frigidaire' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler', issues: 'Temperature off · Compressor · Under-counter · Built-in', brands: 'True · U-Line · Liebherr · Dacor · Sub-Zero' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Igniter · Gas burner · Induction not heating · Hood motor', brands: 'GE · Bosch · Samsung · Wolf · Thermador · Broan' }
];

const neighborhoods = [
  { name: 'Live Oak Ave corridor', zip: '91780', featured: true },
  { name: 'Las Tunas Drive', zip: '91780', featured: true },
  { name: 'Longden Ave neighborhood', zip: '91780', featured: true },
  { name: 'Lower Azusa Rd area', zip: '91780' },
  { name: 'Broadway corridor', zip: '91780' },
  { name: 'North Temple City', zip: '91780' },
  { name: 'South Temple City', zip: '91780' }
];

const keyStreets = ['Live Oak Ave', 'Rosemead Blvd', 'Las Tunas Dr', 'Longden Ave', 'Lower Azusa Rd', 'Broadway'];

const recentJobs = [
  {
    appliance: 'LG Refrigerator',
    location: 'Live Oak Ave, 91780',
    quote: '"Ice maker slowed to almost nothing — maybe 6 cubes a day"',
    description: "LG French door on Live Oak — gradual ice decline over about four months, the consistent SGVMWD hard water pattern. Inlet valve orifice restricted to roughly 15% of normal capacity by mineral scale. Replaced the inlet valve with an OEM LG part, flushed the water line, replaced the in-door filter (16 months old). Full production within 24 hours. Explained the San Gabriel Valley water quality situation and set a 6-month filter calendar reminder. Owner hadn't realized the filter should be changed more than once a year with this water supply.",
    outcome: '✓ Same day · OEM LG inlet valve · San Gabriel Valley water explained · 6-month plan'
  },
  {
    appliance: 'Samsung Dishwasher',
    location: 'Longden Ave, 91780',
    quote: '"White film on glasses, smells a bit musty after cycles"',
    description: "Samsung DW80 — both spray arm ports blocked by SGVMWD mineral deposits, filter trap with significant scale buildup creating the musty odor. Descaled both spray arms completely, deep-cleaned the filter assembly, ran a full citric acid cycle. Showed the homeowner the extracted scale — both were surprised at the amount from just under two years of use. Confirmed full spray arm rotation and clean drain. Monthly maintenance tablet routine explained. Glasses came out clear from the first load.",
    outcome: '✓ Same day · Scale cleared · Odor gone · Maintenance routine set'
  },
  {
    appliance: 'Whirlpool Dryer',
    location: 'Las Tunas corridor, 91780',
    quote: '"No heat at all, clothes come out the same as they went in"',
    description: "Whirlpool electric dryer — thermal fuse blown from a partially obstructed vent run that terminated with a plastic flap vent cap partially folded inward. The cap had been that way for an unknown period — likely years. Replaced the thermal fuse, replaced the compromised plastic vent cap with a proper metal backdraft damper, confirmed strong airflow at the termination. Single-cycle drying from the first test load. Also inspected the heating element — still good, no replacement needed.",
    outcome: '✓ Same day · Thermal fuse · Metal vent cap installed · Single cycle'
  },
  {
    appliance: 'GE Range',
    location: 'Broadway area, 91780',
    quote: '"Oven igniter glowing but not lighting — been three weeks"',
    description: "GE freestanding range — oven igniter glowing orange but not drawing enough current to open the gas valve. This is the standard GE igniter failure mode: the element heats visually but is electrically weak. Standard repair: OEM GE igniter, roughly 25 minutes. Tested at 325°F, 375°F, and 450°F before leaving — accurate at all three. The homeowner had been convinced the issue was the gas valve itself. Explained the igniter amperage requirement — they were relieved it was a simpler fix.",
    outcome: '✓ Same day · OEM GE igniter · All temps confirmed · Cause explained'
  }
];

const whyReasons = [
  {
    iconKey: 'parts' as const,
    title: 'SGVMWD Hard Water',
    body: "San Gabriel Valley Municipal Water District groundwater accelerates mineral scale on ice makers and dishwashers throughout Temple City. We test inlet valves and check for deposits on every relevant call — it comes up regularly in 91780 and across the SGV."
  },
  {
    iconKey: 'clock' as const,
    title: 'Actually Same Day',
    body: 'Call before noon and we\'re typically there that afternoon. Temple City is a regular part of our San Gabriel Valley route from Pasadena — not a special trip. Same-day means same day, not "we\'ll try our best for next-day."'
  },
  {
    iconKey: 'team' as const,
    title: 'Weekends Available',
    body: 'Saturday Mon–Sat 8am–8pm · Sun closed · Phone answered 24/7. When your appliance breaks before a weekend with family plans, we\'re there. Not every Temple City appliance company offers weekend service — we do.'
  },
  {
    iconKey: 'shield' as const,
    title: '90-Day Warranty, OEM Only',
    body: 'Every repair backed by 90 days on parts and labor. Genuine OEM parts only — never aftermarket. $89 diagnostic waived with repair. Written estimate before we start. California licensed, BBB Accredited.'
  }
];

const testimonials = [
  {
    stars: 5,
    text: '"LG refrigerator had been barely making ice for months. Tech came to our Live Oak home, found the hard water mineral blockage right away, replaced the inlet valve, and explained the San Gabriel Valley water quality situation — I had no idea the filter needed changing every 6 months here. Full ice production by next morning. Very professional."',
    author: '— Kevin L., Live Oak Ave, Temple City'
  },
  {
    stars: 5,
    text: '"Samsung dishwasher leaving white film and smelling odd. Tech showed me the mineral scale on both spray arms — in less than two years. Cleared everything, gave me a monthly maintenance routine for our water quality. Completely clean and odor-free from the first load. This is the level of service I wanted."',
    author: '— Sandra T., Longden Ave, Temple City'
  },
  {
    stars: 5,
    text: '"GE oven igniter glowing but not lighting for three weeks. Called Same Day, tech came that afternoon, had the OEM GE igniter on the truck, done in 25 minutes. Tested all three temperatures before leaving. Explained why the igniter fails this way — genuinely helpful. Would recommend without any hesitation."',
    author: '— Patricia C., Broadway area, Temple City'
  }
];

const pricingTiers = [
  { appliance: 'Refrigerator / Ice Maker', range: '$150 – $400', note: 'SGVMWD hard water inlet valve · Fan motor · OEM parts', featured: true },
  { appliance: 'Dishwasher', range: '$150 – $320', note: 'Hard water descaling · Drain pump · Spray arm · Filter', featured: true },
  { appliance: 'Washer / Dryer', range: '$150 – $350', note: 'Drain pump · Thermal fuse · Vent cleaning · Gas & electric' },
  { appliance: 'Oven / Range', range: '$150 – $400', note: 'Gas igniter · Bake element · Temperature calibration' },
  { appliance: 'Sub-Zero / Wolf', range: '$300 – $700+', note: 'OEM parts only · Luxury brand expertise' },
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Waived when you proceed with the repair' }
];

const faqs = [
  {
    question: "Do you offer same-day appliance repair in Temple City, CA?",
    answer: "Yes. Our technicians cover all of Temple City 91780 — Live Oak Avenue, Rosemead Boulevard, Longden Avenue, Las Tunas Drive, Broadway, and every residential street in the city. Call before noon for same-day afternoon service."
  },
  {
    question: "Does hard water in Temple City affect appliances?",
    answer: "Yes. Temple City is served by the San Gabriel Valley Municipal Water District's mineral-rich groundwater. Ice maker inlet valves and dishwasher spray arms scale up faster than in softer-water cities. We check for this proactively on every relevant Temple City call."
  },
  {
    question: "Are you available on weekends in Temple City?",
    answer: "Yes. Saturday Mon–Sat 8am–8pm · Sun closed · Phone answered 24/7. If your appliance breaks on a weekend, you don't have to wait until Monday."
  },
  {
    question: "What appliance brands do you repair in Temple City?",
    answer: "All major brands: Samsung, LG, GE, Whirlpool, KitchenAid, Bosch, Maytag, Sub-Zero, Wolf, Viking, Thermador, and more. OEM parts on every vehicle."
  },
  {
    question: "What is your diagnostic fee in Temple City?",
    answer: "Our diagnostic fee is $89, waived when you proceed with the repair. Written estimate before we start. Most Temple City repairs run $150–$400."
  },
  {
    question: "What warranty do you offer on appliance repairs in Temple City?",
    answer: "All repairs come with a 90-day warranty on parts and labor. Genuine OEM parts only. If the same issue returns within 90 days, we come back at no charge."
  },
  {
    question: "Do you also serve Arcadia, San Gabriel, and Rosemead?",
    answer: "Yes. Our Temple City service extends to Arcadia, San Gabriel, Rosemead, El Monte, Alhambra, Monrovia, and South Pasadena. All within our regular San Gabriel Valley route."
  },
  {
    question: "What's the most common appliance repair our techs see in Temple City?",
    answer: "The most common Temple City calls our techs at Same Day Appliance Repair handle are SGVMWD hard-water failures — LG ice maker inlet valves scaled shut and Samsung dishwasher spray arms clogged with mineral deposits — alongside Whirlpool dryer thermal fuses blown by obstructed vent runs and GE oven igniters that glow but won't light. We test for mineral scale proactively on every relevant call. $89 residential diagnostic, waived with repair."
  },
  {
    question: "Are your Temple City appliance repairs licensed and insured?",
    answer: "Yes. Our techs at Same Day Appliance Repair are BHGS #A49573 registered, EPA 608 Universal certified (#1346255700410), and BBB Accredited, with a 90-day warranty on parts and labor for every Temple City repair in 91780. We give you a written estimate before we start and use genuine OEM parts only, never aftermarket. $89 residential diagnostic, waived with repair."
  }
];

const nearbyCities = [
  { name: 'Pasadena', slug: 'pasadena' },
  { name: 'Arcadia', slug: 'arcadia' },
  { name: 'Alhambra', slug: 'alhambra' },
  { name: 'Monrovia', slug: 'monrovia' },
  { name: 'South Pasadena', slug: 'south-pasadena' },
  { name: 'San Marino', slug: 'san-marino' },
  { name: 'Glendale', slug: 'glendale' },
  { name: 'Los Angeles', slug: 'los-angeles' }
];
---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Temple City, CA"
    subheadline="Quiet, family-oriented San Gabriel Valley community with well-kept homes — and appliances that need the same care. Samsung, LG, GE, Whirlpool, Sub-Zero, all brands. Same-day service, OEM parts, 90-day warranty. Weekends available."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Temple City — Straightforward and Same Day"
    paragraphs={introParagraphs}
    bookingTitle="Temple City Service Team"
    bookingSub="91780 · Same day · Weekends ok"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Temple City"
    subhead="All brands · SGVMWD hard water aware · Single-family homes · 91780"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Temple City Commercial Kitchen Service"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Temple City Patios and the Scale You Cannot See"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="All of Temple City — 91780"
    subheadline="Every neighborhood and street in the city"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={keyStreets}
    bgImage="/images/cities/temple-city/neighborhood.webp"
  />

  <RecentRepairs
    citySlug={citySlug}
    cityName={cityName}
    headline="Recent Jobs in Temple City"
    subhead="Real calls from 91780 — single-family homes, SGVMWD hard water, weekend service."
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Temple City Calls Us Back"
    reasons={whyReasons}
  />

  <ReviewsBlock
    cityName={cityName}
    headline="What Temple City Customers Are Saying"
    testimonials={testimonials}
  />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in Temple City"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions Temple City Customers Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    nearbyCities={nearbyCities}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance broken in Temple City?"
    body="SGVMWD hard water specialists · All brands · Weekends available. 91780. $89 diagnostic waived with repair. 90-day warranty. OEM parts."
  />
</CityLayoutV2>
