---
// src/pages/marine/refrigeration-repair.astro
// Marine refrigeration pillar. $120 marine diagnostic, waived with repair. No repair prices.
// Secop BD35F/BD50F LED codes: only 1/2/3/5 flashes (two Secop-derived sources agree; 4 disputed, omitted).
// Geo-neutral schema per docs/seo-policies.md. BreadcrumbList from Breadcrumbs.astro. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/marine/refrigeration-repair/";

const title = "Marine Refrigeration Repair Los Angeles — Same Day";
const description = "Boat refrigerator and freezer repair: Secop BD35F/BD50F flash codes, low-voltage cut-out, seawater and keel cooling, salt corrosion. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const TRUST = [
  '🏅 BHGS #A49573',
  '❄️ EPA 608 Universal',
  '🔋 12/24 V DC Systems',
  '⚓ We Come to the Slip',
  '💬 $120 Diagnostic — Waived With Repair'
];

const faqs = [
  {
    q: "What do the flashing lights on my boat fridge's compressor module mean?",
    a: "On Danfoss/Secop BD35F and BD50F electronic units, a diagnostic LED wired to the module flashes a fault code. One flash is the battery protection cut-out, two is fan over-current, three is a motor start error, and five means the electronics overheated. The sequence repeats every few seconds. Count the flashes and tell us the number when you call."
  },
  {
    q: "My fridge works on shore power but dies at anchor. Why?",
    a: "Usually the battery bank. On shore power a charger holds battery voltage up; at anchor the bank sags, and when voltage at the compressor module drops below its cut-out, the module stops the compressor to protect the battery. Undersized or corroded DC cables make the drop worse. We measure voltage at the module while the compressor runs before touching the refrigeration side."
  },
  {
    q: "Can salt air really kill a boat refrigerator?",
    a: "Over time, yes. Aluminum evaporators pit and eventually leak refrigerant, terminals corrode and start dropping voltage, and electrolysis attacks metals in seawater cooling circuits. Our techs check terminals and connections on every marine refrigeration call, because corrosion is behind a lot of intermittent faults."
  },
  {
    q: "Do you repair Vitrifrigo, Isotherm, Nova Kool and Dometic refrigerators?",
    a: "Yes, along with U-Line marine models and other units built around DC compressors. We work as an independent service, not a factory-authorized one, and we'll tell you if a repair needs the manufacturer's own network. Refrigerant work is covered by our EPA 608 Universal certification, #1346255700410."
  },
  {
    q: "How much does a marine refrigeration diagnostic cost?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't quote repair prices before seeing the system, because a module, a seawater pump and a leaking evaporator are very different jobs on a boat."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Marine Refrigeration Repair",
    "name": "Marine Refrigerator and Freezer Repair",
    "url": canonical,
    "description": "Repair of boat refrigerators and freezers at the slip: 12/24 V DC compressor systems (Danfoss/Secop BD35F, BD50F) and their electronic control modules, low-voltage cut-out diagnosis, air-cooled, seawater-cooled and keel-cooled condensers, salt corrosion, and EPA 608 Universal sealed-system work.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="refrigeration-repair"
  eyebrow="Marine · Boat Refrigerators & Freezers · 12/24 V DC"
  title="Marine Refrigeration Repair Los Angeles"
  subtitle="Boat fridge warm, freezer soft, compressor module flashing? We start with the battery and the flash code, then the cooling loop. $120 diagnostic, waived with repair."
  heroImageTitle="Marine Refrigeration Repair"
  trustBarItems={TRUST}
  showBranches={true}
/>

<!-- 01 WHERE TO START -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · Where to start</p>
    <h2 class="section-title">A warm boat fridge is often a battery problem wearing a refrigerator costume.</h2>

    <p>Boat refrigeration calls come in with the same line: the fridge died. Sometimes it did. More often the refrigerator is fine and something upstream of it isn't. A lot of marine boxes run on a small 12 or 24 volt DC compressor fed from the house battery bank, and that compressor has its own control module watching the power. When the power goes bad, the module shuts everything down on purpose. This page is part of our <a href="/marine/">marine appliance repair</a> service.</p>

    <p>So our techs work it in a fixed order: read the fault code if there is one, measure the power at the module under load, check the condenser cooling, then look at the sealed system. Pulling a compressor off a boat is slow and expensive work. It should be the last answer, not the first guess.</p>
  </div>
</section>

<!-- 02 FLASH CODES -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · Flash codes</p>
    <h2 class="section-title">Danfoss/Secop BD35F and BD50F: count the flashes.</h2>

    <p>Much of the marine refrigeration in Southern California harbors is built around Danfoss/Secop BD35F and BD50F compressors. Their electronic unit can drive a diagnostic LED. When the unit records an operational error, the LED flashes a set number of times, pauses, and repeats, so the count is the diagnosis. Not every installer wires the LED in, and where it's missing we connect one during the diagnostic.</p>

    <div class="table-wrap">
      <table class="code-table">
        <thead><tr><th>Flashes</th><th>What the module is saying</th><th>Where we look</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Battery protection cut-out</td><td>Voltage at the module under load, battery bank, DC cable size and connections</td></tr>
          <tr><td>2</td><td>Fan over-current</td><td>Condenser fan and its wiring</td></tr>
          <tr><td>3</td><td>Motor start error</td><td>Compressor start, the electronic unit, what the compressor is fighting</td></tr>
          <tr><td>5</td><td>Electronics overheated</td><td>Heat around the module, condenser cooling, how hard the system is working</td></tr>
        </tbody>
      </table>
    </div>

    <p>A code narrows the search. It doesn't close it. Three flashes can be a failing electronic unit or a compressor that genuinely won't start, and a five-flash module is often a module doing its job in a hot, badly ventilated locker. Our techs confirm with a meter before recommending a part.</p>
  </div>
</section>

<!-- 03 LOW VOLTAGE -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Low-voltage cut-out</p>
    <h2 class="section-title">The one-flash call: the fridge is protecting your batteries.</h2>

    <p>The battery protection cut-out is the most common reason a boat refrigerator "dies". A house bank that has aged, or that's been drawn down overnight at anchor, sags when the compressor starts. The module sees voltage fall below its cut-out, around 10.4 volts on a 12 volt system at the default setting, and stops the compressor until voltage recovers. On shore power the charger hides the problem, which is why owners so often say it only happens away from the dock.</p>

    <p>Voltage at the battery isn't the number that matters. Voltage at the module is. Long DC runs, undersized cable and corroded terminals all lose voltage on the way, and on a boat that loss grows every season. That's why our diagnostic starts with a meter on the module terminals while the compressor is trying to run. It's the same logic we use on food trucks running on generator power: measure the power under real load before blaming the appliance.</p>

    <div class="callout">
      <p>If the bank itself is the problem, that's work for your marine electrician or battery installer. We'll show you the readings so the fix happens on the right side of the line.</p>
    </div>
  </div>
</section>

<!-- 04 CONDENSER COOLING -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · Condenser cooling</p>
    <h2 class="section-title">Air, seawater or keel cooler: how the heat leaves decides where we search.</h2>

    <p>Every refrigerator has to get rid of the heat it pulls out of the box. On a boat there are three common ways to do it, and each fails differently.</p>

    <h3 class="series-h3">Air-cooled</h3>
    <p>A fan pushes cabin air across the condenser. Tucked into a hot locker with no fresh air, the system runs long and the electronics run hot. Dust and lint on the fins make it worse.</p>

    <h3 class="series-h3">Water-cooled</h3>
    <p>A seawater pump pushes water through a heat exchanger. A clogged strainer, a pump that quit or marine growth inside the exchanger all cut the flow, and the compressor runs hot and long. We check flow before we suspect refrigerant.</p>

    <h3 class="series-h3">Keel cooler</h3>
    <p>The condenser heat goes into a plate or loop in contact with the water outside the hull, with no pump. Growth on the outside of the plate slows the transfer. Where the keel cooler itself needs attention from outside the hull, that's boatyard work.</p>
  </div>
</section>

<!-- 05 SALT -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">05 · Salt</p>
    <h2 class="section-title">What salt air does to marine refrigeration.</h2>

    <ul class="bullet-list">
      <li><strong>Aluminum evaporators</strong> pit over time, and pits become refrigerant leaks.</li>
      <li><strong>Terminals and connectors</strong> corrode, add resistance and drop voltage, which feeds straight back into low-voltage cut-outs.</li>
      <li><strong>Electrolysis</strong> attacks metals in seawater cooling circuits where dissimilar metals meet.</li>
    </ul>

    <p>When a system has lost refrigerant, we find the leak and repair it before recharging. Opening the sealed system is covered by our EPA 608 Universal certification, #1346255700410. A top-off without a repair only schedules the next trip down the dock.</p>
  </div>
</section>

<!-- 06 BRANDS AND VISIT -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06 · Brands and the visit</p>
    <h2 class="section-title">The boxes we see, and how a visit works.</h2>

    <p>We work on Vitrifrigo, Isotherm (Indel Webasto Marine), Nova Kool, Dometic and U-Line marine models, plus custom boxes built around DC compressors. We're an independent service, not factory-authorized for any of these brands.</p>

    <p>Send the marina, slip number and gate access when you book, and make sure the owner, captain or crew is aboard. A photo of the data plate and, if the LED is flashing, the number of flashes help us bring the right parts down the dock. The diagnostic is $120 and it's waived when you approve the repair; after that you get a written estimate. If the boat's air conditioning is acting up too, the seawater loop is often the shared cause; see <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a>.</p>
  </div>
</section>

<!-- 07 FAQ -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">07 · FAQ</p>
    <h2 class="section-title">Marine refrigeration questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 08 RELATED -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08 · Related</p>
    <h2 class="section-title">More marine service.</h2>
    <ul class="related-list">
      <li><a href="/marine/">Marine appliance repair (all equipment)</a></li>
      <li><a href="/marine/air-conditioning-repair/">Marine air conditioning repair</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Boat fridge warm? Call now.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
