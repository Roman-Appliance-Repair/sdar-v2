---
// src/pages/marine/air-conditioning-repair.astro
// Marine air conditioning pillar. $120 marine diagnostic, waived with repair. No repair prices.
// Credentials in play: CSLB C-20 HVAC + EPA 608 Universal #1346255700410. No ABYC / factory claims.
// Geo-neutral schema per docs/seo-policies.md. BreadcrumbList from Breadcrumbs.astro. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/marine/air-conditioning-repair/";

const title = "Marine Air Conditioning Repair Los Angeles — Same Day";
const description = "Boat AC repair: self-contained units and chilled-water systems, high-pressure trips, seawater strainers, condensate. CSLB C-20, EPA 608. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const TRUST = [
  '🔧 CSLB C-20 HVAC',
  '❄️ EPA 608 Universal',
  '🏅 BHGS #A49573',
  '⚓ We Come to the Slip',
  '💬 $120 Diagnostic — Waived With Repair'
];

const faqs = [
  {
    q: "Why does my boat's air conditioner shut down on high pressure?",
    a: "Because the heat has nowhere to go. A marine AC unit dumps cabin heat into seawater, and when the sea strainer is clogged, the condenser coil is fouled with growth or the raw-water pump isn't moving enough water, head pressure climbs until the unit shuts itself off. We check seawater flow through the loop before we look at refrigerant."
  },
  {
    q: "What's the difference between a self-contained unit and a chilled-water system?",
    a: "A self-contained unit has the compressor, coils and blower in one box, usually under a berth or settee, cooling one area. A chilled-water system uses a chiller to cool a water loop that runs to air handlers around the boat, which is common on larger yachts. Both use seawater to reject heat, so the raw-water side matters on either one."
  },
  {
    q: "There's water under my AC unit. Is it leaking refrigerant?",
    a: "Almost never. Water under a marine AC unit is condensate: the drain pan is blocked, the drain line is kinked or the condensate pump has failed. Left alone it ends up in the bilge or the cabin. Refrigerant leaks don't make puddles; they show up as a unit that runs but doesn't cool."
  },
  {
    q: "Are you licensed to work on marine air conditioning refrigerant?",
    a: "Yes. Opening a refrigerant circuit requires EPA 608 certification, and ours is Universal #1346255700410. We also hold a CSLB C-20 HVAC license and BHGS #A49573. We don't hold ABYC certification and we don't work on the boat's electrical system; that belongs to a marine electrician."
  },
  {
    q: "How much is a marine AC diagnostic?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish repair prices for marine AC, because a packed strainer and a failed compressor on a chilled-water system are very different jobs."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Marine Air Conditioning Repair",
    "name": "Marine Air Conditioning and Chiller Repair",
    "url": canonical,
    "description": "Repair of self-contained marine air conditioning units and chilled-water systems at the slip: high-pressure shutdowns and seawater loop diagnosis (strainers, raw-water pumps, fouled condensers), condensate pans and pumps, digital controls, and EPA 608 Universal refrigerant work under a CSLB C-20 HVAC license.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="air-conditioning-repair"
  eyebrow="Marine · Boat AC & Chillers · CSLB C-20 · EPA 608"
  title="Marine Air Conditioning Repair Los Angeles"
  subtitle="AC tripping on high pressure, blowing warm or dripping into the cabin? We check the seawater loop first, then the refrigeration. $120 diagnostic, waived with repair."
  heroImageTitle="Marine Air Conditioning Repair"
  trustBarItems={TRUST}
  showBranches={true}
/>

<!-- 01 SYSTEMS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The systems</p>
    <h2 class="section-title">Two kinds of marine air conditioning, one shared weak spot.</h2>

    <p>A boat in a Southern California slip on an August afternoon needs its air conditioning more than its owner wants to admit. Marine AC comes in two main designs, and our techs diagnose them differently. This page is part of our <a href="/marine/">marine appliance repair</a> service.</p>

    <h3 class="series-h3">Self-contained units</h3>
    <p>Compressor, coils and blower in one package, usually tucked under a berth, a settee or in a locker, with ducting to the cabin. Smaller boats often run one or two of these, one per zone.</p>

    <h3 class="series-h3">Chilled-water systems</h3>
    <p>On larger yachts a chiller cools a loop of water that runs to air handlers throughout the boat. One refrigeration plant, many air handlers, more pumps and more controls to go wrong.</p>

    <p>We see Dometic equipment, including its Cruisair and Marine Air lines, and Webasto systems. We repair them as an independent service; we're not factory-authorized for any marine AC brand. What both designs share is the way heat leaves the boat: through seawater. That's where most calls end up.</p>
  </div>
</section>

<!-- 02 HIGH PRESSURE -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · High-pressure shutdown</p>
    <h2 class="section-title">High pressure is almost always the seawater side.</h2>

    <p>A marine AC unit pulls heat out of the cabin and hands it to seawater moving through the condenser. When that water slows down, the heat stays in the refrigerant, head pressure climbs, and the unit shuts off to protect itself. From the cabin it looks like the air conditioner randomly quits, often on the hottest afternoon. Our techs work the raw-water loop in order:</p>

    <ol class="num-list">
      <li><strong>Sea strainer.</strong> Packed with growth, shell or debris, it starves the whole loop. It's the first thing we open.</li>
      <li><strong>Water flow at the discharge.</strong> A weak or absent stream overboard confirms the loop isn't moving enough water.</li>
      <li><strong>Raw-water pump.</strong> A pump that lost its prime, has a worn impeller or has stopped outright gives the same symptom as a clogged strainer.</li>
      <li><strong>Condenser coil.</strong> Marine growth and scale inside the coil cut heat transfer even with good flow.</li>
      <li><strong>Refrigeration side.</strong> Only after the water side checks out do we put gauges on the refrigerant circuit.</li>
    </ol>

    <p>The seacock and the through-hull fitting at the start of that loop aren't ours. If the problem is at the hull, that's boatyard or marine mechanic work, and we'll say so before anyone goes further.</p>
  </div>
</section>

<!-- 03 COOLING POORLY -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Running but not cooling</p>
    <h2 class="section-title">When it runs all day and the cabin stays warm.</h2>

    <p>A unit that runs without tripping but never gets the cabin cool usually has an airflow or refrigerant problem. Clogged return filters and blocked ducting starve the evaporator, which can ice over and cool even less. Low refrigerant from a leak shows up the same way. Salt air speeds up corrosion on coils and fittings, and pinhole leaks follow.</p>

    <p>When refrigerant is low, we find and repair the leak before recharging. Opening a refrigerant circuit takes EPA 608 certification, and ours is Universal #1346255700410. We also hold a CSLB C-20 HVAC license. On a boat these aren't wall decorations; they're what makes a sealed-system repair legitimate.</p>
  </div>
</section>

<!-- 04 CONDENSATE -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · Condensate</p>
    <h2 class="section-title">Water where it shouldn't be: pans, drains and condensate pumps.</h2>

    <p>Every air conditioner pulls water out of the air. On a boat that water collects in a drain pan and leaves by gravity or through a condensate pump. When the pan drain clogs, the line kinks or the pump fails, water overflows into the locker, the bilge or the cabin sole. Standing water in the pan also breeds the smell people blame on "the AC".</p>

    <p>We clear and flush the drain path, test the condensate pump and its float switch, and check that the pan actually drains before we leave. It's routine work, but a failed condensate pump left alone can soak cabinetry and wiring.</p>
  </div>
</section>

<!-- 05 CONTROLS AND POWER -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">05 · Controls and power</p>
    <h2 class="section-title">Digital controllers, sensors and the power behind them.</h2>

    <p>Modern marine AC runs through digital controllers with temperature sensors and fault displays. A failed sensor or a controller that lost its settings can look like a dead unit. We read the controller's fault history where it has one and test sensors before replacing boards.</p>

    <p>Power matters too. A compressor start pulls far more current than the running load, and on a generator or an inverter that start can sag voltage enough to trip the unit or stall it. We measure voltage, frequency and polarity at the unit. If the problem is in the boat's own electrical system, the panel or the shore power inlet, the fix belongs to a marine electrician working to ABYC standards, and we'll hand over the readings.</p>
  </div>
</section>

<!-- 06 VISIT -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06 · The visit</p>
    <h2 class="section-title">How a marine AC call works.</h2>

    <p>Tell us the marina, slip number and how to get through the gate, and make sure the owner, captain or crew is aboard. Let us know whether it's a self-contained unit or a chilled-water system, and send a photo of the data plate and any code on the controller. Everything we bring goes down the dock by hand, so good information saves a second trip.</p>

    <p>The diagnostic is $120 and it's waived when you approve the repair. After that you get a written estimate before any part is ordered. If the boat's refrigerator is struggling too, check whether it shares the seawater loop; see <a href="/marine/refrigeration-repair/">marine refrigeration repair</a>.</p>
  </div>
</section>

<!-- 07 FAQ -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">07 · FAQ</p>
    <h2 class="section-title">Marine air conditioning questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 08 RELATED -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08 · Related</p>
    <h2 class="section-title">More marine service.</h2>
    <ul class="related-list">
      <li><a href="/marine/">Marine appliance repair (all equipment)</a></li>
      <li><a href="/marine/refrigeration-repair/">Marine refrigeration repair</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Boat AC tripping? Call now.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
