---
// src/pages/marine/san-diego.astro
// Marine geo page (wave 2). Single LocalBusiness of the San Diego branch (resolved straight from
// branches.ts — see below), NO location array (docs/seo-policies.md §1 п.6). City-level address,
// no streetAddress. Harbor facts from open sources only: Shelter Island and Harbor Island are
// man-made, built up from bay dredging material; tidelands administered by the San Diego Unified
// Port District; America's Cup Harbor on Point Loma; Coronado across the bay. NO slip counts
// (unverified). $120 marine diagnostic. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES } from '../../data/branches';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

// City of San Diego proper is deliberately absent from cities.ts (Wave 2, see the header
// comment there), so we resolve the branch directly instead of going through getCityBySlug.
const branch = BRANCHES.find((b) => b.slug === 'san-diego')!;
const phone = branch.phone;
const phoneHref = `tel:+1${branch.phone.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/marine/san-diego/";
const PLACE = "San Diego";

const title = "Boat Appliance Repair San Diego — Same Day";
const description = "Boat appliance repair at the slip in San Diego: Shelter Island, Harbor Island and Coronado. Marine refrigeration, AC, ice and galley. $120 diagnostic.";

const faqs = [
  {
    q: "Which San Diego marinas do you cover?",
    a: "We work at the slip around the bay: Shelter Island and America's Cup Harbor on Point Loma, Harbor Island, the downtown and Embarcadero marinas, and across the bay in Coronado. Visits are dispatched from our San Diego branch and phones are answered 24/7. Tell us the marina, dock and slip number when you book."
  },
  {
    q: "Do you service liveaboards?",
    a: "Yes, and it usually makes the visit easier because someone is already aboard. A liveaboard's refrigeration and laundry run every day of the year rather than on weekends, so they wear like household appliances and fail like them. Tell us when the boat is occupied and which appliance is down so we can keep the galley out of action as briefly as possible."
  },
  {
    q: "The Navy and commercial traffic make the bay busy. Does that change anything for a service call?",
    a: "Only in getting to you. Access around the bay varies by marina and some areas have their own security arrangements, so the gate code or a name to meet the tech matters more here than in a small harbor. Once we're aboard the work is the same as anywhere else."
  },
  {
    q: "My boat's air conditioning trips after a few weeks at the dock. Why?",
    a: "Growth in the raw-water loop. Marine AC rejects cabin heat into seawater, and warm bay water grows things in a sea strainer and on a condenser surprisingly fast. Flow drops, head pressure climbs and the unit shuts itself down. We check the strainer, the raw-water pump and the condenser before touching the refrigerant side."
  },
  {
    q: "How much does a boat appliance diagnostic cost in San Diego?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish marine repair prices, because access and installation vary so much from boat to boat."
  }
];

const business = mergeCredentials({
  ...buildBranchLocation(branch),
  "@context": "https://schema.org",
  "@id": canonical + "#business",
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": PLACE, "addressRegion": "CA", "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": PLACE },
  "openingHoursSpecification": OPENING_HOURS_SCHEMA
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Appliance Repair",
    "name": "Boat Appliance Repair in San Diego",
    "url": canonical,
    "description": "At-the-slip repair of marine refrigerators and freezers, ice makers, marine air conditioning, washer-dryer combos and galley appliances on boats in San Diego Bay, including Shelter Island, Harbor Island, the Embarcadero and Coronado.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": { "@type": "City", "name": PLACE },
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];

const TRUST = [
  '⚓ At the Slip in San Diego Bay',
  '❄️ EPA 608 Universal',
  '🔧 CSLB C-20 HVAC',
  '🏅 BHGS #A49573',
  '💬 $120 Diagnostic — Waived With Repair'
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="san-diego"
  imageAlt="Boat appliance repair in San Diego CA — San Diego Bay"
  eyebrow="Marine · San Diego Bay · Shelter Island · Coronado"
  title="Boat Appliance Repair San Diego"
  subtitle="Shelter Island, Harbor Island, the Embarcadero, Coronado. Marine refrigeration, boat AC, ice and galley, at the slip. $120 diagnostic, waived with repair."
  phone={phone}
  phoneHref={phoneHref}
  heroImageTitle="Boat Appliance Repair San Diego"
  heroImageLocation="San Diego"
  trustBarItems={TRUST}
  showBranches={false}
/>

<!-- 01 THE BAY -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The bay</p>
    <h2 class="section-title">Two of San Diego's best-known boating addresses were built out of the bay itself.</h2>

    <p>Shelter Island and Harbor Island look like natural features and aren't. Both were built up from material dredged out of San Diego Bay, turned into land, and then lined with marinas, yacht clubs and the trades that serve them. The tidelands around the bay are administered by the San Diego Unified Port District, and the result is a boating district with an unusual range packed into a few miles of shoreline: America's Cup Harbor and the sportfishing fleet on Point Loma, big motoryachts off Harbor Island, downtown marinas under the Embarcadero, and quieter slips across the water in Coronado.</p>

    <p>That range is what shapes our calls here. A sportfisher needs ice and refrigeration working before a trip. A liveaboard downtown runs a galley and a washer-dryer combo every day of the year. A cruiser at Harbor Island has a full built-in kitchen aboard. Visits are dispatched from our San Diego branch, and this page is part of our <a href="/marine/">marine appliance repair</a> service. For appliance repair in homes ashore, see our <a href="/san-diego-county/">San Diego County</a> page.</p>
  </div>
</section>

<!-- 02 WHAT BREAKS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · What we see here</p>
    <h2 class="section-title">The calls that come off these docks.</h2>

    <h3 class="series-h3">Air conditioning that trips</h3>
    <p>The most common San Diego call in warm months. Marine AC rejects cabin heat into seawater, and a bay that stays warm grows things in a sea strainer and on a condenser quickly. Flow falls, pressure climbs, the unit shuts down. We work the raw-water loop first — strainer, pump, heat exchanger — and refrigerant work is covered by our EPA 608 Universal certification. Detail on our <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a> page.</p>

    <h3 class="series-h3">Refrigeration that quits away from the dock</h3>
    <p>Boat boxes running on 12 or 24 volt compressors have a control module that cuts out when battery voltage sags, which is why a fridge that's fine on shore power dies at anchor or on a long day out. We measure voltage at the module under load first. See <a href="/marine/refrigeration-repair/">marine refrigeration repair</a>.</p>

    <h3 class="series-h3">Ice before a trip</h3>
    <p>On the sportfishing fleet the ice maker is working equipment, not a convenience. Thin cubes and a bin that won't fill are nearly always water supply or a hot locker rather than refrigerant. See <a href="/marine/ice-maker-repair/">marine ice maker repair</a>.</p>

    <h3 class="series-h3">Full galleys on the bigger boats</h3>
    <p>Above roughly 60 feet, the galley is a household kitchen — Sub-Zero drawers, a Miele or Bosch dishwasher, a wine column, compact laundry. That's our <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a> work, and it's the same equipment our techs service in San Diego homes every day. Laundry specifically is covered on our <a href="/marine/washer-dryer-repair/">boat washer dryer repair</a> page.</p>
  </div>
</section>

<!-- 02b LIVEABOARDS AND CHARTER -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Boats that are used every day</p>
    <h2 class="section-title">San Diego has more boats being lived on and worked from than any harbor we cover.</h2>

    <p>That changes the failure pattern. A weekend boat's appliances get light duty and long rests; a liveaboard's refrigerator, galley and washer-dryer combo run every day of the year, and a charter or sportfishing operation puts its ice maker and refrigeration under load on a schedule. Equipment used like that wears like household equipment and fails like it — parts reach the end of their service life rather than dying of neglect.</p>

    <p>It also raises what a day of downtime costs. When a charter has trips booked back to back, a refrigerator that quit isn't an inconvenience, it's a cancelled trip; the same is true of ice on a boat that runs long-range. So we ask, when you book, whether the boat is working and when it next goes out. It changes how we schedule and what the tech carries down the dock, and it's the difference between a repair that fits between trips and one that costs you one.</p>

    <p>The upside of a boat that's occupied is access. Someone is already aboard, the gate isn't an obstacle, and the crew can tell the tech exactly what the machine has been doing for the past week — which is usually worth more than anything a fault code says.</p>
  </div>
</section>

<!-- 03 ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">04 · Getting us to the boat</p>
    <h2 class="section-title">Gate codes, slip numbers and someone aboard.</h2>

    <p>San Diego Bay has more separate marinas, and more separate access arrangements, than any other harbor we cover. Getting this right is most of the battle.</p>

    <ol class="num-list">
      <li><strong>Where exactly.</strong> Marina name first — "Shelter Island" covers a lot of docks — then dock and slip number.</li>
      <li><strong>How to get through the gate.</strong> The gate code, or who meets the tech and when. Some areas around the bay have their own security arrangements.</li>
      <li><strong>Someone aboard.</strong> The owner, captain or a crew member has to be on the boat for the visit. We don't board an unattended vessel.</li>
      <li><strong>What we're walking into.</strong> A photo of the data plate, and the flash count if a refrigeration module LED is blinking.</li>
    </ol>

    <p>Tools and parts go down the dock by hand, so the first trip is planned around what you tell us. The diagnostic is $120 and it's waived when you approve the repair; the written estimate comes before any part is ordered.</p>

    <div class="callout">
      <p>We work on the appliance side. Shore power, the boat's electrical panel and wiring go to a marine electrician working to ABYC standards; seacocks, through-hulls and haul-out work go to a boatyard.</p>
    </div>
  </div>
</section>

<!-- 04 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">05 · FAQ</p>
    <h2 class="section-title">Boat appliance repair in San Diego, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Appliance down on the boat? Call our San Diego branch.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
