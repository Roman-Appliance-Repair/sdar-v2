---
// src/pages/marine/santa-barbara.astro
// Marine geo page (wave 2). Single LocalBusiness of the primary branch from cities.ts
// (santa-barbara → santa-barbara), NO location array (docs/seo-policies.md §1 п.6). City-level
// address, no streetAddress. Harbor facts from open sources only: harbor run by the City of Santa
// Barbara Waterfront Department; sand moving along the coast shoals the harbor entrance, so it is
// dredged regularly; Stearns Wharf adjoins the waterfront. NO slip counts (unverified).
// $120 marine diagnostic. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES } from '../../data/branches';
import { getCityBySlug } from '../../data/cities';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const city = getCityBySlug('santa-barbara')!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;
const phone = branch.phone;
const phoneHref = `tel:+1${branch.phone.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/marine/santa-barbara/";
const PLACE = "Santa Barbara";

const title = "Boat Appliance Repair Santa Barbara — Same Day";
const description = "Boat appliance repair at the slip in Santa Barbara Harbor: marine refrigeration, boat AC, ice makers, galley and laundry. $120 diagnostic.";

const faqs = [
  {
    q: "Do you come to boats in Santa Barbara Harbor?",
    a: "Yes. We work at the slip in Santa Barbara, dispatched from our Santa Barbara branch, and phones are answered 24/7. Same-day service is available when the schedule allows. Send the dock and slip number plus gate access when you book, and have someone aboard for the visit."
  },
  {
    q: "Our boat crosses to the Channel Islands regularly. What should we check before a trip?",
    a: "The three things that strand people: battery voltage under load, because that's what shuts down a DC refrigeration module away from the dock; the sea strainer, because a partly blocked one will trip the air conditioning on the first warm afternoon; and the ice maker's water supply. All three are cheaper to sort at the dock than to discover at anchor."
  },
  {
    q: "Does the harbor dredging affect service visits?",
    a: "Not the work itself. Sand moves along this coast and shoals the harbor entrance, so dredging is a regular part of life here and equipment moves around the harbor while it happens. It can change where a tech parks and which gate is easiest, so tell us the current arrangement when you book."
  },
  {
    q: "My boat fridge is warm after it sat for a few weeks. Is the refrigeration dead?",
    a: "Usually not. Most marine boxes run on a 12 or 24 volt compressor whose control module cuts out when battery voltage drops below its threshold, protecting the bank. A boat that sat has a sagging bank, so the module stops the compressor and the box goes warm. We measure voltage at the module while the compressor tries to run before looking at the refrigeration side at all."
  },
  {
    q: "How much does a boat appliance diagnostic cost in Santa Barbara?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish marine repair prices, because access and installation vary so much from boat to boat."
  }
];

const business = mergeCredentials({
  ...buildBranchLocation(branch),
  "@context": "https://schema.org",
  "@id": canonical + "#business",
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": PLACE, "addressRegion": "CA", "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": PLACE },
  "openingHoursSpecification": OPENING_HOURS_SCHEMA
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Appliance Repair",
    "name": "Boat Appliance Repair in Santa Barbara",
    "url": canonical,
    "description": "At-the-slip repair of marine refrigerators and freezers, ice makers, marine air conditioning, washer-dryer combos and galley appliances on boats in Santa Barbara Harbor, including cruisers, sailboats and motoryachts working the Channel Islands.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": { "@type": "City", "name": PLACE },
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];

const TRUST = [
  '⚓ At the Slip in Santa Barbara Harbor',
  '❄️ EPA 608 Universal',
  '🔧 CSLB C-20 HVAC',
  '🏅 BHGS #A49573',
  '💬 $120 Diagnostic — Waived With Repair'
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="santa-barbara"
  eyebrow="Marine · Santa Barbara Harbor · Channel Islands · Same Day"
  title="Boat Appliance Repair Santa Barbara"
  subtitle="Refrigeration, boat AC, ice and galley appliances, repaired at the slip in Santa Barbara Harbor. $120 diagnostic, waived with repair."
  phone={phone}
  phoneHref={phoneHref}
  heroImageTitle="Boat Appliance Repair Santa Barbara"
  heroImageLocation="Santa Barbara"
  trustBarItems={TRUST}
  showBranches={false}
/>

<!-- 01 THE HARBOR -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The harbor</p>
    <h2 class="section-title">A working harbor that the coast keeps trying to fill in.</h2>

    <p>Santa Barbara Harbor is run by the city's Waterfront Department, and it has a problem most harbors don't: sand. Sediment moves steadily along this coast, piles up against the breakwater and shoals the entrance, so dredging is a permanent part of the harbor's year rather than an occasional project. Stearns Wharf sits just along the waterfront, and the fleet behind the breakwater mixes commercial fishing boats, sailboats, cruisers and motoryachts that use Santa Barbara as their jumping-off point for the Channel Islands.</p>

    <p>That last part shapes the calls we get. A boat here isn't only a weekend platform tied to a dock — it's a boat that crosses open water to the islands and stays out. Appliances that merely limp along at the slip become a real problem twenty-five miles offshore. Visits are dispatched from our Santa Barbara branch, and this page is part of our <a href="/marine/">marine appliance repair</a> service. For appliance repair in homes ashore, see our <a href="/santa-barbara/">Santa Barbara</a> page.</p>
  </div>
</section>

<!-- 02 WHAT BREAKS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · What we see here</p>
    <h2 class="section-title">The calls that come off these docks.</h2>

    <h3 class="series-h3">Refrigeration that fails away from the dock</h3>
    <p>The classic Channel Islands call. A 12 or 24 volt compressor module cuts out when battery voltage drops below its threshold, so the box that ran perfectly on shore power goes warm at anchor on the second night. The fix is usually in the battery bank, the cable or a corroded terminal rather than the refrigeration. See <a href="/marine/refrigeration-repair/">marine refrigeration repair</a>.</p>

    <h3 class="series-h3">Air conditioning that trips on a warm afternoon</h3>
    <p>Marine AC dumps cabin heat into seawater, and a partly blocked strainer or a fouled condenser raises pressure until the unit shuts down. We work the raw-water loop before the refrigerant side; opening a refrigerant circuit is covered by our EPA 608 Universal certification. See <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a>.</p>

    <h3 class="series-h3">Ice on a boat that's going out for days</h3>
    <p>Ice matters more on a boat that stays out than on one that comes home each night. Thin cubes and slow production are nearly always water supply, scale or a hot locker rather than refrigerant. See <a href="/marine/ice-maker-repair/">marine ice maker repair</a>.</p>

    <h3 class="series-h3">Galley and laundry</h3>
    <p>Combo washer-dryers fail in the same few places every time — the drain filter and pump, the belt, the door lock, the heating element — and that's covered on our <a href="/marine/washer-dryer-repair/">boat washer dryer repair</a> page. On larger motoryachts the galley is a household kitchen with a Sub-Zero and a wine column in it, which is our <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a> work.</p>
  </div>
</section>

<!-- 02b BEFORE THE CROSSING -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Before the crossing</p>
    <h2 class="section-title">An appliance that limps at the dock will fail at anchor.</h2>

    <p>Santa Barbara is a jumping-off point, and that changes what a marginal appliance means. In a marina, a refrigerator that cuts out overnight is annoying — you open a hatch, you reset it, you carry on. Anchored off Santa Cruz Island with three days of food aboard and no dock power, the same behavior is the trip ending early.</p>

    <p>The faults that strand people are almost always the ones that were already visible and easy to explain away. A fridge that runs fine on shore power and cut out once at anchor, blamed on a hot night. An air conditioner that tripped on a warm afternoon and ran again after a rest. An ice maker that has been making thin cubes for a month. Every one of those is a system already working at its margin, and the crossing takes away the margin.</p>

    <p>So when you book, tell us you're heading out. We check the things that only matter offshore: voltage at the compressor module while it actually runs rather than at rest, the raw-water loop with the strainer opened rather than glanced at, and the ice maker's supply at the pressure it will really see. It's the same visit either way — it just changes what the tech looks at hardest.</p>
  </div>
</section>

<!-- 03 ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">04 · Getting us to the boat</p>
    <h2 class="section-title">Gate codes, slip numbers and someone aboard.</h2>

    <p>Harbor docks are gated, parking near the waterfront is tight, and dredging equipment moves things around from season to season. A few details up front save an appointment.</p>

    <ol class="num-list">
      <li><strong>Where exactly.</strong> Dock and slip number, plus where the tech should park given what's going on in the harbor that week.</li>
      <li><strong>How to get through the gate.</strong> The gate code, or who meets us and when.</li>
      <li><strong>Someone aboard.</strong> The owner, captain or a crew member has to be on the boat for the visit. We don't board an unattended vessel.</li>
      <li><strong>What we're walking into.</strong> A photo of the data plate, and the flash count if a refrigeration module LED is blinking.</li>
    </ol>

    <p>Tools and parts go down the dock by hand, so we plan the first trip around what you tell us. If you're heading for the islands, say so when you book — it changes what we check before you leave. The diagnostic is $120 and it's waived when you approve the repair; the written estimate comes before any part is ordered.</p>

    <div class="callout">
      <p>We work on the appliance side. Shore power, the boat's electrical panel and wiring go to a marine electrician working to ABYC standards; seacocks, through-hulls and haul-out work go to a boatyard.</p>
    </div>
  </div>
</section>

<!-- 04 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">05 · FAQ</p>
    <h2 class="section-title">Boat appliance repair in Santa Barbara, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Appliance down on the boat? Call our Santa Barbara branch.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
