---
import { CSLB_ACTIVE } from '../../data/credentials-schema';
// src/pages/marine/dana-point.astro
// Marine geo page (wave 2). Single LocalBusiness of the primary branch from cities.ts
// (dana-point → irvine), NO location array (docs/seo-policies.md §1 п.6). City-level address,
// no streetAddress. Harbor facts from open sources only: harbor named for Richard Henry Dana Jr.,
// author of "Two Years Before the Mast"; county-run harbor undergoing a long revitalization;
// Ocean Institute on the harbor. NO slip counts (unverified). $120 marine diagnostic. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES } from '../../data/branches';
import { getCityBySlug } from '../../data/cities';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const city = getCityBySlug('dana-point')!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;
const phone = branch.phone;
const phoneHref = `tel:+1${branch.phone.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/marine/dana-point/";
const PLACE = "Dana Point";

const title = "Boat Appliance Repair Dana Point — Same Day";
const description = "Boat appliance repair at the slip in Dana Point Harbor: marine refrigeration, boat AC, ice makers, galley and laundry. $120 diagnostic.";

const faqs = [
  {
    q: "Do you come to boats in Dana Point Harbor?",
    a: "Yes. We work at the slip in Dana Point, dispatched from our Irvine branch, and phones are answered 24/7. Same-day service is available when the schedule allows. Give us the dock and slip number plus gate access when you book, and make sure someone will be aboard."
  },
  {
    q: "The harbor has been under construction for years. Does that affect a service call?",
    a: "It affects parking and which gates are open more than anything else. Docks and landside areas have moved through the harbor's long revitalization, so the useful thing to tell us is the current dock and slip, where to park, and which gate the tech should use today rather than the one that worked last season."
  },
  {
    q: "My boat sits for weeks between trips. What usually fails?",
    a: "Two things. The battery bank sags while the boat sits, and a 12 or 24 volt refrigeration module will cut out to protect it, so the fridge is warm when you arrive. And the raw-water side collects growth, so the air conditioning trips on high pressure the first hot afternoon. Both are normal for a boat that isn't used weekly, and both are things we check first here."
  },
  {
    q: "Do you work on the appliances in a sportfisher's galley?",
    a: "Yes. Dana Point runs a lot of sportfishers and cruisers, and their galleys hold ordinary household-grade equipment plus an ice maker that matters more than anything else aboard. We service refrigeration, ice, galley cooking, dishwashers and laundry, and on larger boats the full built-in kitchen."
  },
  {
    q: "How much does a boat appliance diagnostic cost in Dana Point?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish marine repair prices, because access and installation vary so much from boat to boat."
  }
];

const business = mergeCredentials({
  ...buildBranchLocation(branch),
  "@context": "https://schema.org",
  "@id": canonical + "#business",
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": PLACE, "addressRegion": "CA", "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": PLACE },
  "openingHoursSpecification": OPENING_HOURS_SCHEMA
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Appliance Repair",
    "name": "Boat Appliance Repair in Dana Point",
    "url": canonical,
    "description": "At-the-slip repair of marine refrigerators and freezers, ice makers, marine air conditioning, washer-dryer combos and galley appliances on boats in Dana Point Harbor, including sportfishers, cruisers and larger motoryachts.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": { "@type": "City", "name": PLACE },
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];

const TRUST = [
  '⚓ At the Slip in Dana Point',
  '❄️ EPA 608 Universal',
  ...(CSLB_ACTIVE ? ['🔧 CSLB C-20 HVAC'] : []),
  '🏅 BHGS #A49573',
  '💬 $120 Diagnostic — Waived With Repair'
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="dana-point"
  imageAlt="Boat appliance repair in Dana Point CA — the harbor and headland"
  eyebrow="Marine · Dana Point Harbor · Irvine Branch · Same Day"
  title="Boat Appliance Repair Dana Point"
  subtitle="Boat fridge warm, AC tripping, no ice before a trip? We come to the slip in Dana Point Harbor. $120 diagnostic, waived with repair."
  phone={phone}
  phoneHref={phoneHref}
  heroImageTitle="Boat Appliance Repair Dana Point"
  heroImageLocation="Dana Point"
  trustBarItems={TRUST}
  showBranches={false}
/>

<!-- 01 THE HARBOR -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The harbor</p>
    <h2 class="section-title">A harbor named after a man who wrote about this coast before it had one.</h2>

    <p>Dana Point takes its name from Richard Henry Dana Jr., whose <em>Two Years Before the Mast</em> described this stretch of coast in the 1830s, when hides were thrown down the cliffs to boats waiting below and there was no harbor at all. The harbor came much later, and for years now it has been working through a long revitalization that has moved docks, parking and landside buildings in stages. The Ocean Institute sits on the water here, and the harbor is Orange County's south-coast base for sportfishers, cruisers and a growing number of larger motoryachts.</p>

    <p>What that means for us is a fleet that gets used hard in bursts. Boats here go out for fishing trips and weekends and then sit through the week, and appliances feel that rhythm. Our visits to Dana Point are dispatched from our Irvine branch, and this page is part of our <a href="/marine/">marine appliance repair</a> service. For appliance repair in homes ashore, see our <a href="/dana-point/">Dana Point</a> page.</p>
  </div>
</section>

<!-- 02 WHAT BREAKS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · What we see here</p>
    <h2 class="section-title">The calls that come off these docks.</h2>

    <h3 class="series-h3">A fridge that's warm on arrival</h3>
    <p>The most common Dana Point call, and usually a boat that has been sitting. Many marine boxes run on 12 or 24 volt Danfoss/Secop compressors whose control module cuts out when battery voltage drops below its threshold, protecting the bank. Owners arrive to a warm fridge and assume the refrigeration failed. We measure voltage at the module under load before anything else — the detail is on our <a href="/marine/refrigeration-repair/">marine refrigeration repair</a> page.</p>

    <h3 class="series-h3">Air conditioning that trips on the first hot day</h3>
    <p>Marine AC dumps cabin heat into seawater. A boat that sat for a few weeks has growth in the strainer and on the condenser, flow drops, pressure climbs and the unit shuts down. We work the raw-water loop first; refrigerant work is covered by our EPA 608 Universal certification. See <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a>.</p>

    <h3 class="series-h3">No ice before a trip</h3>
    <p>On a sportfisher the ice maker is not a luxury item, and it fails at the worst possible time. Nearly always it's water supply or a hot locker rather than refrigerant. More on our <a href="/marine/ice-maker-repair/">marine ice maker repair</a> page.</p>

    <h3 class="series-h3">Galley and laundry on the bigger boats</h3>
    <p>Above roughly 60 feet the galley is a household kitchen: Sub-Zero drawers, a Miele or Bosch dishwasher, a wine column, a washer-dryer combo. That's our <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a> work, and it's the same equipment our techs service in Orange County homes every day.</p>
  </div>
</section>

<!-- 02b THE RHYTHM -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · The rhythm here</p>
    <h2 class="section-title">Boats that run hard in bursts age differently than boats that run every day.</h2>

    <p>A liveaboard's refrigerator never really stops, and it wears the way a kitchen refrigerator wears. A Dana Point sportfisher does the opposite: it works hard for a weekend, then sits at the dock for two or three weeks, then works hard again. That pattern is its own kind of wear, and it explains most of what we find on these docks.</p>

    <p>Sitting is what does the damage. The house bank drifts down while the boat is idle, so the first thing a 12 or 24 volt refrigeration module does on your return is protect the battery by shutting the compressor off. Growth builds quietly in a sea strainer that nothing is pulling water through, so the air conditioning that was fine in May trips on the first warm Saturday in July. Water sits in a laundry drain and a pump trap and starts to smell. None of that is a broken appliance; all of it reads like one to the owner walking aboard.</p>

    <p>The practical answer is to have us look at the boat before the season rather than during it. A pre-trip check on the battery voltage under load, the strainer and the ice maker's water supply costs one visit and heads off the call that comes in on a Friday afternoon when every tech in the county is already booked.</p>
  </div>
</section>

<!-- 03 ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">04 · Getting us to the boat</p>
    <h2 class="section-title">Gate codes, slip numbers and someone aboard.</h2>

    <p>This part decides whether a marine call goes smoothly, so we're direct about it. Docks are behind locked gates, and with construction still shifting things around the harbor, last year's directions aren't always this year's.</p>

    <ol class="num-list">
      <li><strong>Where exactly.</strong> Dock and slip number, and where the tech should park given whatever is closed at the moment.</li>
      <li><strong>How to get through the gate.</strong> The gate code, or who meets us and when.</li>
      <li><strong>Someone aboard.</strong> The owner, captain or a crew member has to be on the boat for the visit. We don't board an unattended vessel.</li>
      <li><strong>What we're walking into.</strong> A photo of the data plate, and the flash count if a refrigeration module LED is blinking.</li>
    </ol>

    <p>Everything goes down the dock by hand, so the first trip is planned around what you tell us. The diagnostic is $120 and it's waived when you approve the repair; the written estimate comes before any part is ordered.</p>

    <div class="callout">
      <p>We work on the appliance side. Shore power, the boat's electrical panel and wiring go to a marine electrician working to ABYC standards; seacocks, through-hulls and haul-out work go to a boatyard.</p>
    </div>
  </div>
</section>

<!-- 04 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">05 · FAQ</p>
    <h2 class="section-title">Boat appliance repair in Dana Point, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Appliance down on the boat? Call our Irvine branch.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
