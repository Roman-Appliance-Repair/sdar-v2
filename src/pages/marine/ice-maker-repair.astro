---
// src/pages/marine/ice-maker-repair.astro
// Marine ice maker page (wave 2). Marine ice makers, U-Line marine, Vitrifrigo.
// Water from tank or watermaker, pump pressure, hot compartment, scale, seawater cooling where fitted.
// $120 marine diagnostic, no repair prices. NO ABYC claim, NO factory-authorized claim.
// U-Line / Marvel = Composition Brands, never "Middleby" (factual-accuracy §1.1).
// Geo-neutral schema per docs/seo-policies.md. BreadcrumbList from Breadcrumbs.astro. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/marine/ice-maker-repair/";

const title = "Marine Ice Maker Repair Los Angeles — Same Day";
const description = "Boat ice maker repair at the slip: tank and watermaker supply, pump pressure, hot lockers, scale, seawater-cooled units. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const TRUST = [
  '🏅 BHGS #A49573',
  '❄️ EPA 608 Universal',
  '🧊 Marine · U-Line · Vitrifrigo',
  '⚓ We Come to the Slip',
  '💬 $120 Diagnostic — Waived With Repair'
];

const faqs = [
  {
    q: "My boat ice maker runs but makes almost no ice. Where do you start?",
    a: "With water and heat, in that order. A marine ice maker needs a steady supply at the pressure it was designed for, and a tank feed through a small pump often can't hold that when another tap is open. Then we look at where the unit lives: a locker that sits at 95 degrees with no airflow will stretch a harvest cycle until production collapses. Refrigerant is the last thing we check, not the first."
  },
  {
    q: "Does it matter whether the water comes from the tank or the watermaker?",
    a: "It changes what we look for. Tank water carries whatever the tank carries, so we check the filter and the inlet screen first. Watermaker output is very low in minerals, which is easy on the machine, but the supply is only there while the watermaker runs — if the ice maker is asking for water when the unit is off, it starves. Dock water is the third case, and that's where scale builds fastest."
  },
  {
    q: "What does scale do to a marine ice maker?",
    a: "It coats the evaporator or the mold, and ice stops releasing cleanly. You get thin cubes, cloudy cubes, cubes that stick and a harvest cycle that runs longer and longer. Descaling on schedule is the single best thing an owner can do for one of these machines, and we'll show the crew what the interval should be for the water you're actually using."
  },
  {
    q: "Do you work on seawater-cooled ice makers?",
    a: "Yes, where they're fitted. On those units we check the raw-water side first — strainer, pump, growth in the heat exchanger — because a machine that can't reject its heat behaves exactly like a machine with a refrigeration fault. It's the same loop logic as our marine air conditioning work."
  },
  {
    q: "How much does a marine ice maker diagnostic cost?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't quote repair prices sight unseen, because a clogged inlet screen and a failed sealed system are very different jobs on the same machine."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Marine Ice Maker Repair",
    "name": "Boat Ice Maker Repair",
    "url": canonical,
    "description": "At-the-slip repair of ice makers aboard boats: marine ice makers, U-Line marine and Vitrifrigo units and household-style machines fitted in galleys, covering tank, watermaker and dock water supply, pump pressure, inlet valves and screens, scale and harvest faults, hot compartment ventilation, and air-cooled or seawater-cooled condensers.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="ice-maker-repair"
  imageAlt="Marine ice maker repair in Los Angeles CA — technician at the evaporator"
  eyebrow="Marine · Boat Ice Makers · Tank, Watermaker, Dock Water"
  title="Marine Ice Maker Repair Los Angeles"
  subtitle="Thin cubes, no harvest, a bin that never fills? On a boat that's usually water supply or heat, not refrigerant. $120 diagnostic, waived with repair."
  heroImageTitle="Marine Ice Maker Repair"
  trustBarItems={TRUST}
  showBranches={true}
/>

<!-- 01 WHERE TO START -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · Where to start</p>
    <h2 class="section-title">An ice maker is a water appliance that happens to get cold.</h2>

    <p>Ice is the appliance people miss fastest on a boat. It's also the one most often blamed for a fault that belongs somewhere else. A machine that has stopped producing is usually not short of refrigerant; it's short of water, short of pressure, or drowning in its own heat in a closed locker. This page is part of our <a href="/marine/">marine appliance repair</a> service, and on larger vessels it sits alongside our <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a> work.</p>

    <p>So our techs work it in a fixed order: confirm the machine is getting water at the pressure it expects, look at where the heat is going, check the harvest mechanism and the state of the mold or evaporator, and only then open the sealed system. Refrigerant work is covered by our EPA 608 Universal certification, #1346255700410, but it's the last step for a reason.</p>
  </div>
</section>

<!-- 02 WATER -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · Water</p>
    <h2 class="section-title">Three possible supplies, three different failure patterns.</h2>

    <p>Ashore an ice maker has one water source and it never changes. Aboard there are usually two or three, and the machine behaves differently on each.</p>

    <h3 class="series-h3">Tank water through a pump</h3>
    <p>The most common setup, and the most common source of trouble. The freshwater pump has to hold pressure while the ice maker's inlet valve is open, and if someone is running a tap or a shower at the same time, the machine can see a pressure dip instead of a fill. Add a clogged inlet screen or a tired filter and the fill gets shorter every cycle. Thin, hollow cubes are the classic symptom.</p>

    <h3 class="series-h3">Watermaker output</h3>
    <p>Clean and very low in minerals, which is kind to the machine. The catch is availability: if the ice maker calls for water when the watermaker isn't running, it fills short or not at all. On boats where this happens we look at the plumbing arrangement and how the crew actually uses the system before condemning any part.</p>

    <h3 class="series-h3">Dock water</h3>
    <p>Steady pressure, and harder water than either of the other two. It's the easiest supply for the machine to work with and the hardest on the mold over a season, because that's where scale builds.</p>
  </div>
</section>

<!-- 03 HEAT -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Heat</p>
    <h2 class="section-title">A hot locker will stop an ice maker that tests perfectly on the bench.</h2>

    <p>Making ice means moving heat out of water and dumping it somewhere. On a boat that somewhere is often a closed compartment behind a galley cabinet, in a hull that has been sitting in the sun all day. The condenser can only reject heat into air that's cooler than it is, and when the locker climbs, cycles stretch, production drops, and eventually the machine runs almost continuously for a trickle of ice.</p>

    <p>Owners describe this as the machine dying slowly, and it usually gets blamed on age. Our techs measure the compartment, check that whatever ventilation was designed in is still clear, and look at the condenser fins, which collect dust and salt film. Where a unit is seawater-cooled instead, the same job falls on the raw-water loop: strainer, pump, and growth inside the heat exchanger. A fouled exchanger looks exactly like a failing compressor from the outside.</p>

    <div class="callout">
      <p>If the fix is more ventilation or a relocated vent rather than a part, we'll say so. That's a conversation with your carpenter or yard, and it beats replacing a machine that was never broken.</p>
    </div>
  </div>
</section>

<!-- 04 SCALE AND HARVEST -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · Scale and harvest</p>
    <h2 class="section-title">When ice stops letting go.</h2>

    <p>Every ice maker has to release finished ice, and that step is where mineral scale does its damage. Scale coats the surface the ice forms on, and ice that should drop cleanly clings instead. What the crew sees is cloudy cubes, cubes fused into a sheet, a harvest cycle that runs long, or a bin that fills far more slowly than it used to.</p>

    <ul class="bullet-list">
      <li><strong>Scale on the mold or evaporator</strong> — descaling on a schedule matched to your water is the fix, and the interval is shorter on dock water than on watermaker output.</li>
      <li><strong>The harvest mechanism itself</strong> — the parts that free the ice wear, and on marine units salt-laden air doesn't help them.</li>
      <li><strong>Drain and bin</strong> — a slow drain refreezes meltwater and bridges the cubes; a bin thermostat that misreads stops production with the bin half full.</li>
      <li><strong>Water quality</strong> — a filter nobody has changed in three seasons feeds every problem above.</li>
    </ul>

    <p>We work on marine ice makers, U-Line marine and Vitrifrigo units, and the household-style machines fitted in bigger galleys. We're an independent service, not factory-authorized for any of them, and we'll tell you when a job genuinely needs the manufacturer's own network.</p>
  </div>
</section>

<!-- 05 THE VISIT -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">05 · The visit</p>
    <h2 class="section-title">What to send us before the tech walks down the dock.</h2>

    <p>Send the marina, dock and slip number, the gate code or a name to meet the tech, and make sure the owner, captain or crew is aboard. Then tell us three things about the machine: where the water comes from, whether it ever made ice properly on this boat, and what the crew has already tried.</p>

    <p>A photo of the data plate lets us bring the right parts down in one trip, which matters more here than ashore — there's no running back to the van for a valve. The diagnostic is $120 and it's waived when you approve the repair; the written estimate comes before anything is ordered. If the boat's refrigeration is struggling too, the two often share a cause, and that's covered on our <a href="/marine/refrigeration-repair/">marine refrigeration repair</a> page.</p>
  </div>
</section>

<!-- 06 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06 · FAQ</p>
    <h2 class="section-title">Marine ice maker questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 07 RELATED -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">07 · Related</p>
    <h2 class="section-title">More marine service.</h2>
    <ul class="related-list">
      <li><a href="/marine/">Marine appliance repair (all equipment)</a></li>
      <li><a href="/marine/yacht-appliance-repair/">Yacht appliance repair</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>No ice aboard? Call now.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
