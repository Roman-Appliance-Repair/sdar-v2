---
// src/pages/marine/newport-beach.astro
// Marine geo page. Single LocalBusiness of the primary branch from cities.ts (newport-beach → irvine),
// NO location array (docs/seo-policies.md §1 п.6). City-level address, no streetAddress.
// Harbor facts from open sources only: Newport Harbor emerged after dredging; artificial / modified islands
// (Balboa Island, Lido Isle, Linda Isle, Harbor Island, Collins Island, Newport Island); homeowners' boat piers
// along the island bayfronts (Wikipedia). No boat counts published — none written. $120 marine diagnostic.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES } from '../../data/branches';
import { getCityBySlug } from '../../data/cities';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const city = getCityBySlug('newport-beach')!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;
const phone = branch.phone;
const phoneHref = `tel:+1${branch.phone.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/marine/newport-beach/";
const PLACE = "Newport Beach";

const title = "Boat Appliance Repair Newport Beach — Same Day";
const description = "Boat appliance repair in Newport Harbor: marine refrigeration, yacht AC and galley appliances at marina slips and private docks. $120 diagnostic.";

const faqs = [
  {
    q: "Do you come to boats in Newport Harbor?",
    a: "Yes. We work at marina slips and at private docks around Newport Harbor, dispatched from our Irvine branch. Same-day service is available when the schedule allows, and phones are answered 24/7. Tell us whether the boat is in a marina or at a private dock when you book."
  },
  {
    q: "The boat is at a private dock behind a house. How does access work?",
    a: "Give us the street address and tell us how to reach the dock: through the house, a side gate or a dock gate. Someone needs to be there to let us in and to be aboard during the visit. Parking on the islands can be tight, so a note about where the tech can park saves time."
  },
  {
    q: "Do you work on motor yacht air conditioning and chillers?",
    a: "Yes. We service self-contained marine AC units and chilled-water systems, including Dometic, Cruisair, Marine Air and Webasto equipment, as an independent service. Refrigerant work is covered by our EPA 608 Universal certification, #1346255700410, and we hold a CSLB C-20 HVAC license."
  },
  {
    q: "How much does a marine appliance diagnostic cost in Newport Beach?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish marine repair prices, because installations and access vary widely from boat to boat."
  },
  {
    q: "Can you repair the generator or the shore power connection too?",
    a: "No. Generators and engines go to a marine mechanic, and the shore power inlet, AC panel and boat wiring go to a marine electrician working to ABYC standards. We repair the appliances and measure the power at the appliance, and we'll share those readings with whoever handles the electrical side."
  }
];

const business = mergeCredentials({
  ...buildBranchLocation(branch),
  "@context": "https://schema.org",
  "@id": canonical + "#business",
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": PLACE, "addressRegion": "CA", "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": PLACE },
  "openingHoursSpecification": OPENING_HOURS_SCHEMA
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Appliance Repair",
    "name": "Boat Appliance Repair in Newport Beach",
    "url": canonical,
    "description": "Repair of marine refrigerators and freezers, ice makers, marine air conditioning and chillers, washer-dryer combos and galley appliances on boats at marina slips and private docks in Newport Harbor.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": { "@type": "City", "name": PLACE },
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];

const TRUST = [
  '⚓ Newport Harbor Slips & Docks',
  '❄️ EPA 608 Universal',
  '🔧 CSLB C-20 HVAC',
  '🏅 BHGS #A49573',
  '💬 $120 Diagnostic — Waived With Repair'
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="newport-beach"
  imageAlt="Boat appliance repair in Newport Beach CA — Newport Harbor"
  eyebrow="Marine · Newport Harbor · Irvine Branch · Same Day"
  title="Boat Appliance Repair Newport Beach"
  subtitle="Yacht AC, boat refrigeration, galley or laundry down? We come to marina slips and private docks around Newport Harbor. $120 diagnostic, waived with repair."
  phone={phone}
  phoneHref={phoneHref}
  heroImageTitle="Boat Appliance Repair Newport Beach"
  heroImageLocation="Newport Beach"
  trustBarItems={TRUST}
  showBranches={false}
/>

<!-- 01 THE HARBOR -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The harbor</p>
    <h2 class="section-title">In Newport Harbor, half the boats live behind somebody's house.</h2>

    <p>Newport Harbor was made, not found. It emerged only after millions of tons of silt were dredged out of the bay, and the islands inside it, Balboa Island, Lido Isle, Linda Isle, Harbor Island, Collins Island and Newport Island among them, are artificial or reshaped. Along the island bayfronts the homes have their own piers for their own boats. Add the marinas and yacht clubs, and the harbor packs a lot of boats, many of them motor yachts, into a tight stretch of water.</p>

    <p>For our techs that means two kinds of visits: a marina slip with a gate and a dock walk, or a private dock reached through a house or a side gate on an island street. Motor yachts also bring bigger systems, including chilled-water air conditioning and multiple refrigeration units, and more of them to check on each call. Visits here are dispatched from our Irvine branch, and this page is part of our <a href="/marine/">marine appliance repair</a> service. For appliance repair in homes ashore, see our <a href="/newport-beach/">Newport Beach</a> page.</p>
  </div>
</section>

<!-- 02 WHAT BREAKS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · What we see here</p>
    <h2 class="section-title">The calls that come out of the harbor.</h2>

    <h3 class="series-h3">Air conditioning on bigger boats</h3>
    <p>Motor yachts often run chilled-water systems: a chiller cools a water loop feeding air handlers through the boat. Both chillers and self-contained units reject heat into seawater, so a clogged strainer, a fouled condenser or a raw-water pump that quit pushes pressure up until the system shuts down. We work the water side before the refrigerant side. Details are on our <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a> page.</p>

    <h3 class="series-h3">Refrigeration and ice</h3>
    <p>Boat refrigerators on 12 or 24 volt Danfoss/Secop compressors shut down when battery voltage sags below the cut-out, and a boat sitting at a private dock between trips is a classic case. We read the module's flash code and measure voltage under load first. More on our <a href="/marine/refrigeration-repair/">marine refrigeration repair</a> page.</p>

    <h3 class="series-h3">Galley and laundry</h3>
    <p>Dishwashers, microwaves, galley cooktops and washer-dryer combos all come up. Combos fail at the drain filter and pump, the water supply side, and the door lock and seal, so that's where our techs look first.</p>

    <h3 class="series-h3">Salt and power</h3>
    <p>Salt air corrodes terminals and coils; generators and inverters sag when compressors start. We check connections and measure voltage, frequency and polarity at the appliance on every visit.</p>
  </div>
</section>

<!-- 03 ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Getting us to the boat</p>
    <h2 class="section-title">Marina gate or private dock: tell us which.</h2>

    <p>Access decides how fast a marine call goes, so we're direct about what we need.</p>

    <ol class="num-list">
      <li><strong>Marina slip:</strong> marina name, dock and slip number, and the gate code or who meets us at the gate.</li>
      <li><strong>Private dock:</strong> the street address, how to reach the dock, and where the tech can park on the island.</li>
      <li><strong>Someone aboard.</strong> The owner, captain or a crew member needs to be on the boat. We don't board an unattended vessel.</li>
      <li><strong>What it is.</strong> A photo of the data plate, the AC system type, and any controller code or fridge flash count help us bring the right parts.</li>
    </ol>

    <p>Parts and tools go down the dock by hand, so a good first description saves a second trip. The diagnostic is $120 and it's waived when you approve the repair; after that you get a written estimate.</p>

    <div class="callout">
      <p>We work on the appliance side. Shore power, the AC panel and boat wiring go to a marine electrician working to ABYC standards; generators and engines go to a marine mechanic; seacocks, through-hulls and haul-outs go to a boatyard.</p>
    </div>
  </div>
</section>

<!-- 04 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · FAQ</p>
    <h2 class="section-title">Boat appliance repair in Newport Beach, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Appliance down on the boat? Call our Irvine branch.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
