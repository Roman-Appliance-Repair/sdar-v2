---
// src/pages/marine/marina-del-rey.astro
// Marine geo page. Single LocalBusiness of the primary branch from cities.ts (marina-del-rey → los-angeles),
// NO location array (docs/seo-policies.md §1 п.6). City-level address, no streetAddress.
// Harbor facts from open sources only: "largest man-made small-craft harbor in North America, with nearly
// 4,600 boat slips" (The Log); basins lettered A–H and liveaboard permits (visitmdr.com); managed by
// LA County Department of Beaches and Harbors. $120 marine diagnostic. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES } from '../../data/branches';
import { getCityBySlug } from '../../data/cities';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const city = getCityBySlug('marina-del-rey')!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;
const phone = branch.phone;
const phoneHref = `tel:+1${branch.phone.replace(/\D/g, '')}`;
const canonical = "https://samedayappliance.repair/marine/marina-del-rey/";
const PLACE = "Marina del Rey";

const title = "Boat Appliance Repair Marina del Rey — Same Day";
const description = "Boat appliance repair at the slip in Marina del Rey: marine refrigeration, boat AC, galley and laundry for liveaboards, charters and owners. $120 diagnostic.";

const faqs = [
  {
    q: "Do you come to boats in Marina del Rey?",
    a: "Yes. We work at the slip across the Marina del Rey basins, dispatched from our Los Angeles branch. Same-day service is available when the schedule allows, and phones are answered 24/7. Give us the basin or marina name, the slip number and gate access when you book."
  },
  {
    q: "Someone lives aboard. Can you work around that?",
    a: "Yes, and it usually helps, because someone is already aboard to let us on. Tell us when the boat is occupied and which appliance is down, and we'll plan the visit so the galley or cabin is out of action for as little time as possible."
  },
  {
    q: "How much does a boat appliance diagnostic cost in Marina del Rey?",
    a: "The diagnostic is $120 and it's waived when you approve the repair. You get a written estimate before any part is ordered. We don't publish marine repair prices, because access and installation vary so much from boat to boat."
  },
  {
    q: "My charter boat's AC keeps tripping between trips. What should we check?",
    a: "Start with the sea strainer: a clogged strainer starves the raw-water loop and the unit shuts down on high pressure. If the strainer is clean and it still trips, the raw-water pump or a fouled condenser is next, and that's a call for us. Opening the refrigerant circuit is covered by our EPA 608 Universal certification."
  },
  {
    q: "Do you work on shore power or the boat's electrical panel?",
    a: "No. The shore power inlet, the AC panel and the boat's wiring belong to a marine electrician working to ABYC standards. We check voltage, frequency and polarity at the appliance and hand you the readings if the problem is on the electrical side."
  }
];

const business = mergeCredentials({
  ...buildBranchLocation(branch),
  "@context": "https://schema.org",
  "@id": canonical + "#business",
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": PLACE, "addressRegion": "CA", "addressCountry": "US" },
  "areaServed": { "@type": "City", "name": PLACE },
  "openingHoursSpecification": OPENING_HOURS_SCHEMA
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Appliance Repair",
    "name": "Boat Appliance Repair in Marina del Rey",
    "url": canonical,
    "description": "At-the-slip repair of marine refrigerators and freezers, ice makers, marine air conditioning, washer-dryer combos and galley appliances on boats in Marina del Rey, including liveaboard and charter vessels.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": { "@type": "City", "name": PLACE },
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];

const TRUST = [
  '⚓ At the Slip in Marina del Rey',
  '❄️ EPA 608 Universal',
  '🔧 CSLB C-20 HVAC',
  '🏅 BHGS #A49573',
  '💬 $120 Diagnostic — Waived With Repair'
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="marina-del-rey"
  imageAlt="Boat appliance repair in Marina del Rey CA — the main channel"
  eyebrow="Marine · Marina del Rey · Los Angeles Branch · Same Day"
  title="Boat Appliance Repair Marina del Rey"
  subtitle="Boat fridge, marine AC, galley or washer-dryer down? We come to the slip across the Marina del Rey basins. $120 diagnostic, waived with repair."
  phone={phone}
  phoneHref={phoneHref}
  heroImageTitle="Boat Appliance Repair Marina del Rey"
  heroImageLocation="Marina del Rey"
  trustBarItems={TRUST}
  showBranches={false}
/>

<!-- 01 THE HARBOR -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · The harbor</p>
    <h2 class="section-title">Marina del Rey is a neighborhood that floats, and its appliances work harder than most.</h2>

    <p>Marina del Rey is the largest man-made small-craft harbor in North America, with nearly 4,600 boat slips spread across basins lettered A through H. Before construction began in the 1950s, most of it was marsh and wetland. Today the Los Angeles County Department of Beaches and Harbors oversees the anchorages, and the docks hold everything from weekend sailboats to charter fleets to people who live aboard with a county permit.</p>

    <p>That mix shapes the calls our guys get. A liveaboard's refrigerator runs every day of the year, not just on weekends. A charter boat's air conditioning has to work between one trip and the next, with no time to wait for parts. And a boat that sits for weeks between visits comes back with a battery bank that sagged and a sea strainer full of growth. Our visits here are dispatched from our Los Angeles branch, and this page is part of our <a href="/marine/">marine appliance repair</a> service. For appliance repair in the homes and apartments ashore, see our <a href="/marina-del-rey/">Marina del Rey</a> page.</p>
  </div>
</section>

<!-- 02 WHAT BREAKS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · What we see here</p>
    <h2 class="section-title">The calls that come out of the basins.</h2>

    <h3 class="series-h3">Refrigeration that "died"</h3>
    <p>Many boat boxes run on 12 or 24 volt Danfoss/Secop compressors that shut themselves off when battery voltage drops below the cut-out. On a boat that's been sitting, or a liveaboard drawing the bank down overnight, that's the most common reason a fridge goes warm. We measure voltage at the compressor module under load first. The full story is on our <a href="/marine/refrigeration-repair/">marine refrigeration repair</a> page.</p>

    <h3 class="series-h3">Air conditioning that trips</h3>
    <p>A marine AC unit rejects cabin heat into seawater. When the strainer clogs or growth fouls the condenser, pressure climbs and the unit shuts down. We work the raw-water loop before the refrigerant side, and refrigerant work is covered by our EPA 608 Universal certification. More on our <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a> page.</p>

    <h3 class="series-h3">Galley and laundry</h3>
    <p>Liveaboards use their galley and their washer-dryer combo the way a household does. Combos fail in the same few places: the drain filter and pump, the water supply side, and the door lock and seal. Dishwashers, microwaves and galley cooktops round out the list.</p>

    <h3 class="series-h3">Salt, everywhere</h3>
    <p>Salt air corrodes terminals, pits aluminum evaporators and attacks metals in seawater circuits. Our techs check connections on every marine call here, because corrosion is behind a lot of intermittent faults.</p>
  </div>
</section>

<!-- 03 ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Getting us to the boat</p>
    <h2 class="section-title">Gate codes, slip numbers and someone aboard.</h2>

    <p>This is the part of a marine call that decides whether it goes smoothly, so we're straightforward about it. Marina docks are behind locked gates. A tech waiting at the gate is time nobody gets back.</p>

    <ol class="num-list">
      <li><strong>Where exactly.</strong> Marina or anchorage name, dock and slip number. Marina del Rey has a lot of docks, and "the one near the restaurants" costs a lot of walking.</li>
      <li><strong>How to get through the gate.</strong> The gate code, or who meets us at the gate and when.</li>
      <li><strong>Someone aboard.</strong> The owner, captain or a crew member needs to be on the boat for the visit. We don't board an unattended vessel.</li>
      <li><strong>What we're walking into.</strong> A photo of the data plate, and the flash count if a fridge module LED is blinking, lets us bring the likely parts.</li>
    </ol>

    <p>Everything we use goes down the dock by hand: meters, gauges, parts, sometimes a recovery machine. We plan the first trip around what you tell us. The diagnostic is $120 and it's waived when you approve the repair; after that you get a written estimate.</p>

    <div class="callout">
      <p>We work on the appliance side. Shore power, the boat's electrical panel and wiring go to a marine electrician working to ABYC standards; seacocks, through-hulls and haul-out work go to a boatyard.</p>
    </div>
  </div>
</section>

<!-- 04 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · FAQ</p>
    <h2 class="section-title">Boat appliance repair in Marina del Rey, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Appliance down on the boat? Call our Los Angeles branch.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
