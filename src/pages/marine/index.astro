---
// src/pages/marine/index.astro
// Marine vertical hub (mirrors /outdoor/: own top-level section, ServiceHero section="marine").
// $120 marine diagnostic (factual-accuracy §9), waived with repair. No repair prices published.
// Geo-neutral schema per docs/seo-policies.md: mergeCredentials() + BRANCHES.map(buildBranchLocation)
// + OPENING_HOURS_SCHEMA; Service + FAQPage. BreadcrumbList comes from Breadcrumbs.astro.
// NO aggregateRating. No ABYC or factory-authorized claims.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/marine/";

const title = "Marine Appliance Repair Los Angeles — Same Day";
const description = "Marine appliance repair across Los Angeles and Orange County harbors: boat refrigeration, marine air conditioning, galley and laundry. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const TRUST = [
  '🏅 BHGS #A49573',
  '❄️ EPA 608 Universal',
  '🔧 CSLB C-20 HVAC',
  '⚓ We Come to the Slip',
  '💬 $120 Diagnostic — Waived With Repair'
];

const faqs = [
  {
    q: "Do you come to the boat?",
    a: "Yes. We work at the slip or at a private dock, the same way we work in a kitchen. Same-day service is available across Los Angeles and Orange County harbors when the schedule allows, and phones are answered 24/7. Send us the marina, the slip number and how to get through the gate when you book."
  },
  {
    q: "How much does a marine appliance repair visit cost?",
    a: "The diagnostic is $120, and it's waived when you approve the repair. After the diagnostic you get a written estimate before any part is ordered. We don't publish repair prices for boats, because the same failure can take very different time depending on where the unit is installed and how you reach it."
  },
  {
    q: "My boat fridge stopped cooling. Is the compressor dead?",
    a: "Often it isn't. Many boat refrigerators run on a 12 or 24 volt Danfoss/Secop BD35F or BD50F compressor, and its control module shuts the compressor off when battery voltage sags below the cut-out. If a diagnostic LED is wired to the module, one flash means exactly that. We measure voltage at the module while the compressor tries to run before we condemn anything."
  },
  {
    q: "My marine air conditioner keeps shutting off on high pressure. What's wrong?",
    a: "On a boat that is almost always the seawater side: a clogged sea strainer, a condenser coil fouled with marine growth, or a raw-water pump that stopped moving enough water. We check water flow through the loop first, then the refrigeration side. Opening the refrigerant circuit is covered by our EPA 608 Universal certification."
  },
  {
    q: "Do you work on the boat's wiring, shore power inlet or seacocks?",
    a: "No. The AC panel, shore power inlet and boat wiring belong to a marine electrician working to ABYC standards. Through-hull fittings, seacocks, engines, generators and anything that needs the boat hauled belong to a boatyard or marine mechanic. We measure power at the appliance and tell you plainly when the problem is on their side."
  },
  {
    q: "Do you hold ABYC certification or factory authorization for marine brands?",
    a: "No to both, and we say so up front. We don't work on the boat's electrical system, which is where ABYC certification matters, and we repair Dometic, Vitrifrigo, Isotherm, Nova Kool and other marine brands as an independent service. What we do hold: BHGS #A49573, EPA 608 Universal #1346255700410 and a CSLB C-20 HVAC license."
  },
  {
    q: "What warranty comes with a marine repair?",
    a: "Our repairs carry a 90-day labor warranty on the work we performed. Manufacturer parts warranties, where they apply, are handled separately."
  }
];

const business = mergeCredentials({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": canonical + "#business",
  "name": "Same Day Appliance Repair",
  "url": canonical,
  "telephone": phone,
  "priceRange": "$$$",
  "description": "Marine appliance repair at the slip across Southern California harbors: DC and AC boat refrigeration, ice makers, self-contained and chilled-water marine air conditioning, dishwashers, washer-dryer combos and galley appliances. EPA 608 Universal, CSLB C-20 HVAC, BHGS #A49573.",
  "areaServed": AREA_SERVED,
  "openingHoursSpecification": OPENING_HOURS_SCHEMA,
  "location": BRANCHES.map(buildBranchLocation)
});

const schemaJsons = [
  business,
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Marine Appliance Repair",
    "name": "Marine Appliance Repair Service",
    "url": canonical,
    "description": "On-board repair of marine refrigerators and freezers, ice makers, marine air conditioning and chillers, dishwashers, washer-dryer combos, microwaves and galley cooking appliances, including power checks at the appliance.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="marine"
  imageAlt="Marine appliance repair in Los Angeles CA — technician on the dock"
  eyebrow="Marine · Boat Refrigeration · Marine AC · Galley · Same Day"
  title="Marine Appliance Repair Los Angeles"
  subtitle="Boat fridges on 12/24 V compressors, self-contained and chilled-water air conditioning, galley and laundry. We come to the slip. $120 diagnostic, waived with repair."
  heroImageTitle="Marine Appliance Repair"
  trustBarItems={TRUST}
  showBranches={true}
/>

<!-- 01 INTRO -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · On the water</p>
    <h2 class="section-title">A boat galley is a small kitchen that runs on batteries and pumps seawater through its air conditioning.</h2>

    <p>Walk the docks in Marina del Rey on a weekday and plenty of boats aren't going anywhere. People live aboard, charter boats sit between trips, owners come down to get something fixed before the weekend. Newport Harbor looks different again, with motor yachts in the marinas and boats tied up at private docks behind the houses on the islands. The appliances on those boats are ones our guys already know from kitchens and restaurants: a refrigerator, an ice maker, air conditioning, a dishwasher, a washer-dryer combo. What changes is how they're powered, how they get rid of heat, and what salt air does to them.</p>

    <p>On land a refrigerator plugs into a wall and dumps its heat into the kitchen. On a boat it often runs on a 12 or 24 volt DC compressor fed from the house battery bank, and its condenser may be cooled by air, by a seawater loop or by a keel cooler. The air conditioner pulls seawater through a strainer and a pump to carry heat overboard. Power comes from shore, from a generator or from an inverter, and any one of those can be the real reason something stopped. That's why a marine call starts with measurements, not with parts.</p>

    <p>Above roughly 60 feet the picture changes again: the galley fills up with ordinary premium household appliances — Sub-Zero, Miele, Bosch, Gaggenau, a wine column — installed in joinery that was never designed to be taken apart. That side of the work has its own page, <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a>.</p>

    <p>Pricing is simple. The diagnostic is $120, and it comes off the bill when you approve the repair. After that you get a written estimate before we order anything. We don't publish repair prices for boats: the same failure can be quick on one boat and slow on the next, depending on where the unit sits and how our tech gets to it.</p>
  </div>
</section>

<!-- 02 SCOPE -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · Scope</p>
    <h2 class="section-title">What we service, and what we don't touch.</h2>

    <p>A boat carries more trades than a house. Here's exactly where our work starts and stops, so the right people get the call the first time.</p>

    <div class="scope-grid">
      <div class="scope-card scope-yes">
        <h3>What we service</h3>
        <ul class="scope-list">
          <li><strong>Marine refrigerators and freezers</strong>, DC compressor systems and AC units.</li>
          <li><strong>Ice makers</strong> on board.</li>
          <li><strong>Marine air conditioning</strong>: self-contained units and chilled-water systems.</li>
          <li><strong>Dishwashers.</strong></li>
          <li><strong>Washer-dryer combos.</strong></li>
          <li><strong>Galley microwaves, cooktops and ranges.</strong></li>
        </ul>
      </div>
      <div class="scope-card scope-no">
        <h3>What we don't touch</h3>
        <ul class="scope-list">
          <li><strong>Through-hull fittings and seacocks.</strong> That's a boatyard or marine mechanic. We work on the appliance end of a raw-water loop, not the fitting through the hull.</li>
          <li><strong>Boat wiring, the AC distribution panel and the shore power inlet.</strong> That's a marine electrician working to ABYC standards.</li>
          <li><strong>The main engine and the generator.</strong> That's a marine mechanic or generator service.</li>
          <li><strong>Anything that needs the boat hauled out of the water.</strong> That's a boatyard.</li>
        </ul>
      </div>
    </div>

    <p>We don't hold ABYC certification, and the work we take on doesn't call for it: we stay on the appliance side of the boat's systems and leave the electrical system itself to the electrician. We're also not factory-authorized for any marine brand. We repair them as an independent service, and we'll tell you if a job needs the manufacturer's own network.</p>
  </div>
</section>

<!-- 03 REFRIGERATION -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · Refrigeration</p>
    <h2 class="section-title">Most boat refrigeration runs on a small DC compressor, and it tells you what's wrong.</h2>

    <p>A lot of the marine refrigeration we see runs on Danfoss/Secop BD35F and BD50F compressors, 12 or 24 volt, each with its own electronic control module. That module does something a home refrigerator doesn't. When it records a fault, a diagnostic LED wired to it flashes, and the number of flashes is the diagnosis: one flash is the battery protection cut-out, two is an over-current on the fan circuit, three is a motor start error, five means the electronics overheated. When the LED is installed, our techs count the flashes before touching anything.</p>

    <p>The most common one-flash call isn't a refrigerator problem at all. A tired house bank sags under load, the module sees voltage drop below its cut-out, around 10.4 volts on a 12 volt system at the default setting, and switches the compressor off to protect the battery. From the galley it looks exactly like a dead fridge. So the diagnostic starts with voltage at the module while the compressor is trying to run, the same logic we use on food trucks running off generators, and not with pulling the compressor.</p>

    <p>Then comes the condenser, and on a boat that's where the search splits. Some units are air-cooled, some use a seawater pump with a strainer, some use a keel cooler. A clogged strainer, a pump that quit or marine growth on the heat exchanger all look the same from inside the cabin: warm box, compressor running long. Salt adds its own failures, from pitted aluminum evaporators to corroded terminals and electrolysis where metals meet in the seawater circuit.</p>

    <p>We work on Vitrifrigo, Isotherm, Nova Kool, Dometic and U-Line marine models, among others. The full breakdown is on our <a href="/marine/refrigeration-repair/">marine refrigeration repair</a> page.</p>
  </div>
</section>

<!-- 04 AIR CONDITIONING -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04 · Air conditioning</p>
    <h2 class="section-title">Marine air conditioning: when it trips, look at the seawater first.</h2>

    <p>Smaller boats usually run self-contained units tucked under berths and settees. Larger yachts often run chilled-water systems, where a chiller cools a water loop that feeds air handlers throughout the boat. We see Dometic equipment, including its Cruisair and Marine Air lines, plus Webasto systems.</p>

    <p>A high-pressure shutdown is almost always the raw-water side. The heat the unit pulls out of the cabin has to leave through seawater, and if the sea strainer is packed, the condenser coil is fouled or the raw-water pump has stopped moving enough water, pressure climbs until the unit protects itself. Condensate is the other steady call: a pan that doesn't drain or a condensate pump that died puts water where it shouldn't be. Digital controllers and their sensors fill in the rest.</p>

    <p>This is also where our credentials do real work. Opening a refrigerant circuit takes EPA 608 certification, and ours is Universal #1346255700410. We also hold a CSLB C-20 HVAC license. Details are on our <a href="/marine/air-conditioning-repair/">marine air conditioning repair</a> page.</p>
  </div>
</section>

<!-- 05 POWER -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">05 · Power</p>
    <h2 class="section-title">Shore power, generator, inverter: check the power before the appliance.</h2>

    <p>A boat at the dock usually runs on 30 or 50 amp shore power. Away from it, power comes from a generator or through an inverter from the batteries. Each source has its own way of starving an appliance. Our techs check voltage, frequency and polarity at the appliance itself, and watch what happens when a compressor starts, because a motor start pulls far more current than the running load and a weak source sags hard at that moment. Inverters add waveform: a modified sine wave is hard on electronic controls. We wrote up that problem for food trucks in <a href="/commercial/food-truck-equipment-repair/generator-vs-battery-power/">generator vs battery power</a>, and boats behave the same way.</p>

    <p>Where the reading points at the boat's own electrical system, including galvanic isolation, the shore power inlet and the panel, we stop and hand you the numbers for your marine electrician. That keeps each trade on its own side of the line.</p>
  </div>
</section>

<!-- 06 GALLEY AND LAUNDRY -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06 · Galley and laundry</p>
    <h2 class="section-title">Galley appliances and the Splendide combo.</h2>

    <p>A washer-dryer combo such as a Splendide earns its place on a boat because one unit fits in a closet. It also fails in predictable places, so our techs check the same places first: the drain side, meaning the filter and pump that catch lint and small debris; the water supply side, where inlet valves meet a boat's onboard pump pressure; and the door, where the lock and seal take the wear. Most combo calls end in one of those three areas, and the full breakdown is on our <a href="/marine/washer-dryer-repair/">boat washer dryer repair</a> page.</p>

    <p>Ice gets its own page too, because on a boat it fails for reasons that have nothing to do with refrigerant: see <a href="/marine/ice-maker-repair/">marine ice maker repair</a>. The rest of the galley is familiar ground: dishwashers, microwaves, cooktops and ranges. On propane galley stoves we repair the appliance, not the LPG supply system that feeds it.</p>
  </div>
</section>

<!-- 07 WHERE AND ACCESS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">07 · Where we work</p>
    <h2 class="section-title">We come to the slip. Here's how to make the visit go fast.</h2>

    <p>Five harbors have their own pages: <a href="/marine/marina-del-rey/">Marina del Rey</a>, <a href="/marine/newport-beach/">Newport Beach</a>, <a href="/marine/dana-point/">Dana Point</a>, <a href="/marine/san-diego/">San Diego</a> and <a href="/marine/santa-barbara/">Santa Barbara</a>. We also take calls from other harbors across our service area, from Ventura down to the South Bay of San Diego.</p>

    <ol class="num-list">
      <li><strong>Where the boat is.</strong> Marina name, dock and slip number, or the address if it's a private dock behind a house.</li>
      <li><strong>How to get in.</strong> Gate code or who meets us at the gate. Marinas are locked, and a tech waiting outside is time on your bill.</li>
      <li><strong>Who's aboard.</strong> The owner, captain or a crew member needs to be on the boat. We don't board an empty vessel.</li>
      <li><strong>What it is.</strong> A photo of the data plate on the fridge, AC unit or combo helps us bring the likely parts. Everything we carry goes down the dock by hand, so the first trip counts.</li>
    </ol>
  </div>
</section>

<!-- 08 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08 · FAQ</p>
    <h2 class="section-title">Marine appliance repair, common questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 09 RELATED -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">09 · Related</p>
    <h2 class="section-title">Marine service pages.</h2>
    <ul class="related-list">
      <li><a href="/marine/yacht-appliance-repair/">Yacht appliance repair</a></li>
      <li><a href="/marine/refrigeration-repair/">Marine refrigeration repair</a></li>
      <li><a href="/marine/air-conditioning-repair/">Marine air conditioning repair</a></li>
      <li><a href="/marine/ice-maker-repair/">Marine ice maker repair</a></li>
      <li><a href="/marine/washer-dryer-repair/">Boat washer dryer repair</a></li>
      <li><a href="/marine/marina-del-rey/">Boat appliance repair in Marina del Rey</a></li>
      <li><a href="/marine/newport-beach/">Boat appliance repair in Newport Beach</a></li>
      <li><a href="/marine/dana-point/">Boat appliance repair in Dana Point</a></li>
      <li><a href="/marine/san-diego/">Boat appliance repair in San Diego</a></li>
      <li><a href="/marine/santa-barbara/">Boat appliance repair in Santa Barbara</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Something quit on the boat? Call now.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
