---
// src/pages/marine/washer-dryer-repair.astro
// Boat laundry page (wave 2). Splendide combos, vented vs ventless, predictable failures:
// blocked drain pump, belt, door lock, heating element. Compact 24-inch Bosch / Miele on larger boats.
// $120 marine diagnostic, no repair prices. NO ABYC claim, NO factory-authorized claim.
// Geo-neutral schema per docs/seo-policies.md. BreadcrumbList from Breadcrumbs.astro. NO aggregateRating.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
