import { buildBranchLocation } from '../../lib/build-location-array';
import { mergeCredentials } from '../../data/credentials-schema';
import { OPENING_HOURS_SCHEMA, BUSINESS_HOURS } from '../../data/business-hours';

const phone = MAIN_PHONE;
const phoneHref = `tel:${MAIN_PHONE_TEL}`;
const canonical = "https://samedayappliance.repair/marine/washer-dryer-repair/";

const title = "Boat Washer Dryer Repair Los Angeles — Same Day";
const description = "Boat washer-dryer repair at the slip: Splendide combos, vented and ventless, drain pump, belt, door lock, heating element. $120 diagnostic.";

const AREA_SERVED = [
  "Los Angeles County", "Orange County", "Ventura County", "Santa Barbara County",
  "San Bernardino County", "Riverside County", "San Diego County"
].map((name) => ({ "@type": "AdministrativeArea", name }));

const TRUST = [
  '🏅 BHGS #A49573',
  '🌀 Splendide Combos',
  '👕 Vented and Ventless',
  '⚓ We Come to the Slip',
  '💬 $120 Diagnostic — Waived With Repair'
];

const faqs = [
  {
    q: "My Splendide combo washes but the clothes come out soaking wet. What is it?",
    a: "Almost always drainage or spin, not the dryer. If the machine can't pump out, it won't reach spin speed, and a load that never spun can't dry no matter how long the cycle runs. We check the drain filter and pump first, then the belt and the drum. It's one of the most common calls we get on boats, and it's usually a small part."
  },
  {
    q: "What's the difference between a vented and a ventless combo on a boat?",
    a: "A vented unit pushes hot, moist air outside through a duct, so its drying depends on that duct being clear and correctly run. A ventless unit condenses the moisture instead and sends the water down the drain, which means no hull penetration but longer cycles and a condenser that has to stay clean. When a ventless machine stops drying well, the condensing side and the drain are where we look; on a vented machine it's usually the duct."
  },
  {
    q: "The door won't unlock at the end of the cycle. Can that be fixed at the slip?",
    a: "Usually, yes. Door locks on these machines are a known wear item, and the machine deliberately keeps the door shut if it believes there's still water in the drum — so a drain fault and a lock fault look identical from outside. We confirm which one it is before replacing anything, and both repairs are normally done aboard in one visit."
  },
  {
    q: "Do you work on the compact Bosch and Miele units on larger boats?",
    a: "Yes. Above roughly 60 feet, boats often carry separate compact 24-inch machines rather than a combo, and those are the same units we service in apartments and condos ashore every day. On a yacht they're covered by our yacht appliance work as well."
  },
  {
    q: "How much does a boat washer-dryer repair cost?",
    a: "The diagnostic is $120 and it's waived when you approve the repair, with a written estimate before any part is ordered. We don't publish repair prices for boats: the same drain pump is a straightforward job in an accessible locker and a much longer one when the machine is built into joinery with no service access."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "areaServed": AREA_SERVED,
    "openingHoursSpecification": OPENING_HOURS_SCHEMA,
    "location": BRANCHES.map(buildBranchLocation)
  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Boat Washer Dryer Repair",
    "name": "Boat Washer and Dryer Repair",
    "url": canonical,
    "description": "At-the-slip repair of laundry equipment aboard boats: Splendide washer-dryer combos in vented and ventless configurations, blocked drain filters and pumps, drive belts, door locks and seals, heating elements and drying faults, plus the compact 24-inch Bosch and Miele machines fitted on larger vessels.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": AREA_SERVED,
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "120.00", "priceCurrency": "USD", "description": "Marine diagnostic fee, waived with repair." } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) }
  // BreadcrumbList: emitted once for every page by Layout → Breadcrumbs.astro.
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="marine"
  slug="washer-dryer-repair"
  imageAlt="Boat washer dryer repair in Los Angeles CA — technician at the drain filter"
  eyebrow="Marine · Boat Laundry · Splendide Combos · Compact 24-inch"
  title="Boat Washer Dryer Repair Los Angeles"
  subtitle="Clothes coming out soaked, door stuck shut, nothing drying? Boat laundry fails in a short list of predictable places. $120 diagnostic, waived with repair."
  heroImageTitle="Boat Washer Dryer Repair"
  trustBarItems={TRUST}
  showBranches={true}
/>

<!-- 01 WHERE TO START -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01 · Where to start</p>
    <h2 class="section-title">Boat laundry breaks in a short list of places, and the list barely changes.</h2>

    <p>Marine laundry is one of the more predictable things we work on. A washer-dryer combo aboard a boat lives a hard life — it runs in a tight locker, often on a supply that isn't rock steady, in damp salt air, and on a liveaboard or a charter it runs as often as a household machine. But when it fails, it fails in the same handful of spots nearly every time: the drain filter and pump, the belt, the door lock, and the heating side. This page is part of our <a href="/marine/">marine appliance repair</a> service.</p>

    <p>That's good news for an owner, because it means most of these calls end in a small part and an afternoon rather than a replacement. It also means a tech who knows the pattern can often bring the likely part down the dock on the first trip, which matters when the alternative is a second appointment.</p>
  </div>
</section>

<!-- 02 THE COMBO -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02 · The combo</p>
    <h2 class="section-title">Splendide combos: one drum that has to do two jobs.</h2>

    <p>The washer-dryer combo is the standard fit on boats for the obvious reason — one machine, one opening in the joinery, one set of plumbing. Splendide is the name we see most often in Southern California harbors. The trade-off is that a single drum has to wash and then dry the same load, so every stage depends on the one before it going right.</p>

    <h3 class="series-h3">Vented</h3>
    <p>Hot, moist air goes overboard through a duct. Drying performance is tied to that duct: a crushed run, a long run with too many bends, or a blocked outlet all show up as clothes that stay damp. When a vented machine stops drying, the duct is where we look before the machine.</p>

    <h3 class="series-h3">Ventless</h3>
    <p>The machine condenses the moisture and sends the water out with the drain, so no hull penetration is needed. Cycles run longer by design, and owners sometimes read normal behavior as a fault. Real faults on these live on the condensing side and in the drain — and because the drain does double duty, a partial blockage hurts drying as well as washing.</p>

    <p>On boats above roughly 60 feet we more often find separate compact 24-inch machines, usually Bosch or Miele. Those are ordinary household units, the same ones we service in condos ashore, and on a yacht they fall under our <a href="/marine/yacht-appliance-repair/">yacht appliance repair</a> work.</p>
  </div>
</section>

<!-- 03 THE USUAL FAULTS -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">03 · The usual faults</p>
    <h2 class="section-title">Four parts account for most of the calls.</h2>

    <ul class="bullet-list">
      <li><strong>Blocked drain filter and pump.</strong> The single most common fault. Lint, hair, sand tracked aboard, the occasional coin. The machine can't pump out, so it never reaches spin speed, so the load comes out soaked and nothing dries. Owners report a dryer problem; it's a drain problem.</li>
      <li><strong>Drive belt.</strong> A worn or thrown belt means the drum won't turn or won't spin up. The wash may still fill and drain, which makes it look like a control fault from outside.</li>
      <li><strong>Door lock.</strong> A wear item on these machines. It also refuses to release while the machine believes water is still in the drum, so a drain fault and a lock fault look identical until you check.</li>
      <li><strong>Heating element.</strong> On the drying side, the tell is a cycle that runs full length with cool air and damp clothes at the end.</li>
    </ul>

    <p>Salt air adds its own layer to all four: terminals and connectors corrode, and a marginal connection on a heating circuit or a pump can produce a fault that comes and goes with no pattern. Our techs check connections on every marine call, because chasing the symptom without checking the connection is how a machine gets a second visit.</p>

    <div class="callout">
      <p>Supply matters here too. A machine running off an inverter or a generator can behave oddly when voltage sags under a heating load. We measure at the machine while it's working rather than at the panel with the boat idle.</p>
    </div>
  </div>
</section>

<!-- 03b LIVING WITH IT -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">04 · Living with it</p>
    <h2 class="section-title">Half the calls we take are a machine being asked to do something it can't.</h2>

    <p>A combo is a compromise, and the compromise shows up in load size. The drum that just washed a full load has to dry that same load, and a drum packed to capacity for washing is well over capacity for drying. Crews load it like a household washer, the drying stage can't move air through the pack, and the machine gets blamed for clothes that come out damp after three hours. Running a smaller load for anything that has to come out dry is the single change that fixes the most complaints we hear.</p>

    <p>Water is the other half. Boat plumbing delivers through a pump rather than street pressure, so a machine filling while someone runs a shower sees a dip instead of a fill, and a short fill means a poor wash and sometimes a cycle that stalls waiting for water it never gets. On a liveaboard we usually suggest doing laundry when nothing else is drawing water, which sounds obvious and solves a surprising number of "faults".</p>

    <p>Then there's the long sit. A machine that goes unused for weeks holds water in the pump and the trap, and in a damp locker that turns into smell, mold on the door seal and a stiff pump when it finally runs again. Leaving the door ajar between trips and running an empty hot cycle when you come back aboard costs nothing and heads off a service call.</p>
  </div>
</section>

<!-- 05 THE VISIT -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">05 · The visit</p>
    <h2 class="section-title">What we need before the tech walks down the dock.</h2>

    <p>Send the marina, dock and slip number, the gate code or a name to meet the tech, and have the owner, captain or a crew member aboard for the visit. Then tell us what the machine actually does: does it fill, does it drain, does it spin, does the door release, and does the drying stage produce heat. Those five answers usually narrow the fault to one of the four parts above before anyone opens a panel.</p>

    <p>A photo of the data plate tells us the model and lets us carry the right pump, belt or lock down in one trip. The diagnostic is $120 and it's waived when you approve the repair; the written estimate comes before anything is ordered. If the galley refrigeration is acting up on the same boat, see <a href="/marine/refrigeration-repair/">marine refrigeration repair</a>.</p>
  </div>
</section>

<!-- 05 FAQ -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">06 · FAQ</p>
    <h2 class="section-title">Boat laundry questions.</h2>
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 06 RELATED -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">07 · Related</p>
    <h2 class="section-title">More marine service.</h2>
    <ul class="related-list">
      <li><a href="/marine/">Marine appliance repair (all equipment)</a></li>
      <li><a href="/marine/yacht-appliance-repair/">Yacht appliance repair</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container">
    <h2>Laundry down aboard? Call now.</h2>
    <p>$120 diagnostic, waived with repair. {BUSINESS_HOURS.display}.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/book/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
  .section { padding: 72px 24px; }
  .section-gray { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 10px; }
  h2.section-title { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 20px; line-height: 1.2; color: var(--text); letter-spacing: -0.01em; }
  .section p { margin: 0 0 18px; font-size: 1rem; line-height: 1.75; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }
  .series-h3 { font-size: 1.1rem; font-weight: 800; margin: 28px 0 10px; color: var(--text); border-left: 4px solid var(--red); padding-left: 12px; }
  .scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin: 24px 0; }
  @media (max-width: 720px) { .scope-grid { grid-template-columns: 1fr; } }
  .scope-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 22px 8px; }
  .scope-yes { border-top: 4px solid #2e7d32; }
  .scope-no { border-top: 4px solid var(--red); }
  .scope-card h3 { font-size: 1.05rem; font-weight: 800; margin: 0 0 12px; color: var(--text); }
  .scope-list { padding-left: 18px; margin: 0 0 14px; }
  .scope-list li { font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .num-list { padding-left: 22px; margin: 14px 0 18px; }
  .num-list li { font-size: 0.98rem; line-height: 1.7; color: var(--text); margin-bottom: 12px; }
  .bullet-list { padding-left: 22px; margin: 14px 0 18px; }
  .bullet-list li { font-size: 1rem; line-height: 1.65; color: var(--text); margin-bottom: 8px; }
  .related-list { padding-left: 22px; margin: 14px 0 0; }
  .related-list li { font-size: 0.98rem; line-height: 1.7; margin-bottom: 8px; }
  .callout { background: #f0f7ff; border: 1px solid #b8d4f0; border-radius: 8px; padding: 16px 20px; margin: 0 0 20px; }
  .callout p { margin: 0; }
  .table-wrap { overflow-x: auto; margin: 20px 0; }
  .code-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; background: #fff; }
  .code-table th { text-align: left; background: var(--black); color: #fff; padding: 12px 16px; font-weight: 700; font-size: 0.85rem; }
  .code-table td { padding: 12px 16px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .code-table tr:nth-child(even) td { background: #fafafa; }
  .faq-list { margin-top: 24px; }
  .faq-item { background: #fff; border: 1px solid var(--border); border-radius: 6px; padding: 16px 22px; margin-bottom: 10px; }
  .faq-item summary { font-weight: 700; cursor: pointer; font-size: 0.98rem; color: var(--text); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+ "; color: var(--red); font-weight: 800; margin-right: 6px; }
  .faq-item[open] summary::before { content: "− "; }
  .faq-item p { font-size: 0.93rem; color: var(--text); line-height: 1.7; margin: 12px 0 0; }
  .bottom-cta { background: var(--black); padding: 64px 24px; text-align: center; color: #fff; }
  .bottom-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; margin: 0 0 14px; color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,0.85); margin: 0 0 26px; font-size: 1.05rem; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 5px; font-weight: 700; text-decoration: none; }
  .btn-secondary { background: transparent; color: #fff; padding: 14px 28px; border-radius: 5px; border: 2px solid rgba(255,255,255,0.5); font-weight: 600; text-decoration: none; }
</style>
