---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import WhereWeWork from '../../components/WhereWeWork.astro';
// src/pages/services/pizza-oven-repair.astro
// Phase 3 Tier 3 structural fix (2026-04-29), converted from standalone HTML
// to Layout + ServiceHero pattern (matches refrigerator-repair Phase 3 reference).
// Preserves all existing content: 10 brand cards, residential vs commercial scope,
// 3 oven types, 8 problems, 4 recent repairs, why-us, pricing table, 3 reviews, 8 FAQs.

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, toE164 } from '../../data/branches';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;

const title = "Home & Outdoor Pizza Oven Repair Los Angeles — Gas, Electric";
const description = "Gas or electric pizza oven won't light or heat? Same-day repair for home and outdoor pizza ovens across LA and SoCal: Gozney, Alfa, Ooni, Alfresco, Breville, Wolf. $89 diagnostic.";

const faqItems = [
  {
    question: "Do you repair Ooni pizza ovens?",
    answer: "Yes, the gas and electric Ooni models: Koda 12, Koda 16, Volt 12, and Karu ovens running on the Ooni gas burner. Common issues: igniter failure on Koda models, a thermocouple cutting the flame, temperature sensor errors, and burner clogs. We carry Ooni-compatible parts and can usually complete the repair the same visit."
  },
  {
    question: "Can you fix a Gozney Dome, Arc, or Roccbox?",
    answer: "Yes, on gas. Roccbox burner issues, regulator failures, and gas connection problems are the most common calls we get. The Dome and Dome S1 occasionally need thermocouple replacement or door seal work, and the Arc gets igniter and burner calls. We service Gozney ovens running on gas. We don't work on wood-fired ovens."
  },
  {
    question: "What does pizza oven repair cost?",
    answer: "Diagnostic fee is $89, waived when you move forward with the repair. Most home and outdoor pizza oven repairs run $150–$350 depending on the brand and what's wrong. Igniter replacements tend to be on the lower end; burner assembly work or control board failures run higher. We give you a written estimate before any work starts, and every repair carries a 90-day warranty on parts and labor."
  },
  {
    question: "Do you repair wood-fired or pellet pizza ovens?",
    answer: "No. We repair gas and electric pizza ovens only. We don't work on wood- or pellet-burning equipment. If your oven is dual-fuel (for example a Gozney Dome or an Alfa with a gas burner), we service the gas side: burner, gas valve, thermocouple, igniter, regulator, and gas line."
  },
  {
    question: "My pizza oven won't get hot enough. What's usually wrong?",
    answer: "On gas ovens the most common culprits are a partially clogged burner, a failing thermocouple, or a worn regulator that's not delivering full pressure. On electric ovens like the Breville Pizzaiolo, it's usually a heating element, thermal fuse, or temperature sensor. We diagnose on-site and tell you exactly what's happening before we fix anything."
  },
  {
    question: "Do you repair Breville Pizzaiolo?",
    answer: "Yes. The Pizzaiolo is a countertop electric oven that hits 750°F. When it stops reaching temperature or starts throwing error codes, it usually needs heating element inspection, thermal fuse replacement, or control board diagnostics. We work on the full Breville Pizzaiolo lineup."
  },
  {
    question: "Which areas of Southern California do you cover?",
    answer: "Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties: Malibu, Beverly Hills, Pacific Palisades, Silver Lake, Los Feliz LA-side; Newport Coast, Newport Beach, and Anaheim OC; Westlake Village, Hidden Hills, and Thousand Oaks Ventura; Rancho Cucamonga, Riverside, and Temecula IE. Phones are answered 24/7; visits run Monday to Saturday, 8am to 6pm, same day when a technician is available. BHGS #A49573."
  },
  {
    question: "When does it make sense to repair vs replace a pizza oven?",
    answer: "Under 5 years old: repair almost always wins. On a luxury built-in (Wolf, Lynx, Alfresco, Kalamazoo) where replacement runs into the thousands, repair virtually always wins. On a portable Ooni Koda or Bertello where the failure is a major component (gas valve, burner, and thermocouple together), we'll quote both honestly. Sometimes a 6-year-old portable with multiple failures is at end of life; we tell you directly."
  },
  {
    question: "My pizza oven's cooking stone cracked. Can you replace just the stone?",
    answer: "Yes. Stone cracking usually comes from thermal shock, rapid heating or water on a hot surface, on both portable and built-in gas ovens. We replace the cooking stone and cure it properly, typically a $120 to $220 same-day job depending on the model and access. We also check why it cracked so it doesn't happen again on the next firing. $89 diagnostic, waived with repair."
  },
  {
    question: "The door on my gas pizza oven doesn't seal anymore and it's losing heat. Fixable?",
    answer: "Yes. A failed door seal means heat loss and uneven cooking, so we replace the seal (and the hinge if it's worn) to restore a tight close, usually $100 to $180. While we're there we also check the burner and thermocouple, since a weak flame shows up the same way as a leaking door. $89 diagnostic, waived with repair."
  }
];

const brands = [
  { name: "Gozney (gas models)", models: "Dome · Dome S1 · Arc · Roccbox", issues: "Thermocouple, regulator, igniter, gas connection" },
  { name: "Alfa (gas models)", models: "Moderno · 4 Pizze · Nano, gas versions", issues: "Gas burner, thermocouple, gas valve, cooking floor" },
  { name: "Ooni (gas and electric)", models: "Koda 12/16 · Volt 12 · Karu on the gas burner", issues: "Igniter failure, burner clog, temp sensor" },
  { name: "Alfresco", models: "Built-in and countertop gas pizza ovens", issues: "Burner, ignition, gas valve, thermocouple" },
  { name: "Breville Pizzaiolo (electric)", models: "BOV900BSS · BOV900SST", issues: "Heating element, thermal fuse, error codes" },
  { name: "Wolf outdoor built-in", models: "ICBOGP 24\" · ICBOGP 30\" · older Outdoor Living", issues: "Dual-flame burner, infrared ceramic, gas valve" },
  { name: "Fontana (gas models)", models: "Mangiafuoco · Marinara · Riviera, gas versions", issues: "Gas burner, thermocouple, door seal" },
  { name: "Bertello (gas)", models: "Grande · Bertello 12.5 on the gas burner", issues: "Gas valve, burner, stone cracking" },
  { name: "Lynx", models: "Napoli outdoor gas pizza oven", issues: "Burner, ignition, gas valve, thermocouple" },
  { name: "Kalamazoo (gas)", models: "Artisan Fire pizza oven", issues: "Ignition, gas manifold, pizza stone" }
];
---

<Layout title={title} description={description}>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Pizza Oven Repair",
  "name": "Pizza Oven Repair, Same Day Appliance Repair",
  "description": "Home and outdoor gas and electric pizza oven repair across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties: Gozney, Alfa, Ooni, Alfresco, Breville Pizzaiolo, Wolf built-in, Fontana, Bertello, Lynx, Kalamazoo. Gas and electric only; no wood-fired ovens. $89 diagnostic waived with repair. 90-day warranty on parts and labor.",
  "provider": {
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "name": "Same Day Appliance Repair",
    "url": "https://samedayappliance.repair/",
    "telephone": toE164(phone),
    "priceRange": "$$",
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ]
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Los Angeles County" },
    { "@type": "AdministrativeArea", "name": "Orange County" },
    { "@type": "AdministrativeArea", "name": "Ventura County" },
    { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
    { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
  ],
  "offers": {
    "@type": "Offer",
    "priceSpecification": {
      "@type": "PriceSpecification",
      "price": "89.00",
      "priceCurrency": "USD",
      "description": "Residential diagnostic fee, applied toward repair"
    }
  }
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
})} />

<style>
  .section { padding: 72px 24px; }
  .section-inner { max-width: 1080px; margin: 0 auto; }
  .section-gray { background: var(--gray); }
  .section-black { background: var(--black); color: #fff; }
  .section-label { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--red); margin-bottom: 12px; font-weight: 600; }
  .section-black .section-label { color: #ff6b6b; }
  h2 { font-size: clamp(24px, 3vw, 36px); font-weight: 700; line-height: 1.2; margin-bottom: 24px; }
  .section-black h2 { color: #fff; }
  p { margin-bottom: 14px; line-height: 1.7; }
  /* BRANDS */
  .brands-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 28px; }
  .brand-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px; }
  .brand-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 6px; color: var(--text); }
  .brand-card .models { font-size: 13px; color: var(--muted); margin-bottom: 10px; }
  .brand-card .issues { font-size: 13px; color: var(--text); border-top: 1px solid var(--border); padding-top: 10px; margin-top: 10px; }
  /* TYPES */
  .types-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; margin-top: 28px; }
  .type-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 26px; }
  .type-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 12px; }
  .type-card p { font-size: 14px; color: var(--muted); }
  /* PROBLEMS */
  .problems-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-top: 28px; }
  .problem-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px; }
  .problem-card .icon { font-size: 28px; margin-bottom: 10px; }
  .problem-card h4 { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .problem-card p { font-size: 14px; color: var(--muted); margin: 0; }
  /* CASES */
  .cases-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; margin-top: 28px; }
  .case-card { background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12); border-radius: 10px; padding: 22px; }
  .case-card .case-brand { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: #ff8a8a; margin-bottom: 10px; }
  .case-card h4 { font-size: 16px; font-weight: 700; color: #fff; margin-bottom: 12px; line-height: 1.3; }
  .case-card .case-body { font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.65; margin: 0; }
  /* WHY */
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 22px; margin-top: 28px; }
  .why-item { display: flex; gap: 16px; align-items: flex-start; }
  .why-icon { font-size: 26px; flex-shrink: 0; }
  .why-text h4 { font-size: 15px; font-weight: 700; margin-bottom: 6px; }
  .why-text p { font-size: 14px; color: var(--muted); margin: 0; }
  /* PRICING */
  .pricing-table { width: 100%; border-collapse: collapse; margin-top: 28px; background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
  .pricing-table th { background: var(--gray); text-align: left; padding: 14px 18px; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--text); border-bottom: 2px solid var(--border); }
  .pricing-table td { padding: 14px 18px; font-size: 14px; border-bottom: 1px solid var(--border); }
  .pricing-table tr:last-child td { border-bottom: none; }
  .pricing-table .price { font-weight: 700; color: var(--red); white-space: nowrap; }
  /* REVIEWS */
  .reviews-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 22px; margin-top: 28px; }
  .review-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px; }
  .review-text { font-style: italic; color: var(--text); margin-bottom: 12px; font-size: 14px; line-height: 1.6; }
  .review-author { font-size: 13px; color: var(--muted); }
  /* FAQ */
  .faq-list { margin-top: 28px; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 18px 0; }
  .faq-item:first-child { border-top: 1px solid var(--border); }
  .faq-item h3 { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 10px; }
  .faq-item p { font-size: 15px; color: var(--muted); line-height: 1.7; margin: 0; }
  /* NEARBY */
  .nearby-grid { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .nearby-link { font-size: 14px; padding: 8px 14px; border: 1px solid var(--border); border-radius: 20px; color: var(--text); text-decoration: none; }
  .nearby-link:hover { background: var(--gray); border-color: var(--red); color: var(--red); }
  /* BOTTOM CTA */
  .bottom-cta { background: var(--black); color: #fff; padding: 80px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; margin-bottom: 16px; }
  .bottom-cta p { color: #aaa; font-size: 17px; margin-bottom: 28px; max-width: 580px; margin-left: auto; margin-right: auto; }
  .phone-big { font-size: clamp(28px, 5vw, 46px); font-weight: 800; color: var(--red); display: block; margin-bottom: 18px; letter-spacing: -.01em; text-decoration: none; }
  .btn-primary-cta { background: var(--red); color: #fff; padding: 16px 36px; border-radius: 6px; font-size: 17px; font-weight: 600; text-decoration: none; display: inline-block; }
</style>

<!-- ============================================================
  01 HERO + TRUST BAR (unified ServiceHero)
============================================================ -->
<ServiceHero
  slug="pizza-oven-repair"
  eyebrow="Home & Outdoor · Gas & Electric Pizza Oven Repair · Same Day"
  title="Home & Outdoor Pizza Oven Repair in Los Angeles"
  subtitle="Gas and electric pizza ovens for homes and backyard kitchens: Gozney, Alfa, Ooni, Alfresco, Breville Pizzaiolo, Wolf built-in, Fontana, Bertello, Lynx. Same-day across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside & San Diego counties. $89 diagnostic, waived with repair. BHGS #A49573."
  heroImageTitle="Pizza Oven Repair"
/>

<!-- ============================================================
  02 INTRO
============================================================ -->
<section class="section">
  <div class="section-inner">
    <div style="max-width: 720px;">
      <p class="section-label">About This Service</p>
      <h2>Pizza ovens are their own animal. We treat them that way.</h2>
      <p><strong>When an outdoor pizza oven fails at an LA-area home, our techs at Same Day Appliance Repair trace it to a handful of patterns: an igniter that won't fire on a gas unit ($120 to $190), a thermocouple reading low and cutting gas as a safety measure ($130 to $210), or a burner clog or worn regulator that keeps the oven from reaching temperature ($110 to $280). These run from portable Ooni and Gozney units to luxury built-in Wolf ovens in Malibu, Beverly Hills, and Newport Coast outdoor kitchens, on gas and electric. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong></p>
      <p>
        Outdoor pizza ovens have taken over Southern California backyards, LA's Westside luxury kitchens, Newport Coast and Newport Beach OC
        outdoor entertaining setups, Westlake Village Conejo Valley patios, Temecula wine-country estates, and they break in ways
        that most appliance companies aren't set up for. A Gozney Dome runs at 950°F. A Breville Pizzaiolo tops out at 750°F
        and talks in error codes. An Ooni Koda 16 has a gas burner system that's nothing like a kitchen range.
      </p>
      <p>
        We've built out the knowledge and parts inventory to work on all of it. Our techs know the difference
        between a thermocouple failure and a regulator pressure problem on a Roccbox. They know which
        Ooni models have igniter issues from the factory. We work on gas and electric pizza ovens only;
        we don't work on wood-fired ovens.
      </p>
      <p>
        The diagnostic is $89 and it gets waived the moment you say yes to the repair. Most pizza oven jobs
        are done same visit, we carry the common parts.
      </p>
    </div>
  </div>
</section>

<!-- ============================================================
  03 BRANDS WE REPAIR
============================================================ -->
<section class="section section-gray">
  <div class="section-inner">
    <p class="section-label">Brands</p>
    <h2>Pizza oven brands we repair</h2>
    <p style="max-width: 640px; color: var(--muted);">
      From a portable Ooni Koda to a built-in Wolf or Alfresco in a Malibu, Newport Coast, or Westlake Village
      outdoor kitchen, we service gas and electric home pizza ovens across all seven Southern California counties.
    </p>
    <div class="brands-grid">
      {brands.map(brand => (
        <div class="brand-card">
          <h3>{brand.name}</h3>
          <p class="models">{brand.models}</p>
          <div class="issues">Common: {brand.issues}</div>
        </div>
      ))}
    </div>
    <p style="margin-top: 24px; font-size: 14px; color: var(--muted);">
      Don't see your brand? Call us. If it runs on gas or electric, we've likely worked on it.
    </p>
    <p style="margin-top: 16px; font-size: 14px; color: var(--muted);">
      <strong>Luxury outdoor built-in:</strong> Wolf ICBOGP pizza ovens integrate into Sub-Zero Group matched suites alongside Wolf BBQ grills, Sub-Zero outdoor refrigerators, and Cove outdoor dishwashers.
    </p>
  </div>
</section>

<!-- ============================================================
  04 RESIDENTIAL vs COMMERCIAL SCOPE
============================================================ -->
<section class="section">
  <div class="section-inner">
    <div style="max-width: 820px;">
      <p class="section-label">Home vs Restaurant</p>
      <h2>Home and outdoor pizza ovens vs restaurant production ovens</h2>
      <p>
        This page covers <strong>home and outdoor</strong> pizza oven repair: backyard built-ins (Wolf, Alfresco, Lynx,
        Kalamazoo), portable gas ovens (Gozney, Ooni, Alfa, Fontana, Bertello), and countertop electric
        (Breville Pizzaiolo). Gas and electric only.
      </p>
      <p>
        <strong>Restaurant pizza ovens</strong> are a separate service line: conveyor ovens (<strong>Middleby Marshall</strong>,
        <strong>Lincoln Impinger</strong>, <strong>XLT</strong>) and gas deck ovens (<strong>Bakers Pride</strong>, <strong>Marsal</strong>,
        <strong>Blodgett</strong>, <strong>Peerless</strong>), with a $120 commercial diagnostic.
        <a href="/commercial/pizza-oven-repair/" style="color: var(--red); font-weight: 600;">Restaurant or pizzeria oven? See commercial pizza oven repair</a>.
      </p>
      <p>
        <strong>What a repair visit covers:</strong> burner, ignition, temperature control, gas valve, regulator,
        heating element, thermocouple, door seal, and cooking stone replacement. Deep grease and carbon cleaning
        is not part of a repair visit.
      </p>
    </div>
  </div>
</section>

<!-- ============================================================
  05 OVEN TYPES
============================================================ -->
<section class="section section-gray">
  <div class="section-inner">
    <p class="section-label">Oven Types</p>
    <h2>Gas and electric pizza ovens, the two we work on</h2>
    <div class="types-grid">
      <div class="type-card">
        <h3>🔥 Gas Pizza Ovens</h3>
        <p>
          Gozney Dome and Arc, Ooni Koda, Alfa, Alfresco, Wolf, Lynx, Fontana, Bertello. Gas ovens fail at the
          burner, the thermocouple, the regulator, or the ignition system. We diagnose the actual
          cause, not just swap parts until something works.
        </p>
      </div>
      <div class="type-card">
        <h3>⚡ Electric Pizza Ovens</h3>
        <p>
          Breville Pizzaiolo is in more Southern California kitchens than you'd think. Countertop electric at 750°F
          means serious heating elements and thermal management. Error codes, temperature
          failures, and heating element replacements, we have the parts.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
  06 COMMON PROBLEMS
============================================================ -->
<section class="section">
  <div class="section-inner">
    <p class="section-label">What We Fix</p>
    <h2>Common pizza oven problems we see across Southern California</h2>
    <div class="problems-grid">
      <div class="problem-card">
        <div class="icon">🌡️</div>
        <h4>Oven won't reach temperature</h4>
        <p>Regulator pressure, clogged burner, or faulty thermocouple on gas; element or sensor on electric. We test before any parts.</p>
      </div>
      <div class="problem-card">
        <div class="icon">🔴</div>
        <h4>Igniter not firing</h4>
        <p>Ooni Koda igniters have a known failure rate. Gozney piezo units go too. Usually a 30-minute repair.</p>
      </div>
      <div class="problem-card">
        <div class="icon">💨</div>
        <h4>Uneven heat / hotspots</h4>
        <p>Often a burner clog or uneven flame distribution, sometimes a cracked stone that no longer holds heat evenly.</p>
      </div>
      <div class="problem-card">
        <div class="icon">💡</div>
        <h4>Error codes (Breville / electric)</h4>
        <p>Breville Pizzaiolo throws codes when the heating element or thermal fuse fails. We read the codes, don't guess.</p>
      </div>
      <div class="problem-card">
        <div class="icon">🚪</div>
        <h4>Door seal / hinge damage</h4>
        <p>Doors take abuse. Seal failure means heat loss and uneven cooking. We replace seals on all major gas models.</p>
      </div>
      <div class="problem-card">
        <div class="icon">🪨</div>
        <h4>Cracked stone or floor tile</h4>
        <p>Thermal shock from rapid heating or water exposure cracks cooking surfaces. Floor replacement is usually a same-day job.</p>
      </div>
      <div class="problem-card">
        <div class="icon">⛽</div>
        <h4>Gas connection problems</h4>
        <p>Regulator failures, flex line leaks, manifold issues. We pressure-test before and after every gas repair.</p>
      </div>
      <div class="problem-card">
        <div class="icon">🔌</div>
        <h4>Electric oven won't heat</h4>
        <p>Failed heating element, blown thermal fuse, or a control board fault. We test each part before replacing anything.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============================================================
  07 RECENT REPAIRS
============================================================ -->
<section class="section section-black">
  <div class="section-inner">
    <p class="section-label">Recent Work</p>
    <h2>Recent pizza oven repairs across Southern California</h2>
    <div class="cases-grid">
      <div class="case-card">
        <div class="case-brand">Ooni Koda 16 · Malibu (LA)</div>
        <h4>"Flame keeps going out after about 5 minutes"</h4>
        <p class="case-body">
          Thermocouple on the Koda 16 was reading low and cutting gas flow as a safety measure.
          Classic sign: oven lights, runs for a few minutes, shuts off. Replaced the thermocouple,
          tested for 20 minutes, held steady at 900°F. Client was back to cooking the same night.
        </p>
      </div>
      <div class="case-card">
        <div class="case-brand">Gozney Roccbox · Silver Lake (LA)</div>
        <h4>"Clicks but won't light, and sometimes smells like gas"</h4>
        <p class="case-body">
          Gas was flowing but the piezo igniter wasn't producing a consistent spark. The smell told us
          there was also a small regulator o-ring issue releasing trace gas before ignition.
          Replaced the igniter assembly and regulator seal. Pressure-tested the full gas path before signing off.
        </p>
      </div>
      <div class="case-card">
        <div class="case-brand">Breville Pizzaiolo · Newport Coast (OC)</div>
        <h4>"E3 error code, stopped heating halfway through preheat"</h4>
        <p class="case-body">
          E3 on the Pizzaiolo typically means a thermal fuse has blown, usually triggered by a preceding
          heating element failure running the unit too hot. Replaced both the fuse and the upper element.
          Unit now reliably hits 750°F in about 12 minutes as spec'd.
        </p>
      </div>
    </div>
  </div>
