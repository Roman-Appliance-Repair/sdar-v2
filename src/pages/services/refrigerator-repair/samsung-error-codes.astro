// Info Wave I-2 — "samsung refrigerator error codes" (450 vol/mo KD 0). Final page 6/6.
// Informational, answer-first. Per-brand code umbrella. Codes verified against Samsung
// US support (TSG10007315 / ANS10006925).
// DIFFERENTIATOR: OF OF / O FF = Cooling Off / Demo mode (NOT a fault) in answer-first
// lead. NOT PUBLISHED: 8E1 (unconfirmed), firm 41E/42E/43E meaning (sources conflict).
// Safe DIY = exit demo, power cycle, defrost, check outlet; escalate sensors/compressor.
// Pillar: /services/refrigerator-repair/ (residential, $89). Schema: LocalBusiness +
// Service + FAQPage + BreadcrumbList.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
