const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/samsung-error-codes/";

const title = "Samsung Refrigerator Error Codes Explained — Same Day";
const description = "Samsung fridge showing OF OF, 22E, 5E, or 88 88? A plain-English guide to the common Samsung refrigerator codes — including why OF OF isn't a breakdown — and which need a tech.";

const faqs = [
  {
    q: "What does OF OF mean on a Samsung refrigerator?",
    a: "OF OF (sometimes shown as O FF, OFF OFF, or scrolling bars) is not a breakdown — it's Cooling Off / Demo mode, the setting stores use to light up the display without running the compressor. Owners trigger it by accident and think the fridge died. The panel works but nothing cools. To exit, hold the correct button combination for about 8 seconds until you hear a chime; the exact buttons vary by model (often the top two on the left, or a Power Freeze + Freezer/Lock combo). Check your model's manual for the sequence. Once you exit demo mode, cooling and ice resume."
  },
  {
    q: "What does the 22E code mean on a Samsung fridge?",
    a: "22E (shown as 22E or 22C depending on the model generation — E and C are the same fault) is a refrigerator fan error: the evaporator fan isn't giving its rotation feedback. The usual cause is frost or ice locking the fan blade, often after a door was left open too long, or a failed fan motor. Try powering the fridge off and doing a manual defrost for about 24 hours, then verify the vents are clear. If 22E returns, the fan motor or defrost system needs a tech. The freezer version of this fault is 21E."
  },
  {
    q: "Are the E and C suffixes on Samsung codes different?",
    a: "No — E and C are model-generation variants of the same code. Newer Samsung refrigerators tend to show a letter-plus-number like 22 C, while older ones show 22E, but they mean the same fault. So 39E and 39C are the same ice-maker error, and 40E and 40C are the same ice-room fan fault. Read the number and the fault; the E-versus-C suffix just reflects how old the model's display is."
  },
  {
    q: "Which Samsung refrigerator codes point to the ice maker?",
    a: "Several. 39E/39C means the ice maker isn't completing its harvest cycle, 26E is an ice-maker function error, 40E/40C is the ice-room fan, and 8E and 14E are ice-maker sensor faults. Samsung ice makers frost over as a well-documented pattern, so these codes often trace back to ice in the compartment. A forced defrost is usually the first thing to try; if the code returns, the seal, fan, or sensor needs attention. We cover the whole thing on our Samsung ice maker page."
  },
  {
    q: "My Samsung fridge shows 88 88 — what is that?",
    a: "88 88 (sometimes 888) is a display or communication glitch, typically triggered when power was interrupted during the refrigerator's start-up. The fix is usually simple: unplug the fridge for a full minute, then restore power, and it often self-clears. If 88 88 or a PC ER communication code keeps coming back, there's a loose wiring harness (commonly under the left door hinge on French-door models) or a board issue, and that's a tech job."
  }
];

