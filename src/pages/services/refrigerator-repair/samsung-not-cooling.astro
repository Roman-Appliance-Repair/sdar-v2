const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/samsung-not-cooling/";

const title = "Samsung Refrigerator Not Cooling? Causes & Fix — Same Day";
const description = "Samsung refrigerator not cooling? First check for OF OF / demo mode — it's not a breakdown. Then the Twin Cooling evaporator fan, defrost, and coils. Safe checks, food-safety timing, and when to call.";

const faqs = [
  {
    q: "Why is my Samsung refrigerator not cooling?",
    a: "First, rule out a non-fault: if the panel is lit but nothing's cooling and you see OF OF (or O FF, or scrolling bars), that's Cooling Off / demo mode, not a breakdown — exit it before troubleshooting anything. If it's genuinely not cooling, the common causes are a failed evaporator fan (which shows as 'freezer cold, fridge warm'), a defrost system iced over the evaporator, dirty condenser coils, and a bad thermistor or control board. Samsung's Twin Cooling models have separate evaporators for the fridge and freezer, so one side can warm while the other stays cold. Coils and airflow are yours to check; the sealed system is a tech job."
  },
  {
    q: "My Samsung shows OF OF (or O FF) and won't cool — is it broken?",
    a: "No — OF OF, O FF, or scrolling bars mean the refrigerator is in Cooling Off / demo (shop) mode, the showroom setting that lights the panel but disables cooling, ice, and the dispenser. People trigger it by accident and think the fridge died. To exit, press and hold the two arrow buttons together for about eight seconds until you hear a chime; the exact button combination varies by model, so check your manual if that doesn't work. Once you exit demo mode, cooling resumes. It's the first thing to rule out on any Samsung that's lit but not cold."
  },
  {
    q: "My Samsung freezer is cold but the fridge is warm — what's wrong?",
    a: "On a Twin Cooling Plus Samsung, the fridge and freezer have their own evaporators and fans, so this split usually means the fridge-side evaporator fan has failed or its coil has frosted over. On single-evaporator models, it's the shared evaporator fan not pushing cold air up to the fridge. Either way it's a fan or defrost fault inside the cabinet — a common, fixable repair, and a tech job. Keep the doors closed while you wait; the fridge food is on roughly a four-hour clock."
  },
  {
    q: "Can I fix a Samsung refrigerator that's not cooling myself?",
    a: "Some of it. First exit demo mode if you see OF OF. Then vacuum the condenser coils, make sure interior vents aren't blocked by food, confirm the doors seal and the temperature is set right, pull the fridge a few inches off the wall so it can shed heat, and give it a power-cycle. What you should not do is open the sealed refrigeration system, test the compressor, or replace the control board — those carry shock and refrigerant risks and are a tech's job. If it's clearly warm inside and demo mode isn't the cause, call the same day."
  },
  {
    q: "How long is food safe in a Samsung that stopped cooling?",
    a: "Per USDA and FDA guidance, a refrigerator keeps food safe for about 4 hours with the door kept closed, and a full freezer holds a safe temperature for roughly 48 hours (24 hours if half-full) if you keep it shut. Perishable food — meat, poultry, seafood, eggs, milk, cut produce, leftovers — held above 40°F for 2 hours or more should be thrown out. When in doubt, throw it out, and never taste food to check. That 4-hour fridge window is why a no-cool refrigerator is a same-day call — keep the doors closed and get a tech out before it closes."
  }
];

