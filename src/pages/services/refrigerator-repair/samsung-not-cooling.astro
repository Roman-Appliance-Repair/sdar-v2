// Info Wave W5 page 2/9 — "samsung refrigerator not cooling" (2,400/mo KD0). Brand sniper.
// Samsung differentiator: OF OF / O FF = Cooling Off / demo mode (NON-fault) in answer-
// first lead (repeat of the error-codes-page differentiator). Twin Cooling Plus (2 evap),
// evap fan, defrost, thermistor. Food-safety block (USDA/FDA). Codes cross-ref samsung-
// error-codes. Safe DIY only. umbrella<->sniper links. $89.

import Layout from '../../../layouts/Layout.astro';
