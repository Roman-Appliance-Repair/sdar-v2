const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/kenmore-not-cooling/";

const title = "Kenmore Refrigerator Not Cooling? Who Made Yours";
const description = "Kenmore refrigerator not cooling? The first 3 digits of your model number tell you who actually built it — Whirlpool, LG, Frigidaire, GE, or Samsung — and that decides the fix. Prefix table, safe checks, food-safety timing.";

const faqs = [
  {
    q: "Who actually makes Kenmore refrigerators?",
    a: "Kenmore is Sears' house brand — the refrigerators are built by other manufacturers and badged Kenmore. The first three digits of your model number tell you who: 106, 110, 596, and 562 are Whirlpool; 253 and 417 are Frigidaire (Electrolux); 795 and 796 are LG; 363 and 364 are GE; 401 and 402 are Samsung. That prefix decides which parts and which diagnosis apply, so it's the first thing to find when a Kenmore won't cool. The model number is on a sticker inside the fridge — often on a side wall or near the crisper drawers."
  },
  {
    q: "Why is my Kenmore refrigerator not cooling?",
    a: "The causes are the same as any fridge, but the parts depend on who built it: dirty condenser coils (the most common and homeowner-fixable), a failed evaporator fan (shows as 'freezer cold, fridge warm'), a defrost system iced over the evaporator, the control board, and — the serious end — a locked compressor or sealed-system fault. Start by cleaning the coils and confirming airflow. Find your model prefix so a tech brings the right Whirlpool, LG, Frigidaire, GE, or Samsung parts to the first visit. Cleaning coils is yours to do; the board and sealed system are a tech job."
  },
  {
    q: "My Kenmore freezer is cold but the fridge is warm — what's wrong?",
    a: "That split — cold freezer, warm fridge — is the classic evaporator fan failure, and it's the same on a Kenmore whoever built it. The evaporator fan blows cold air from the freezer coil up into the fridge; when it fails or frost from a defrost fault jams it, the freezer stays cold but the fridge warms. On a 795/796 (LG-built) Kenmore this often traces to the same linear-compressor-era cooling behavior LG units show; on a 106/110 (Whirlpool-built) it's usually the fan or defrost. Both are tech-level repairs inside the cabinet. Keep the doors closed — the fridge food is on roughly a four-hour clock."
  },
  {
    q: "Does a Kenmore refrigerator show an error code when it's not cooling?",
    a: "It depends entirely on who built it. A 795/796 (LG-built) Kenmore can show LG-style codes; a 401/402 (Samsung-built) can show Samsung-style ones; a 106/110 (Whirlpool-built) or a GE-built 363/364 is mostly diagnosed by symptom with few no-cool codes. There's no single 'Kenmore code list' because there's no single Kenmore refrigerator — the code behavior follows the real manufacturer. That's the whole reason the model prefix matters before anyone starts guessing."
  },
  {
    q: "How long is food safe in a Kenmore that stopped cooling?",
    a: "Per USDA and FDA guidance, a refrigerator keeps food safe for about 4 hours with the door kept closed, and a full freezer holds a safe temperature for roughly 48 hours (24 hours if half-full) if you keep it shut. Perishable food — meat, poultry, seafood, eggs, milk, cut produce, leftovers — held above 40°F for 2 hours or more should be thrown out. When in doubt, throw it out, and never taste food to check. That 4-hour fridge window is why a no-cool refrigerator is a same-day call — keep the doors closed and get a tech out before it closes."
  }
];

