const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/lg-error-codes/";

const title = "LG Refrigerator Error Codes Explained — Same Day";
const description = "LG fridge showing FF, dH, CO, or CL? A plain-English guide to the common LG refrigerator error codes, which you can clear yourself, and which need a tech — plus why CL isn't an error at all.";

const faqs = [
  {
    q: "What does CL mean on an LG refrigerator?",
    a: "On its own, CL is not an error — it's the Child Lock indicator. The control panel is locked so buttons don't respond, usually switched on by accident. Hold the Lock button (often labeled on the dispenser panel) for about 3 to 5 seconds to turn it off. Don't confuse plain CL with CL-E or CH-E, which are different and serious: those indicate a refrigerant (sealed-system) issue on the low or high side and need a tech. If your panel just won't respond and shows CL, try the lock button before you worry."
  },
  {
    q: "What is the FF code on an LG refrigerator?",
    a: "FF (shown as FF, Er FF, or E FF depending on the model) is a freezer evaporator fan fault. Either the fan motor has failed or — very commonly — frost has built up and locked the fan blade. The first thing to try is a power cycle: unplug the fridge for five minutes and restart. If the fan is frost-locked, unplugging the unit and letting the freezer thaw fully with the doors open (about a day) clears it. If FF returns after that, the fan motor or the defrost system is the real cause and needs a tech."
  },
  {
    q: "Does the Er or E prefix on LG codes mean anything different?",
    a: "No. LG displays the same code as FF, Er FF, ER FF, or E FF across different model generations — the prefix is cosmetic. What matters is the two-letter code itself. So Er dH and dH are the same defrost fault, and Er CO and CO are the same communication error. Read the two letters and ignore whether an E or Er sits in front."
  },
  {
    q: "Which LG error codes can I fix myself?",
    a: "The ones tied to a power glitch, frost, water supply, or the child lock. CO (communication) often clears with a 60-second unplug. FF, IF, and 1F (fan codes) frequently clear after a full defrost if frost was locking the blade. gF (water flow) is worth checking your water supply valve and line for. CL is just the child lock. The codes you should not try to clear yourself are the sensor faults — FS, rS, dS, HS — and any code that keeps returning after a reset, because those mean a failed part that needs testing and replacement."
  },
  {
    q: "My LG fridge shows dH — is that serious?",
    a: "dH means the defrost cycle ran too long without completing, which points to a failed defrost heater, defrost sensor, or thermal fuse. It's not an emergency, but it won't fix itself: without a working defrost, frost builds on the coil until cooling drops off. A single power cycle is worth trying, but if dH comes back, it's a diagnostic. Our techs test the defrost heater, sensor, and fuse and replace the failed one. $89 residential diagnostic, waived with the repair."
  }
];

