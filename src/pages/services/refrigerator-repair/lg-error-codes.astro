// Info Wave I-2 — "lg refrigerator error codes" (700 vol/mo KD 6).
// Informational, answer-first. Per-brand code umbrella. Codes verified against LG
// US support (error-code-list, digital/analog, FF/rF + CO troubleshooting pages).
// DIFFERENTIATOR: CL = Child Lock (NOT an error) in the answer-first lead; CL-E/CH-E
// refrigerant-leak distinction called out. Safe DIY = power cycle, defrost thaw,
// water supply, child-lock release; escalate sensors/persistent codes to tech.
// Pillar: /services/refrigerator-repair/ (residential, $89). Schema: LocalBusiness +
// Service + FAQPage + BreadcrumbList.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
