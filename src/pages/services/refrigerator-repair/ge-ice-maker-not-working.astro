const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/ge-ice-maker-not-working/";

const title = "GE Ice Maker Not Working? Causes & Fix — Same Day";
const description = "GE refrigerator not making ice? Start with the filter, supply, and freezer temp, then the feeler arm and GE's reset steps. What to check yourself, why Quick Ice isn't a reset, and when it's a tech job.";

const faqs = [
  {
    q: "Why is my GE refrigerator not making ice?",
    a: "Work the water path first: a clogged water filter (replace every six months), a supply valve that's partly closed or a kinked line, a frozen fill tube, a freezer that's too warm to cycle, and the ice maker switched off. On GE, the feeler (bail) arm is the most common single culprit — a stuck or raised arm tells the ice maker the bin is full, so it stops harvesting even when it's empty. If the water path and arm are fine, the fault is usually the water inlet valve or the ice maker module, which are tech jobs."
  },
  {
    q: "How do I reset a GE ice maker?",
    a: "GE gives a few ways depending on the model. The simplest: find the power switch on the side or bottom of the ice maker, turn it off for at least 15 seconds, then back on. Many GE ice makers also have a recessed reset button — remove the ice bucket to reach it and hold it 3 to 5 seconds until a light flashes or the arm moves. You can also cycle the feeler arm: push it up to the off position, wait, then pull it down to on to force a harvest. After any reset, give it several hours for the first batch. Note that 'Quick Ice' is a production-boost feature, not a reset — it won't fix a stopped ice maker."
  },
  {
    q: "The feeler arm on my GE ice maker seems stuck — is that the problem?",
    a: "Very likely. GE ice makers use a wire feeler (bail) arm that rides on top of the ice; when the bin fills, the arm lifts and shuts off production. If the arm is jammed up by a clump of ice, frozen in place, or knocked to the off position, the ice maker thinks the bin is full and stops even when it's empty. Gently free the arm and make sure it moves down to the on position, then run a harvest with the reset. If the arm is broken or the linkage inside the module has failed, that's a tech repair."
  },
  {
    q: "Can I fix a GE ice maker that won't work myself?",
    a: "Several parts, yes: replace an overdue filter, confirm the supply valve is open and the line isn't kinked, free a stuck feeler arm and make sure it's down, verify the freezer is cold enough, thaw a frozen fill tube gently, and run GE's reset (power switch or reset button). What you shouldn't do is replace the water inlet valve or open the ice maker module — those are electrically live, plumbed-in tech jobs. If the reset and water checks don't restore ice, that's the handoff point."
  },
  {
    q: "Is it worth repairing a GE ice maker?",
    a: "Usually yes. The no-ice fixes — a filter, a fill-tube thaw, the water inlet valve, or the ice maker module — are affordable against a refrigerator you're keeping. Our techs verify the water path and the feeler arm first (a stuck arm or clogged filter mimics a dead maker), then test the valve and module before quoting. In LA's hard water, mineral scale on the inlet-valve screen and fill tube is a common flow restriction that's often the whole fix. $89 residential diagnostic, waived with the repair."
  }
];

