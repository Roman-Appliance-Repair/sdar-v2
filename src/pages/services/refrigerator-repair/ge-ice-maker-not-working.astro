// Info Wave W3 page 4/6 — "ge ice maker not working" (1,200/mo) + "ge refrigerator ice
// maker not working" (400). Fridge-scoped brand sniper.
// GE specifics: feeler (bail) arm = primary trigger (stuck arm = leading no-harvest);
// reset = side power switch off >=15s / recessed reset button hold 3-5s / feeler-arm
// cycle. "Quick Ice" is a BOOST feature, NOT a reset (do not conflate). Universal chain.
// Safe DIY only. LA hard water. umbrella<->sniper + fridge<->standalone links. $89.

import Layout from '../../../layouts/Layout.astro';
