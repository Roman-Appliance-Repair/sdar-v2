---
// src/pages/services/refrigerator-repair/kenmore-ice-maker-not-working.astro
// Info Wave W3 page 5/6 — "kenmore ice maker not working" (500/mo KD0). Fridge-scoped.
// DIFFERENTIATOR: Kenmore = Sears house brand; first 3 model digits = actual maker
// (FRIDGE prefixes verified): 106=Whirlpool (+110/596/562), 253=Frigidaire/Electrolux
// (417), 795/796=LG, 363/364=GE, 401/402=Samsung (soft/medium-conf). Maker table in
// answer-first lead + hub cross-links to W3 brand pages + I-2 samsung page. Universal
// water chain. Safe DIY only. LA hard water. umbrella<->sniper + fridge<->standalone. $89.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../../lib/build-location-array';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/kenmore-ice-maker-not-working/";

const title = "Kenmore Ice Maker Not Working? Who Made Yours — Same Day";
const description = "Kenmore refrigerator not making ice? Kenmore is a Sears brand — the first 3 digits of your model number reveal the real maker, the parts, and the reset.";

const faqs = [
  {
    q: "Who actually makes Kenmore refrigerators?",
    a: "Kenmore is a Sears house brand, not a manufacturer — the refrigerators are built by other companies and badged Kenmore. The first three digits of your model number identify who really built it: 106 (also 110, 596, 562) is Whirlpool, which built the most Kenmore refrigerators; 253 is the Frigidaire/Electrolux family; 795 or 796 is LG; 363 or 364 is GE; and 401 or 402 indicates a Samsung-built unit. This matters for a no-ice repair because a Whirlpool-built Kenmore takes Whirlpool ice-maker parts and reset steps, an LG-built one takes LG parts and uses LG's Test button, and so on — same badge, different hardware."
  },
  {
    q: "Why is my Kenmore refrigerator not making ice?",
    a: "Whoever built it, the water path comes first: a clogged water filter (replace every six months), a supply valve that's partly closed or a kinked line, a frozen fill tube, a freezer that's too warm to cycle, and the ice maker being off or its feeler arm stuck up. If those check out, the fault is usually the water inlet valve or the ice maker itself — and the specific part and the reset procedure depend on the real maker, which the model-number prefix tells you."
  },
  {
    q: "Where do I find my Kenmore model number?",
    a: "It's on a rating label, usually inside the refrigerator on a side wall or ceiling, or along the door frame. It typically starts with three digits, then a period, then more digits (for example 106.xxxxxxx). Those first three digits are the key: match them to the maker list above to know whether your no-ice repair needs Whirlpool, Frigidaire, LG, GE, or Samsung parts — and which brand's reset steps to use. If you're unsure, our techs identify the maker from the model number when you call."
  },
  {
    q: "Can I fix a Kenmore ice maker that won't work myself?",
    a: "The safe steps are the same no matter who built your Kenmore: replace an overdue filter, confirm the supply valve is open and the line isn't kinked, free a stuck feeler arm and make sure the maker is on, verify the freezer is cold enough, and thaw a frozen fill tube gently. A reset (power-cycle, or the maker's own button) clears many transient faults. Don't replace the water inlet valve or open the ice maker module — those are electrically live, plumbed-in tech jobs. If the water checks and reset don't restore ice, that's the handoff point."
  },
  {
    q: "Is it worth repairing a Kenmore ice maker?",
    a: "Usually yes. The no-ice fixes — a filter, a fill-tube thaw, the water inlet valve, or the ice maker assembly — are affordable against a refrigerator you're keeping, and they're the same mainstream parts as the underlying brand. Our techs identify the real maker from your model number, carry the right Whirlpool, LG, or Samsung part, and verify the water path first. In LA's hard water, mineral scale on the inlet-valve screen and fill tube is a common flow restriction that's often the whole fix. $89 residential diagnostic, waived with the repair."
  }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" },
