const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/frigidaire-not-cooling/";

const title = "Frigidaire Refrigerator Not Cooling? Fixes — Same Day";
const description = "Frigidaire refrigerator not cooling? Usually dirty condenser coils, the evaporator fan, or the control board (a known weak point). Safe checks, when to call.";

const faqs = [
  {
    q: "Why is my Frigidaire refrigerator not cooling?",
    a: "On a Frigidaire that runs but won't cool, the most common cause is dirty condenser coils that can't shed the compressor's heat. Next is a failed evaporator fan (which shows as 'freezer cold, fridge warm'), and on Frigidaire and Electrolux the electronic control board is a documented weak point — a dead evaporator fan often traces back to a failed board. A locked compressor or sealed-system fault is the serious end. Cleaning the coils and checking airflow are yours to do; the board, fan, and sealed system are a tech job. If it's clearly warm inside, call the same day — your food is on a clock."
  },
  {
    q: "Is the control board a common problem on Frigidaire refrigerators?",
    a: "Yes — the main electronic control board is one of the more frequently cited Frigidaire and Electrolux failure points on no-cool refrigerators. The board manages the compressor cycling, the fans, and the defrost timing, so when it fails the symptoms can look like several different parts at once: a fan that won't run, a compressor that won't cycle, or erratic temperatures. That's why we test the board rather than assuming it's a simple fan — swapping a fan on a bad-board fridge just leaves you with the same problem. It's a tech diagnosis and replacement."
  },
  {
    q: "My Frigidaire freezer is cold but the fridge is warm — what's wrong?",
    a: "That split — cold freezer, warm fridge — is the classic evaporator fan failure. The evaporator fan blows cold air from the freezer coil up into the fridge; when it fails, or when a control-board fault stops it running, the freezer stays cold but the fridge warms. On Frigidaire, checking whether the fan itself is dead or whether the board isn't powering it is part of the diagnosis. Either way it's a tech job inside the cabinet. Keep the doors closed while you wait — the fridge food is on roughly a four-hour clock."
  },
  {
    q: "Can I fix a Frigidaire refrigerator that's not cooling myself?",
    a: "Some of it. Vacuum the condenser coils (behind the rear panel or under a front kick-plate) — on Frigidaire this is the number-one cause and often the whole fix. Make sure interior vents aren't blocked, confirm the doors seal and the temperature is set right, pull the fridge a few inches off the wall to shed heat, and give it a power-cycle. What you should not do is open the sealed refrigeration system, test the compressor, or replace the control board — those carry shock and refrigerant risks and are a tech's job. If it stays warm after a coil clean, call the same day."
  },
  {
    q: "How long is food safe in a Frigidaire that stopped cooling?",
    a: "Per USDA and FDA guidance, a refrigerator keeps food safe for about 4 hours with the door kept closed, and a full freezer holds a safe temperature for roughly 48 hours (24 hours if half-full) if you keep it shut. Perishable food — meat, poultry, seafood, eggs, milk, cut produce, leftovers — held above 40°F for 2 hours or more should be thrown out. When in doubt, throw it out, and never taste food to check. That 4-hour fridge window is why a no-cool refrigerator is a same-day call — keep the doors closed and get a tech out before it closes."
  }
];

