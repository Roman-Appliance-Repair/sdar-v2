// Info Wave W5 page 9/9 — "amana refrigerator not cooling" (300/mo KD0).
// Amana = Whirlpool value line. Differentiator = value/simplicity + honest
// repair-vs-replace math on an inexpensive fridge. Same Whirlpool cooling parts.
// Cross-links whirlpool anchor + siblings. Food-safety block. Safe DIY only. $89.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../../lib/build-location-array';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/amana-not-cooling/";

const title = "Amana Refrigerator Not Cooling? Causes & Fix";
const description = "Amana refrigerator not cooling? It's Whirlpool's value line — dirty coils, the start relay, the evaporator fan, or defrost. We'll give you the honest repair-vs-replace math on a low-cost fridge. Safe checks, food-safety timing.";

const faqs = [
  {
    q: "Why is my Amana refrigerator not cooling?",
    a: "Amana is Whirlpool's value line and its refrigerators run on the Whirlpool platform, so the causes are the same familiar short list: dirty condenser coils, a failed compressor start relay (often 'clicking' at the back), a failed evaporator fan ('freezer cold, fridge warm'), a defrost system iced over the evaporator, the control board, and — the serious end — a locked compressor or sealed-system fault. Amana refrigerators are relatively simple, so many no-cool cases are a coil clean or a single inexpensive part. Cleaning the coils and checking airflow are yours to do; the relay, board, and sealed system are a tech job. On an inexpensive fridge, we'll always give you the honest repair-vs-replace math before you spend."
  },
  {
    q: "Is it worth repairing an Amana that won't cool?",
    a: "Usually yes — but it depends on the fault. Amana is a value-priced brand, so the repair math matters more than on a premium fridge. A dirty-coil fix, a start relay, an evaporator fan, or a defrost part is almost always worth doing — those repairs are modest and the fridge is otherwise fine. The one that changes the math is a compressor or sealed-system failure on an older unit: if the sealed-system repair approaches the cost of a comparable new value fridge, replacing can be the smarter call. Our techs diagnose the exact fault first and tell you straight which side of that line you're on — we don't sell you a repair that doesn't make sense."
  },
  {
    q: "My Amana freezer is cold but the fridge is warm — what's wrong?",
    a: "That split — cold freezer, warm fridge — is the classic evaporator fan failure, same as on any Whirlpool-platform fridge. The evaporator fan blows cold air from the freezer coil up into the fridge; when it fails or frost from a defrost fault jams it, the freezer stays cold but the fridge warms. On Amana the frost usually traces back to a defrost heater, sensor, or control that's stopped running its cycle — and on this value platform those are affordable, worthwhile repairs. Keep the doors closed while you wait — the fridge food is on roughly a four-hour clock."
  },
  {
    q: "What's the clicking sound from the back of my Amana?",
    a: "A click every few minutes from the bottom-rear, with the fridge slowly warming, is often the compressor start relay cycling — it tries to start the compressor, fails, trips its overload, and tries again. On the Whirlpool platform Amana uses, that relay is a common and well-understood no-cool part — and an inexpensive one, which is good news on a value fridge. Don't keep running it in that state; the repeated starting stresses the compressor, and a stressed compressor is the one repair that can tip an Amana toward replacement. Get it diagnosed promptly."
  },
  {
    q: "How long is food safe in an Amana that stopped cooling?",
    a: "Per USDA and FDA guidance, a refrigerator keeps food safe for about 4 hours with the door kept closed, and a full freezer holds a safe temperature for roughly 48 hours (24 hours if half-full) if you keep it shut. Perishable food — meat, poultry, seafood, eggs, milk, cut produce, leftovers — held above 40°F for 2 hours or more should be thrown out. When in doubt, throw it out, and never taste food to check. That 4-hour fridge window is why a no-cool refrigerator is a same-day call — keep the doors closed and get a tech out before it closes."
  }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
    ],
