// Info Wave W3 page 3/6 — "lg ice maker not working" (2,100/mo) + "lg refrigerator ice
// maker not working" (800). Fridge-scoped brand sniper.
// LG specifics (OEM-verified): freezer below 19F (rec -4F); Ice On/Off hold 3-5s; Test
// button (pinhole, hold ~3s); reset = remove bin/shake/power-off 30s/wait 4-6h; Craft
// Ice = unplug 10min + 24h. Universal chain. LG linear-compressor->no-ice OMITTED (not
// OEM, per Roman). Safe DIY only. LA hard water. umbrella<->sniper + fridge<->standalone.

import Layout from '../../../layouts/Layout.astro';
