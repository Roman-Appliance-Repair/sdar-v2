const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/refrigerator-repair/lg-ice-maker-not-working/";

const title = "LG Ice Maker Not Working? Causes & Fix — Same Day";
const description = "LG refrigerator not making ice? Start with the filter, supply, and freezer temp, then use LG's Test button and reset steps. What to check yourself, Craft Ice notes, and when it's a tech job.";

const faqs = [
  {
    q: "Why is my LG refrigerator not making ice?",
    a: "Work the water path first. The common operator-fixable causes are a clogged water filter (replace every six months), a supply valve that's partly closed or a kinked line, a frozen fill tube, a freezer that isn't cold enough, and the ice maker being switched off. LG is specific about temperature: the freezer needs to be below about 19°F, with -4°F recommended, for the ice maker to run — a freezer running warm is a common no-ice cause. If the water path and temperature are fine, the fault is usually the water inlet valve or the ice maker assembly, which are tech jobs."
  },
  {
    q: "How do I reset an LG ice maker?",
    a: "Per LG's own guidance: first confirm the ice maker is on — hold the Ice On/Off button for 3 to 5 seconds until 'Ice On' shows, or check the physical switch on the ice maker. To force a harvest, press the Test button (some models have a visible button, others a small pinhole you reach with a straightened paperclip) and hold about 3 seconds until the tray or arms turn. For a full reset, remove the ice bin, gently shake the ice maker up and down, replace the bin, then turn the refrigerator off for 30 seconds and back on — and allow 4 to 6 hours for ice. On Craft Ice models (the round, slow-melt ice), unplug for about 10 minutes and then allow up to 24 hours."
  },
  {
    q: "My LG makes water but no ice — what's wrong?",
    a: "If the door dispenser gives water but the ice maker stays empty, the supply and filter are fine, so the issue is downstream. Rule out a frozen fill tube (thaw it gently) and a freezer that's too warm (LG wants it below 19°F). If those are clear, the ice-maker fill isn't happening — usually the water inlet valve's ice circuit or the ice maker assembly itself. Run the Test button first to see whether the mechanism cycles; if it turns but no water arrives, it's the valve, and if it doesn't move at all, it's the ice maker. Both are tech replacements."
  },
  {
    q: "Can I fix an LG ice maker that won't work myself?",
    a: "Several parts, yes: replace an overdue filter, confirm the supply valve is open and the line isn't kinked, make sure the freezer is cold enough (below 19°F, ideally -4°F), confirm the ice maker is on, and run LG's Test-button and reset steps. Thawing a frozen fill tube is also safe. What you shouldn't do is replace the water inlet valve or open the ice maker assembly — those are electrically live, plumbed-in tech jobs. If the reset and water checks don't restore ice, that's the handoff point."
  },
  {
    q: "Is it worth repairing an LG ice maker?",
    a: "Usually yes. The no-ice fixes — a filter, a fill-tube thaw, the water inlet valve, or the ice maker assembly — are affordable against a refrigerator you're keeping. Our techs verify the water path and temperature first (a clogged filter or warm freezer mimics a dead maker), then test the valve and the assembly before quoting. In LA's hard water, mineral scale on the inlet-valve screen and fill tube is a common flow restriction that's often the whole fix. $89 residential diagnostic, waived with the repair."
  }
];

