const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/microwave-repair/lg-not-heating/";

const title = "LG Microwave Not Heating? Causes & Fix — LA";
const description = "LG microwave runs but doesn't heat? It's the magnetron or high-voltage circuit — on NeoChef inverter models an inverter board. A microwave's HV parts can hold a lethal charge even unplugged, so never open it. Safe checks, repair-vs-replace, $89.";

const faqs = [
  {
    q: "Why does my LG microwave run but not heat?",
    a: "When an LG microwave lights up, turns the plate, and counts down but the food stays cold, the fault is in the high-voltage circuit that makes the microwaves — most often the magnetron, along with the high-voltage diode and, on conventional models, the high-voltage capacitor and transformer. On LG's NeoChef and other inverter models, an inverter board replaces the bulky transformer, and a failed inverter board is a common no-heat cause on those. A door interlock switch that isn't confirming a shut door will also stop heating. None of these are DIY: a microwave's high-voltage parts can hold a dangerous, even lethal, charge long after it's unplugged, so the inside is technician-only. You can safely rule out the door and your settings, then call. $89 residential diagnostic, waived with repair."
  },
  {
    q: "Is it safe to open an LG microwave to fix it?",
    a: "No — never open a microwave, LG or any brand. Inside is a high-voltage capacitor (on conventional models) or inverter circuit that can hold a lethal electrical charge even after the unit has been unplugged for a long time, and the magnetron circuit runs at thousands of volts. This is the one appliance where unplugging it does not make the inside safe to touch. Every internal part — magnetron, diode, capacitor, transformer or inverter board, door switches — is a job for a technician who safely discharges the high-voltage components first. There is no homeowner-safe way to test them."
  },
  {
    q: "What is an LG inverter (NeoChef) microwave and does it change the repair?",
    a: "LG's NeoChef and other inverter microwaves use an inverter board instead of the traditional heavy high-voltage transformer, which gives steadier low-power cooking. For a no-heat fault it changes which part fails but not the safety rule: instead of a transformer-and-capacitor pair, a failed inverter board is the common high-voltage culprit, and it still carries a dangerous charge and is still technician-only. It also affects the repair-vs-replace math a bit — an inverter board can be a pricier part — which is exactly why our tech identifies the exact failed component before quoting, so you know whether repair or replacement makes sense."
  },
  {
    q: "What can I safely check on an LG microwave that won't heat?",
    a: "Only the outside. Confirm the door closes fully and latches firmly with nothing caught in the seal — the interlock switches must sense a shut door before it heats. Check the power level isn't set low (a 30% setting heats slowly and feels like 'not heating'), rule out demo mode, and do a two-minute power-cycle by unplugging for a minute. Test with a cup of water so you're judging real heating rather than a cold spot. If it still won't heat after all that, the fault is in the high-voltage circuit — do not open the cabinet; call a technician."
  },
  {
    q: "Is an LG microwave worth repairing if it won't heat?",
    a: "It depends on the type. A countertop LG microwave is inexpensive, so a magnetron or inverter-board repair can approach the price of a new one — for a basic countertop unit, replacement is often the sensible call, and we'll say so. An over-the-range or built-in LG is expensive and integrated into the cabinetry and venting, so a magnetron or diode repair is usually well worth it versus replacing the whole unit. On an inverter model the board cost matters, so our tech diagnoses the exact failed part first, then gives you the real repair-vs-replace numbers."
  }
];

