    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Microwave Turntable Repair",
    "name": "Microwave Plate Not Rotating Diagnostic and Repair",
    "url": canonical,
    "description": "Residential microwave turntable diagnostic across all seven Southern California counties. Drive coupler (cheapest fix, year 4 to 7 typical), turntable synchronous motor, support roller ring, plate alignment (~25% of calls resolve at $89 dx). Inverter-model rotation control on Panasonic NN-SN / NN-SD and Samsung inverter (some models tie rotation to control board signal). $89 residential diagnostic, applied toward repair.",
    "provider": { "@id": canonical + "#business" },
