const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dryer-repair/error-codes/";

const title = "Dryer Error Codes by Brand, Explained — Same Day";
const description = "LG, Samsung, Whirlpool, and GE dryer error codes in plain English. Which point to a clogged vent, which you can clear yourself, and when it's a tech job — plus why LG's CL isn't an error.";

const faqs = [
  {
    q: "What is the most common cause of a dryer error code?",
    a: "Restricted airflow, by a wide margin. Most brands have a dedicated code for it — LG uses the Flow Sense d80/d90/d95 set, Whirlpool and Maytag show AF, and Samsung's heating codes (HC/hE) usually trace back to the same thing. A clogged lint filter or a blocked exhaust vent chokes the air the dryer needs, so it either overheats and shuts down or takes three cycles to dry. It's also a genuine fire hazard, which is why these codes are worth acting on the same day. The fix is almost always cleaning the filter and vent, not replacing a part."
  },
  {
    q: "What does CL mean on an LG dryer?",
    a: "On its own, CL is not an error — it's the Child Lock indicator. The control panel is locked so the buttons don't respond, usually switched on by accident. Hold the Child Lock button for about 3 seconds to turn it off. It's the single most common 'code' LG dryer owners worry about, and it isn't a fault at all."
  },
  {
    q: "Can I clear a dryer error code myself?",
    a: "Often, yes — start with the safe basics. Clean the lint filter and the exhaust vent end to end (this clears the airflow codes: LG d80/d90/d95, Whirlpool AF, and most Samsung heating codes). Power-cycle the dryer by unplugging it for a minute (this clears power-interruption codes like Whirlpool and LG's PF). Release the child lock if you see CL. What you should not do is open the dryer cabinet to test the thermistor or heating element, or disturb a gas line — those are tech jobs. If a code returns after a full vent cleaning and a power cycle, the fault is inside the machine."
  },
  {
    q: "My dryer shows a thermistor code (LG tE1, Samsung tS, Whirlpool E1). What now?",
    a: "A thermistor code means the temperature sensor is reading out of range. First rule out the simple cause: a clogged vent makes the sensor read a false high temperature, so clean the filter and exhaust and run it again. If the vent is genuinely clear and the code returns, the thermistor itself (or its wiring) has failed and needs testing against spec and replacing. That's a tech job — the sensor lives inside the cabinet. Our techs carry the common LG, Samsung, and Whirlpool thermistors, so it's usually a one-visit fix."
  },
  {
    q: "Do GE dryers have error codes?",
    a: "Mostly not. Traditional GE dryers are diagnosed by symptom, not by a digital code — they simply don't display one. Some newer GE front-load (GFD-series) models can show a fault code, but GE's code formats vary by model and generation, and there's no single consistent published list, so the reliable move on a GE is to check the model-specific manual rather than trust a generic code chart. Whatever the display shows, the diagnostic logic is the same: airflow and power problems first, then sensor, heater, or control. Our techs diagnose GE dryers by behavior, which is how GE intends them to be serviced."
  }
];

