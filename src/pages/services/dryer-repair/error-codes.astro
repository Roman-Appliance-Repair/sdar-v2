// src/pages/services/dryer-repair/error-codes.astro
// Info Wave I-3 — "dryer error codes" umbrella. Head term 150/mo but brand aggregate
// strong (samsung 900, lg 600, whirlpool 200). Per-brand H2 sections.
// Codes verified vs OEM: LG (lg.com/us dryer code list), Samsung (samsung.com/us
// TSG10001006), Whirlpool/Maytag (producthelp.whirlpool.com). GE = HONEST FRAMING
// (no consistent code set; many GE dryers show no codes) — NO invented GE table.
// Differentiators: LG CL = Child Lock (not an error); "restricted airflow = #1 cause +
// fire hazard" across brands. lg-d80-error cross-linked (Flow Sense not duplicated).
// Safe DIY = vent/filter, power cycle, child lock; no cabinet/gas. $89 residential.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
