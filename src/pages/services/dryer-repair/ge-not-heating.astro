const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dryer-repair/ge-not-heating/";

const title = "GE Dryer Not Heating? Causes & Fix — Same Day";
const description = "GE dryer runs but won't heat? Usually a clogged vent (a fire risk), then the heating element/coils, a thermostat, or the thermal fuse. GE codes explained, gas vs electric, and when it's a tech job.";

const faqs = [
  {
    q: "Why is my GE dryer not heating?",
    a: "On a GE dryer that tumbles but won't heat, the leading cause is a restricted exhaust vent that makes the dryer overheat and trips a thermostat or the thermal fuse. After the vent, the usual failed parts are the heating element (the coils on the heater assembly), the cycling and high-limit thermostats, and the thermal fuse. On a gas GE, a weak igniter, gas-valve coils, or a bad flame sensor stops the burner from lighting. Clean the vent first — a thermostat or fuse that tripped on a blocked vent will just trip again until the airflow is fixed."
  },
  {
    q: "Does a GE dryer show an error code when it won't heat?",
    a: "Traditionally, no. Most GE dryers are diagnosed by symptom rather than a digital code — a GE that won't heat usually just runs cold with nothing on the display, and you diagnose it by testing the heating parts. That's changed on GE's newest models (roughly 2024 onward), which added a limited set of heater codes such as HE (heater error) and E60 through E64. If your GE shows one of those, it points at the heating circuit; if it shows nothing at all, that's normal for GE and doesn't mean the control is dead. Either way the diagnosis is the same: vent and power first, then the element, thermostats, and fuse."
  },
  {
    q: "Can I fix a GE dryer that won't heat myself?",
    a: "The safe, high-value step is yours: clean the lint filter and clear the entire exhaust vent — the hose behind the dryer and the exterior flap included. That resolves most no-heat calls and removes a real fire hazard. Also reset both halves of the 240V breaker on an electric GE; if one leg trips, the drum tumbles but the heat is dead. What you shouldn't do is open the cabinet to test the heating coils, thermostats, or thermal fuse, and never touch the gas line or valve on a gas model. Those are tech jobs."
  },
  {
    q: "Is a dryer that won't heat a fire hazard?",
    a: "Yes — the clogged vent that most often stops a GE from heating is also a leading fire cause. The U.S. Fire Administration reports roughly 15,600 dryer fires a year, and the NFPA finds failure to clean the dryer and its venting is the number-one factor, with lint the most common material to ignite. A GE running hot or refusing to heat is worth clearing the same day — it fixes the heat and removes the hazard together."
  },
  {
    q: "Is it worth repairing a GE dryer that won't heat?",
    a: "Usually yes. The GE no-heat parts — heating element/coils, cycling and high-limit thermostats, and the thermal fuse on an electric model, or the igniter, gas-valve coils, and flame sensor on a gas model — are among the more affordable dryer repairs. Our techs verify the vent first (a thermostat that tripped on a blocked vent will just trip again), then test the heating circuit and replace the failed part. $89 residential diagnostic, waived with the repair."
  }
];

