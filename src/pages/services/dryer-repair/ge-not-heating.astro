// Info Wave W1 page 6/8 — "ge dryer not heating" (1,400/mo KD0). Brand sniper.
// GE-specific: heating element/coils on the heater assembly, thermostats, thermal fuse.
// Honest code framing: GE traditionally SYMPTOM-DIAGNOSED (few digital codes); newer
// (2024-26) models added limited heater codes (HE, E60/E61/E63/E64). Gas split (coils/
// igniter/flame sensor). Fire framing NFPA/USFA. umbrella<->sniper links. $89.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
