// Info Wave W1 page 4/8 — "maytag dryer not heating" (3,000/mo KD1). Whirlpool platform.
// Differentiator = Maytag 10-yr limited parts warranty (covers drum + drive motor, NOT
// heating parts -> no-heat fix is out-of-pocket after yr 1). Shared platform w/ Whirlpool/
// Amana -> cross-link anchor. Thermal fuse + element + cut-off + AF; gas split. Fire
// framing NFPA/USFA. umbrella<->sniper links. $89.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
