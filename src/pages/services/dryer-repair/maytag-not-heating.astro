const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dryer-repair/maytag-not-heating/";

const title = "Maytag Dryer Not Heating? Causes & Fix — Same Day";
const description = "Maytag dryer runs but won't heat? Usually a blown thermal fuse from a clogged vent (a fire risk). What the 10-year warranty covers, and when to call.";

const faqs = [
  {
    q: "Why is my Maytag dryer not heating?",
    a: "On a Maytag dryer that tumbles but won't heat, the signature cause is a blown thermal fuse — a one-time safety device that trips when a clogged exhaust vent makes the dryer overheat. After the fuse come the heating element and the thermal cut-off (high-limit thermostat); electric models may also show an AF restricted-airflow message. On a gas Maytag, a weak igniter, gas-valve coils, or a bad flame sensor stops the burner. Maytag dryers use the Whirlpool heating platform, so the diagnosis matches Whirlpool and Amana. Clean the vent first — a fuse that blew from a blocked vent will just blow again until the airflow is fixed."
  },
  {
    q: "Doesn't Maytag have a 10-year warranty? Will it cover a no-heat repair?",
    a: "Usually not the part you need. Maytag advertises a 10-year limited parts warranty, but on dryers that coverage is for the drum and the drive motor specifically — not the heating system. The parts that cause no-heat (thermal fuse, heating element, thermal cut-off, and on gas the igniter and valve coils) fall under the standard 1-year parts-and-labor warranty. So on a Maytag past its first year, a no-heat repair is typically out of pocket, and it's worth knowing that before you call Maytag expecting it to be free. The good news is these are among the more affordable dryer parts."
  },
  {
    q: "What does the AF code mean on a Maytag dryer?",
    a: "AF stands for restricted airflow — the control detected that air isn't moving through the exhaust properly, almost always a clogged filter, a blocked or crushed vent, or a plugged exterior flap. It's the same root cause behind most no-heat and blown-fuse calls. Clean the filter and the full vent, then touch any key to clear it. If AF returns on a clear vent, the airflow sensor or blower needs a look."
  },
  {
    q: "Can I fix a Maytag dryer that won't heat myself?",
    a: "The safe, high-value step is yours: clean the lint filter and clear the entire exhaust vent — hose behind the dryer and exterior flap included. That resolves most no-heat, AF, and blown-fuse calls and removes a real fire hazard. Also reset both halves of the 240V breaker on an electric Maytag; if one leg trips, the drum tumbles but the heat is dead. Don't open the cabinet to test the thermal fuse, element, or thermostat, and never touch the gas line or valve on a gas model. Those are tech jobs."
  },
  {
    q: "Is a dryer that won't heat a fire hazard?",
    a: "Yes — the clogged vent that most often stops a Maytag from heating is also a leading fire cause. The U.S. Fire Administration reports roughly 15,600 dryer fires a year, and the NFPA finds failure to clean the dryer and its venting is the number-one factor, with lint the most common material to ignite. A Maytag running hot, showing AF, or refusing to heat is worth clearing the same day — it fixes the heat and removes the hazard together."
  }
];

