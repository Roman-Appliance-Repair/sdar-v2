        <tr><td>F2E2</td><td>UI ↔ control communication (NOT a leak)</td><td>Power-cycle 30s; then UI board / harness</td></tr>
        <tr><td>F3E1 / F3E2 / F3E3</td><td>Thermistor / OWI sensor fault or calibration</td><td>Water sensor (technician)</td></tr>
        <tr><td>F4E3</td><td>Control ↔ circulation-pump communication</td><td>Pump or harness (technician)</td></tr>
        <tr><td>F5E1 / F5E2</td><td>Door switch fault / control detects door won't open</td><td>Door latch / switch</td></tr>
        <tr><td>F6E1</td><td>Won't fill / no water detected</td><td>Supply valve, fill hose kink</td></tr>
        <tr><td>F6E2</td><td>Water inlet valve failure</td><td>Inlet valve ($200-340)</td></tr>
        <tr><td>F6E3</td><td>Suds or air in the water / pump</td><td>Detergent type/amount; air lock</td></tr>
        <tr><td>F6E4</td><td>Float switch open (overfill)</td><td>Float / overfill</td></tr>
        <tr><td>F6E6</td><td>Incoming water too cold</td><td>Run hot tap first; water heater</td></tr>
        <tr><td>F6E7</td><td>Disconnected / damaged flow meter</td><td>Flow meter (technician)</td></tr>
        <tr><td>F7E1 / F7E2</td><td>Heating element doesn't work / won't shut off</td><td>Element or high-limit ($180-460)</td></tr>
        <tr><td>F8E1</td><td>Slow drain</td><td>Filter, hose, air gap → drain guide</td></tr>
        <tr><td>F8E2 / F8E3</td><td>Drain pump electrical / stuck on</td><td>Drain pump → drain guide</td></tr>
        <tr><td>F9E1 / F9E2 / F9E3</td><td>Diverter disc position / motor / disc missing</td><td>Diverter motor (technician)</td></tr>
        <tr><td>FAE1 / FAE2 / FAE3</td><td>Detergent dispenser / vent wax-motor / drying fan</td><td>Dispenser or vent/fan</td></tr>
      </tbody>
    </table>
