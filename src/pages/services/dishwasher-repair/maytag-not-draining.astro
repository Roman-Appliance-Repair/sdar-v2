// Whirlpool-platform: F9E1 "Long Drain" (OEM producthelp.maytag.com). Angle = heavy-duty /
// PowerBlast + drain-hose high-loop emphasis. Shared-platform honest line + mutual links
// (whirlpool/kitchenaid/kenmore). CA air-gap operator check. Safe DIY = filter/hose/high loop/
// disposal knockout/air gap; drain pump = tech. $89 residential.

import Layout from '../../../layouts/Layout.astro';
