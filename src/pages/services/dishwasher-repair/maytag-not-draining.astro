const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dishwasher-repair/maytag-not-draining/";

const title = "Maytag Dishwasher Not Draining: F9E1 Fix — Same Day";
const description = "Maytag dishwasher won't drain or showing F9E1? Usually the filter, drain hose high loop, disposal plug, or air gap on the Whirlpool platform. Safe checks and when to call.";

const faqs = [
  {
    q: "Why is my Maytag dishwasher not draining?",
    a: "On a Maytag the standing water almost always traces to a clogged lower filter, a kinked or clogged drain hose (or a loop that sits too low), a disposal knockout plug left in after a new disposal, a blocked sink air gap, or a failed drain pump. The first four are homeowner-checkable; the pump is the tech job. Maytag's drain-fault code is F9E1, a drain-timeout meaning the pump-out didn't finish in time. Start with the filter and the drain hose loop — those two fix most Maytag drain calls. $89 residential diagnostic, waived with repair."
  },
  {
    q: "What does F9E1 mean on a Maytag dishwasher?",
    a: "F9E1 is the \"Long Drain\" code: the dishwasher tried to pump out but didn't finish draining in the allowed time. It's a timeout, not a specific failed part. Maytag's documented causes are the drain path — clogged filter, kinked or clogged drain hose, blocked air gap, un-removed disposal knockout plug, or excess suds from dish soap. Clear those first; if F9E1 returns with everything clean, the drain pump or its check valve is the likely fault. It's the same code Maytag shares with Whirlpool and KitchenAid."
  },
  {
    q: "Is Maytag the same as Whirlpool?",
    a: "For dishwashers, effectively yes — Maytag, KitchenAid, and many Kenmore (665-series) dishwashers are built on the same Whirlpool platform, sharing the F9E1 code, the removable filter, and the same drain pump and check valve. Maytag is positioned as the heavy-duty, dependable badge (PowerBlast cycle, longer parts warranties on some models), but the drain diagnosis is identical. The steps here match our Whirlpool and KitchenAid pages."
  },
  {
    q: "What is the drain hose high loop on a Maytag?",
    a: "Maytag requires the drain hose to loop up higher than the inside of the tub before it drops to the sink drain or disposal. That high loop stops dirty sink water from siphoning back into the dishwasher and pooling in the tub. It's a very common cause of a \"won't drain\" complaint right after an install, or after the unit was pulled out and pushed back and the hose fell flat. If the hose runs low under the sink, re-routing it into a high loop is a safe, free fix — and a sink air gap does the same job automatically, which is why many California kitchens have one."
  },
  {
    q: "My Maytag drains but leaves water in the bottom — normal or a problem?",
    a: "A small amount of clean water in the filter well after a cycle is normal by design on many Maytag models — it keeps the seals wet. A tub with a noticeable pool of dirty water is not normal and points to a partial drain clog: filter, hose, or air gap. Work that list. If the water is clean and only in the recessed filter area, it's fine; if it's dirty and across the tub floor, treat it as a drain problem before F9E1 shows up."
  }
];

