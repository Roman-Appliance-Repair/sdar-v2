const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dishwasher-repair/kitchenaid-not-draining/";

const title = "KitchenAid Dishwasher Not Draining: F9E1 — Same Day";
const description = "KitchenAid dishwasher won't drain or showing F9E1? Usually the filter, drain hose, disposal plug, or air gap on the shared Whirlpool platform. Safe checks and when to call.";

const faqs = [
  {
    q: "Why is my KitchenAid dishwasher not draining?",
    a: "On a KitchenAid the standing water almost always traces to a clogged lower filter, a kinked or clogged drain hose (or a hose loop that sits too low), a disposal knockout plug left in after a new disposal, a blocked sink air gap, or a failed drain pump. The first four are homeowner-checkable; the pump is the tech job. KitchenAid's drain-fault code for this is F9E1, a drain-timeout that means the pump-out didn't finish in time. Many KitchenAid owners never realize their quiet dishwasher even has a filter to clean — start there. $89 residential diagnostic, waived with repair."
  },
  {
    q: "What does F9E1 mean on a KitchenAid dishwasher?",
    a: "F9E1 is the \"Long Drain\" code: the dishwasher tried to pump out but didn't finish draining in the allowed time. It's a timeout, not a specific part failure. The documented causes are the drain path — clogged filter, kinked or clogged drain hose, blocked air gap, un-removed disposal knockout plug, or excess suds from dish soap. Clear those first; if F9E1 returns with everything clean, the drain pump or its check valve is the likely fault. It's the same code and cause list KitchenAid shares with Whirlpool and Maytag."
  },
  {
    q: "Is KitchenAid just a rebadged Whirlpool?",
    a: "For repair purposes, largely yes — KitchenAid, Maytag, and many Kenmore (665-series) dishwashers are built on the same Whirlpool platform, with the same F9E1 code, the same removable filter, and the same drain pump and check valve. KitchenAid sits at the premium end (quieter tubs, third racks, nicer finishes), but the drain diagnosis under the hood is identical. So the steps here match our Whirlpool and Maytag pages."
  },
  {
    q: "Where is the filter on a KitchenAid dishwasher?",
    a: "It's in the floor of the tub, usually under the lower spray arm — a cylindrical filter you twist a quarter turn and lift out. Because KitchenAid tubs are so quiet, plenty of owners run them for years without ever cleaning it, and it slowly packs with food and grease until the drain slows and F9E1 trips. Rinse the filter under the tap, clear the sump underneath (mind broken glass), reseat it flat and locked, and run a rinse cycle. This alone fixes a large share of KitchenAid drain calls."
  },
  {
    q: "My KitchenAid drains slowly but not fully — is that the same problem?",
    a: "Usually yes, caught earlier. A partial clog in the filter, hose, or air gap slows the drain so a little water is left in the bottom after a cycle, and it will progress to a full F9E1 stop if ignored. Work the same list — filter, hose and high loop, disposal, air gap — before it becomes standing water. If the pump is weak rather than blocked, the drain stays slow no matter how clean the path is, and that's a pump we'd test and replace."
  }
];

