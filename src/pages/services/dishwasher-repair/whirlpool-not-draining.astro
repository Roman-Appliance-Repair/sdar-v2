const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dishwasher-repair/whirlpool-not-draining/";

const title = "Whirlpool Dishwasher Not Draining: F9E1 Fix — Same Day";
const description = "Whirlpool dishwasher won't drain or showing F9E1? The top causes are the filter, drain hose high loop, disposal knockout plug, and air gap. Safe checks and when to call.";

const faqs = [
  {
    q: "Why is my Whirlpool dishwasher not draining?",
    a: "On a Whirlpool the standing water almost always traces to one of these, most common first: a clogged lower filter, a kinked or clogged drain hose (or a hose loop that sits too low), a garbage-disposal knockout plug left in after a new disposal, a blocked sink air gap, or a failed drain pump. The first four are homeowner-checkable in a few minutes; the pump is the tech job. Whirlpool's own drain-fault code for this is F9E1, which just means the pump-out didn't finish in time. Start with the filter — it is the single most common fix. $89 residential diagnostic, waived with repair."
  },
  {
    q: "What does F9E1 mean on a Whirlpool dishwasher?",
    a: "F9E1 is Whirlpool's \"Long Drain\" code: the dishwasher tried to pump out but didn't finish draining within its allowed time. It is a drain-timeout, not a diagnosis of which part failed. Whirlpool's documented causes are exactly the drain-path list — a clogged filter, a kinked or clogged drain hose, a blocked air gap, an un-removed disposal knockout plug, or excess suds from using dish soap instead of dishwasher detergent. Clear those first; if F9E1 returns with everything clear, the drain pump is the likely culprit. On light-only models there is no digital code, so you'd just see the tub holding water."
  },
  {
    q: "Do KitchenAid and Maytag dishwashers have the same problem?",
    a: "Yes — KitchenAid, Maytag, and many Kenmore (665-series) dishwashers are built on the same Whirlpool platform, so they share the F9E1 code and the identical drain path and fixes. If you have one of those, the steps on this page apply. We keep brand-specific pages for each so you land on the right one, but our techs treat them as the same diagnostic under the hood."
  },
  {
    q: "How do I clear a Whirlpool dishwasher that won't drain?",
    a: "Safe, in order: scoop out the standing water, then twist out and rinse the lower filter and clear the sump below it, check the drain hose behind the unit for a kink or clog and confirm it loops up high before it drops to the drain, run the garbage disposal for a few seconds (a full disposal blocks the shared drain), and clear the sink air gap if you have one. Use only dishwasher detergent, since dish soap over-suds and blocks draining. Re-run a rinse cycle. If water still stands, it's the drain pump or control — that's our job."
  },
  {
    q: "What is a drain hose high loop and why does it matter?",
    a: "Whirlpool requires the drain hose to loop up higher than the inside of the tub before it drops to the sink drain or disposal. That high loop stops dirty sink water from siphoning back into the dishwasher and pooling. It's a top cause of a \"won't drain\" complaint right after an install or after the unit was pulled out and pushed back. If your hose runs low and flat under the sink, re-routing it into a high loop is a safe, free fix — and one an air gap accomplishes automatically, which is why California kitchens often use one."
  }
];

