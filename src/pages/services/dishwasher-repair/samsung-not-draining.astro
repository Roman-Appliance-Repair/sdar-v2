// Info Wave W2 — "samsung dishwasher not draining" (3500) + "samsung dishwasher oc code" (900).
// Brand sniper. OEM: 5C=5E=SC=SE = "can't drain" (samsung.com/us/support). OC/oE = over-level/
// overflow (drain-adjacent, labeled correctly — NOT the primary drain code). Samsung's most-cited
// cause = unit sitting on its own drain hose. Filter self-cleaning vs manual = model-dependent.
// CA air-gap check. Safe DIY = filter/sump-debris/hose/disposal/air gap; drain pump = tech. $89.

import Layout from '../../../layouts/Layout.astro';
