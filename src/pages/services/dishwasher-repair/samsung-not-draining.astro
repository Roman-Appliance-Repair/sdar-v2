const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/dishwasher-repair/samsung-not-draining/";

const title = "Samsung Dishwasher Not Draining: 5C/5E Fix — Same Day";
const description = "Samsung dishwasher won't drain, or showing 5C, 5E, SC, or OC? Usually the filter, a hose the unit is sitting on, the disposal plug, or air gap. Safe checks and when to call.";

const faqs = [
  {
    q: "Why is my Samsung dishwasher not draining?",
    a: "On a Samsung the standing water almost always traces to a clogged filter and sump, a kinked or pinched drain hose (very often the dishwasher is simply sitting on its own hose), a disposal knockout plug left in after a new disposal, a blocked sink air gap, or a failed drain pump. The first four are homeowner-checkable; the pump is the tech job. Samsung signals a drain failure with 5C, 5E, SC, or SE — all the same 'can't drain' code, just shown in different display fonts. Start by cleaning the filter and checking the hose isn't crushed behind the unit. $89 residential diagnostic, waived with repair."
  },
  {
    q: "What do 5C, 5E, SC, and SE mean on a Samsung dishwasher?",
    a: "They're all the same drain error — 'the dishwasher can't drain.' The characters differ only by display type: 5C and 5E on digital screens, SC and SE on alphanumeric ones (the 5 and the S look alike, as do the C and the E). Samsung's fix is the drain path — clean the filter and sump, check the drain hose for kinks or a pinch, clear the disposal and air gap, and remove the disposal knockout plug if it's a new install. Clear those first; if the code returns with everything clean, the drain pump is the likely fault."
  },
  {
    q: "What is the OC or oE code on a Samsung dishwasher?",
    a: "OC (also shown as oE or 0C) is an over-level water code — there's more water in the tub than there should be. It's related to draining but distinct from the 5C 'can't drain' code: instead of no drainage, the unit is sensing too much water, which a slow drain or a partial blockage can cause. The checks overlap — filter, sump, drain hose, air gap — but if you see OC specifically, you're dealing with a water-level fault, and it's worth confirming the drain isn't just running slow."
  },
  {
    q: "Where is the filter on a Samsung dishwasher, and does it self-clean?",
    a: "The filter sits in the floor of the tub, usually under the lower spray arm, and you twist it out to rinse it. It depends on the model whether it's a manual filter (you clean it) or a self-cleaning type — check yours. Even on self-cleaning models, debris like labels, seeds, or rice can collect in the sump and block the drain, so it's worth removing the filter, checking the sump for debris, and reseating the filter flat and locked. Watch for broken glass. Run a rinse cycle after."
  },
  {
    q: "How do I clear a Samsung dishwasher that won't drain?",
    a: "Safe, in order: scoop out the standing water, twist out and rinse the filter and clear any debris in the sump, check the drain hose behind the unit for a kink or a pinch (Samsung's most common cause is the unit sitting on its own hose) and confirm the high loop, run the garbage disposal (a full one blocks the shared drain, and a new disposal may still have its knockout plug), and clear the sink air gap. Use only dishwasher detergent. Re-run a rinse cycle. If 5C/SC returns with everything clear, the drain pump needs testing — that's our job."
  }
];

