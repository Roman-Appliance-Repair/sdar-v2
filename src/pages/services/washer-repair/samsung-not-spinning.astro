// door/lid lock (dC), worn drive belt/rotor, suspension. Differentiator = UR unbalance +
// VRT/direct-drive. Cross-links samsung-error-codes (W4) + ge-not-spinning sibling +
// wont-spin generic + not-draining. $89. 4 schema. Reuse W4 Samsung code set. Safe-DIY.

import Layout from '../../../layouts/Layout.astro';
