const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/washer-repair/maytag-not-draining/";

const title = "Maytag Washer Not Draining? Causes & Fix";
const description = "Maytag washer won't drain? Same Whirlpool-platform drain pump, coin trap, and F9E1 code — but the 10-year warranty does NOT cover the pump. Bravos and Maxima, safe checks, when to call. Same-day LA, $89.";

const faqs = [
  {
    q: "Why won't my Maytag washer drain?",
    a: "Maytag washers are built on the Whirlpool platform, so the causes are the same: a failed or clogged drain pump, a clog in the pump filter or drain hose, a kinked or too-deeply-inserted drain hose, or a stuck lid lock (Maytag top-loaders won't drain or spin unless the lid locks). On electronic models Maytag flags a drain that takes too long as F9E1 — 'long drain' — which points at the pump or a clog, not the control board. Whether you have a Bravos top-loader or a Maxima front-loader, the drain system is the same Whirlpool design. Clearing a hose or filter is homeowner-safe; the pump is a tech job. $89 residential diagnostic, waived with repair."
  },
  {
    q: "Does the Maytag 10-year warranty cover the drain pump?",
    a: "No — and this is worth knowing before you assume it's covered. Maytag's well-known 10-year limited parts warranty covers only the drive motor and the wash basket (the stainless tub) on most models, and it's parts-only, not labor. The drain pump, the lid lock, the control board, and the hoses are not on that list. So a no-drain repair — which is almost always the pump or a clog — generally isn't a warranty claim. We'll tell you straight what your fault is and whether any warranty applies, but for a drain pump, plan on a normal repair rather than a covered one. For the full Maytag code picture, see our Maytag washer error codes page."
  },
  {
    q: "What does F9E1 mean on a Maytag washer?",
    a: "F9E1 is the 'long drain' code shared across the Whirlpool platform Maytag is built on: the washer ran the drain step but the water didn't clear in the expected time, so it flagged a drain fault and usually stopped before spinning. It's a plumbing/pump problem the control is reporting, not a control-board failure. Check a kinked drain hose, a hose pushed too far down the standpipe, and the pump filter first; if those are clear, it's the drain pump. The same code and order apply to Whirlpool and Amana washers on this platform."
  },
  {
    q: "My Maytag is a Bravos (or Maxima) — does that change the fix?",
    a: "The drain parts are the same; only the layout differs. On a Maxima front-loader there's usually a drain pump filter (coin trap) behind a small bottom-front access panel — clear that first, it catches coins and lint. A Bravos top-loader typically doesn't have a user-accessible filter, so on those the clog is more often in the drain hose or the pump itself. Either way it's the same Whirlpool-platform pump underneath, so a technician diagnoses both the same way and carries the parts that fit."
  },
  {
    q: "Why won't my Maytag spin if it won't drain?",
    a: "A washer drains before it spins — it won't spin on top of a full tub, because it can't balance and would sling water everywhere. So if the Maytag can't drain, it never reaches the spin step, and 'won't drain' and 'won't spin' appear together. Fix the drain and the spin usually returns. That's why clearing the water is always the first move before judging whether the spin itself is broken."
  }
];

