const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/washer-repair/whirlpool-error-codes/";

const title = "Whirlpool Washer Error Codes? Causes & Fix — Same Day";
const description = `Whirlpool washer showing F9E1, F7E1, F5E2, or old F21/F51? Same-day LA. Cabrio top-load vs Duet front-load codes, generation transitions. BHGS #A49573. $89 dx.`;

const faqs = [
  {
    q: "My old Whirlpool showed F21, the new one shows F9E1. Different problems?",
    a: "Same problem, different code generation. Whirlpool renamed its washer codes around 2011. The old two-part codes (F21, F02, F51) became the FxEy format (F9E1, F7E1). F21 on an older Duet was a long-drain fault; that exact fault is F9E1 on a newer machine. F51 (basket/motor speed on the old Cabrio) became F7E1. If you're cross-referencing an old manual against a new washer, translate the code first — same drain path, same pump, same fix. On both generations, a drain fault starts at the pump filter (front-load) or the pump-and-hose (top-load), then the drain pump motor at $380 to $540. $89 residential diagnostic, waived with repair."
  },
  {
    q: "Is my Whirlpool a Cabrio or a Duet, and why does it matter for codes?",
    a: "Cabrio (and its Bravos twin) is the high-efficiency TOP-load washer — lid on top, no front door. Duet (and Maxima) is the FRONT-load washer with the round door and a drain pump filter behind a lower kickplate. It matters because the same code number can point to different hardware: on a top-load Cabrio there's no front filter, so a drain code F9E1 goes straight to the pump and hose, while on a front-load Duet the very first stop is that accessible filter, which clears roughly half of drain codes without a part. Tell us which one you have and we bring the right parts."
  },
  {
    q: "What does F9E1 mean on a Whirlpool washer?",
    a: "Long-drain / drain fault — the washer couldn't pump the water out in the expected window. On a front-load Duet or Maxima, start at the drain pump filter behind the lower-front kickplate (technician access on most, customer on some), then the drain hose at the standpipe, then the pump motor. On a top-load Cabrio or Bravos there's no filter, so it's a hose-and-pump check. Pump replacement runs $380 to $540. On pre-2011 machines this same fault showed as F21 (Duet) or F02. Related: our washer not-draining page walks the full drain path."
  },
  {
    q: "F7E1 keeps coming back on my Cabrio. What is it?",
    a: "F7E1 is a motor or basket-speed fault — the control commanded a spin speed and the basket didn't reach it, or the motor's rotor-position sensor disagreed. On the top-load Cabrio and Bravos this often traces to the motor rotor position sensor, the shifter (which switches between wash and spin), or the drive motor itself. On the older Cabrio generation the same fault was F51. It's a technician diagnosis — the fix depends on which component in the drive train failed, and quoting it blind wastes your money. Drive-system repairs on these run $340 to $620 depending on the part."
  },
  {
    q: "F5E2 — is that the door or the lid?",
    a: "Both, depending on which washer. F5E2 is a lock fault: the washer can't confirm the door (front-load Duet) or lid (top-load Cabrio) actually locked, and it won't spin until it does — that's a safety interlock, by design. On a Duet it's the door interlock assembly; on a Cabrio it's the lid-lock assembly. Either way it's a $260 to $440 replacement. On top-load machines you may also see F5E1 (reads the lid open when it's closed) or F5E3 (lid won't unlock at the end) — same lock hardware family."
  },
  {
    q: "F8E1 or 'LF' on the display — what's failing?",
    a: "F8E1 (older machines sometimes print LF, 'long fill') is a water-supply fault: the washer isn't getting water fast enough. Work cheap to expensive — both supply valves fully open, fill hoses not kinked, then the mesh inlet screens where the hoses thread on (sediment clogs those across our harder-water areas). If it's the inlet valve solenoid itself, that's $260 to $380. On front-load Duets with a dispenser you may instead see F8E2, which points at the dispenser motor or a clog on the dispenser side."
  },
  {
    q: "How do I reset a Whirlpool washer code?",
    a: "First, unplug for about 60 seconds (or flip the breaker), restore power, and run a quick rinse-and-spin to see if the code returns. Many Whirlpool, Maytag, and KitchenAid models also clear a latched code if you press Cancel/Pause twice or Stop/Drain. A code that clears and stays gone was transient noise. A code that comes back within a cycle or two every time is a real fault — book a visit. Lock faults (F5E2/F5E3) and motor faults (F7E1) generally won't clear from a reset because the underlying hardware is actually down."
  },
  {
    q: "Are Maytag and KitchenAid codes the same as Whirlpool?",
    a: "Yes, essentially byte-for-byte. Whirlpool, Maytag (Bravos is the Maytag Cabrio, Maxima is the Maytag Duet), and KitchenAid share the same control architecture and F-code system. F9E1 means long-drain on all three, F5E2 means lock fault on all three, and the parts come from the same catalog families. That's why our techs treat them as one platform — same diagnostic, same part numbers, same labor. See our Maytag washer error-codes page for the Maytag-specific model families."
  },
  {
    q: "Several different F-codes on an older Whirlpool within a month — replace it?",
    a: "Probably time for that conversation. When a year 8-plus machine throws a drain code, then an unbalance code, then a lock code across a few weeks, it's usually the main control board sending false signals as it ages, not three separate broken parts. Board replacement runs $580 to $880. On a washer that age we run the repair-versus-replace math with you at the door rather than just selling a board. Premium and Speed Queen-class machines push that timeline out further; a mid-tier Cabrio or Duet at year 10 is a judgment call."
  },
  {
    q: "What's your warranty?",
    a: "90 days on SDAR labor and parts for the work we perform. Same component fails inside 90 days, we replace it free. BHGS #A49573, BBB Accredited Business, EPA 608 Universal certified #1346255700410. $89 residential diagnostic, waived when you approve the repair."
  }
];

