// Info Wave W4 — Whirlpool washer error codes (brand umbrella sniper).
// Differentiator: Cabrio/Bravos (top-load) vs Duet/Maxima (front-load) split as PAGE STRUCTURE.
// Generation transitions shown explicitly: F51 -> F7E1, F21/F02 -> F9E1.
// Codes verified vs Whirlpool producthelp. Maytag/KitchenAid shared-platform mutual links.
// $89 residential. 4 schema entities.
import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../../data/branches';
