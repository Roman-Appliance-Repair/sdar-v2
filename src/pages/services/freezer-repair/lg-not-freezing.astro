// condenser fan, start relay, sealed system. LG differentiator = linear/inverter compressor
// (reuse W5 lg-not-cooling) + 10-yr compressor parts warranty. Standalone + fridge-freezer.
// Cross-links lg-not-cooling (W5) + frigidaire-not-freezing sibling + generic not-freezing. $89.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
