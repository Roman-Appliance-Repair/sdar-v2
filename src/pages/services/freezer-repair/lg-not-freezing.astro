const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/services/freezer-repair/lg-not-freezing/";

const title = "LG Freezer Not Freezing? Causes & Fix — Same Day";
const description = "LG freezer not staying frozen? Usually the defrost system iced over, dirty coils, the evaporator fan, or the linear compressor. What's safe to check, the 10-year compressor warranty, and when to call. Same-day LA, $89.";

const faqs = [
  {
    q: "Why is my LG freezer not freezing?",
    a: "On an LG freezer that runs but won't stay frozen, the usual causes are a defrost system that's iced over the evaporator coil, dirty condenser coils, a failed evaporator fan, a bad start relay, or a sealed-system/compressor fault. A freezer should hold around 0°F; when it drifts up toward the 20s or 30s, one of those is usually why. On LG specifically, the linear (or inverter) compressor is the part tied to LG's cooling story — and it carries LG's long parts warranty, which matters if the compressor turns out to be the fault. Cleaning the coils and checking the door seal are homeowner-safe; the defrost parts, fan, and sealed system are a tech job. $89 residential diagnostic, waived with repair."
  },
  {
    q: "What temperature should an LG freezer be?",
    a: "About 0°F (−18°C) — that's the standard for keeping food safely frozen, and it's LG's target too. If your LG freezer is reading warmer than that, or the food is soft or partly thawed, it's not holding temperature and something's wrong. Give it 24 hours after any temperature change or a big grocery load before judging, and make sure the vents inside aren't blocked by packed food. If it still won't reach 0°F, work down the causes — coils, door seal, defrost, fan, compressor. Per USDA guidance, a full freezer holds a safe temperature about 48 hours if the door stays shut during an outage, so keep it closed while you wait on a repair."
  },
  {
    q: "My LG freezer has a lot of frost — is that the problem?",
    a: "A wall of frost on the back interior panel of the freezer usually points at the defrost system. Every frost-free LG runs a defrost cycle that melts the frost off the evaporator coil periodically; when the defrost heater, sensor, or control fails, frost builds up until it blocks airflow and the freezer can't cool properly — and it often jams the evaporator fan too. Light frost is normal; a thick sheet that keeps coming back after you clear it is a defrost fault and a technician repair. Don't just chip it off and move on — it'll return until the defrost part is fixed."
  },
  {
    q: "Is the LG linear compressor covered if my freezer won't freeze?",
    a: "It can be. LG's linear and inverter compressors carry a long parts warranty — commonly 10 years — so if a compressor fault is why your LG freezer won't freeze, that warranty may cover the compressor part itself. It's a parts warranty (it typically covers the part, not the labor to install it), and the exact terms depend on your model and purchase date, so find your original purchase paperwork and model number. If the diagnosis is the compressor or sealed system, that warranty can turn a big-ticket repair into a much smaller one — we diagnose it so you know exactly what you're claiming. This is the same compressor story we cover on our LG refrigerator not cooling page."
  },
  {
    q: "Can I fix an LG freezer that won't freeze myself?",
    a: "Some first steps, yes. Vacuum the condenser coils, make sure the door seals fully and nothing's holding it ajar, confirm the temperature is set cold enough and the interior vents aren't blocked by packed food, and give it 24 hours after any change. Those handle a fair share of gradual not-freezing cases. What to leave to a tech: the defrost heater/sensor/control, the evaporator or condenser fan, the start relay, and anything in the sealed system or the compressor. Those carry shock and refrigerant risks. If it stays warm after a coil clean and a good door seal, it's a service call."
  }
];

