  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Malibu, CA"
    subheadline="Beach houses, canyon estates, vacation homes — all of Malibu 90265. Sub-Zero, Wolf, Viking, and outdoor BBQ repair. Salt air, long driveways, property managers calling for absent owners — we've seen it all. Same-day service, OEM parts, 90-day warranty."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Malibu — How We Actually Work Here"
    paragraphs={introParagraphs}
    bookingTitle="Malibu Service Team"
    bookingSub="90265 · Beach House · Canyon · Vacation Home"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Malibu"
    subhead="Indoor & outdoor · Luxury brands · Beach house ready · 90265"
    services={services}
  />

  <LuxurySpecialists
    citySlug={citySlug}
    cityName={cityName}
    headline={luxuryNarrative.headline}
    paragraphs={luxuryNarrative.paragraphs}
    brands={getLuxuryBrands(citySlug)}
  />

  <CustomNarrative
    eyebrow={malibuZonesNarrative.eyebrow}
    headline={malibuZonesNarrative.headline}
    paragraphs={malibuZonesNarrative.paragraphs}
    subSections={malibuZonesNarrative.subSections}
    background="white"
  />

  <ServiceArea
    cityName={cityName}
    headline="Malibu Areas We Service"
    subheadline="Beachfront PCH, Point Dume, the canyons — every part of 90265."
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={[]}
    bgImage="/images/cities/malibu/neighborhood.webp"
  />

  <PropertyManagers
    citySlug={citySlug}
    cityName={cityName}
    eyebrow={propertyNarrative.eyebrow}
    headline={propertyNarrative.headline}
    paragraphs={propertyNarrative.paragraphs}
    bullets={propertyNarrative.bullets}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow={commercialNarrative.eyebrow}
    headline={commercialNarrative.headline}
    paragraphs={commercialNarrative.paragraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline={outdoorNarrative.headline}
    paragraphs={outdoorNarrative.paragraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <RecentRepairs
    citySlug={citySlug}
    cityName={cityName}
    headline="Jobs Our Team Did in Malibu"
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Malibu Homeowners & Property Managers Call Us"
    reasons={whyReasons}
  />

  <ReviewsBlock
    cityName={cityName}
    headline="What Malibu Clients Are Saying"
    testimonials={testimonials}
  />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in Malibu"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair. OEM parts only."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions Malibu Clients Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    nearbyCities={nearbyCities}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Broken in Malibu?"
    body="Beach house · Canyon estate · Vacation rental · BBQ · All of 90265. $89 diagnostic waived with repair. 90-day warranty. OEM parts. Salt air experts."
  />
</CityLayoutV2>
