---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="San Gabriel, CA"
    subheadline="One of the most historic cities in the San Gabriel Valley — and one where appliances need the same reliable service as anywhere else. Samsung, LG, GE, Whirlpool, Sub-Zero, all brands. Same-day service, OEM parts, 90-day warranty. Weekends available."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in San Gabriel — What We Know Here"
    paragraphs={introParagraphs}
    bookingTitle="San Gabriel Service Team"
    bookingSub="91775 · 91776 · Same day · Weekends ok"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in San Gabriel"
    subhead="All brands · SGVMWD hard water aware · 91775 & 91776"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="San Gabriel Restaurant Kitchen Service"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="San Gabriel Patios and the Hard Water Outside"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="All of San Gabriel — 91775 & 91776"
    subheadline="Mission Drive to Valley Blvd — every neighborhood in the city"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={keyStreets}
    bgImage="/images/cities/san-gabriel/neighborhood.webp"
  />

  <RecentRepairs
    citySlug={citySlug}
    cityName={cityName}
    headline="Recent Jobs in San Gabriel"
    subhead="Real calls from 91775 and 91776 — San Gabriel Valley homes, SGVMWD hard water, same-day service."
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why San Gabriel Calls Us Back"
    reasons={whyReasons}
  />

  <ReviewsBlock
    cityName={cityName}
    headline="What San Gabriel Customers Are Saying"
    testimonials={testimonials}
  />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in San Gabriel"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions San Gabriel Customers Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    nearbyCities={nearbyCities}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance broken in San Gabriel?"
    body="SGVMWD hard water specialists · All brands · Weekends available. 91775 & 91776. $89 diagnostic waived with repair. 90-day warranty."
  />
</CityLayoutV2>
