---
import Layout from '../layouts/Layout.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL, type Branch } from '../data/branches';
import BranchNAP from '../components/BranchNAP.astro';
import QuoteSheet from '../components/QuoteSheet.astro';
import QuoteFallbackForm from '../components/QuoteFallbackForm.astro';
import { DIAGNOSTIC_RES_DISPLAY } from '../data/quote-copy';

import { mergeCredentials } from '../data/credentials-schema';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
// Filter out branches with placeholder 555 phones (RC + Temecula are 'pending'
// until Roman buys real DIDs). Don't publish 555-fake numbers.
const activeBranches = BRANCHES.filter(b => b.phoneStatus === 'active');

const title = 'Book Appliance Repair Online — Same Day Service';
const description = 'Book a same-day appliance repair visit online or by phone. $89 dx waived, OEM parts, 90-day labor warranty. 10 branches across Southern California.';
const canonical = 'https://samedayappliance.repair/book/';

const mainPhone = MAIN_PHONE;          // (424) 325-0520 — LA default
const mainPhoneTel = MAIN_PHONE_TEL;   // +14243250520

// slug -> display phone, for the client-side branch detector (SSOT = branches.ts)
const branchPhoneMap = Object.fromEntries(activeBranches.map(b => [b.slug, b.phone]));

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://samedayappliance.repair/#business',
  name: 'Same Day Appliance Repair',
  legalName: 'HVAC 777 LLC',
  url: 'https://samedayappliance.repair/',
  telephone: '+13238704790',
  email: 'support@samedayappliance.repair',
  priceRange: '$89 diagnostic · OEM parts · 90-day warranty',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8746 Rangely Ave',
    addressLocality: 'West Hollywood',
    addressRegion: 'CA',
    postalCode: '90048',
    addressCountry: 'US'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.0800742, longitude: -118.384211 },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: canonical },
    name: 'Book an appliance repair visit'
  },
  'openingHoursSpecification': OPENING_HOURS_SCHEMA
});

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Book an appliance repair visit',
  url: canonical,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: 'Same Day Appliance Repair', url: 'https://samedayappliance.repair/' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://samedayappliance.repair/' },
    { '@type': 'ListItem', position: 2, name: 'Book', item: canonical }
  ]
};

---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="book-hero">
    <div class="container">
      <p class="eyebrow">Book · Same-Day Visits</p>
      <h1>Broken appliance? Get a tech out today.</h1>
      <p class="lede">
        Six quick questions, then we call you back — most requests booked before noon get a tech
        the same afternoon.
      </p>

      <div class="two-path">
        <!-- Path A: the quote sheet, first on the page and first in the fold.
             The link is a real anchor to the fallback form below, so with JS off
             it still lands somewhere useful; the island intercepts the click and
             opens the sheet instead. -->
        <a href="#contact" class="qs-cta" data-quote-source="book-hero">
          <span class="qs-cta-label">Get your price</span>
          <span class="qs-cta-sub">{DIAGNOSTIC_RES_DISPLAY} diagnostic · about a minute</span>
        </a>

        <!-- Path B: call the dispatcher. -->
        <a id="heroCall" href={`tel:${mainPhoneTel}`} class="call-now" data-tel>
          <span class="call-now-label">Call now</span>
          <span class="call-now-phone" id="heroCallPhone">{mainPhone}</span>
        </a>
      </div>
    </div>
  </section>

  <section class="fallback-section" id="contact">
    <div class="container">
      <div class="fallback-wrap">
        <h2>Send it in writing</h2>
        <p class="section-intro">
          Three fields and a dispatcher calls you back. Works with or without JavaScript.
        </p>
        <QuoteFallbackForm phone={mainPhone} phoneTel={mainPhoneTel} />
      </div>
    </div>
  </section>

  <section class="flow-section">
    <div class="container">
      <h2>How booking works</h2>
      <div class="step-grid">
        <div class="step">
          <span class="step-num">1</span>
          <h3>You call or send the form</h3>
          <p>
            Takes about 30 seconds. Name, phone, ZIP, and a line on what's wrong is all we need to
            get you in the queue and route you to the nearest branch.
          </p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Dispatch calls back</h3>
          <p>
            Within 30 minutes on a weekday. We confirm the address, book a 2-hour arrival window,
            and tell the tech which parts to stock on the truck. You get a text with the window
            and the tech's name.
          </p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Tech arrives, diagnoses, quotes</h3>
          <p>
            The $89 diagnostic covers up to 45 minutes of testing — pulling codes, checking
            compressor draw, inspecting water valves, whatever the symptom points at. You get a
            flat written repair quote before anything gets swapped.
          </p>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <h3>Approve → repair → 90-day warranty</h3>
          <p>
            Approve the quote and the $89 is waived — it rolls into the repair. OEM parts where
            available. You get a 90-day labor warranty and, on most parts, the manufacturer's
            parts warranty on top.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="branch-phones">
    <div class="container">
      <h2>Or call the branch closest to you</h2>
      <p class="section-intro">
        All five dispatch queues route through the same team. Calling the local branch just helps
        us pick the right truck faster.
      </p>
      <div class="phone-grid">
        {activeBranches.map((b) => (
          <div class="phone-card">
            <BranchNAP branch={b} showHeading={true} showEmail={false} showCities={true} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="coverage-note">
    <div class="container">
      <div class="note-grid">
        <div>
          <h3>Service area</h3>
          <p>
            Los Angeles County (from Malibu to the San Gabriel Valley), Orange County, Ventura
            County (through Thousand Oaks to Oxnard), the Santa Barbara South Coast (Carpinteria
            through Montecito and Santa Barbara to Goleta), plus parts of western San Bernardino
            and Riverside counties. If you're outside the map, call anyway — we've driven further
            for the right repair.
          </p>
        </div>
        <div>
          <h3>Not residential?</h3>
          <p>
            Restaurants, hotels, bars, grocery, property management, Airbnb portfolios — see our
            <a href="/for-business/">For Business</a> page for net-30 invoicing and named account
            managers, or call and ask for commercial dispatch. Commercial diagnostic is $120 and
            carries a different parts-warranty structure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline set:html={`window.__SDAR_BRANCH_PHONES = ${JSON.stringify(branchPhoneMap)};`}></script>

  <script is:inline>
    (function () {
      // What survives the QS-1 rewrite: the hero call button's branch detection and
      // the tel: click tracking. Everything that drove the old four-field form —
      // validation, the phone mask, the fetch, the ZIP table — is gone. The ZIP
      // table now lives in src/data/service-zone.ts and reaches the browser through
      // the quote sheet's serialised payload; form submission is the sheet's job,
      // or QuoteFallbackForm's native POST when JS is unavailable.
      var BRANCH_PHONES = window.__SDAR_BRANCH_PHONES || {};
      var MAIN_SLUG = 'los-angeles';

      var heroCall = document.getElementById('heroCall');
      var heroCallPhone = document.getElementById('heroCallPhone');

      function telHref(p) { return 'tel:+1' + String(p || '').replace(/\D/g, ''); }

      // Branch for the hero Call button: ?city=/?branch= → saved choice → LA default.
      function detectBranch() {
        try {
          var qs = new URLSearchParams(window.location.search);
          var q = (qs.get('city') || qs.get('branch') || '').toLowerCase().trim();
          if (q && BRANCH_PHONES[q]) { try { localStorage.setItem('sdar_branch', q); } catch (e) {} return q; }
          var saved = null;
          try { saved = localStorage.getItem('sdar_branch'); } catch (e) {}
          if (saved && BRANCH_PHONES[saved]) return saved;
        } catch (e) {}
        return MAIN_SLUG;
      }

      var currentBranch = detectBranch();
      if (heroCall && heroCallPhone && BRANCH_PHONES[currentBranch]) {
        var ph = BRANCH_PHONES[currentBranch];
        heroCall.href = telHref(ph);
        heroCallPhone.textContent = ph;
      }

      // Tracking: contact_click on every tel: link on the page.
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!a) return;
        window.dataLayer.push({ event: 'contact_click', branch: currentBranch, page: '/book/' });
      });

      // Tracking: form_start on first focus in the fallback form.
      var fb = document.getElementById('qs-fallback-form');
      if (fb) {
        var started = false;
        fb.addEventListener('focusin', function () {
          if (started) return;
          started = true;
          window.dataLayer.push({ event: 'form_start', form: 'fallback' });
        });
      }
    })();
  </script>

  <QuoteSheet phone={mainPhone} />
</Layout>

<style>
  /* QS-1.4: the top padding is deliberately small. On a 360×740 phone the quote
     button has to clear the fold without scrolling, and 64px of dead space above
     the eyebrow was the single biggest thing pushing it under. */
  .book-hero { padding: 12px 0 40px; background: var(--gray); border-bottom: 1px solid var(--border); }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); margin-bottom: 8px; }
  h1 { font-size: clamp(1.6rem, 5vw, 3.2rem); line-height: 1.12; margin: 0 0 12px; max-width: 820px; }
  .lede { max-width: 640px; font-size: 16px; line-height: 1.5; color: var(--muted); margin-bottom: 20px; }

  /* Two-path column — narrow, focused, mobile-first */
  .two-path { max-width: 560px; }

  /* Path A: the quote-sheet trigger — the primary action, solid red, first.
     A real anchor (#contact) so the no-JS leg still goes somewhere; the island
     upgrades the click into the sheet. */
  .qs-cta {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 2px; width: 100%; min-height: 56px; padding: 14px 24px;
    background: var(--red); color: var(--white); border: none;
    border-radius: 8px; text-decoration: none; text-align: center;
    box-shadow: 0 6px 20px rgba(200, 16, 46, 0.28);
    transition: background 0.2s var(--ease), transform 0.1s var(--ease);
  }
  .qs-cta:hover { background: var(--red-dark, #8a0d20); color: var(--white); }
  .qs-cta:active { transform: translateY(1px); }
  .qs-cta:focus-visible { outline: 2px solid var(--black); outline-offset: 2px; }
  .qs-cta-label { font-size: clamp(1.25rem, 5.5vw, 1.5rem); font-weight: 800; line-height: 1.15; }
  .qs-cta-sub { font-size: 13px; color: var(--white); opacity: 0.92; }

  /* Path B: call the dispatcher — secondary, outlined in the same red. */
  .call-now {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1px; width: 100%; min-height: 56px; margin-top: 12px; padding: 12px 24px;
    background: var(--white); color: var(--red); border: 2px solid var(--red);
    border-radius: 8px; text-decoration: none; text-align: center;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }
  .call-now:hover { background: var(--red); color: var(--white); }
  .call-now:active { transform: translateY(1px); }
  .call-now-label { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.9; }
  .call-now-phone { font-family: var(--font-display, inherit); font-size: clamp(1.5rem, 5.5vw, 2rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }

  /* Desktop has fold to spare — give the hero its air back above the tablet
     breakpoint. Everything below 768px stays fold-first. */
  @media (min-width: 768px) {
    .book-hero { padding: 48px 0 64px; }
    .eyebrow { margin-bottom: 16px; }
    h1 { margin-bottom: 18px; }
    .lede { font-size: 17px; line-height: 1.6; margin-bottom: 28px; }
  }

  .fallback-section { padding: 56px 0; background: var(--white); border-bottom: 1px solid var(--border); }
  .fallback-wrap { max-width: 560px; }
  .fallback-wrap h2 { margin-bottom: 10px; }

  .flow-section { padding: 64px 0; }
  h2 { font-size: clamp(1.6rem, 3.5vw, 2.2rem); margin: 0 0 14px; }
  .section-intro { color: var(--muted); max-width: 720px; margin-bottom: 32px; font-size: 16px; line-height: 1.6; }
  .step-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-top: 28px; }
  .step { padding: 24px; background: var(--gray); border-radius: 6px; border: 1px solid var(--border); position: relative; }
  .step-num {
    position: absolute; top: -14px; left: 20px; display: inline-flex;
    align-items: center; justify-content: center; width: 32px; height: 32px;
    background: var(--red); color: var(--white); border-radius: 50%;
    font-weight: 700; font-size: 15px;
  }
  .step h3 { font-size: 17px; margin: 8px 0 10px; font-family: var(--font-body); font-weight: 600; }
  .step p { font-size: 14px; line-height: 1.65; color: var(--muted); margin: 0; }

  .branch-phones { padding: 64px 0; background: var(--gray); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .phone-grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .phone-card {
    display: flex; flex-direction: column; gap: 4px; padding: 18px 20px;
    background: var(--white); border: 1px solid var(--border); border-radius: 6px;
    text-decoration: none; transition: all 0.2s var(--ease);
  }
  .phone-card:hover { border-color: var(--black); transform: translateY(-1px); }
  .phone-city { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); }
  .phone-num { font-family: var(--font-display); font-size: 22px; font-weight: 700; color: var(--black); }
  .phone-zones { font-size: 12px; color: var(--muted); margin-top: 4px; }

  .coverage-note { padding: 56px 0 96px; }
  .note-grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .note-grid h3 { font-size: 15px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: var(--red); margin: 0 0 14px; }
  .note-grid p { font-size: 15px; line-height: 1.7; color: var(--text); }
  .note-grid a { color: var(--red); }
</style>
