---
import Layout from '../layouts/Layout.astro';
import { BRANCHES, MAIN_PHONE, MAIN_PHONE_TEL, type Branch } from '../data/branches';
import BranchNAP from '../components/BranchNAP.astro';

import { mergeCredentials } from '../data/credentials-schema';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
// Filter out branches with placeholder 555 phones (RC + Temecula are 'pending'
// until Roman buys real DIDs). Don't publish 555-fake numbers.
const activeBranches = BRANCHES.filter(b => b.phoneStatus === 'active');

const title = 'Book Appliance Repair Online — Same Day Service';
const description = 'Book a same-day appliance repair visit online or by phone. $89 dx waived, OEM parts, 90-day labor warranty. 10 branches across SoCal.';
const canonical = 'https://samedayappliance.repair/book/';

const mainPhone = MAIN_PHONE;          // (424) 325-0520 — LA default
const mainPhoneTel = MAIN_PHONE_TEL;   // +14243250520

// slug -> display phone, for the client-side branch detector (SSOT = branches.ts)
const branchPhoneMap = Object.fromEntries(activeBranches.map(b => [b.slug, b.phone]));

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://samedayappliance.repair/#business',
  name: 'Same Day Appliance Repair',
  legalName: 'HVAC 777 LLC',
  url: 'https://samedayappliance.repair/',
  telephone: '+1-323-870-4790',
  email: 'support@samedayappliance.repair',
  priceRange: '$89 diagnostic · OEM parts · 90-day warranty',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '8746 Rangely Ave',
    addressLocality: 'West Hollywood',
    addressRegion: 'CA',
    postalCode: '90048',
    addressCountry: 'US'
  },
  geo: { '@type': 'GeoCoordinates', latitude: 34.0619, longitude: -118.3692 },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    target: { '@type': 'EntryPoint', urlTemplate: canonical },
    name: 'Book an appliance repair visit'
  },
  'openingHoursSpecification': OPENING_HOURS_SCHEMA
});

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Book an appliance repair visit',
  url: canonical,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: 'Same Day Appliance Repair', url: 'https://samedayappliance.repair/' }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://samedayappliance.repair/' },
    { '@type': 'ListItem', position: 2, name: 'Book', item: canonical }
  ]
};

---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <section class="book-hero">
    <div class="container">
      <p class="eyebrow">Book · Same-Day Visits</p>
      <h1>Broken appliance? Get a tech out today.</h1>
      <p class="lede">
        Two ways to book — call the dispatcher direct, or send a 30-second request and we call
        you back. Most same-day requests booked before noon get a tech out the same afternoon.
      </p>

      <div class="two-path">
        <!-- Path A: call now -->
        <a id="heroCall" href={`tel:${mainPhoneTel}`} class="call-now" data-tel>
          <span class="call-now-label">Call Now — fastest</span>
          <span class="call-now-phone" id="heroCallPhone">{mainPhone}</span>
        </a>
        <p class="call-micro">Phones answered 24/7 · $89 diagnostic, waived when the repair goes ahead</p>

        <div class="path-divider"><span>or book online — 30 seconds</span></div>

        <!-- Path B: 4-field form -->
        <form class="book-form" id="bookingForm" novalidate>
          <div class="form-row">
            <label>
              <span>Your name *</span>
              <input type="text" id="f-name" name="name" required autocomplete="name" placeholder="First name" />
            </label>
            <label>
              <span>Phone *</span>
              <input type="tel" id="f-phone" name="phone" required autocomplete="tel"
                     inputmode="tel" placeholder="(000) 000-0000" />
            </label>
          </div>

          <div class="form-row">
            <label>
              <span>ZIP *</span>
              <input type="text" id="f-zip" name="zip" required inputmode="numeric"
                     pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" placeholder="90048" />
            </label>
            <label>
              <span>What's wrong? <em>(optional)</em></span>
              <input type="text" id="f-issue" name="symptom"
                     placeholder="e.g. Sub-Zero warm on one side" />
            </label>
          </div>

          <input type="text" id="f-hp" name="website" autocomplete="off" tabindex="-1" aria-hidden="true"
                 style="position:absolute;left:-9999px;opacity:0;pointer-events:none;height:1px;width:1px" />

          <div id="formError" class="form-error-banner" role="alert" hidden></div>
          <button type="button" id="bookSubmit" class="btn-primary submit">Send booking request</button>
          <p class="form-note">
            Prefer to talk it through? Calling <a href={`tel:${mainPhoneTel}`} data-tel>{mainPhone}</a>
            is the fastest path to a same-day slot.
          </p>
        </form>

        <div id="bookingSuccess" class="book-success" style="display:none">
          <div class="success-check" aria-hidden="true">✓</div>
          <h3>Booking received</h3>
          <p>
            A dispatcher from your nearest branch will call back within 30 minutes during business
            hours (Mon–Sat 8AM–8PM). For urgent same-day needs, calling directly is fastest.
          </p>
          <a id="successCallLink" href={`tel:${mainPhoneTel}`} class="btn-primary submit" data-tel>Call {mainPhone}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="flow-section">
    <div class="container">
      <h2>How booking works</h2>
      <div class="step-grid">
        <div class="step">
          <span class="step-num">1</span>
          <h3>You call or send the form</h3>
          <p>
            Takes about 30 seconds. Name, phone, ZIP, and a line on what's wrong is all we need to
            get you in the queue and route you to the nearest branch.
          </p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <h3>Dispatch calls back</h3>
          <p>
            Within 30 minutes on a weekday. We confirm the address, book a 2-hour arrival window,
            and tell the tech which parts to stock on the truck. You get a text with the window
            and the tech's name.
          </p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <h3>Tech arrives, diagnoses, quotes</h3>
          <p>
            The $89 diagnostic covers up to 45 minutes of testing — pulling codes, checking
            compressor draw, inspecting water valves, whatever the symptom points at. You get a
            flat written repair quote before anything gets swapped.
          </p>
        </div>
        <div class="step">
          <span class="step-num">4</span>
          <h3>Approve → repair → 90-day warranty</h3>
          <p>
            Approve the quote and the $89 is waived — it rolls into the repair. OEM parts where
            available. You get a 90-day labor warranty and, on most parts, the manufacturer's
            parts warranty on top.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="branch-phones">
    <div class="container">
      <h2>Or call the branch closest to you</h2>
      <p class="section-intro">
        All five dispatch queues route through the same team. Calling the local branch just helps
        us pick the right truck faster.
      </p>
      <div class="phone-grid">
        {activeBranches.map((b) => (
          <div class="phone-card">
            <BranchNAP branch={b} showHeading={true} showEmail={false} showCities={true} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="coverage-note">
    <div class="container">
      <div class="note-grid">
        <div>
          <h3>Service area</h3>
          <p>
            Los Angeles County (from Malibu to the San Gabriel Valley), Orange County, Ventura
            County (through Thousand Oaks to Oxnard), the Santa Barbara South Coast (Carpinteria
            through Montecito and Santa Barbara to Goleta), plus parts of western San Bernardino
            and Riverside counties. If you're outside the map, call anyway — we've driven further
            for the right repair.
          </p>
        </div>
        <div>
          <h3>Not residential?</h3>
          <p>
            Restaurants, hotels, bars, grocery, property management, Airbnb portfolios — see our
            <a href="/for-business/">For Business</a> page for net-30 invoicing and named account
            managers, or call and ask for commercial dispatch. Commercial diagnostic is $120 and
            carries a different parts-warranty structure.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline set:html={`window.__SDAR_BRANCH_PHONES = ${JSON.stringify(branchPhoneMap)};`}></script>

  <script is:inline>
    (function () {
      var btn = document.getElementById('bookSubmit');
      if (!btn) return;
      var form = document.getElementById('bookingForm');
      var success = document.getElementById('bookingSuccess');
      var successCall = document.getElementById('successCallLink');
      var heroCall = document.getElementById('heroCall');
      var heroCallPhone = document.getElementById('heroCallPhone');
      var formError = document.getElementById('formError');

      var BRANCH_PHONES = window.__SDAR_BRANCH_PHONES || {};
      var MAIN_SLUG = 'los-angeles';
      var MAIN_PHONE = BRANCH_PHONES[MAIN_SLUG] || '(424) 325-0520';

      function val(id) {
        var el = document.getElementById(id);
        return el ? (el.value || '').trim() : '';
      }
      function telHref(p) { return 'tel:+1' + String(p || '').replace(/\D/g, ''); }
      function branchPhoneFor(slug) { return BRANCH_PHONES[slug] || MAIN_PHONE; }

      // ── ZIP → branch slug (7-county coverage, LA default) ───────────────
      // branches.ts has no ZIP coverage table; this prefix map + boundary
      // overrides route the payload to the nearest branch for dispatch.
      function zipToBranch(zip) {
        zip = String(zip || '').replace(/\D/g, '').slice(0, 5);
        if (zip.length < 5) return MAIN_SLUG;
        // Exact-ZIP overrides for branch boundaries
        var exact = {
          // West Hollywood pin territory
          '90048': 'west-hollywood', '90046': 'west-hollywood', '90069': 'west-hollywood',
          '90038': 'west-hollywood', '90028': 'west-hollywood',
          // Beverly Hills
          '90209': 'beverly-hills', '90210': 'beverly-hills', '90211': 'beverly-hills',
          '90212': 'beverly-hills', '90213': 'beverly-hills',
          // Thousand Oaks / Conejo Valley zips that live in the 913xx block
          '91319': 'thousand-oaks', '91320': 'thousand-oaks', '91358': 'thousand-oaks',
          '91359': 'thousand-oaks', '91360': 'thousand-oaks', '91361': 'thousand-oaks',
          '91362': 'thousand-oaks', '91377': 'thousand-oaks', '91301': 'thousand-oaks',
          // Santa Barbara branch — South Coast corridor (2026-08-06).
          // 930xx/931xx prefixes stay thousand-oaks (Ventura county); these
          // exact SB-county ZIPs override: Carpinteria, Summerland,
          // Santa Barbara city (incl. 93108 Montecito, 93110 Hope Ranch), Goleta.
          // San Diego branch — Wave 1 North County Coastal + La Jolla ONLY
          // (2026-08-07). City-of-SD prefixes 919xx/921xx stay UNMAPPED on
          // purpose until Wave 2 pages exist.
          '92037': 'san-diego',
          '92008': 'san-diego', '92009': 'san-diego', '92010': 'san-diego', '92011': 'san-diego',
          '92014': 'san-diego', '92067': 'san-diego', '92091': 'san-diego',
          '92024': 'san-diego', '92075': 'san-diego', '92007': 'san-diego',
          '93013': 'santa-barbara', '93067': 'santa-barbara',
          '93101': 'santa-barbara', '93102': 'santa-barbara', '93103': 'santa-barbara',
          '93104': 'santa-barbara', '93105': 'santa-barbara', '93106': 'santa-barbara',
          '93107': 'santa-barbara', '93108': 'santa-barbara', '93109': 'santa-barbara',
          '93110': 'santa-barbara', '93111': 'santa-barbara', '93117': 'santa-barbara'
        };
        if (exact[zip]) return exact[zip];
        var p3 = zip.slice(0, 3);
        var map3 = {
          // LA basin / South Bay / Westside / Long Beach
          '900': 'los-angeles', '901': 'los-angeles', '902': 'los-angeles', '903': 'los-angeles',
          '904': 'los-angeles', '905': 'los-angeles', '906': 'los-angeles', '907': 'los-angeles',
          '908': 'los-angeles',
          // San Gabriel Valley / Pasadena / Glendale
          '910': 'pasadena', '911': 'pasadena', '912': 'pasadena', '918': 'pasadena',
          // San Fernando Valley / Burbank
          '913': 'los-angeles', '914': 'los-angeles', '915': 'los-angeles',
          // Inland Empire (San Bernardino county)
          '917': 'rancho-cucamonga', '923': 'rancho-cucamonga', '924': 'rancho-cucamonga',
          // Riverside county
          '922': 'riverside', '925': 'riverside',
          // Orange county
          '926': 'irvine', '927': 'irvine', '928': 'irvine',
          // Ventura county
          '930': 'thousand-oaks', '931': 'thousand-oaks'
        };
        return map3[p3] || MAIN_SLUG;
      }

      // ── Branch detection for the hero Call button ───────────────────────
      // Priority: ?city=/?branch= query param → saved choice → LA default.
      function detectBranch() {
        try {
          var qs = new URLSearchParams(window.location.search);
          var q = (qs.get('city') || qs.get('branch') || '').toLowerCase().trim();
          if (q && BRANCH_PHONES[q]) { try { localStorage.setItem('sdar_branch', q); } catch (e) {} return q; }
          var saved = null;
          try { saved = localStorage.getItem('sdar_branch'); } catch (e) {}
          if (saved && BRANCH_PHONES[saved]) return saved;
        } catch (e) {}
        return MAIN_SLUG;
      }

      var currentBranch = detectBranch();
      if (heroCall && heroCallPhone && BRANCH_PHONES[currentBranch]) {
        var ph = BRANCH_PHONES[currentBranch];
        heroCall.href = telHref(ph);
        heroCallPhone.textContent = ph;
      }

      // ── Tracking: contact_click on every tel: link on the page ──────────
      window.dataLayer = window.dataLayer || [];
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[href^="tel:"]') : null;
        if (!a) return;
        window.dataLayer.push({ event: 'contact_click', branch: currentBranch, page: '/book/' });
      });

      // ── Tracking: form_start on first field focus (once) ────────────────
      var formStarted = false;
      if (form) {
        form.addEventListener('focusin', function () {
          if (formStarted) return;
          formStarted = true;
          window.dataLayer.push({ event: 'form_start' });
        });
      }

      // ── US phone mask ───────────────────────────────────────────────────
      var phoneEl = document.getElementById('f-phone');
      if (phoneEl) {
        phoneEl.addEventListener('input', function () {
          var d = phoneEl.value.replace(/\D/g, '').slice(0, 10);
          var out = d;
          if (d.length > 6) out = '(' + d.slice(0, 3) + ') ' + d.slice(3, 6) + '-' + d.slice(6);
          else if (d.length > 3) out = '(' + d.slice(0, 3) + ') ' + d.slice(3);
          else if (d.length > 0) out = '(' + d;
          phoneEl.value = out;
        });
      }
      // ZIP: digits only
      var zipEl = document.getElementById('f-zip');
      if (zipEl) {
        zipEl.addEventListener('input', function () {
          zipEl.value = zipEl.value.replace(/\D/g, '').slice(0, 5);
        });
      }

      // ── Inline field-error helpers ──────────────────────────────────────
      var REQUIRED = ['f-name', 'f-phone', 'f-zip'];
      function fieldWrap(id) {
        var e = document.getElementById(id);
        if (!e) return null;
        return e.closest ? e.closest('label') : e.parentNode;
      }
      function showFieldError(id, msg) {
        var e = document.getElementById(id); if (!e) return;
        var wrap = fieldWrap(id); if (!wrap) return;
        var err = wrap.querySelector('.field-error');
        if (!err) { err = document.createElement('span'); err.className = 'field-error'; wrap.appendChild(err); }
        err.textContent = msg;
        e.setAttribute('aria-invalid', 'true');
        e.classList.add('input-invalid');
      }
      function clearFieldError(id) {
        var e = document.getElementById(id); if (!e) return;
        var wrap = fieldWrap(id); if (wrap) { var err = wrap.querySelector('.field-error'); if (err) err.textContent = ''; }
        e.removeAttribute('aria-invalid');
        e.classList.remove('input-invalid');
      }
      function showFormError(html) { if (formError) { formError.innerHTML = html; formError.hidden = false; formError.scrollIntoView({ behavior: 'smooth', block: 'center' }); } }
      function hideFormError() { if (formError) { formError.hidden = true; formError.innerHTML = ''; } }

      REQUIRED.forEach(function (id) {
        var e = document.getElementById(id); if (!e) return;
        e.addEventListener('input', function () { clearFieldError(id); });
      });

      function validate() {
        hideFormError();
        REQUIRED.forEach(clearFieldError);
        var firstBad = null;
        function bad(id, msg) { showFieldError(id, msg); if (!firstBad) firstBad = id; }
        if (!val('f-name')) bad('f-name', 'Please enter your name.');
        var phone = val('f-phone');
        if (!phone || phone.replace(/\D/g, '').length < 10) bad('f-phone', 'Enter a 10-digit phone number.');
        var zip = val('f-zip');
        if (!/^[0-9]{5}$/.test(zip)) bad('f-zip', 'Enter your 5-digit ZIP.');
        if (firstBad) {
          var e = document.getElementById(firstBad);
          if (e) { try { e.focus(); } catch (_) {} e.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
          return false;
        }
        return true;
      }

      btn.addEventListener('click', async function () {
        if (!validate()) return;

        var zip = val('f-zip');
        var branch = zipToBranch(zip);
        var issue = val('f-issue');
        var origText = btn.textContent;
        var submitted = false;
        btn.disabled = true;
        btn.textContent = 'Sending…';
        hideFormError();

        try {
          var res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'booking',
              brand_site: 'samedayappliance.repair',
              name: val('f-name'),
              phone: val('f-phone'),
              zip: zip,
              city: branch,
              description: issue,
              symptom: issue,
              _hp: val('f-hp')
            })
          });
          var data = null;
          try { data = await res.json(); } catch (_) { data = null; }

          if (res.ok && data && data.ok) {
            submitted = true;
            var bp = branchPhoneFor((data && data.branch) || branch);
            if (successCall) { successCall.href = telHref(bp); successCall.textContent = 'Call ' + bp; }
            form.style.display = 'none';
            success.style.display = 'block';
            // GA4 conversion — do not remove.
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'booking_submitted',
              branch: (data && data.branch) || branch,
              appliance: issue
            });
            success.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            var bpe = branchPhoneFor(branch);
            showFormError('We couldn’t submit your request. So we don’t lose it, please call your branch directly: <a href="' + telHref(bpe) + '">' + bpe + '</a>.');
          }
        } catch (err) {
          var bpn = branchPhoneFor(branch);
          showFormError('Network problem — your request didn’t go through. Please call <a href="' + telHref(bpn) + '">' + bpn + '</a> and we’ll book you right away.');
        } finally {
          if (!submitted) { btn.disabled = false; btn.textContent = origText; }
        }
      });
    })();
  </script>
</Layout>

<style>
  .book-hero { padding: 64px 0 72px; background: var(--gray); border-bottom: 1px solid var(--border); }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--red); margin-bottom: 16px; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; margin: 0 0 18px; max-width: 820px; }
  .lede { max-width: 640px; font-size: 17px; line-height: 1.6; color: var(--muted); margin-bottom: 32px; }

  /* Two-path column — narrow, focused, mobile-first */
  .two-path { max-width: 560px; }

  /* Path A: the single most prominent element on the screen */
  .call-now {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 2px; width: 100%; padding: 20px 24px; background: var(--red); color: var(--white);
    border-radius: 8px; text-decoration: none; text-align: center;
    box-shadow: 0 6px 20px rgba(200, 16, 46, 0.28); transition: background 0.2s var(--ease), transform 0.1s var(--ease);
  }
  .call-now:hover { background: var(--red-dark, #8a0d20); color: var(--white); }
  .call-now:active { transform: translateY(1px); }
  .call-now-label { font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.9; }
  .call-now-phone { font-family: var(--font-display, inherit); font-size: clamp(1.8rem, 6vw, 2.4rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.01em; }
  .call-micro { margin: 12px 0 0; font-size: 13px; color: var(--muted); text-align: center; }

  /* Divider between the two paths */
  .path-divider { display: flex; align-items: center; gap: 14px; margin: 28px 0 24px; color: var(--muted); }
  .path-divider::before, .path-divider::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .path-divider span { font-size: 13px; font-weight: 600; letter-spacing: 0.02em; white-space: nowrap; }

  .btn-primary {
    display: inline-block; padding: 14px 22px; background: var(--red); color: var(--white);
    font-weight: 600; border-radius: 4px; text-decoration: none; transition: background 0.2s var(--ease);
    border: none; font-family: inherit; cursor: pointer; font-size: 16px;
  }
  .btn-primary:hover { background: var(--red-dark, #8a0d20); color: var(--white); }

  .book-form { background: var(--white); padding: 24px; border: 1px solid var(--border); border-radius: 8px; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
  @media (max-width: 560px) { .form-row { grid-template-columns: 1fr; } }
  label { display: block; font-size: 13px; font-weight: 600; color: var(--text); }
  label span { display: block; margin-bottom: 6px; }
  label em { font-style: normal; font-weight: 400; color: var(--muted); }
  input {
    width: 100%; padding: 12px 12px; border: 1px solid var(--border); border-radius: 4px;
    font-family: inherit; font-size: 16px; background: var(--white); color: var(--text);
  }
  input:focus { outline: 2px solid var(--red); outline-offset: 1px; border-color: var(--red); }
  .submit { width: 100%; margin-top: 4px; }
