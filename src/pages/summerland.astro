const citySlug = 'summerland';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Summerland';
const zips = ['93067'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Summerland CA — Same Day Service`;
const description = "Same-day appliance repair in Summerland 93067 — hillside cottages, compact kitchens, stacked laundry. Covered daily from Santa Barbara. $89 dx. (805) 500-0855.";
const canonical = 'https://samedayappliance.repair/summerland/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Summerland', sameAs: 'https://en.wikipedia.org/wiki/Summerland,_California' },
    { '@type': 'Place', name: 'Lillie Avenue' },
    { '@type': 'Place', name: 'Lookout Park area' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
});

const introParagraphs = [
  "<strong>When an appliance fails in Summerland, our techs at Same Day Appliance Repair are usually working inside a space problem: hillside cottages on narrow lots where the laundry is a stacked pair in a hall closet, the kitchen was framed a century ago, and the refrigerator that lives there now is bigger than anything the builder imagined. We dispatch same-day along the Lillie Avenue village and the hillside lanes above Lookout Park. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Let's be honest about scale: Summerland is a few hundred households on a hillside between <a href=\"/montecito/\">Montecito</a> and <a href=\"/carpinteria/\">Carpinteria</a>, and no repair company keeps a truck parked here. What we keep instead is a daily 101 route that passes the Summerland exit every working day — our Santa Barbara branch covers the whole South Coast corridor, and Summerland sits dead-center on it. Same-day here isn't a stretch goal; it's geometry.",
  "The village's building stock drives the work. Summerland's cottages date to an era of small rooms and smaller kitchens, and decades of remodels have packed modern equipment into them: counter-depth and full-size refrigerators boxed into alcoves with an inch of clearance, stacked washer-dryers in closets without much airflow, dishwashers plumbed into cabinetry that predates the plumbing code that governs them. Machines squeezed into tight spaces run hotter, vent worse, and get serviced less — because getting them out is a project. Tight-space extraction is routine for us: floor protection, appliance rollers, and the patience to do it without scarring a hundred-year-old doorframe.",
  "The ocean is right there, too — most of the village looks at it. Salt exposure here is real but gentler than Carpinteria's beach grid; the hillside elevation helps. We still check coils and gaskets on refrigeration calls, because the coastal schedule applies, just with more forgiving math.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for same-day service in 93067 — and the rest of the <a href="/santa-barbara-county/">South Coast corridor</a>.`
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Alcove airflow · Counter-depth units · Coastal coil wear', brands: 'KitchenAid · Whirlpool · GE · LG · Samsung · Sub-Zero' },
  { icon: '🫧', name: 'Washer & Dryer Repair', slug: 'washer', issues: 'Stacked pairs · Closet installs · Drain codes · Venting', brands: 'LG · Samsung · Whirlpool · GE · Bosch' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Air gap backups · Retrofit plumbing · Compact units', brands: 'Bosch · Miele · KitchenAid · Whirlpool · GE' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven', issues: 'Not heating · Elements · Igniters · Cottage kitchens', brands: 'Samsung · GE · Whirlpool · Wolf · Viking' },
  { icon: '♨️', name: 'Cooktop Repair', slug: 'cooktop', issues: "Burners won't light · Compact cooktops · Glass tops", brands: 'GE · Bosch · Whirlpool · Wolf' },
  { icon: '❄️', name: 'Freezer & Undercounter', slug: 'freezer', issues: 'Undercounter units · Frost · Small-space installs', brands: 'U-Line · GE · Frigidaire · Sub-Zero' }
];

const cottageNarrative = {
  eyebrow: 'SMALL VILLAGE, TIGHT KITCHENS',
  headline: 'Full-Size Appliances in Cottage-Size Spaces',
  paragraphs: [
    "Summerland's remodels all faced the same constraint: the rooms weren't getting bigger. So the village is full of modern appliances installed at the very edge of fit — refrigerators in alcoves with no side clearance, stacked laundry behind louvered closet doors, dishwashers whose supply lines snake through cabinetry never meant to hold plumbing.",
    "Tight installs create their own service patterns. A refrigerator with an inch of clearance recirculates its own heat, runs longer, and wears its cooling system faster than the same unit breathing freely — on boxed-in units, condenser airflow is the first thing we check, not the last. Stacked pairs in closets vent poorly, so lint and moisture issues show up earlier. And everything is harder to reach, which means small faults get ignored until they're big ones, because nobody wants to wrestle the machine out of its nook to look.",
    "Wrestling machines out of nooks is, frankly, a skill we've built. Rollers, floor protection, door-frame padding, and the two-person patience to extract a unit from a space with zero margin — then put it back without a mark. If your last technician declined the job because the appliance was 'inaccessible,' that's the call we're used to getting next."
  ]
};

const luxuryNarrative = {
  headline: 'Estate-Grade Kitchens in Cottage-Size Rooms',
