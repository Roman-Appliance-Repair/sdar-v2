<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Summerland, CA"
    subheadline="Hillside cottages, compact kitchens, stacked laundry in closets — small-space appliance work is the village specialty. On our route daily. $89 diagnostic, waived with repair."
    zips={zips}
    tier={2}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Summerland — How We Actually Work Here"
    paragraphs={introParagraphs}
    bookingTitle="Summerland Service"
    bookingSub="93067 · Cottages · Compact Installs"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Summerland"
    subhead="Compact installs · Stacked laundry · Cottage kitchens · 93067"
    services={services}
  />

  <CustomNarrative
    eyebrow={cottageNarrative.eyebrow}
    headline={cottageNarrative.headline}
    paragraphs={cottageNarrative.paragraphs}
    background="white"
  />

