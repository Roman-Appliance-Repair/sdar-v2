---
/**
 * Summerland, CA — city pillar (feat/santa-barbara Stage C).
 * Branch: Santa Barbara — service_area (no public street address).
 *
 * Angle (distinct from siblings): tiny coastal village between Montecito and
 * Carpinteria. Old cottages on narrow lots, compact and stacked laundry,
 * undersized kitchens where full-size appliances were retrofitted into spaces
 * never designed for them. Honest about scale — small town, covered from the
 * Santa Barbara branch on the daily 101 route.
 *
 * Zero-invention: repair cases reuse site-established patterns only (LG OE
 * drain code, KitchenAid counter-depth airflow, Samsung oven bake element,
 * dishwasher air-gap cleaning per our CA-code flagship page). No ReviewsBlock.
 * Residential → $89 only.
 */

import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
