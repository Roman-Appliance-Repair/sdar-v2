---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair in"
    headlineCity="Villa Park, CA"
    subheadline="Sub-Zero, Wolf, Thermador, Miele & all luxury brands. Estate home specialists. OEM parts, 90-day warranty. $89 diagnostic — waived with repair."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Villa Park — Where Sub-Zero Is the Standard"
    paragraphs={introParagraphs}
    bookingTitle="Villa Park Service"
    bookingSub="92861 · Estate Homes · Same Day"
  />

  <ServicesGrid
    cityName={cityName}
    headline="Luxury Appliance Repair Services in Villa Park"
    services={services}
  />

  <LuxurySpecialists
    citySlug={citySlug}
    cityName={cityName}
    headline={luxuryNarrative.headline}
    paragraphs={luxuryNarrative.paragraphs}
    brands={getLuxuryBrands(citySlug)}
  />

  <CustomNarrative
    headline={villaParkContextNarrative.headline}
    paragraphs={villaParkContextNarrative.paragraphs}
    subSections={villaParkContextNarrative.subSections}
    background="white"
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Villa Park Commercial Kitchen Service"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Villa Park Lots, Horses and the Dry Slope"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Villa Park Areas We Service"
    subheadline="All of 92861 — large-lot estate community."
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={[]}
    bgImage="/images/cities/villa-park/neighborhood.webp"
  />

  <RecentRepairs
    citySlug={citySlug}
    cityName={cityName}
    headline="Recent Repairs in Villa Park"
    jobs={recentJobs}
  />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Villa Park Homeowners Call Us"
    reasons={whyReasons}
  />

  <ReviewsBlock
    cityName={cityName}
    headline="What Villa Park Clients Say"
    testimonials={testimonials}
  />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Villa Park"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Villa Park"
    faqs={faqs}
  />

  <AlsoServingNearby
    nearbyCities={nearbyCities}
    headline="Also Serving Nearby OC Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Schedule Your Villa Park Repair Today"
    body="Sub-Zero, Wolf, Thermador, Miele — same-day service, OEM parts, estate home expertise. $89 diagnostic · 90-day warranty · OEM parts · Villa Park, CA 92861."
  />
</CityLayoutV2>
