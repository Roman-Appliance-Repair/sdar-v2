---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'south-pasadena';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'South Pasadena';
const zips = ['91030'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair South Pasadena CA — Same Day Service`;
const description = `Same-day appliance repair in South Pasadena, CA 91030. Mission Street, Marengo Ave, Meridian Ave. Licensed, OEM parts Weekends available.`;
const canonical = 'https://samedayappliance.repair/south-pasadena/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/images/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'South Pasadena', sameAs: 'https://en.wikipedia.org/wiki/South_Pasadena,_California' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
  license: 'BHGS #A49573'

});

const introParagraphs = [
  "<strong>When an appliance fails in South Pasadena, our techs at Same Day Appliance Repair trace it to a handful of patterns: vintage O'Keefe & Merritt ranges with corroded burner igniters and out oven pilots, LADWP hard-water scale (230–310 mg/L) on LG ice maker inlet valves, mineral-clogged Samsung dishwasher spray arms, and Maytag dryer thermal fuses blown from lint-blocked vent runs. We dispatch same-day across the Mission Street corridor, the Historic District, Marengo Avenue, and Meridian Avenue. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "South Pasadena is one of the best-preserved small cities in the San Gabriel Valley. The Craftsman bungalows along Marengo, Meridian, and Fairview Avenues, the Spanish Colonials and Victorians throughout the historic district — these homes have been maintained and loved for decades, and their kitchens reflect that.",
  "A meaningful number of those kitchens still have vintage ranges — O'Keefe & Merritt, Wedgewood, Roper — running alongside modern dishwashers and refrigerators. We don't turn these away. If a vintage range can be repaired economically, we do it. If it can't, we'll tell you that directly rather than waste your time and money.",
  "Hard water is a real factor in South Pasadena. LADWP water in this area runs 230–310 mg/L hardness, and older galvanized pipes in the 1920s–40s homes add iron. Ice maker inlet valves and dishwasher spray arms scale up faster than the national average — we test for this on every relevant South Pasadena call. It consistently matters here.",
  "Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong>. We're available <strong>Saturdays and Sundays</strong> — unlike some South Pasadena competitors who close on weekends.",
  "<strong>Vintage range tip for South Pasadena:</strong> If you have an O'Keefe & Merritt, Wedgewood, or Roper still running in your Craftsman kitchen — these are worth keeping. Parts are still available for most common failures (burner igniters, pilot assemblies, oven thermostats). A $150–$250 repair on a range that cooks beautifully is almost always the right call. We assess vintage ranges honestly and won't push you toward unnecessary replacement."
];

// Commercial: written new — this page had no commercial prose. The only prior
// commercial material, where any existed, was an FAQ answer feeding FAQPage schema
// and therefore not liftable; nothing was moved.
const commercialParagraphs = [
  "South Pasadena's commercial kitchens are small, old, and clustered — Mission Street and the blocks around it, a handful along Fair Oaks, and not much else. These are restaurants and cafes in buildings that predate commercial kitchen design, run by operators who have been in the same room for years and who know exactly what their equipment does. That makes the work refreshingly specific: nobody here calls about a mystery, they call because the machine that has done the same thing for a decade started doing something else. It also makes it tight. Getting a walk-in panel or a range out of a Mission Street back-of-house is a genuine logistics problem, and the answer is usually that it does not come out, so the repair happens in place. Our techs plan for that before the truck leaves."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map — it does ICONS[e.icon] with no
// fallback, so a wrong key renders an empty <path> silently. Valid keys:
// snowflake, pizza-oven, fryer, oven, droplet, laundry.
const commercialEquipment = [
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// NO premium outdoor brand pills anywhere in wave 5: not one of these 28 pages names a
// single outdoor brand (Lynx/DCS/Twin Eagles/Alfresco/Coyote/Bull = 0 occurrences across
// the whole set). The $$$ pages have heavy premium evidence but all of it is indoor estate
// brands. Pills would assert an outdoor install base no page here claims. Pasadena precedent.
const outdoorParagraphs = [
  "South Pasadena backyards come attached to houses that are ninety and a hundred years old, and the outdoor equipment is plumbed into whatever that history left behind. A grill out here is frequently fed by a line that was run for something else entirely and extended twice since, through a yard that has been re-landscaped around it. That shows up as a grill that lights fine on one burner and starves on three, or a unit that works in the evening and not on a hot afternoon — pressure problems that read like burner problems and get diagnosed as burner problems by people who did not look upstream. The deep old canopy over these yards adds its own layer of litter into everything. Our techs put a gauge on the supply before condemning anything on a South Pasadena outdoor call, because on this housing stock the line is a real suspect."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Not cooling · Hard water ice maker · Fan motor · Temperature off', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Bosch' },
  { icon: '🔥', name: 'Oven, Range & Vintage Stove', slug: 'oven', issues: "O'Keefe & Merritt · Wedgewood · Roper · Gas igniter · Oven thermostat", brands: 'Vintage brands · GE · Samsung · Bosch · Wolf · Viking' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'Hard water inlet screens · Not draining · Not spinning · Error codes', brands: 'LG · Samsung · Whirlpool · Maytag · Bosch · Speed Queen' },
  { icon: '♨️', name: 'Dryer Repair + Vent Cleaning', slug: 'dryer', issues: 'Not heating · Older vent runs · Thermal fuse · Lint buildup', brands: 'LG · Samsung · GE · Maytag · Whirlpool · Electrolux' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Hard water spray arm scale · Not draining · Spots · Error codes', brands: 'Bosch · KitchenAid · Samsung · LG · GE · Miele' },
  { icon: '❄️', name: 'Freezer & Ice Maker Repair', slug: 'freezer', issues: 'Hard water valve · Not freezing · Ice stopped · Frost buildup', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Frigidaire' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Igniter issues · Gas burner · Induction not heating · Hood motor', brands: 'GE · Bosch · Samsung · Wolf · Thermador · Broan' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler', issues: 'Temperature off · Compressor · Under-counter · Built-in', brands: 'Sub-Zero · True · U-Line · Liebherr · Dacor' }
