const citySlug = 'rancho-santa-fe';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Rancho Santa Fe';
const zips = ['92067', '92091'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Rancho Santa Fe CA — Same Day`;
const description = "Appliance repair in Rancho Santa Fe 92067 — Covenant estates, guest houses, outdoor kitchens, wine rooms. Estate managers welcome. (858) 667-7237.";
const canonical = 'https://samedayappliance.repair/rancho-santa-fe/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Rancho Santa Fe', sameAs: 'https://en.wikipedia.org/wiki/Rancho_Santa_Fe,_California' },
    { '@type': 'Place', name: 'The Covenant' },
    { '@type': 'Place', name: 'Fairbanks Ranch area' },
    { '@type': 'Place', name: 'The Crosby area' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$$',
  license: 'BHGS #A49573'
});

const introParagraphs = [
  "<strong>A Rancho Santa Fe service call is rarely one appliance. Our San Diego technicians typically walk a property that runs a main kitchen, a butler's pantry, a guest house, a pool cabana, an outdoor kitchen, and a wine room — six or eight compressors spread across several buildings behind one gate. We work the whole inventory in one relationship: gate codes on file, estimates a manager can forward, and small problems batched into the same visit as the urgent one. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "The Covenant set the template a century ago — large parcels, eucalyptus rows, architecture that hides its size — and the surrounding enclaves followed it. What that means for appliances is dispersion: equipment scattered across buildings, some of it running unattended for months, most of it premium, and all of it far enough from the next service company that 'we'll fit you in' often means next week. Our answer is a branch that treats the RSF estate belt as a primary route, not a detour.",
  "This is inland country, and we service it as inland country. No salt-air speech here — Rancho Santa Fe's enemies are dry heat, airborne dust from paddocks and landscaping, and time. Condensers load slowly with fine dust instead of quickly with salt; door gaskets bake instead of corroding; equipment closets turn into ovens by August. The failure calendar runs longer than the coast's, which tempts owners to skip maintenance entirely — and that's exactly how a quiet guest-house refrigerator becomes a spoiled-food discovery.",
  "Most of our RSF calls come from estate managers, house managers, and property offices rather than owners. The workflow is built for that: written estimates that forward cleanly for approval, scheduling around household calendars and event weeks, invoicing to whoever runs the books, and horses given the right-of-way our trucks owe them on the trails and lanes. Discretion isn't a premium option; it's the default setting.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for service across 92067 and 92091 — and the rest of the <a href="/san-diego-county/">North Coastal corridor</a>.`
];

const services = [
