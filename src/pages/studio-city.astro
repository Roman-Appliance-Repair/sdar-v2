---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'studio-city';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Studio City';
const zips = ['91604'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Studio City CA — Same Day Service`;
const description = `Same-day appliance repair in Studio City, CA 91604. Sub-Zero, Wolf, Thermador, Samsung, LG, GE. Licensed, OEM parts.`;
const canonical = 'https://samedayappliance.repair/studio-city/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Studio City', sameAs: 'https://en.wikipedia.org/wiki/Studio_City,_Los_Angeles' },
    { '@type': 'Place', name: 'Fryman Canyon' },
    { '@type': 'Place', name: 'Tujunga Village' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',

});

const introParagraphs = [
  "<strong>When an appliance fails in Studio City, our techs at Same Day Appliance Repair trace it to a handful of patterns: LADWP hard-water scale (230–310 mg/L) blocking Sub-Zero ice maker inlet valves, cracked Wolf dual-fuel burner igniter electrodes, LG front-loader OE drain errors from scale-clogged pump filters, and recurring Bosch dishwasher E24 drain faults. We dispatch same-day across Fryman Canyon, the Ventura Blvd corridor, Coldwater Canyon, and Tujunga Village. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "Studio City sits between the Santa Monica Mountains and the San Fernando Valley floor — part hillside, part flat, all character. The Fryman Canyon homes above Mulholland are serious properties with serious kitchens: Sub-Zero, Wolf, Thermador. The bungalows and mid-century homes along Coldwater and the streets south of Ventura have GE, Samsung, and LG that need the same reliable same-day service as any other home.",
  "Studio City has an unusually high concentration of entertainment industry professionals — writers, directors, producers, editors who work irregular hours and are rarely available in a standard weekday morning window. We don't require you to clear your schedule for us. We work around yours: first slots at 8am, late-afternoon slots, Saturdays. Tell us when you're available and we'll be there.",
  "LADWP hard water is a consistent factor throughout 91604 — 230–310 mg/L hardness, and many older Studio City homes still have original galvanized supply lines that compound the mineral content. Ice maker inlet valves and dishwasher spray arms scale faster here than national average. We check for this on every relevant call.",
  "Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong>. Saturdays available.",
  "<strong>LADWP hard water tip for Studio City:</strong> If your refrigerator ice maker has been declining gradually — not a sudden stop but a slow reduction in output over weeks or months — LADWP mineral scale on the water inlet valve is the most likely cause in 91604. Older homes with galvanized supply lines compound the effect. A 6-month filter change cycle (not 12) meaningfully slows the accumulation rate on Studio City's water supply."
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'LADWP hard water ice maker · Sub-Zero built-in · Not cooling · Fan', brands: 'Sub-Zero · Samsung · LG · GE · Thermador · Bosch' },
  { icon: '🔥', name: 'Oven, Range & Pro Range', slug: 'oven', issues: 'Wolf dual-fuel · Thermador igniter · Gas igniter · Temperature off', brands: 'Wolf · Thermador · Viking · GE · Samsung · KitchenAid' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'OE / UE error · Not draining · Not spinning · Stackable', brands: 'LG · Samsung · Whirlpool · Maytag · Bosch · Speed Queen' },
  { icon: '♨️', name: 'Dryer Repair + Vent Cleaning', slug: 'dryer', issues: 'Not heating · Thermal fuse · Hillside vent runs · Gas & electric', brands: 'LG · Samsung · GE · Maytag · Whirlpool · Miele' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'LADWP scale · E24 · Miele · Panel-ready · Not draining', brands: 'Miele · Bosch · KitchenAid · Samsung · LG · GE' },
  { icon: '❄️', name: 'Freezer & Ice Maker Repair', slug: 'freezer', issues: 'LADWP inlet valve scale · Not freezing · Ice stopped · Sub-Zero', brands: 'Sub-Zero · Samsung · LG · GE · True · Whirlpool' },
  { icon: '🍷', name: 'Wine Cellar & Cooler Repair', slug: 'wine-cooler', issues: 'Temperature off · Sub-Zero wine · WhisperKOOL · EuroCave', brands: 'Sub-Zero · EuroCave · True · WhisperKOOL · Liebherr' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Wolf star burner · Thermador igniter · Induction · Hood motor', brands: 'Wolf · Thermador · Gaggenau · GE · Bosch · Dacor' }
];

const neighborhoods = [
  { name: 'Fryman Canyon estates', zip: '91604', featured: true },
  { name: 'Ventura Blvd corridor', zip: '91604', featured: true },
  { name: 'Coldwater Canyon area', zip: '91604', featured: true },
  { name: 'Tujunga Village', zip: '91604' },
  { name: 'Laurel Canyon border', zip: '91604' },
  { name: 'CBS Studio Center area', zip: '91604' },
  { name: 'Wrightwood Estates', zip: '91604' }
];

const keyStreets = ['Ventura Blvd', 'Coldwater Canyon Ave', 'Laurel Canyon Blvd', 'Mulholland Dr (south side)', 'Moorpark St', 'Fryman Rd'];


const whyReasons = [
  {
    iconKey: 'clock' as const,
    title: 'Schedule Flexibility',
    body: "Studio City has an above-average share of people who work non-standard hours. We don't require you to be home between 10am and 2pm on a Tuesday. Appointments run Mon–Sat 8am–6pm: first slots, late-afternoon slots, Saturdays — tell us when you're available and we work around that."
  },
  {
    iconKey: 'parts' as const,
    title: 'LADWP Hard Water Aware',
    body: 'Studio City is LADWP territory at 230–310 mg/L. Older homes with galvanized supply lines add iron on top. Ice makers and dishwashers scale faster here than national average. We test for mineral deposits proactively on every relevant 91604 call.'
  },
  {
    iconKey: 'team' as const,
    title: 'Hillside to Valley Floor',
    body: 'Fryman Canyon estates with Sub-Zero and Wolf, Ventura Blvd condos with LG and Samsung, mid-century bungalows with Whirlpool — we cover all of it. Same $89 diagnostic waived with repair, same OEM parts, same 90-day warranty regardless of address.'
  },
  {
    iconKey: 'shield' as const,
    title: '90-Day Warranty, OEM Only',
    body: 'Every repair backed by 90 days on parts and labor. Genuine OEM parts only. Written estimate before we start. California licensed. No upcharges for same-day, no dispatch center routing, no hourly waiting windows.'
  }
];

const pricingTiers = [
  { appliance: 'Sub-Zero / Wolf / Thermador', range: '$300 – $800+', note: 'OEM parts · Fryman Canyon · Hillside estates', featured: true },
  { appliance: 'Refrigerator / Ice Maker', range: '$150 – $400', note: 'LADWP inlet valve · Galvanized pipe factor · Fan motor' },
  { appliance: 'Washer / Dryer', range: '$150 – $350', note: 'OE drain error · Thermal fuse · Vent · Hillside runs' },
  { appliance: 'Dishwasher', range: '$150 – $320', note: 'LADWP scale · E24 · Miele · Panel-ready · Pump' },
  { appliance: 'Oven / Range', range: '$150 – $450', note: 'Wolf igniter · Gas valve · Temperature calibration' },
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Waived when you proceed with the repair' }
];

const faqs = [
  {
    question: 'Do you offer same-day appliance repair in Studio City, CA?',
    answer: 'Yes. Our technicians cover all of Studio City 91604 — Ventura Boulevard corridor, Fryman Canyon hillside homes, Tujunga Village area, Coldwater Canyon, Laurel Canyon border, and every residential street. Same-day visits when a technician is available — call early for the best chance.'
  },
  {
    question: 'Do you repair Sub-Zero, Wolf, and Thermador appliances in Studio City?',
    answer: "Yes. Sub-Zero, Wolf, Thermador, Miele, and Viking are common throughout Studio City's hillside homes and the premium properties in the Fryman Canyon area. Our technicians carry OEM parts for all luxury brands on every service vehicle."
  },
  {
    question: 'Does LADWP hard water affect appliances in Studio City?',
    answer: 'Yes. Studio City is LADWP territory at 230–310 mg/L hardness. Ice maker inlet valves and dishwasher spray arms accumulate mineral deposits faster than in soft-water areas. We check for this proactively on every relevant Studio City call involving refrigerators and dishwashers.'
  },
  {
    question: 'Are you available on weekends in Studio City?',
    answer: 'Yes. Technicians work Mon–Sat 8am–6pm, Saturdays included. Sunday by arrangement; phone answered 24/7.'
  },
  {
    question: 'What is your diagnostic fee in Studio City?',
    answer: 'Our diagnostic fee is $89, waived when you proceed with the repair. Written estimate before we start. Most Studio City repairs run $150–$450 depending on brand and appliance.'
  },
  {
    question: 'Can you work around production and work schedules in Studio City?',
    answer: "Yes. We know Studio City has an above-average share of entertainment industry professionals with irregular schedules. We work around your availability — first slots at 8am, late-afternoon slots, Saturdays. We don't require you to be home in a 4-hour window; we schedule to fit your day."
  },
  {
    question: 'Do you also serve Sherman Oaks, North Hollywood, and Burbank?',
    answer: 'Yes. Our Studio City service extends to Sherman Oaks, North Hollywood, Burbank, Toluca Lake, Valley Village, and all of the San Fernando Valley.'
  },
  {
    question: "What's the most common appliance repair our techs see in Studio City?",
    answer: 'The most common Studio City calls our techs at Same Day Appliance Repair handle are LADWP hard-water failures — Sub-Zero ice maker inlet valves scaled shut in Fryman Canyon estates, often compounded by original galvanized supply lines — alongside cracked Wolf dual-fuel burner igniter electrodes, LG front-loader OE drain errors, and recurring Bosch dishwasher E24 drain faults. We check for mineral scale on every relevant call. $89 residential diagnostic, waived with repair.'
  },
  {
    question: 'Are your Studio City appliance repairs licensed and insured?',
    answer: 'Yes. Our techs at Same Day Appliance Repair are BHGS #A49573 registered, EPA 608 Universal certified (#1346255700410), with a 90-day warranty on parts and labor for every Studio City repair in 91604. We carry OEM parts for Sub-Zero, Wolf, and Thermador on the truck, offer early and Saturday slots, and give you a written estimate before we start. $89 residential diagnostic, waived with repair.'
  }
];

// Commercial brand pills + equipment cards — the verified sets the WeHo template uses.
const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Beverage-Air', href: '/commercial/refrigeration/brands/beverage-air/' },
      { name: 'Perlick', href: '/commercial/refrigeration/brands/perlick/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Pizza ovens', href: '/commercial/pizza-oven-repair/', icon: 'pizza-oven' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

const commercialNarrative = {
  eyebrow: 'COMMERCIAL KITCHENS',
  headline: 'Studio City Restaurant & Kitchen Repair',
  paragraphs: [
    `Studio City anchors the east end of Ventura Blvd, and its sushi counters are the calls our techs take most seriously here. On a sushi line the refrigeration is not a convenience — it is the product. A case drifting two degrees is a food-safety decision before it is a repair decision, and the owner already knows it when they phone. Add the studio crowd off Radford and Coldwater eating at hours the rest of the Valley doesn't, and the equipment never gets a clean window to be down in. <a href="/commercial/refrigeration/">commercial refrigeration</a> is the first thing our techs ask about on this stretch, and <a href="/commercial/ice-machines/">commercial ice machine</a> for the bar runs a close second. <a href="/commercial/dishwasher-repair/">commercial dishwasher</a> and walk-in coolers as well.`
  ]
};

// Outdoor service chips — verified present in dist.
const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' }
];

const outdoorParagraphs = [
  `Up in Fryman Canyon and the Wrightwood streets the yard is usually a deck cantilevered off a slope, and everything on it arrived up a flight of stairs. Our techs pack lighter for those addresses — nothing rolls to a canyon house. Down on the flats toward Moorpark the lots are ordinary and so is the equipment: a grill, sometimes a fridge beside it. The calls split the same way the geography does. Igniters and burners on the flats; on the canyon decks, add whatever the damp coming off the hillside has done to the ignition over a winter.`
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="Studio City, CA"
    subheadline="Where the Valley meets the hills — Ventura Boulevard boutiques, Fryman Canyon estates, and an above-average share of people whose schedule doesn't follow a 9-to-5. Same-day service that works around yours. Sub-Zero, Wolf, Samsung, LG — all brands. OEM parts, 90-day warranty."
    zips={zips}
    tier={2}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in Studio City — What This Neighbourhood Actually Needs"
    paragraphs={introParagraphs}
    bookingTitle="Studio City Service"
    bookingSub="91604 · Schedule flexibility · Same day"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in Studio City"
    subhead="Luxury & all brands · LADWP hard water aware · All of 91604"
    services={services}
  />

  <ServiceArea
    cityName={cityName}
    headline="All of Studio City — 91604"
    subheadline="Ventura Blvd to the hillsides — every part of the neighbourhood"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={keyStreets}
    bgImage="/images/cities/studio-city/neighborhood.webp"
  />

  <CommercialSection
    cityName={cityName}
    eyebrow={commercialNarrative.eyebrow}
    headline={commercialNarrative.headline}
    paragraphs={commercialNarrative.paragraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Studio City Hillside Decks and Canyon Patios"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />
  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Jobs in Studio City" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Studio City Calls Us Back"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in Studio City"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair. OEM parts only."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions Studio City Customers Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance broken in Studio City?"
    body="Fryman Canyon · Ventura Blvd · Coldwater Canyon · LADWP hard water aware · Saturday slots available. $89 diagnostic waived with repair. 90-day warranty."
  />
</CityLayoutV2>
