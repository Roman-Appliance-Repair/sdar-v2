---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CustomNarrative from '../components/cities/v2/CustomNarrative.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import { CITIES } from '../data/cities';
import { BRANCHES, MAIN_PHONE, isPlaceholderPhone } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'north-hollywood';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'North Hollywood';
const zips = ['91601', '91602', '91605', '91606'];

const phone = branch.phone;
const phoneRaw = `+1${phone.replace(/\D/g, '')}`;

const title = `Appliance Repair North Hollywood CA — Same Day Service`;
const description = `Same-day appliance repair in North Hollywood, CA. 91601–91606. Production-schedule friendly. Licensed, OEM parts.`;
const canonical = 'https://samedayappliance.repair/north-hollywood/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'North Hollywood', sameAs: 'https://en.wikipedia.org/wiki/North_Hollywood,_Los_Angeles' },
    { '@type': 'Place', name: 'NoHo Arts District' },
    { '@type': 'Place', name: 'Valley Village' },
    { '@type': 'Place', name: 'Toluca Woods' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',

});

const introParagraphs = [
  "<strong>When an appliance fails in North Hollywood, our techs at Same Day Appliance Repair trace it to a handful of patterns: LG dryers taking three cycles from lint-clogged vent runs in the older housing stock, Samsung dual-evaporator fridge fan failures (fridge warm, freezer fine), Bosch dishwasher E15 flood faults from a loose inlet hose, and GE oven igniters glowing but not lighting. We dispatch same-day across the NoHo Arts District, Valley Village, Toluca Woods, and Magnolia Park. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "North Hollywood has changed a lot in the last decade. The NoHo Arts District brought new apartment buildings along Lankershim, new mixed-use development near the Metro B Line station, and a population that works in production, music, post-production, and the entertainment industry at large — schedules that don't fit neatly into a standard service window.",
  "We get that. If your dryer stopped heating before a long shoot, or your fridge quit while you're on a six-day production call schedule, we work around your availability. Saturdays, 8am first slots — call us and tell us your constraints. We'll find a time. That flexibility is part of why NoHo residents call us back.",
  "The rest of North Hollywood — the valley ranch houses in Valley Village, the craftsman bungalows in Toluca Woods, the garden apartments in Magnolia Park — we're there too, same day, same approach. Written estimate before we start. <strong>$89 diagnostic</strong> waived with repair. <strong>90-day warranty</strong>."
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Not cooling · Ice maker · Fan motor · Temperature off · Leaking', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Bosch' },
  { icon: '♨️', name: 'Dryer Repair + Vent Cleaning', slug: 'dryer', issues: 'Not heating · Vent clogged · Takes forever · Fire hazard check', brands: 'LG · Samsung · GE · Maytag · Whirlpool · Electrolux' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer', issues: 'Not draining · Not spinning · Leaking · Error codes · Stackable', brands: 'LG · Samsung · Whirlpool · Maytag · Bosch · Speed Queen' },
  { icon: '🔥', name: 'Oven, Range & Stove Repair', slug: 'oven', issues: 'Not heating · Gas igniter · Temperature control · Broiler', brands: 'GE · Samsung · Bosch · Wolf · Viking · Thermador' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: "Not draining · Leaking · Error codes · Won't start · Spots", brands: 'Bosch · KitchenAid · Samsung · LG · Miele · GE' },
  { icon: '❄️', name: 'Freezer & Ice Maker Repair', slug: 'freezer', issues: 'Not freezing · Ice maker stopped · Frost buildup · Temperature', brands: 'Samsung · LG · GE · Whirlpool · Sub-Zero · Frigidaire' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Igniter issues · Burner clicking · Induction · Hood motor', brands: 'GE · Samsung · Bosch · Wolf · Thermador · Broan' },
  { icon: '🏪', name: 'Commercial Appliance Repair', slug: 'commercial', issues: 'Commercial washers · Walk-in cooler · Ice machine · Restaurant', brands: 'Speed Queen · True · Hoshizaki · Manitowoc · Hobart' }
];

const dryerVentTipNarrative = {
  headline: 'Dryer Vent Tip for North Hollywood',
  paragraphs: [
    "<strong>Dryer vent tip for North Hollywood:</strong> In the older housing stock here — the 1950s ranch houses and converted bungalows — dryer vent ducts are often long, kinked, or run through walls in ways that trap lint faster than modern installations. A blocked vent is the top cause of residential dryer fires and the top reason dryers take two cycles to dry one load. We check vent airflow on every North Hollywood dryer call — it costs nothing extra and it matters."
  ]
};

const neighborhoods = [
  { name: 'NoHo Arts District', zip: '91601', featured: true },
  { name: 'Valley Village', zip: '91607', featured: true },
  { name: 'Toluca Woods', zip: '91602', featured: true },
  { name: 'Magnolia Park', zip: '91601' },
  { name: 'Tujunga Village', zip: '91602' },
  { name: 'NoHo West', zip: '91605' },
  { name: 'East North Hollywood', zip: '91606' },
  { name: 'Laurel Grove', zip: '91605' }
];

const keyStreets = ['Lankershim Blvd', 'Vineland Ave', 'Chandler Blvd', 'Victory Blvd', 'Magnolia Blvd', 'Cahuenga Blvd', 'Laurel Canyon Blvd', 'Oxnard St'];


const whyReasons = [
  {
    iconKey: 'team' as const,
    title: 'Production Schedule Friendly',
    body: 'A lot of NoHo residents work in entertainment — production, music, post. Schedules that don\'t fit a 9-to-5 window. We have Saturday availability (Mon–Sat 8am–6pm, Sunday by arrangement) and can work around shoot schedules and irregular call times. Tell us your constraints.'
  },
  {
    iconKey: 'parts' as const,
    title: 'Dryer Vent Check Every Time',
    body: "North Hollywood's older housing stock has some of the longest, most convoluted dryer vent runs we see. A blocked vent is a fire hazard and the leading cause of dryers that \"take forever.\" We check vent airflow on every dryer call — standard, not extra."
  },
  {
    iconKey: 'shield' as const,
    title: 'Houses & Apartments Both',
    body: 'Valley ranch houses, craftsman bungalows, garden apartments, new Lankershim high-rises — we work in all of them. Tenants, landlords, property managers — we coordinate with whoever needs to be involved.'
  },
  {
    iconKey: 'clock' as const,
    title: '90-Day Warranty, OEM Only',
    body: 'Every repair backed by 90 days on parts and labor. Genuine OEM parts only. $89 diagnostic waived with repair. California licensed. If the same issue returns within 90 days, we come back at no charge.'
  }
];

const pricingTiers = [
  { appliance: 'Refrigerator', range: '$150 – $400', note: 'Fan motor, thermostat, ice maker, drain, compressor relay' },
  { appliance: 'Dryer + Vent Cleaning', range: '$150 – $320', note: 'Heating element, thermal fuse, vent inspection & clearance', featured: true },
  { appliance: 'Washer', range: '$150 – $350', note: 'Drain pump, door latch, shock absorbers, control board' },
  { appliance: 'Oven / Range', range: '$150 – $400', note: 'Igniter, bake element, gas valve, temperature calibration' },
  { appliance: 'Dishwasher', range: '$150 – $320', note: 'Drain pump, door latch, inlet valve, error code reset' },
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Waived when you proceed with the repair' }
];

const faqs = [
  {
    question: 'Do you offer same-day appliance repair in North Hollywood, CA?',
    answer: 'Yes. Our technicians cover all of North Hollywood — the NoHo Arts District, Valley Village, Toluca Woods, Magnolia Park, Tujunga Village, NoHo West, and East North Hollywood. We serve ZIP codes 91601, 91602, 91605, and 91606. Same-day visits when a technician is available — call early for the best chance.'
  },
  {
    question: 'Can you work around production or entertainment industry schedules?',
    answer: "Yes. A lot of North Hollywood residents work in production, music, or the entertainment industry — which means schedules that don't fit a Mon–Fri 9-to-5 window. We dispatch Mon–Sat 8am–6pm with full Saturday availability, and our phones are answered 24/7 — Sunday visits are by arrangement. Call us and tell us your constraints — we'll find a time that works."
  },
  {
    question: 'What is your diagnostic fee in North Hollywood?',
    answer: 'Our diagnostic fee is $89, waived when you proceed with the repair. We give you a complete written estimate before starting any work. Most North Hollywood repairs run $150–$400 depending on the appliance.'
  },
  {
    question: 'Do you repair dryer vents in North Hollywood?',
    answer: "Yes. Dryer vent cleaning is one of the most important appliance maintenance tasks in North Hollywood's older housing stock. A clogged vent is the leading cause of residential dryer fires — and takes two cycles where one should do. We clean and inspect dryer vents on every dryer call, and can do standalone vent cleaning on request."
  },
  {
    question: 'Do you repair appliances in apartments and multi-family buildings in North Hollywood?',
    answer: "Yes. North Hollywood has a large rental population — garden apartments off Lankershim, new construction near the Metro B Line station, converted bungalow courts in the Arts District. We work with tenants, landlords, and property managers. If you're a renter, we can coordinate with your landlord directly if needed."
  },
  {
    question: 'What warranty do you offer on appliance repairs in North Hollywood?',
    answer: 'All repairs come with a 90-day warranty on parts and labor. We use genuine OEM parts only. If the same issue returns within 90 days, we come back at no charge.'
  },
  {
    question: 'Do you also serve Burbank, Studio City, and Van Nuys?',
    answer: 'Yes. Our North Hollywood service area extends to Burbank, Studio City, Toluca Lake, Sherman Oaks, Van Nuys, Glendale, and Sun Valley. All are in our regular San Fernando Valley coverage area.'
  },
  {
    question: "What's the most common appliance repair our techs see in North Hollywood?",
    answer: 'The most common North Hollywood calls our techs at Same Day Appliance Repair handle are LG dryers taking three cycles from lint-clogged vent runs in the older 1950s ranch houses and converted bungalows, alongside Samsung dual-evaporator fridge fan failures (fridge warm, freezer fine), Bosch dishwasher E15 flood faults from a loose inlet hose, and GE oven igniters that glow but won\'t light. We check vent airflow on every dryer call at no extra charge. $89 residential diagnostic, waived with repair.'
  },
  {
    question: 'Are your North Hollywood appliance repairs licensed and insured?',
    answer: 'Yes. Our techs at Same Day Appliance Repair are BHGS #A49573 registered, EPA 608 Universal certified (#1346255700410), with a 90-day warranty on parts and labor for every North Hollywood repair across 91601, 91602, 91605, and 91606. We work houses and apartments alike, coordinate with tenants and landlords, and give you a written estimate before we start. $89 residential diagnostic, waived with repair.'
  }
];

// Commercial brand pills + equipment cards — the verified sets the WeHo template uses.
const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Beverage-Air', href: '/commercial/refrigeration/brands/beverage-air/' },
      { name: 'Perlick', href: '/commercial/refrigeration/brands/perlick/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Pizza ovens', href: '/commercial/pizza-oven-repair/', icon: 'pizza-oven' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

const commercialNarrative = {
  eyebrow: 'COMMERCIAL KITCHENS',
  headline: 'North Hollywood Restaurant & Theatre-Row Kitchen Service',
  paragraphs: [
    `NoHo runs on curtain times, and so do its kitchens. There are around twenty theatres packed into roughly a square mile here — more than anywhere outside New York — and the rooms along Lankershim and Magnolia feed the same audience twice: a hard rush before the house opens, then again when it lets out. That is not a normal restaurant rhythm, and equipment specified for a normal one struggles with it. Two compressed spikes a night wear a machine differently than a steady evening does. <a href="/commercial/ice-machines/">commercial ice machine</a> takes the worst of it — a bar that empties twice in four hours asks for more than one that empties once. Our <a href="/commercial/refrigeration/">commercial refrigeration</a> and <a href="/commercial/dishwasher-repair/">commercial dishwasher</a> work follows the same curtain schedule.`
  ]
};

// Outdoor service chips — verified present in dist.
const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' }
];

const outdoorParagraphs = [
  `The bungalows around Valley Village and Toluca Woods have small back yards with a grill on a slab, and that's the honest extent of it here. The apartment courts off Lankershim and Vineland are a different animal: one grill shared between the whole building, used constantly and looked after by nobody in particular, which is exactly the equipment that comes to us worst-maintained. Neither case is exotic. Igniters that stopped sparking, burners lighting unevenly, the occasional patio heater dragged out of a garage in January. Inland heat means wear, not corrosion — the fix is usually a part and an hour.`
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="North Hollywood, CA"
    subheadline="NoHo Arts District, Valley Village, Toluca Woods, Magnolia Park, Tujunga Village. We cover all of North Hollywood — call us and we'll be there the same day. No 9-to-5 requirement. OEM parts, 90-day warranty."
    zips={zips}
    tier={2}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Same Day Appliance Repair in North Hollywood"
    paragraphs={introParagraphs}
    bookingTitle="North Hollywood Service"
    bookingSub="91601 · 91602 · 91605 · 91606"
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in North Hollywood"
    services={services}
  />

  <CustomNarrative
    headline={dryerVentTipNarrative.headline}
    paragraphs={dryerVentTipNarrative.paragraphs}
    background="white"
  />

  <ServiceArea
    cityName={cityName}
    headline="All of North Hollywood — 91601, 91602, 91605, 91606"
    subheadline="Every neighborhood, every ZIP — from the Arts District to the Valley side"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={keyStreets}
    bgImage="/images/cities/north-hollywood/neighborhood.webp"
  />

  <CommercialSection
    cityName={cityName}
    eyebrow={commercialNarrative.eyebrow}
    headline={commercialNarrative.headline}
    paragraphs={commercialNarrative.paragraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="North Hollywood Yards and Shared Courtyards"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />
  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Jobs in North Hollywood" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why North Hollywood Calls Us Back"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in North Hollywood"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions North Hollywood Customers Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance broken in North Hollywood?"
    body="NoHo Arts District · Valley Village · Toluca Woods · All of 91601–91606. Saturdays available. $89 diagnostic waived with repair. 90-day warranty."
  />
</CityLayoutV2>
