  { icon: '🍷', name: 'Wine & Beverage Cooling', slug: 'wine-cooler', issues: 'Undercounter units · Beverage centers · Temperature drift', brands: 'U-Line · Sub-Zero · Perlick · EuroCave' },
  { icon: '🫧', name: 'Laundry Repair', slug: 'washer', issues: 'Main + guest house sets · Large-capacity machines', brands: 'LG · Miele · Whirlpool · Speed Queen' },
