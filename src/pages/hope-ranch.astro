---
/**
 * Hope Ranch, CA — city pillar (feat/santa-barbara Stage C).
 * Branch: Santa Barbara — service_area (no public street address).
 *
 * Angle (distinct from /montecito/ — the cannibalization risk): Hope Ranch is
 * the gated/private-road estate enclave with MULTI-BUILDING properties. The
 * page owns: pool houses, guest houses, secondary kitchens, multiple
 * refrigeration units per property, equestrian-property logistics, private
 * roads / gate codes / patrol scheduling. Montecito keeps the "aging Sub-Zero
 * 500/600-series without service history" angle — deliberately NOT used here.
 *
 * Zero-invention: repair cases reuse site-established patterns/brands only
 * (Lynx igniters, U-Line undercounter condenser, Thermador older-model F-codes
 * per our L-2 enrich, Miele F12/F13 inlet per our L-2 fix). No ReviewsBlock.
 * Residential → $89 only.
 */

import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
