import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
import { mergeCredentials } from '../data/credentials-schema';

const citySlug = 'hope-ranch';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Hope Ranch';
const zips = ['93110'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Hope Ranch CA — Same Day Service`;
const description = "Appliance repair in Hope Ranch 93110 — main kitchens, pool houses, guest houses, outdoor kitchens. Private-road logistics handled. $89 dx. (805) 500-0855.";
const canonical = 'https://samedayappliance.repair/hope-ranch/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Hope Ranch', sameAs: 'https://en.wikipedia.org/wiki/Hope_Ranch,_California' },
    { '@type': 'Place', name: 'Las Palmas Drive' },
    { '@type': 'Place', name: 'Laguna Blanca area' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$$',
});

const introParagraphs = [
  "<strong>When an appliance fails in Hope Ranch, our techs at Same Day Appliance Repair rarely find just one kitchen. A typical property here runs a main kitchen, a butler's pantry, a pool house with its own refrigeration, a guest house with a second full appliance set, and an outdoor kitchen on the terrace — five or six refrigeration units on one parcel is normal, not exceptional. We service the whole inventory in one relationship, and we know the drill on private roads, gate codes, and patrol check-ins. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Hope Ranch is its own kind of estate community — not a city, not quite a neighborhood, but a private enclave of large parcels behind its own roads, with the lake, the bridle trails, and an equestrian culture that shapes how properties are built. Homes here spread out instead of up: separate structures, long driveways, outbuildings with plumbing and power. Every one of those structures accumulates appliances, and every appliance eventually needs someone who'll actually drive past the gate to look at it.",
  "The multi-building layout changes the service math. When we come out for the pool house ice maker, it costs almost nothing to also look at the guest house refrigerator that's been making a noise since spring — same visit, same trip, one invoice. We encourage Hope Ranch clients to keep a running list; batching two or three small items into one call is the efficient way to run a property this size, and it's how the properties that look after themselves actually do it.",
  "Logistics get handled like locals: gate codes and access notes stay in the property's job record, we call ahead the way the household prefers, we're comfortable coordinating through house staff or a property manager, and we treat the private roads at the speed they're posted — slower where the horses are. None of this is exotic; it's just Hope Ranch, and we work it regularly enough that it's routine.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for service across 93110 — and the rest of the <a href="/santa-barbara-county/">South Coast corridor</a>.`
];

const services = [
  { icon: '🧊', name: 'Refrigeration — Every Building', slug: 'refrigerator', issues: 'Main kitchen · Pool house · Guest house · Beverage centers', brands: 'Sub-Zero · Thermador · U-Line · True · GE Monogram · KitchenAid' },
