---
// src/pages/index.astro — Homepage v2.1
// 5-niche architecture restructure (2026-05-02). Layout provides global Navbar + Footer.
// HomepageSchema preserved 1:1 (Organization + WebSite + WebPage + 8 LocalBusiness + FAQPage).

import Layout from '../layouts/Layout.astro';
import HomepageSchema from '../components/homepage/HomepageSchema.astro';
import { BRANCHES, MAIN_PHONE, isPlaceholderPhone } from '../data/branches';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;

const title = 'Same Day Appliance Repair — $89 Visit, 24/7';
const description = 'Same-day appliance repair across LA and 4 SoCal counties — fridge, washer, dryer, oven, dishwasher. $89 diagnostic waived with repair. Phones answered 24/7.';

// Hero branch chips — all 8 branches, phones read from the branches.ts SSOT.
// (Was a hardcoded 5-branch list with duplicated phone literals.)
// Short labels keep the chip grid to 4 across without wrapping the number.
const HERO_BRANCH_LABELS: Record<string, string> = {
  'west-hollywood': 'WeHo',
  'beverly-hills': 'BH',
  'los-angeles': 'LA',
  'pasadena': 'Pasadena',
  'thousand-oaks': 'T.Oaks',
  'irvine': 'Irvine',
  'rancho-cucamonga': 'Rancho',
  'riverside': 'Riverside'
};

const HERO_BRANCHES = BRANCHES.map((b) => {
  // Same pending-DID guard BrandBranchesGrid uses: a branch without a real DID
  // falls back to MAIN_PHONE so a chip never dials a dead placeholder number.
  const isPending = b.phoneStatus === 'pending' || isPlaceholderPhone(b.phone);
  const phone = isPending ? MAIN_PHONE : b.phone;
  return {
    label: HERO_BRANCH_LABELS[b.slug] ?? b.name,
    phone,
    href: 'tel:+1' + phone.replace(/\D/g, '')
  };
});

// 5 niches
const NICHES = [
  { title: 'Home Appliances',     desc: 'Fridge, washer, oven, dryer · all residential brands',          href: '/services/',                       dot: '#185FA5' },
  { title: 'Restaurant Kitchen',  desc: 'Ovens, fryers, dishwashers, mixers · $120 diagnostic',          href: '/commercial/',                     dot: '#0F6E56' },
  { title: 'Cold Storage',        desc: 'Restaurant refrigeration, reach-ins, display cases · EPA 608', href: '/commercial/refrigeration/',       dot: '#534AB7' },
  { title: 'Ice Machines',        desc: 'Hoshizaki, Scotsman, Manitowoc · bars & hotels',                href: '/commercial/ice-machines/',        dot: '#993C1D' },
  { title: 'Outdoor Living',      desc: 'Grills, fireplaces, patio heaters · Lynx, DCS, Fire Magic',     href: '/outdoor/',                        dot: '#854F0B' }
];

// Popular services
const POPULAR = [
  { title: 'Refrigerator Repair',     badge: 'Residential', brands: 'LG, Samsung, Sub-Zero, Viking',    href: '/services/refrigerator-repair/' },
  { title: 'Washer & Dryer Repair LA', badge: 'Residential', brands: 'LG, Samsung, Whirlpool, Maytag',   href: '/services/washer-repair/' },
  { title: 'Patio Heater Repair',     badge: 'Outdoor',     brands: 'Bromic, Infratech, Fire Sense',    href: '/outdoor/patio-heater-repair/' },
  { title: 'Commercial Oven Repair',  badge: 'Commercial',  brands: 'Vulcan, Garland, Rational',        href: '/commercial/oven-repair/' },
  { title: 'Ice Machine Repair',      badge: 'Commercial',  brands: 'Hoshizaki, Scotsman, Manitowoc',   href: '/commercial/ice-machines/' },
  { title: 'Gas Fireplace Repair',    badge: 'Outdoor',     brands: 'Heat & Glo, Heatilator, Majestic', href: '/outdoor/fireplace-repair/' }
];

const BADGE_STYLES: Record<string, { bg: string; fg: string }> = {
  'Residential': { bg: '#E6F1FB', fg: '#0C447C' },
  'Commercial':  { bg: '#E1F5EE', fg: '#085041' },
  'Outdoor':     { bg: '#FAEEDA', fg: '#633806' }
};

// Service areas — by county
const COUNTY_CITIES = [
  { county: 'Los Angeles County',    href: '/los-angeles-county/',    cities: ['Los Angeles','West Hollywood','Beverly Hills','Santa Monica','Pasadena','Glendale','Burbank','Malibu'] },
  { county: 'Orange County',         href: '/orange-county/',         cities: ['Newport Beach','Irvine','Anaheim','Huntington Beach'] },
  { county: 'Ventura County',        href: '/ventura-county/',        cities: ['Thousand Oaks','Westlake Village','Camarillo'] },
  { county: 'Riverside County',      href: '/riverside-county/',      cities: ['Temecula','Corona','Riverside'] },
  { county: 'San Bernardino County', href: '/san-bernardino-county/', cities: ['Rancho Cucamonga','Ontario'] }
];

// Branches bar — all 8 from BRANCHES SSOT
function countyTitle(slug: string): string {
  return slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') + ' County';
}
const BRANCH_DISPLAY = BRANCHES.map(b => ({
  name: b.name,
  county: countyTitle(b.primaryCounty).toUpperCase(),
  phone: b.phone,
  isPlaceholder: isPlaceholderPhone(b.phone),
  href: `tel:+1${b.phone.replace(/\D/g, '')}`
}));
---

<Layout title={title} description={description}>
  <HomepageSchema slot="head-scripts" />
  <!-- Preload the hero (LCP element) so the fetch starts from <head>,
       before the parser reaches <picture>. Media queries mirror the
       source-order logic below: ≤768 mobile, 769–1000 mid, >1000 full. -->
  <link slot="head-scripts" rel="preload" as="image" type="image/webp" href="/images/hero/v1/hero-mobile.webp" media="(max-width: 768px)" />
  <link slot="head-scripts" rel="preload" as="image" type="image/webp" href="/images/hero/v1/hero-960.webp" media="(min-width: 769px) and (max-width: 1000px)" />
  <link slot="head-scripts" rel="preload" as="image" type="image/webp" href="/images/hero/v1/hero.webp" media="(min-width: 1001px)" />

  <!-- ===== BLOCK 2: HERO ===== -->
  <section class="hp-hero">
    <div class="hp-hero-bg">
      <picture>
        <source media="(max-width: 768px)" type="image/webp" srcset="/images/hero/v1/hero-mobile.webp" />
        <source media="(max-width: 768px)" type="image/jpeg" srcset="/images/hero/v1/hero-mobile.jpg" />
        <source media="(max-width: 640px)" type="image/webp" srcset="/images/hero/v1/hero-640.webp" />
        <source media="(max-width: 640px)" type="image/jpeg" srcset="/images/hero/v1/hero-640.jpg" />
        <source media="(max-width: 1000px)" type="image/webp" srcset="/images/hero/v1/hero-960.webp" />
        <source media="(max-width: 1000px)" type="image/jpeg" srcset="/images/hero/v1/hero-960.jpg" />
        <source type="image/webp" srcset="/images/hero/v1/hero.webp" />
        <img src="/images/hero/v1/hero.jpg" alt="Same Day Appliance Repair technicians with a service van in Los Angeles" width="1920" height="840" loading="eager" fetchpriority="high" />
      </picture>
      <div class="hp-hero-overlay"></div>
    </div>
    <div class="hp-hero-inner">
      <div class="hp-hero-text">
        <p class="hp-eyebrow">Los Angeles · Orange County · Ventura · Riverside · San Bernardino</p>
        <h1>Same Day Appliance Repair</h1>
        <p class="hp-subline">From Brentwood to Pasadena, Beverly Hills to West Hollywood — same-day dispatch across 8 branches in greater Los Angeles, plus Orange, Ventura, San Bernardino, and Riverside counties. Phones answered 24/7.</p>
        <div class="hp-cta-row">
          <a href={phoneHref} class="hp-btn hp-btn-red">☎ Call Now</a>
          <a href="/book/" class="hp-btn hp-btn-outline">Book Online</a>
        </div>
        <div class="hp-branch-chips">
          <p class="hp-branch-chips__label">Call your local branch</p>
          <div class="hp-branch-chips__grid">
            {HERO_BRANCHES.map((b) => (
              <a href={b.href} class="hp-branch-chip">
                <span class="hp-branch-chip__city">{b.label}</span>
                <span class="hp-branch-chip__phone">{b.phone}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 3: TRUST BAR ===== -->
  <div class="hp-trust">
    <div class="hp-trust-inner">
      <span>Same Day Service</span>
      <span class="hp-trust-sep">·</span>
      <span>OEM Parts</span>
      <span class="hp-trust-sep">·</span>
      <span>90-Day Warranty</span>
      <span class="hp-trust-sep">·</span>
      <span>Licensed &amp; Insured</span>
      <span class="hp-trust-sep">·</span>
      <span>BBB Accredited</span>
      <span class="hp-trust-sep">·</span>
      <span>EPA 608 Certified</span>
      <span class="hp-trust-sep">·</span>
      <span>BHGS #A49573</span>
    </div>
  </div>

  <!-- ===== BLOCK 3B: INTRO NARRATIVE ===== -->
  <section class="hp-intro">
    <div class="hp-intro-inner">
      <h2 class="hp-section-title">Appliance Repair Los Angeles — Residential, Commercial, Outdoor</h2>
      <div class="hp-intro-body">
        <p>From Beverly Hills to Pasadena to Brentwood, our technicians cover the Los Angeles market end-to-end. Same Day Appliance Repair runs 8 branches across LA, Orange, Ventura, San Bernardino, and Riverside counties — but the bulk of our work happens in greater Los Angeles. We service <a href="/brands/sub-zero/" class="brand-inline-link">Sub-Zero</a>, <a href="/brands/wolf/" class="brand-inline-link">Wolf</a>, <a href="/brands/thermador/" class="brand-inline-link">Thermador</a>, <a href="/brands/viking/" class="brand-inline-link">Viking</a>, <a href="/brands/miele/" class="brand-inline-link">Miele</a> on Westside estates; <a href="/brands/lg/" class="brand-inline-link">LG</a>, <a href="/brands/samsung/" class="brand-inline-link">Samsung</a>, <a href="/brands/whirlpool/" class="brand-inline-link">Whirlpool</a>, <a href="/brands/bosch/" class="brand-inline-link">Bosch</a>, <a href="/brands/ge/" class="brand-inline-link">GE</a> in standard residential; <a href="/brands/true/" class="brand-inline-link">True</a>, <a href="/brands/hoshizaki/" class="brand-inline-link">Hoshizaki</a>, <a href="/brands/vulcan/" class="brand-inline-link">Vulcan</a>, Garland in restaurant kitchens.</p>
        <p>The $89 residential diagnostic applies to the repair the moment you approve the work. Commercial calls are $120 — waived the same way. Phones answer 24/7; technicians dispatch Mon–Sat 8am–8pm. Licensed by BHGS (#A49573), EPA 608 Universal Certified, CSLB C-20 HVAC, and BBB Accredited.</p>
        <p>Most calls in Los Angeles County route from West Hollywood, Pasadena, or our central LA branch — whichever is closest to your zip. The Westside cluster (WeHo, Beverly Hills, Brentwood, Santa Monica) sees the most calls per week. Pasadena handles Glendale, Burbank, the San Gabriel foothills. Orange County dispatches from Irvine; Ventura County from Thousand Oaks. Each branch carries OEM parts for brands common to its territory.</p>
        <p style="margin-top: 18px;"><strong>Commercial brand pillar guides</strong> for restaurant, hotel, hospital, school, and stadium kitchens:
          <a href="/brands/scotsman/" class="brand-inline-link">Scotsman</a>,
          <a href="/brands/hoshizaki/" class="brand-inline-link">Hoshizaki</a>, and
          <a href="/brands/manitowoc/" class="brand-inline-link">Manitowoc</a> ice machines;
          <a href="/brands/hobart/" class="brand-inline-link">Hobart</a>,
          <a href="/brands/jackson/" class="brand-inline-link">Jackson</a>, and
          <a href="/brands/champion/" class="brand-inline-link">Champion</a> warewashing;
          <a href="/brands/rational/" class="brand-inline-link">Rational</a>,
          <a href="/brands/lang/" class="brand-inline-link">Lang</a>,
          <a href="/brands/garland/" class="brand-inline-link">Garland</a>,
          <a href="/brands/imperial/" class="brand-inline-link">Imperial</a>, and
          <a href="/brands/vulcan/" class="brand-inline-link">Vulcan</a> commercial cooking;
          <a href="/brands/frymaster/" class="brand-inline-link">Frymaster</a> and
          <a href="/brands/pitco/" class="brand-inline-link">Pitco</a> fryers;
          <a href="/brands/beverage-air/" class="brand-inline-link">Beverage-Air</a>,
          <a href="/brands/true/" class="brand-inline-link">True Manufacturing</a>, and
          <a href="/brands/traulsen/" class="brand-inline-link">Traulsen</a> refrigeration.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 4: BRANCHES BAR ===== -->
  <section class="hp-branches">
    <div class="hp-branches-inner">
      <p class="hp-branches-label">8 Branches Across Southern California</p>
      <div class="hp-branches-grid">
        {BRANCH_DISPLAY.map(b => (
          <div class="hp-branch-card">
            <div class="hp-branch-name">{b.name}</div>
            <div class="hp-branch-county">{b.county}</div>
            {b.isPlaceholder ? (
              <div class="hp-branch-coming">Coming soon</div>
            ) : (
              <a href={b.href} class="hp-branch-phone">{b.phone}</a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 5: 5 NICHES ===== -->
  <section class="hp-niches">
    <div class="hp-niches-inner">
      <p class="hp-section-label">What can we help with?</p>
      <h2 class="hp-section-title">5 Service Directions · One Call</h2>
      <p class="hp-section-sub">Pick your category and we'll match the right technician</p>
      <div class="hp-niches-grid">
        {NICHES.map(n => (
          <a href={n.href} class="hp-niche-card">
            <span class="hp-niche-dot" style={`background:${n.dot}`}></span>
            <h3>{n.title}</h3>
            <p>{n.desc}</p>
            <span class="hp-niche-arrow">View →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 6: POPULAR SERVICES ===== -->
  <section class="hp-popular">
    <div class="hp-popular-inner">
      <h2 class="hp-section-title">Most Requested Repairs</h2>
      <div class="hp-popular-grid">
        {POPULAR.map(p => {
          const bs = BADGE_STYLES[p.badge];
          return (
            <a href={p.href} class="hp-pop-card">
              <span class="hp-pop-badge" style={`background:${bs.bg};color:${bs.fg}`}>{p.badge}</span>
              <h3>{p.title}</h3>
              <p>{p.brands}</p>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 7: WHY US ===== -->
  <section class="hp-why">
    <div class="hp-why-inner">
      <h2 class="hp-section-title">Numbers That Matter</h2>
      <div class="hp-why-grid">
        <div class="hp-why-card"><div class="hp-why-num">85%</div><div class="hp-why-label">Fixed first visit</div></div>
        <div class="hp-why-card"><div class="hp-why-num">8</div><div class="hp-why-label">SoCal branches</div></div>
        <div class="hp-why-card"><div class="hp-why-num">90-day</div><div class="hp-why-label">Parts warranty</div></div>
        <div class="hp-why-card"><div class="hp-why-num">24/7</div><div class="hp-why-label">Phones answered</div></div>
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 8: FOR BUSINESS ===== -->
  <section class="hp-business">
    <div class="hp-business-inner">
      <h2 class="hp-section-title hp-title-light">We Work With</h2>
      <p class="hp-section-sub hp-sub-light">Priority dispatch · Commercial invoice · COI available</p>
      <div class="hp-biz-grid">
        <a href="/for-business/restaurants/" class="hp-biz-card">
          <h3>Restaurants &amp; Bars</h3>
          <p>Same-day kitchen equipment service. $120 commercial diagnostic. COI on request.</p>
        </a>
        <a href="/for-business/hotels/" class="hp-biz-card">
          <h3>Hotels &amp; Airbnb</h3>
          <p>Multi-unit dispatch. Discreet service. Hotel laundry, in-room appliances, kitchen.</p>
        </a>
        <a href="/for-business/property-management/" class="hp-biz-card">
          <h3>Property Management</h3>
          <p>Multi-property contracts. Tenant scheduling. Centralized billing across portfolio.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 9: SERVICE AREAS ===== -->
  <section class="hp-areas">
    <div class="hp-areas-inner">
      <h2 class="hp-section-title">87 Cities Across Southern California</h2>
      <div class="hp-county-anchors">
        <h3 class="hp-county-anchors-h">Browse appliance repair by county</h3>
        <ul class="hp-county-list">
          <li><a href="/los-angeles-county/">Appliance Repair Los Angeles County → 26 cities</a></li>
          <li><a href="/orange-county/">Appliance Repair Orange County → 14 cities</a></li>
          <li><a href="/ventura-county/">Appliance Repair Ventura County → 9 cities</a></li>
          <li><a href="/san-bernardino-county/">Appliance Repair San Bernardino County → 8 cities</a></li>
          <li><a href="/riverside-county/">Appliance Repair Riverside County → 8 cities</a></li>
        </ul>
      </div>
      <div class="hp-chip-rows">
        {COUNTY_CITIES.map(c => (
          <div class="hp-chip-row">
            <a href={c.href} class="hp-chip hp-chip-county">{c.county} →</a>
            {c.cities.map(city => (
              <a href={`/${city.toLowerCase().replace(/\s+/g,'-')}/`} class="hp-chip">{city}</a>
            ))}
          </div>
        ))}
        <p class="hp-areas-more"><a href="/areas/">→ + 67 more cities</a></p>
      </div>
    </div>
  </section>

  <!-- ===== BLOCK 10: BOTTOM CTA ===== -->
  <section class="hp-bottom-cta">
    <div class="hp-bottom-cta-inner">
      <h2>Need an Appliance Repair in Los Angeles Today?</h2>
      <p>Same day dispatch across Los Angeles, Orange, Ventura, San Bernardino, Riverside counties · Phones answered 24/7</p>
      <div class="hp-cta-row">
        <a href={phoneHref} class="hp-btn hp-btn-white">☎ Call {phone}</a>
        <a href="/book/" class="hp-btn hp-btn-outline-white">Book Online</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  :root { --red: #C8102E; --black: #0a0a0a; --gray: #f5f5f5; }

  /* shared */
  .hp-section-label { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin: 0 0 12px; }
  .hp-section-title { font-size: clamp(1.7rem, 3.2vw, 2.4rem); font-weight: 800; line-height: 1.2; margin: 0 0 16px; color: var(--black); letter-spacing: -0.01em; }
  .hp-section-sub { font-size: 1.05rem; line-height: 1.6; color: #555; margin: 0 0 32px; max-width: 640px; }
  .hp-title-light { color: #fff; }
  .hp-sub-light { color: rgba(255,255,255,0.72); }
  .hp-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .hp-btn { display: inline-block; padding: 14px 28px; border-radius: 6px; font-size: 15px; font-weight: 700; text-decoration: none; }
  .hp-btn-red { background: var(--red); color: #fff; }
  .hp-btn-outline { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.4); }
  .hp-btn-white { background: #fff; color: var(--red); }
  .hp-btn-outline-white { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.6); }

  /* hero */
  .hp-hero { position: relative; overflow: hidden; background: #0a0a0a; color: #fff; min-height: 560px; display: flex; align-items: center; }
  .hp-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .hp-hero-bg picture, .hp-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 72% center; display: block; }
  .hp-hero-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(100deg, rgba(10,10,10,0.95) 0%, rgba(10,10,10,0.88) 30%, rgba(10,10,10,0.6) 56%, rgba(10,10,10,0.25) 100%); }
  .hp-hero-inner { position: relative; z-index: 2; max-width: 1200px; width: 100%; margin: 0 auto; padding: 72px 24px; }
  .hp-hero-text { max-width: 600px; }
  .hp-eyebrow { font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); margin: 0 0 14px; }
  .hp-hero-text h1 { font-size: clamp(32px, 4.4vw, 52px); font-weight: 800; line-height: 1.1; margin: 0 0 18px; letter-spacing: -0.02em; color: #fff; text-shadow: 0 2px 16px rgba(0,0,0,0.6); }
  .hp-subline { font-size: 18px; color: rgba(255,255,255,0.9); line-height: 1.65; max-width: 560px; margin: 0 0 28px; text-shadow: 0 1px 10px rgba(0,0,0,0.5); }
  /* Hero branch chips — replaced the dim inline list + divider rule.
     All 8 branches as real tel: anchors; existing GTM tel: capture covers them.
     Motion is guarded globally by the prefers-reduced-motion block in
     global.css, so no per-rule guard is needed here. */
  .hp-branch-chips { margin-top: 26px; }
  .hp-branch-chips__label { font-size: 13px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.65); margin: 0 0 12px; }
  .hp-branch-chips__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .hp-branch-chip {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 14px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 10px;
    text-decoration: none;
    /* the photo runs under the left column; blur keeps the numbers legible.
       The rgba background above is the fallback where blur is unsupported. */
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: background 150ms var(--ease), border-color 150ms var(--ease);
  }
  .hp-branch-chip__city { font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(255,255,255,0.75); }
  .hp-branch-chip__phone { font-size: 15px; font-weight: 700; color: #fff; white-space: nowrap; }
  .hp-branch-chip:hover { background: var(--red); border-color: var(--red); }
  .hp-branch-chip:hover .hp-branch-chip__city { color: rgba(255,255,255,0.9); }
  @media (max-width: 900px) {
    .hp-hero { min-height: 480px; }
    .hp-hero-overlay { background: linear-gradient(180deg, rgba(10,10,10,0.62) 0%, rgba(10,10,10,0.58) 45%, rgba(10,10,10,0.85) 100%); }
    .hp-hero-inner { padding: 56px 20px; }
  }
  @media (max-width: 768px) {
    /* 2 across, full available width — 4 across cannot hold a phone number
       at this viewport. */
    .hp-branch-chips__grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* intro narrative */
  .hp-intro { background: #fff; padding: 56px 24px 8px; }
  .hp-intro-inner { max-width: 900px; margin: 0 auto; }
  .hp-intro-body p { font-size: 1.05rem; line-height: 1.7; color: #333; margin: 0 0 18px; }
  .hp-intro-body p:last-child { margin-bottom: 0; }

  /* county anchors */
  .hp-county-anchors { margin: 18px 0 28px; padding: 18px 22px; background: #fff; border-radius: 8px; border: 1px solid #d9d9d9; }
  .hp-county-anchors-h { font-size: 13px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase; color: #444; margin: 0 0 12px; }
