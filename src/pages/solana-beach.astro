  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Counter-depth · Panel-front built-ins · Coastal coil service', brands: 'Sub-Zero · KitchenAid · Samsung · LG · GE Monogram' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Drain codes · Compact 18-inch units · Panel fronts', brands: 'Bosch · Miele · KitchenAid · Samsung' },
