const citySlug = 'solana-beach';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'Solana Beach';
const zips = ['92075'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Solana Beach CA — Same Day`;
const description = "Appliance repair in Solana Beach 92075 — condos, stacked laundry, HOA coordination, bluff-top homes. Cedros to the shoreline. $89 dx. (858) 667-7237.";
const canonical = 'https://samedayappliance.repair/solana-beach/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.fullName,
  image: 'https://samedayappliance.repair/images/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'Solana Beach', sameAs: 'https://en.wikipedia.org/wiki/Solana_Beach,_California' },
    { '@type': 'Place', name: 'Cedros Design District' },
    { '@type': 'Place', name: 'Fletcher Cove area' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
  license: 'BHGS #A49573'
});

const introParagraphs = [
  "<strong>Solana Beach is the compact one on our San Diego routes — barely three and a half square miles, and most of it lives closer together than anywhere else we serve on this corridor: condo complexes stepping down toward the water, townhomes off Lomas Santa Fe, apartments above the Cedros Design District, and a strip of bluff-top single-family homes along the edge. Dense housing means shared walls, stacked laundry closets, HOA rules — and a repair company that knows how to work inside all three. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong>",
  "Here's what density changes about appliance repair, practically: the machines are compact (stacked washer-dryer pairs in closets, counter-depth refrigerators, 18-inch dishwashers in older units), the failures are urgent for more people at once (one leaking washer on a third floor is three units' problem), and the fix has to be coordinated — building access, elevator pads, water shut-offs that serve more homes than yours, and an HOA or property manager who needs the paperwork. Our San Diego technicians handle that coordination as part of the job, not as a favor.",
  "For the property managers and HOA boards running Solana Beach's complexes, we work the way buildings require: written estimates the board can approve remotely, invoices that say what actually happened, one contact who already knows the building's quirks by the second visit, and scheduling that respects quiet hours and parking rules. A management company that covers four complexes shouldn't have to re-explain access four times — that's our record-keeping job, not theirs.",
  "The single-family side gets equal footing: the bluff-top and hillside homes west of the 101 carry serious kitchens — built-in refrigeration, pro-style ranges — sitting a few hundred feet from open ocean, which makes coastal coil and gasket service a habit rather than an upsell. And Cedros itself, the design district that gives the town its character, means more than a few remodeled kitchens with panel-front appliances chosen to disappear into custom cabinetry. We service the machine without wrecking the millwork.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on parts and labor. Call <a href="tel:${phoneRaw}">${branch.phone}</a> for same-day service across 92075 — and the rest of the <a href="/san-diego-county/">North Coastal corridor</a>.`
];

const services = [
