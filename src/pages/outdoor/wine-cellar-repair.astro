---
// src/pages/outdoor/wine-cellar-repair.astro
// Top-level outdoor wine cellar repair pillar — created to be the hub
// the 5 city-specific wine cellar pages link UP to. Minimal scaffold;
// full content writing will be a separate task following the Notion
// writing standard. Page renders MODE A hero photo when
// public/images/outdoor/wine-cellar-repair/hero.{webp,jpg} are deployed.

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../data/branches';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/outdoor/wine-cellar-repair/";

const title = "Outdoor Wine Cellar Repair Across Southern California";
const description = "Walk-in wine cellar cooling repair across LA, OC, Ventura, Riverside. WhisperKool, Wine Guardian, CellarPro, Breezaire. EPA 608 certified. BHGS #A49573.";

const cities = [
  { slug: 'bel-air', name: 'Bel Air' },
  { slug: 'beverly-hills', name: 'Beverly Hills' },
  { slug: 'malibu', name: 'Malibu' },
  { slug: 'newport-beach', name: 'Newport Beach' },
  { slug: 'pacific-palisades', name: 'Pacific Palisades' },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": canonical + "#service",
      "serviceType": "Outdoor Wine Cellar Repair",
      "name": "Outdoor Wine Cellar Cooling Repair",
      "description": "Walk-in wine cellar cooling system repair for residential and estate cellars across Southern California. WhisperKool, Wine Guardian, CellarPro, Breezaire ducted and self-contained units. EPA 608 certified for refrigerant work.",
      "provider": {
        "@type": "LocalBusiness",
        "name": "Same Day Appliance Repair",
        "telephone": MAIN_PHONE,
        "url": "https://samedayappliance.repair/",
        "priceRange": "$$",
        "legalName": "HVAC 777 LLC",
        "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "CSLB C-20 HVAC", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Contractors State License Board" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "BBB Accredited Business", "recognizedBy": { "@type": "Organization", "name": "Better Business Bureau" } } ],
        "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ]
      },
      "areaServed": [
        { "@type": "AdministrativeArea", "name": "Los Angeles County" },
        { "@type": "AdministrativeArea", "name": "Orange County" },
        { "@type": "AdministrativeArea", "name": "Ventura County" },
      ],
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
        { "@type": "ListItem", "position": 2, "name": "Outdoor", "item": "https://samedayappliance.repair/outdoor/" },
        { "@type": "ListItem", "position": 3, "name": "Wine Cellar Repair", "item": canonical },
      ],
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>

  <ServiceHero
    section="outdoor"
    slug="wine-cellar-repair"
    eyebrow="Residential Outdoor · Wine Cellar Repair · LA Estates + Coast · Same Day"
    title="Outdoor Wine Cellar Repair Across Southern California"
    subtitle={`Walk-in wine cellar cooling repair across LA, Orange, Ventura, Riverside. WhisperKool, Wine Guardian, CellarPro, Breezaire ducted and self-contained units. EPA 608 certified. Same-day dispatch. ${phone}`}
    heroImageTitle="Outdoor Wine Cellar Repair"
    showBranches={true}
  />

  <section class="section">
    <div class="container narrow">
      <p class="section-number">01 · What we cover</p>
      <h2 class="section-title">Walk-in cellars, glass-fronted display units, ducted cooling systems.</h2>
      <p><strong>When an outdoor or estate wine cellar fails at an LA-area home, our techs at Same Day Appliance Repair trace it to a handful of patterns: WhisperKool compressor lockouts, Wine Guardian split-system refrigerant leaks at the line set, CellarPro evaporator fan failures, and Breezaire humidity sensor drift. Hillside Bel Air ridge cellars run summer heat load while coastal Pacific Palisades and Newport Beach installs take salt aerosol on the condenser, and each manufacturer has its own diagnostic flow. Our techs at Same Day Appliance Repair hold EPA 608 for the sealed-system refrigerant work most LA shops refer out. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</strong></p>
      <p class="lead">From compact 500-bottle closet cellars to multi-room estate cellars holding 5,000+ bottles, we service the full cooling stack: split ducted systems, self-contained through-the-wall units, condenser pads, evaporator coils, humidity control, and digital temperature controllers. EPA 608 certified for sealed-system refrigerant work — most LA appliance repair companies refer wine cellar calls out because they don't carry the certification or the specialty parts. We do.</p>
      <p>Common failures we see on LA estate cellars: WhisperKool compressor lockouts, Wine Guardian split-system refrigerant leaks at the line set, CellarPro evaporator fan failures, Breezaire humidity sensor drift. Each manufacturer has its own diagnostic flow, and our techs know the brand-specific failure modes before the truck rolls out.</p>
    </div>
  </section>

  <section class="section section-gray">
    <div class="container">
      <p class="section-number">02 · Local service</p>
      <h2 class="section-title">Wine cellar repair by city</h2>
      <div class="city-grid">
        {cities.map(c => (
          <a class="city-card" href={`/outdoor/wine-cellar-repair-${c.slug}/`}>
            <h3>{c.name}</h3>
            <p>Estate and luxury residential wine cellar service in {c.name} and surrounding hillside.</p>
            <span class="city-card__cta">View {c.name} service →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p class="section-number">03 · Talk to a technician</p>
      <h2 class="section-title">Same-day wine cellar service across Southern California.</h2>
      <p>If your cellar is climbing past the 55–58°F target or showing humidity drift outside the 50–70% RH band, call now. We'll diagnose the cooling system, source the part, and have you back in spec before the bottles see thermal damage.</p>
      <div class="cta-row">
        <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
        <a href="/contact/" class="btn-outline">Request Service</a>
      </div>
      <p style="margin-top:32px;font-size:15px;color:#6b6b6b;">Related outdoor services: <a href="/outdoor/wine-cellar-maintenance/">wine cellar maintenance program</a> (semi-annual coastal, annual inland) · <a href="/outdoor/kitchen-repair/">outdoor kitchen repair</a> · <a href="/outdoor/">outdoor appliance hub</a>. Commercial cellars and restaurant wine rooms: <a href="/commercial/refrigeration/wine-cellar-cooling-repair/">commercial wine cellar cooling repair</a>. Indoor freestanding wine cooler service (different scope, $89 residential diagnostic): <a href="/services/wine-cooler-repair/">wine cooler repair</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .section { padding: 64px 24px; }
  .section-gray { background: #f5f5f5; }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 820px; }
  .section-number {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #C8102E;
    margin: 0 0 12px;
  }
  .section-title {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 20px;
    color: #1a1a1a;
  }
  .lead {
    font-size: 17px;
    line-height: 1.7;
    color: #1a1a1a;
    margin: 0 0 18px;
  }
  .city-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 18px;
    margin-top: 24px;
  }
  .city-card {
    background: #fff;
    border: 1px solid #e2e2e2;
    border-radius: 8px;
    padding: 22px;
    text-decoration: none;
    color: #1a1a1a;
    transition: border-color 0.2s, transform 0.2s;
  }
  .city-card:hover {
    border-color: #C8102E;
    transform: translateY(-2px);
  }
  .city-card h3 {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
  }
  .city-card p {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.5;
    color: #6b6b6b;
  }
  .city-card__cta {
    font-size: 13px;
    font-weight: 600;
    color: #C8102E;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .btn-primary {
    background: #C8102E;
    color: #fff;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
  }
  .btn-outline {
    border: 1.5px solid #1a1a1a;
    color: #1a1a1a;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    display: inline-block;
  }
</style>
