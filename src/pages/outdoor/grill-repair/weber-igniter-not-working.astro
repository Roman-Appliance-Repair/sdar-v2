</section>

<!-- 08 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08 · FAQ</p>
    <h2 class="section-title">Weber igniter repair, common questions.</h2>

    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p set:html={f.a} />
