---
// Wave 63 Sprint 2A — Auto-generated brand-index hub page.
// Restores breadcrumb chain Home > Commercial > <Category> > Brands > <Brand>
// (or Outdoor parent for outdoor categories).
// $120 commercial diagnostic only (no $89 — commercial scope per factual-accuracy.md §9).
import Layout from '../../../../layouts/Layout.astro';
import { MAIN_PHONE } from '../../../../data/branches';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/outdoor/pizza-oven-repair/brands/";
const title = "Outdoor Pizza Oven Brands Repair LA — Same Day";
const description = "Commercial outdoor pizza oven brand repair across LA — 2 brands. EPA 608, $120 dx, BHGS #A49573.";

const breadcrumbSchema = {"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/"}, {"@type": "ListItem", "position": 2, "name": "Outdoor", "item": "https://samedayappliance.repair/outdoor/"}, {"@type": "ListItem", "position": 3, "name": "Outdoor Pizza Oven", "item": "https://samedayappliance.repair/outdoor/pizza-oven-repair/"}, {"@type": "ListItem", "position": 4, "name": "Brands", "item": "https://samedayappliance.repair/outdoor/pizza-oven-repair/brands/"}]};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>

  <section class="hub-hero">
    <div class="container">
      <p class="eyebrow">Los Angeles · Commercial · Same-Day</p>
      <h1>Outdoor Pizza Oven Brands We Service in LA</h1>
      <p class="hub-lede">Outdoor residential pizza ovens are a luxury kitchen category specific to LA's outdoor-living climate — Calabasas, Hidden Hills, Bel Air, Beverly Hills estates with built-in outdoor kitchens drive most installs. Two brands cover most service: Alfresco (BBQ Galore Inc., Commerce, CA — AXE-30 built-in luxury pizza oven), and Ooni (UK-based portable units — Karu multi-fuel, Koda gas, Fyra pellet, Pro legacy).</p>
      <div class="cta-row">
        <a href={phoneHref} class="btn-primary">Call {phone}</a>
        <a href="/book/" class="btn-secondary">Book Online</a>
      </div>
      <p class="hub-foot">$120 commercial diagnostic · Applied to repair · BHGS #A49573 · EPA 608 Universal #1346255700410 · BBB Accredited</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="container">
      <h2>2 outdoor pizza oven brands we work on</h2>
      <div class="brand-grid">
        <a href="/outdoor/pizza-oven-repair/brands/alfresco/" class="brand-card">
          <h3>Alfresco</h3>
          <p>Alfresco AXE-30 built-in pizza oven service. BBQG Inc.</p>
          <span class="card-cta">Alfresco repair details →</span>
        </a>
        <a href="/outdoor/pizza-oven-repair/brands/ooni/" class="brand-card">
          <h3>Ooni</h3>
          <p>Ooni Karu (multi-fuel), Koda (gas), Fyra (pellet), Pro (legacy) repair. UK-made portable.</p>
          <span class="card-cta">Ooni repair details →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="hub-section hub-section-gray">
    <div class="container narrow">
      <h2>How our techs approach outdoor pizza ovens</h2>
      <p>Two architectures, two service trees. Built-in outdoor luxury units (Alfresco AXE-30, similar custom installs) — service items include gas valve and ignition components, refractory deck inspection, dome thermometer accuracy, and the built-in venting system. We service these in coordination with outdoor-kitchen access requirements. Portable units (Ooni Karu/Koda/Fyra/Pro) — service items are more limited (the units are designed for replacement at year 5-7 of regular use), but burner head, gas regulator, and stone deck replacements are common service. We give honest repair-vs-replace guidance based on unit age.</p>
    </div>
  </section>

  <section class="hub-section">
    <div class="container narrow">
      <h2>Common questions</h2>
      <div class="faq-list">
        <details class="faq-item">
          <summary>How long do residential outdoor pizza ovens last?</summary>
          <p>Depends heavily on architecture. Built-in luxury units (Alfresco AXE-30 and similar custom installations) — 15-25 years with proper service. Portable units (Ooni Karu/Koda/Fyra/Pro) — typically 5-7 years before component degradation pushes economics toward replacement.</p>
        </details>
        <details class="faq-item">
          <summary>Should I repair or replace my Ooni at year 5+?</summary>
          <p>Depends on the failure. Burner-head or gas-regulator service on a 5-year Ooni is usually a $145-$245 fix worth doing. Stone-deck cracking or chassis-frame degradation typically pushes economics toward replacement — current Ooni Karu/Koda units run $400-$700 retail. We give you the honest math before quoting parts.</p>
        </details>
        <details class="faq-item">
          <summary>Do you service the Alfresco built-in pizza oven?</summary>
          <p>Yes. The AXE-30 built-in luxury units in Calabasas, Hidden Hills, Bel Air, and Beverly Hills outdoor kitchens are a regular part of our outdoor-living service load. BBQ Galore Inc. is the parent (Commerce, CA-based) — parts availability is reliable through their distributor network.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="bottom-cta">
    <div class="container">
      <h2>Outdoor Pizza Oven brand service across LA, same-day priority</h2>
