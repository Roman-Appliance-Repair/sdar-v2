      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Outdoor diagnostic fee, applied toward repair"
      }
    },
    "brand": { "@id": canonical + "#brand" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Brand",
    "@id": canonical + "#brand",
    "name": "Napoleon",
