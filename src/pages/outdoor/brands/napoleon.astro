    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Napoleon Grill Repair",
    "name": "Napoleon Grill Repair Service",
    "url": canonical,
    "description": "Napoleon gas grill repair across all five SoCal counties. Prestige series, Prestige PRO 500 and 665 (freestanding RSIB and built-in RB configurations), and Rogue series. JETFIRE ignition electrodes, infrared SIZZLE ZONE side burner, infrared rear rotisserie burner, WAVE cooking grids, standard tube burners, regulators, and rotisserie motors. Natural gas and liquid propane. BHGS #A49573.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
