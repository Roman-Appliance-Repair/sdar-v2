//   NOT Viking outdoor refrigeration (/brands/viking-outdoor-refrigerator-repair/) — both cross-linked, not duplicated.
// Verified models only: VGBQ (open-flame straight-tube/U burners) incl VGBQ53624 / VGBQ54224 / VGBQ55424;
//   VGIQ (adds Tru-Sear infrared burner) incl VGIQ300-2RE/RT, VGIQ410-3RE/RT, VGIQ54224/55424; VQGI 5 Series built-in.
//   5 Series 42"/54"; E-Series / T-Series; LP=LSS / NG=NSS suffixes. Viking Range LLC (Middleby).
// Em-dash budget in visible body: keep low. Voice: "our techs" / "we". $89 outdoor diagnostic.

import Layout from '../../../layouts/Layout.astro';
import ServiceHero from '../../../components/ServiceHero.astro';
