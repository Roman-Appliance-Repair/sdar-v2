<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="West Hollywood, CA"
    subheadline="Same-day service on every major appliance. Sub-Zero, Thermador, Viking, Bosch, Samsung, LG — our licensed technicians cover all of WeHo from Norma Triangle to Sunset Strip."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Our Technicians Are in WeHo Every Day"
    paragraphs={introParagraphs}
  />

  <ServicesGrid cityName={cityName} services={services} />

  <LuxurySpecialists
    citySlug={citySlug}
    cityName={cityName}
    headline="Sub-Zero, Thermador & Viking Repair in West Hollywood"
    paragraphs={luxuryParagraphs}
    brands={luxuryBrands}
    footnote={{
      lead: 'Built-in & integrated refrigeration is its own specialty — see our',
      linkText: 'built-in refrigerator repair page',
      href: '/services/built-in-refrigerator-repair/'
    }}
  />

  <!-- The neighbourhood photo used to sit here as its own band; it is now the
       background of this section (bgImage), which is what it was always describing. -->
  <ServiceArea
    cityName={cityName}
    cityShortName="WeHo"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={keyStreets}
    bgImage="/images/cities/west-hollywood/neighborhood.webp"
  />

  <PropertyManagers
    citySlug={citySlug}
    cityName={cityName}
    headline="Airbnb Hosts &amp; Property Managers — We Know How WeHo Works"
    paragraphs={propertyParagraphs}
    bullets={propertyBullets}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow={commercialNarrative.eyebrow}
    headline={commercialNarrative.headline}
    paragraphs={commercialNarrative.paragraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Rooftop Decks and Patio Dining Break Things Too"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    brandPills={outdoorBrands}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

