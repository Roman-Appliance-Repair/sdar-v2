---
/**
 * Honest 404 page. Its presence makes Astro emit dist/404.html, which switches
 * Cloudflare Pages off SPA-fallback mode — unmatched paths return a real 404
 * instead of HTTP 200 + homepage HTML.
 *
 * Keep this page light on purpose: no hero image, no grids, no JSON-LD, no FAQ.
 */
import Layout from '../layouts/Layout.astro';

const title = 'Page Not Found — Same Day Appliance Repair';
const description = 'This page does not exist. Find the service or city page you need, or call us and we will point you the right way.';
---

<Layout title={title} description={description} showDiagnosticBanner={false}>
  <main class="nf">
    <h1>Page Not Found</h1>
    <p>
      This address doesn't match any page on our site — the link may be old, or the URL
      got mistyped somewhere along the way. Everything we actually do is one click below,
      and if you'd rather just talk to a person, our West Hollywood line picks up.
    </p>
    <nav class="nf-links" aria-label="Helpful links">
      <a href="/">Home</a>
      <a href="/services/">Services</a>
      <a href="/areas/">Areas We Serve</a>
      <a href="/book/">Book Online</a>
    </nav>
    <a class="nf-call" href="tel:+13238704790">Call (323) 870-4790</a>
  </main>
</Layout>

<style>
  .nf {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 16px 80px;
    text-align: center;
  }
  .nf h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  .nf p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #6b6b6b;
    margin: 0 0 32px;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-bottom: 32px;
  }
  .nf-links a {
    display: inline-block;
    padding: 10px 20px;
    border: 1px solid #e2e2e2;
    border-radius: 6px;
    color: #1a1a1a;
    text-decoration: none;
    font-weight: 600;
  }
  .nf-links a:hover {
    border-color: #C8102E;
    color: #C8102E;
  }
  .nf-call {
    display: inline-block;
    padding: 14px 28px;
    background: #C8102E;
    color: #ffffff;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .nf-call:hover {
    background: #a30d26;
  }
  @media (max-width: 768px) {
    .nf h1 {
      font-size: 1.9rem;
    }
  }
</style>
