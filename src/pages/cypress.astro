---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';

import { mergeCredentials } from '../data/credentials-schema';

// City stage 2 (2026-10-08): new hub — Cypress is a city we do real work in
// (Fixar jobs since July 2026) but had no page. Content is specific to this city;
// facts we could not confirm (named water supplier, hardness figures) are left out.
// Recent repairs and reviews are REAL and selected by src/lib/recent-repairs.ts and
// src/lib/reviews.ts — nothing on this page is hand-written as a customer story.
const citySlug = 'cypress';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = "Cypress";
const zips = ["90630"];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair Cypress CA — Same Day Service`;
const description = "Same-day appliance repair in Cypress, CA — home appliances, ice machines and commercial equipment. $89 diagnostic, waived with repair. BHGS #A49573.";
const canonical = 'https://samedayappliance.repair/cypress/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: "Cypress", sameAs: "https://en.wikipedia.org/wiki/Cypress,_California" },
    { '@type': 'Place', name: "North Cypress" },
    { '@type': 'Place', name: "South Cypress" }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$',
});

const introParagraphs = [
  "<strong>Our technicians at Same Day Appliance Repair have worked in Cypress on both sides of the line between home and business: two ice machines on a work site that had stopped producing ice, a GE Monogram trash compactor with a failed key switch, a rattling Whirlpool dryer. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "Cypress started as a dairy-farming town — it incorporated in 1956 as Dairy City and took its current name a year later — and the farms gave way to the single-family tract neighborhoods of the 1960s and 1970s that make up most of the city today. One ZIP code, 90630, covers it, with a business and office district along Katella Avenue and the Cypress College area in the middle of town.",
  "In homes the calls are the usual ones for houses of that age, remodelled over time: dryers with worn rollers and pulleys, refrigerators that stop cooling, dishwashers and built-ins like trash compactors whose original parts are no longer made. When a part is discontinued, the technician looks for a compatible replacement rather than writing the appliance off.",
  `Cypress is covered by our Irvine branch together with Garden Grove and Anaheim. Same $89 residential diagnostic as anywhere we work, no distance surcharge, and the fee is waived when you go ahead with the repair. Call <a href="tel:${phoneRaw}">${branch.phone}</a>.`
];

const commercialParagraphs = [
  "Cypress has restaurants and food service along Lincoln Avenue, Valley View Street and Katella Avenue, and a large business district with offices, break rooms and work sites. This year we repaired two ice machines on one Cypress work site the same day: one had a broken water-level sensor, the other a failed circulation pump, and both were full of dirt and debris. The commercial diagnostic is $120, waived when you approve the repair, with a written estimate before any work starts."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map (snowflake, pizza-oven, fryer,
// oven, droplet, laundry) — a wrong key renders an empty <path> silently.
const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// No outdoor brand pills: nothing in our records for this city names an outdoor brand.
const outdoorParagraphs = [
  "Cypress's 1960s and 1970s lots usually have a back patio and a garage, and many homes have a gas grill outside and a spare refrigerator or freezer in the garage. Outdoor grills come to us with igniter and low-flame problems, garage units with the strain of summer heat on the condenser and fans. We check the gas supply and airflow before replacing major parts."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '❄️', name: 'Refrigerator Repair', slug: 'refrigerator' },
  { icon: '🫧', name: 'Washer Repair', slug: 'washer' },
  { icon: '💨', name: 'Dryer Repair', slug: 'dryer' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher' },
  { icon: '🔥', name: 'Oven & Range Repair', slug: 'oven' },
  { icon: '🍳', name: 'Stove Repair', slug: 'stove' },
  { icon: '📻', name: 'Microwave Repair', slug: 'microwave' },
  { icon: '🧊', name: 'Ice Maker Repair', slug: 'ice-maker' },
  { icon: '🍷', name: 'Wine Cooler Repair', slug: 'wine-cooler' },
  { icon: '🧊', name: 'Freezer Repair', slug: 'freezer' },
  { icon: '🗑️', name: 'Garbage Disposal Repair', slug: 'garbage-disposal' },
  { icon: '♨️', name: 'Cooktop Repair', slug: 'cooktop' }
];

const neighborhoods = [
  { name: "North Cypress (north of Lincoln)", zip: "90630" },
  { name: "Central Cypress", zip: "90630" },
  { name: "Cypress College area", zip: "90630" },
  { name: "Katella business district", zip: "90630" },
  { name: "South Cypress", zip: "90630" }
];

const whyReasons = [
  {
    iconKey: 'team' as const,
    title: "Real Cypress jobs",
    body: "The four repairs on this page are real Cypress visits from our records — home and commercial — each with the month it happened."
  },
  {
    iconKey: 'parts' as const,
    title: "Discontinued parts",
    body: "Built-in appliances from the 1980s and 1990s often have parts that are no longer made. On a Cypress trash compactor this year the technician found a compatible switch from another model instead of declaring it dead."
  },
  {
    iconKey: 'shield' as const,
    title: "Commercial ice machines",
    body: "Water-level sensors, circulation pumps, scale and debris — we diagnose and clean commercial ice machines, not just swap parts."
  },
  {
    iconKey: 'clock' as const,
    title: "One ZIP, whole city",
    body: "All of 90630 — same dispatch, $89 diagnostic and 90-day warranty on parts and labor."
  }
];

const pricingTiers = [
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Residential · Waived with repair · Written estimate' },
  { appliance: 'Commercial Diagnostic', range: '$120', note: 'Restaurants & businesses · Waived with repair' },
  { appliance: 'Standard Repair', range: '$150–$350', note: 'Parts + labor · OEM parts · 90-day warranty' },
  { appliance: 'Warranty', range: '90 Days', note: 'All repairs · Parts & labor · No-charge callback', featured: true }
];

const faqs = [
  {
    question: "Do you offer same-day appliance repair in Cypress?",
    answer: "Yes. Cypress is covered by our Irvine branch together with Garden Grove and Anaheim, and same-day visits are possible when a technician is free — call early in the day for the best chance. We cover the whole city, ZIP 90630."
  },
  {
    question: "Do you repair commercial ice machines in Cypress?",
    answer: "Yes. This year we repaired two ice machines on one Cypress work site the same day — a Manitowoc with a broken water-level sensor and a Vevor with a failed circulation pump — and cleaned both. The commercial diagnostic is $120, waived with repair."
  },
  {
    question: "Can you fix an older built-in appliance whose parts are discontinued?",
    answer: "Often, yes. When the original part is no longer made, the technician looks for a compatible replacement — as on a GE Monogram trash compactor in Cypress this year, where the original key switch is discontinued."
  },
  {
    question: "How much is the diagnostic in Cypress?",
    answer: "$89 residential and $120 commercial, waived when you approve the repair, with a written estimate first. No distance surcharge."
  },
  {
    question: "What is your warranty on Cypress repairs?",
    answer: "Every repair carries a 90-day warranty on parts and labor. If the same problem returns within 90 days, we come back at no charge."
  },
  {
    question: "Are your Cypress appliance repairs licensed and insured?",
    answer: "Yes. Same Day Appliance Repair is BHGS #A49573, EPA 608 Universal certified (#1346255700410), licensed and insured, with a 90-day warranty on parts and labor on every Cypress repair. $89 residential diagnostic, waived with repair."
  }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair in"
    headlineCity="Cypress, CA"
    subheadline="Same-day service across Cypress, ZIP 90630 — dryers, refrigerators, trash compactors, ice machines and commercial equipment. $89 diagnostic, waived with repair."
    zips={zips}
    tier={3}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Cypress — 1960s neighborhoods and a working business district"
    paragraphs={introParagraphs}
    bookingTitle="Cypress Service"
    bookingSub="Available Today"
  />

  <ServicesGrid
    cityName={cityName}
    headline="Appliance Repair Services in Cypress"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="COMMERCIAL KITCHENS"
    headline="Cypress Restaurants, Offices and Work Sites"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="Cypress Patios and Garage Refrigerators"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="Cypress Neighborhoods We Service"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={["Lincoln Ave", "Valley View St", "Katella Ave", "Ball Rd", "Moody St", "Walker St"]}
  />

  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Repairs in Cypress" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why Cypress Calls Us"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Repair Pricing in Cypress"
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Frequently Asked Questions — Cypress"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Orange County Cities"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Schedule Your Cypress Repair Today"
    body="Same-day service across Cypress, ZIP 90630. Home appliances and commercial equipment."
  />
</CityLayoutV2>
