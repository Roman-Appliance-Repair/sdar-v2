---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Wolf Appliance Repair Los Angeles — Same Day";
const description = "Wolf appliance repair in Los Angeles: ranges, rangetops, wall ovens, steam ovens and cooktops. Same-day visits. $89 diagnostic, waived with repair.";

// 2026-10-05: hub rewritten to stay about the brand as a whole. Product-level depth
// (symptoms, parts, prices) lives on the product pages linked from the "What we repair"
// block, so the hub stops competing with them for product queries.
// FAQ: visible list and FAQPage JSON-LD are both generated from `faqs`.
const faqs = [
  { q: "Are you part of Wolf's service network?", a: "No. We're an independent repair company. If your Wolf is still inside its factory warranty, call Sub-Zero/Wolf at 1-800-222-7820 first; after the warranty, we're usually the faster call." },
  { q: "Which Wolf appliances do you repair?", a: "Ranges and stoves, rangetops and cooktops, wall ovens, convection steam and speed ovens, microwaves and range hoods — including older commercial-style Wolf ranges with standing pilots. Each has its own page in the 'What we repair' list." },
  { q: "Does Wolf make refrigerators or dishwashers?", a: "No. Wolf is cooking only. Refrigeration in the same group is Sub-Zero and dishwashers are Cove — we repair both." },
  { q: "Why do you ask for the serial number as well as the model?", a: "Wolf revised parts across production runs, so two ranges with the same model number can take different boards or switches. The serial lets the technician bring the right part on the first visit." },
  { q: "How much does Wolf repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. Repairs are quoted in writing after the diagnostic, before work starts, and carry a 90-day warranty on parts and labor." },
  { q: "How fast can you come out?", a: "Same day when a technician is free, Monday to Saturday 8am–6pm. Call early for the best chance." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/wolf/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/wolf/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/wolf/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="wolf"
    section="brands"
    eyebrow={"Wolf · Ranges · Ovens · Cooktops"}
    title={"Wolf Appliance Repair in Los Angeles"}
    subtitle={"Dual-fuel and gas ranges, rangetops, wall ovens, steam and speed ovens, cooktops and hoods — repaired in place, with the right part on the first visit."}
    heroImageTitle={"Wolf Appliance Repair in Los Angeles"}
    showBranches={true}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

  <!-- ── WHAT WE REPAIR (route block) ── -->
  <section class="wwr">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Pick your Wolf</h2>
      <div class="wwr-grid">
        <a href="/brands/wolf-range-repair/" class="wwr-card"><strong>Wolf range repair</strong><span>DF dual-fuel and GR gas ranges, older pilot-light Wolfs.</span></a>
        <a href="/brands/wolf-stove-repair/" class="wwr-card"><strong>Wolf stove repair</strong><span>Burners that won’t light or won’t simmer.</span></a>
        <a href="/brands/wolf-oven-repair/" class="wwr-card"><strong>Wolf oven repair</strong><span>M and E Series wall ovens, steam and speed ovens.</span></a>
        <a href="/brands/wolf-wall-oven-repair/" class="wwr-card"><strong>Wolf wall oven repair</strong><span>Single and double built-in wall ovens.</span></a>
        <a href="/brands/wolf-cooktop-repair/" class="wwr-card"><strong>Wolf cooktop repair</strong><span>Gas and induction cooktops.</span></a>
        <a href="/brands/wolf-microwave-repair/" class="wwr-card"><strong>Wolf microwave repair</strong><span>Drawer and convection microwaves.</span></a>
        <a href="/brands/wolf-range-hood-repair/" class="wwr-card"><strong>Wolf range hood repair</strong><span>Hoods and ventilation.</span></a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">About the brand</p>
      <h2>Wolf is the cooking half of Sub-Zero</h2>
      <p class="intro-speakable">Wolf joined the Sub-Zero Group in 2000 and makes cooking appliances only: ranges, rangetops, cooktops, wall ovens, steam and speed ovens, microwaves, warming drawers and ventilation. Refrigeration in the same group is Sub-Zero and dishwashers are Cove.</p>
      <p>Two things shape almost every Wolf repair. The sealed burners are dual-stacked — a high-heat ring and a separate simmer ring — so burner problems are usually on one tier. And the oven under a Wolf range is either electric (DF dual-fuel) or gas (GR), which are completely different repairs. Our product pages above go into each.</p>
    </div>
  </section>

  <!-- ── SCOPE ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Scope</p>
      <h2>What Wolf doesn't make, and where to go</h2>
      <ul class="scope-list">
        <li><strong>Refrigerators</strong> are Sub-Zero. See <a href="/brands/sub-zero/">Sub-Zero repair</a>.</li>
        <li><strong>Dishwashers</strong> are Cove. See <a href="/brands/cove/">Cove dishwasher repair</a>.</li>
        <li><strong>Washers and dryers</strong> — Wolf has never made laundry.</li>
        <li><strong>Outdoor grills</strong> — see our <a href="/services/bbq-grill-repair/">BBQ grill repair</a> page.</li>
      </ul>
    </div>
  </section>

  <!-- ── INDEPENDENCE / WARRANTY ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Warranty and how we work</p>
      <h2>Under warranty, call Wolf. After that, call us.</h2>
      <p>We're an independent repair company, not part of Wolf's own service network, and we don't present ourselves as one. If your Wolf is still inside its factory warranty, call Sub-Zero/Wolf at <strong>1-800-222-7820</strong> first. After that, our residential diagnostic is $89, waived with repair, the quote is in writing before work starts, and every repair carries our 90-day warranty on parts and labor.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Wolf service across Southern California</h2>
      <p>Ten branches cover Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties. Tell us your city, model and serial when you call, and we route the nearest technician with the right parts.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Wolf service questions</h2>
      {faqs.map((f) => (
        <details class="faq faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Wolf service?</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 28px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .scope-list { margin: 20px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); }
  .scope-list a { color: var(--red); text-decoration: underline; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .bottom-cta .hero-ctas { justify-content: center; }

  /* What-we-repair route block (mirrors the symptom-route cards on /commercial/ pages) */
  .wwr { padding: 40px 24px 48px; background: #fff; border-bottom: 1px solid var(--border); }
  .wwr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-top: 18px; }
  .wwr-card { display: block; padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; background: #fff; text-decoration: none; color: inherit; transition: border-color .2s; }
  .wwr-card:hover { border-color: var(--red); }
  .wwr-card strong { display: block; font-size: 15px; color: var(--black); margin-bottom: 4px; }
  .wwr-card span { display: block; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .section a { color: var(--red); }
</style>
</Layout>
