---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Wolf Appliance Repair Los Angeles — Same Day";
const description = "Wolf appliance repair in Southern California: dual-fuel ranges, sealed-burner rangetops, M Series wall ovens, induction. Factory-trained. $89 diagnostic.";

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/wolf/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/wolf/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "CSLB C-20 HVAC", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Contractors State License Board" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "BBB Accredited Business", "recognizedBy": { "@type": "Organization", "name": "Better Business Bureau" } } ],
    "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Are you Wolf Factory-Certified?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We're an independent repair service, not a Sub-Zero/Wolf/Cove Factory-Certified contractor. Our technicians are factory-trained on Wolf platforms, dual-stacked sealed burners, spark ignition modules, DF/GR series oven architecture, M Series wall ovens, ICBCT Freedom Induction. If your Wolf is still under the 2-year warranty, call Sub-Zero/Wolf customer service at 1-800-222-7820 first, they'll dispatch a Factory-Certified contractor at no parts cost. For post-warranty work, we're usually faster and cost less."
        }
      },
      {
        "@type": "Question",
        "name": "Does Wolf make refrigerators, dishwashers, or laundry?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Wolf is a cooking-only brand, ranges, rangetops, cooktops, wall ovens, steam ovens, warming drawers, and range hoods. Refrigeration in the Sub-Zero/Wolf/Cove group is handled by Sub-Zero; dishwashers by Cove. For Sub-Zero refrigerator repair see our Sub-Zero brand page; for Cove dishwasher repair see the Cove page. Wolf has never produced washers or dryers, for laundry we service Miele, Bosch, LG, Samsung, Whirlpool, Speed Queen, Asko."
        }
      },
      {
        "@type": "Question",
        "name": "Do you stock Wolf parts?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Common wear parts for Wolf ranges, rangetops, and wall ovens are on our trucks, spark ignition modules, surface igniters, oven temperature sensors, bake and broil elements (DF Series), door gaskets, convection fan motors, the signature red control knobs. Less common parts, main control boards, induction inverter modules on ICBCT cooktops, infrared charbroiler elements, come next-day from Sub-Zero/Wolf parts distribution. Most jobs finish first visit."
        }
      },
      {
        "@type": "Question",
        "name": "How much does Wolf repair cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Diagnostic is $89 and it's waived when you book the repair. Typical jobs: spark ignition module $285–$425, surface igniter $185–$275, oven temperature sensor $155–$225, bake element (DF Series) $215–$310, door gasket $245–$380, convection fan motor $340–$460, main control board $520–$780, ICBCT induction inverter $720–$1,050. Labor and parts quoted before we start."
        }
      },
      {
        "@type": "Question",
        "name": "What are the error codes F1, F2, F3, and F9 on my Wolf range or oven?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "F1/E1 is an open-circuit temperature sensor, the control can't read the cavity temperature, usually failed sensor or damaged harness. F2/E2 is a temperature runaway, cavity reading higher than set point, can be sensor drift or a stuck relay on the control board. F3/E3 is a shorted temperature sensor, similar root cause as F1 but shorted instead of open. F9 is the door latch motor, usually self-clean cycle engaged the latch and can't release, or the latch motor has failed. We diagnose the root cause before swapping parts, 50% of F-codes resolve to sensor or harness issues, not board replacement."
        }
      },
      {
        "@type": "Question",
        "name": "Why won't my Wolf range burner or oven light?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On a Wolf range, a burner or oven that won't light is most often an ignition fault. On the dual-stacked sealed surface burners, the spark ignition module ($285–$425) drives the spark, and a worn surface igniter ($185–$275) is the common per-burner failure; a burner that clicks but won't light, or won't click at all, points to one of those. On the oven side, a gas igniter that has weakened can't draw enough current to open the safety gas valve, so the oven won't fire. Our techs at Same Day Appliance Repair check the igniter, the ignition module, and the gas supply before quoting, and clean the burner ports since grease and spillover are a frequent no-parts cause. $89 residential diagnostic, waived with repair."
        }
      },
      {
        "@type": "Question",
        "name": "Why won't my Wolf oven heat or hold temperature?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On a Wolf oven that won't heat or won't hold temperature, the usual causes are a burned-out bake or broil element on DF-Series dual-fuel models ($215–$310) and a drifted oven temperature sensor ($155–$225) when the oven runs hot, cold, or uneven. A drifted or failed sensor also shows up as an F1, F2, or F3 error code, and our techs at Same Day Appliance Repair diagnose the root cause first — about half of those F-codes are a sensor or harness rather than a control board. On convection models a failed convection fan motor ($340–$460) produces poor even-baking. We test the element, sensor, and fan before quoting. $89 residential diagnostic, waived with repair."
        }
      }
    ]
  }
,
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/wolf/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="wolf"
    section="brands"
    eyebrow="Wolf Appliance Service · Dual-Fuel + Gas Range + Rangetop + Wall Oven + Cooktop · LA Estate Home Repair · Same Day"
    title="Wolf Appliance Repair"
    subtitle="Factory-trained service for Wolf dual-fuel ranges, all-gas ranges, sealed-burner rangetops, M Series and E Series wall ovens, ICBCT Freedom Induction cooktops. Same-day dispatch across LA, OC, and Ventura counties. Most calls close first visit."
    heroImageTitle="Wolf Appliance Repair"
    showBranches={true}
  />

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">About the brand</p>
      <h2>Wolf is a cooking brand. We service the cooking-only side.</h2>
      <p><strong>When a Wolf range or oven fails in an LA estate kitchen, our techs at Same Day Appliance Repair trace it to a handful of repeat patterns: a burner that won't light (spark ignition module $285–$425, surface igniter $185–$275); an oven that won't heat or hold temperature (DF-Series bake element $215–$310, oven temperature sensor $155–$225); and the F1/F2/F3 temperature-sensor error codes, which resolve to a sensor or harness about half the time rather than a board.</strong> Door gaskets ($245–$380), convection fan motors ($340–$460), and on Freedom Induction the ICBCT inverter ($720–$1,050) round out the calls; a main control board ($520–$780) is the higher-end case. We're the post-warranty independent specialist (Wolf carries a 2-year warranty — call 1-800-222-7820 first if still covered) across Bel Air, Beverly Hills, Malibu, Newport Coast, and Westlake Village. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</p>
      <p class="intro-speakable">Wolf is part of the Sub-Zero Group, Sub-Zero for refrigeration, Wolf for cooking, Cove for dishwashers. Unlike Thermador or Viking, Wolf doesn't make every category under one roof. It focuses on ranges, rangetops, cooktops, wall ovens, steam ovens, warming drawers, and ventilation. That focus shows up in the engineering: dual-stacked sealed burners that go from 20,000 BTU down to a true simmer, infrared charbroilers on premium rangetops, a cast-iron continuous grate system, signature red control knobs with infinite adjustment.</p>
      <p>Across Southern California, Wolf owners are concentrated where you'd expect, Bel Air, Beverly Hills, Brentwood, Pacific Palisades, Malibu, and Holmby Hills on LA's Westside; Newport Coast, Pelican Hill, and Shady Canyon along the OC coast; Calabasas, Hidden Hills, and Westlake Village in the Conejo Valley; the La Cañada and Pasadena foothills in the San Gabriel Valley; and the Temecula wine-country and Rancho Cucamonga estate kitchens in the Inland Empire. These kitchens were typically specified together: a Wolf Pro range or rangetop paired with a Sub-Zero column refrigerator and a Cove dishwasher, all installed by the same designer-builder team. That means when the Wolf needs service, it's part of an integrated Sub-Zero/Wolf/Cove system that was planned and installed once. Service has to respect that, no cabinetry damage, no workarounds, the job done right the first time.</p>
      <p>One thing worth saying clearly: if your Wolf is still inside the 2-year factory warranty, call Sub-Zero/Wolf customer service at <strong>1-800-222-7820</strong>. They'll dispatch a Factory-Certified contractor at no parts cost to you. We're the right call after the warranty expires, when the Factory-Certified dispatch window doesn't fit your schedule, or when the warranty tech has been out twice and the problem is back.</p>

      <p>Across the Wolf calls our techs run in LA homes, the failures cluster in a consistent order. Ignition leads — spark ignition modules and surface igniters on the dual-stacked sealed burners are the most frequent Wolf calls — followed by oven-heat faults (bake/broil element, temperature sensor) and the F-code sensor errors. Door gaskets and convection fan motors come next, then control boards and, on Freedom Induction cooktops, the inverter module. The board and inverter are the higher-ticket, less-frequent repairs we reach last.</p>
    </div>
  </section>

  <!-- ── CATEGORIES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Wolf categories we service</h2>
      <div class="cat-grid">
        <a href="/brands/wolf-range-repair/" class="cat-card">
          <h3>Wolf Range Repair</h3>
          <p>Dual-fuel DF Series (DF486G, DF366, DF304), all-gas GR Series, Pro stoves. Dual-stacked sealed burners, spark ignition modules, oven elements and thermostats. The heart of the Wolf lineup.</p>
          <span class="cat-cta">View range repair →</span>
        </a>
        <a href="/brands/wolf-oven-repair/" class="cat-card">
          <h3>Wolf Oven Repair</h3>
          <p>M Series and E Series wall ovens, Wolf Steam Oven (SO), convection and speed ovens. Door gaskets, convection fans, temperature sensors, control boards, steam generator service.</p>
          <span class="cat-cta">View oven repair →</span>
        </a>
        <a href="/brands/wolf-cooktop-repair/" class="cat-card">
          <h3>Wolf Cooktop Repair</h3>
          <p>CT Series gas sealed-burner cooktops, ICBCT Freedom Induction full-surface. Spark modules, induction inverters, touch control glass, thermal protection systems.</p>
          <span class="cat-cta">View cooktop repair →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── WHAT WOLF DOESN'T MAKE ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Scope honesty</p>
      <h2>What Wolf doesn't make, and where to go</h2>
      <p>Wolf is cooking-only. A few categories come up in searches because customers assume the brand covers everything under one roof. Here's the reality:</p>
      <ul class="scope-list">
        <li><strong>Refrigerators</strong>, Wolf doesn't make them. The matching brand in the Sub-Zero Group is Sub-Zero itself. If you have a Sub-Zero column or built-in, see our <a href="/brands/sub-zero-refrigerator-repair/">Sub-Zero repair page</a>.</li>
        <li><strong>Dishwashers</strong>, handled by Cove, the third brand in the Sub-Zero Group. See our <a href="/brands/cove/">Cove dishwasher repair page</a>.</li>
        <li><strong>Washers and dryers</strong>, Wolf has never made laundry. If you're trying to match a Wolf-based kitchen with a laundry brand, Miele and Bosch are the closest premium options. We service both.</li>
        <li><strong>Microwaves</strong>, Wolf makes a drop-in Convection Microwave (MDD30) and drawer models (MD30). These fall under <a href="/brands/wolf-oven-repair/">Wolf oven repair</a> since they share control architecture. Standalone microwaves aren't part of the Wolf lineup.</li>
        <li><strong>BBQ and outdoor grills</strong>, Wolf made outdoor grills historically, but the current focus is indoor cooking. For outdoor grill repair see our <a href="/services/bbq-grill-repair/">BBQ grill repair page</a>, we cover Viking, Hestan, Lynx, DCS, Fire Magic, Weber, and others.</li>
      </ul>
    </div>
  </section>

  <!-- ── WHY WOLF IS DIFFERENT ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Engineering differences</p>
      <h2>What makes Wolf service different from Thermador, Viking, or Miele</h2>
      <p>Three things matter on every Wolf service call, and they're different from how other luxury cooking brands work.</p>
      <p><strong>Dual-stacked burner architecture.</strong> A Wolf sealed burner is actually two burners in one, an upper high-output tier (up to 20,000 BTU) and a lower simmer tier (down to a true 500 BTU melt). Each tier has its own orifice and spark electrode. When a Wolf burner has ignition trouble, it's almost always on one tier while the other works fine. That means "my burner doesn't light" is actually "my high tier doesn't light" or "my simmer won't hold", two different diagnostic paths. Thermador's Star Burner, Viking's sealed burner, Miele's rapid burner, none work this way.</p>
      <p><strong>DF vs GR oven architecture.</strong> Wolf dual-fuel (DF Series) ovens use an electric bake element, same failure modes as an electric wall oven. Wolf all-gas (GR Series) ovens use a gas igniter with a hot surface element, different failure tree entirely. The single most important diagnostic step on a "Wolf oven won't heat" call is identifying which series you have before reaching for any part. We see shops swap igniters on DF ovens and bake elements on GR ovens, neither fixes anything.</p>
      <p><strong>Red knob tradition.</strong> The signature red infinite-adjustment control knobs are a Wolf brand marker going back decades. They're also a frequent service item, the click-stop detents wear, the shaft bushings loosen, and knobs lose their tactile feel. Replacement knob sets aren't cheap ($180–$240 per set) because they include the machined stainless bezel underneath. When we do control replacements, we match the knob batch to avoid color drift between old and new.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Wolf service across Southern California</h2>
      <p>Ten service territories cover all seven counties, Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego. Wolf concentration is highest in Westside LA, Newport Coast and Pelican Hill in OC, the Conejo Valley estate corridor (Westlake Village, Hidden Hills, Calabasas), the San Gabriel Valley foothills, and Temecula wine-country in the Inland Empire, those get same-day routing on calls before 1 PM weekday.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── CREDENTIALS ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Credentials</p>
      <h2>Licensed, insured, background-checked</h2>
      <p>Wolf builds cooking equipment, so the work on these units is gas, electric, and controls — there's no sealed refrigeration system in a Wolf range or wall oven. Every technician on our routes is background-checked and works under our registration with California's Bureau of Household Goods and Services, <strong>BHGS #A49573</strong>. We carry general liability and workers' comp. BBB Accredited since 2022.</p>
      <p>See the <a href="/credentials/">full credentials page</a> for verification links.</p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Wolf service questions</h2>

      <details class="faq">
        <summary>Are you Wolf Factory-Certified?</summary>
        <p>No, we're factory-trained but independent. Inside the 2-year warranty, call Sub-Zero/Wolf customer service at 1-800-222-7820 for Factory-Certified dispatch at no parts cost. After the warranty window, we're the better call: faster response, lower labor rate, same technical grade. Same platform training across Wolf cooking products.</p>
      </details>

      <details class="faq">
        <summary>How fast can you come out?</summary>
        <p>Same-day when you call before 1 PM on a weekday in regular coverage. Weekend appointments available with priority dispatch. For a dead Wolf range with a dinner party Saturday, call and say so, we rearrange routing for emergencies.</p>
      </details>

      <details class="faq">
        <summary>Do you carry Wolf parts?</summary>
        <p>Common wear parts on the truck: spark ignition modules, surface igniters, temperature sensors, bake/broil elements (DF Series), door gaskets, convection fan motors, red control knob sets. Less common parts, control boards, ICBCT induction inverters, infrared charbroiler elements, come next-day from Sub-Zero/Wolf distribution. Lead times quoted upfront.</p>
      </details>

      <details class="faq">
        <summary>Does Wolf make refrigerators, dishwashers, or laundry?</summary>
        <p>No. Wolf is cooking-only. In the Sub-Zero Group, refrigeration is Sub-Zero and dishwashers are Cove. Wolf has never made laundry. For full-kitchen service we work on all three brands plus Miele and Bosch laundry, see the brand pages for Sub-Zero and Cove.</p>
      </details>

      <details class="faq">
        <summary>What does error F1, F2, F3, or F9 mean on my Wolf range?</summary>
        <p>F1/E1 = open-circuit temperature sensor. F2/E2 = temperature runaway (sensor drift or stuck relay). F3/E3 = shorted temperature sensor. F9 = door latch motor, usually from self-clean cycle. 50% of F-codes resolve to sensor or harness issues, not board replacement. We diagnose root cause before parts.</p>
      </details>

      <details class="faq">
        <summary>Why won't my Wolf range burner or oven light?</summary>
        <p>Usually an ignition fault. On the sealed surface burners, the spark ignition module ($285–$425) drives the spark and a worn surface igniter ($185–$275) is the common per-burner failure. On the oven, a weak gas igniter can't open the safety valve, so it won't fire. Our techs check the igniter, module, and gas supply, and clean the burner ports since grease and spillover are a frequent no-parts cause. $89 diagnostic, waived with repair.</p>
      </details>

      <details class="faq">
        <summary>Why won't my Wolf oven heat or hold temperature?</summary>
        <p>Usually a burned-out bake/broil element on DF-Series models ($215–$310) or a drifted oven temperature sensor ($155–$225) when the oven runs hot, cold, or uneven — the same sensor that throws F1/F2/F3 codes, which are a sensor or harness about half the time, not a board. On convection models a failed convection fan motor ($340–$460) causes poor even-baking. We test element, sensor, and fan before quoting. $89 diagnostic, waived with repair.</p>
      </details>

      <details class="faq">
        <summary>My Wolf burner won't stop clicking after it lights</summary>
        <p>Two causes. Most common: moisture in the spark electrode area from cleaning or a boil-over, dries out on its own, or we clean and dry the electrode. Second: failed spark module that's stuck sending spark even after flame sense. Module replacement $285–$425. LA coastal humidity makes the moisture issue more common than inland, Malibu and Pacific Palisades see it most often.</p>
      </details>
      <details class="faq" data-tag="manufacturer-resource-faq">
        <summary>Where can I find the official Wolf manual or warranty information?</summary>
        <p>Our technicians work independently of Wolf's factory service network - we're often faster and available same-day in Southern California.</p>
      </details>
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Wolf service?</h2>
      <p>Same day available. $89 diagnostic, waived with repair. Labor and parts quoted before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 28px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .scope-list { margin: 20px 0; padding-left: 20px; }
