---
// Phase 2 Cluster 4 #3 — Wine Enthusiast wine cooler pillar.
// Brand: Wine Enthusiast Companies, NY, founded 1979. Started as wine
// accessories catalog, expanded to wine coolers. Dual-tier reality:
// Silent Series (thermoelectric) + Classic Wood Series + VinoView (premium
// $1500-3000) PLUS entry-tier mass-market disposable. Honest tier split.
// Critical technical angle: Silent Series uses thermoelectric Peltier
// modules (no compressor) — different repair approach than typical
// compressor wine coolers.
// Residential pricing ($89). NEW schema pattern via mergeCredentials().

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const phone = '(323) 870-4790';
const phoneRaw = phone.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/brands/wine-enthusiast-wine-cooler/";

const title = "Wine Enthusiast Wine Cooler Repair LA — Same Day";
const description = "Wine Enthusiast wine cooler repair across LA. Silent Series thermoelectric, Classic Wood, VinoView. Premium tier vs entry-tier honest split. EPA 608, $89 dx.";

const faqs = [
  { q: "Is my Wine Enthusiast cooler the premium tier or the entry-tier?", a: "Critical question, and the answer changes the repair-vs-replace math significantly. Silent Series (thermoelectric quiet operation, $800-1800 retail), Classic Wood Series (premium hardwood-front cabinets, $1500-3000 retail), and VinoView Series (luxury display configurations, $1200-2500 retail) are the premium tier — repair almost always makes sense, even on 8+ year-old units. Entry-tier Wine Enthusiast wine coolers ($300-500 retail, often distributed through warehouse clubs or Amazon) — replacement usually wins the math, even on repairs under $200, because the unit's remaining service life expectancy is short. We identify your specific Series during the diagnostic by model number and frame the math honestly before you commit to anything. The brand markets itself as single tier; the underlying reality is two-tier with very different service equations." },
  { q: "How does Silent Series repair differ from typical wine coolers?", a: "Silent Series uses thermoelectric Peltier module cooling instead of conventional compressor refrigeration. No compressor, no refrigerant, no EPA 608 work — entirely different system. The Peltier modules are solid-state heat pumps that move heat from inside the cabinet to outside through the temperature differential. Failure modes are different: Peltier module degradation over 10+ years, heat-sink fan motor wear, controller board fade. The diagnostic approach is electrical and thermal rather than refrigeration. Service life of Silent Series typically 10-15 years; replacement Peltier modules and fan assemblies are sourceable through Wine Enthusiast parts. The trade-off is quiet operation (no compressor noise — Silent Series is genuinely quiet) at the cost of thermal capacity (works best with smaller cabinets and moderate ambient temperature)." },
  { q: "Same-day Wine Enthusiast service in LA?", a: "Yes for diagnostic and most common repairs. Most calls received before 2 PM get a tech on-site the same business day. Common service items — door gaskets, condenser fan motors (compressor units), Peltier modules and heat-sink fans (Silent Series), control boards, and cabinet door seals — typically ride on the truck for premium-tier configurations. Less common items may add 1-5 business days for parts ordering through Wine Enthusiast parts distribution." },
  { q: "Do you carry Wine Enthusiast OEM parts on the truck?", a: "Common service parts for premium-tier units ride on every wine cooler truck: door gaskets in standard configurations, evaporator and condenser fan motors for compressor models, common control board components, and Peltier module replacements for Silent Series. Premium-specific items — Classic Wood Series cabinet hardware, VinoView display configurations parts — come through Wine Enthusiast parts distribution, typically 1-7 business days. Entry-tier mass-market parts: typically not stocked because we don't recommend repair on those units anyway (replacement math wins). We confirm availability before scheduling labor." },
  { q: "What's your diagnostic fee for Wine Enthusiast?", a: "$89 residential diagnostic, waived when you approve the repair. The diagnostic covers tier identification (Silent / Classic Wood / VinoView / entry-tier), full system assessment (refrigerant work under EPA 608 for compressor models, electrical/thermal for Silent Series), door seal integrity, exterior cabinet condition, and a written quote with parts cost, labor estimate, and realistic timeline before any work begins. Tier identification is the first step and shapes everything else." },
  { q: "Is Classic Wood Series worth the premium over standard wine coolers?", a: "For aesthetic value, yes — Classic Wood Series cabinets are real hardwood with premium finishes, and the build quality reads as furniture rather than appliance. The cabinet itself is durable and outlasts the cooling unit inside (similar to Le Cache cabinet philosophy). For service value: Classic Wood is repairable as a cabinet (door alignment, gasket replacement, finish maintenance) and serviceable as cooling system (compressor, fan motors, control board). The combined service-life expectation runs 12-18 years with maintenance — meaningfully longer than entry-tier alternatives. Repair value math typically favors repair on Classic Wood units under 12 years old. Past that, depending on extent of failure and cabinet condition, replacement consideration begins." }
];

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org', '@type': 'HomeAndConstructionBusiness', '@id': canonical + '#business',
  name: 'Same Day Appliance Repair',
  url: canonical, telephone: phone, email: 'support@samedayappliance.repair', priceRange: '$$',
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'], opens: '08:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '00:00', closes: '00:00' }
  ],
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' }, { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' }, { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL

});

const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', '@id': canonical + '#service',
  serviceType: 'Wine Enthusiast Wine Cooler Repair',
  name: 'Wine Enthusiast Wine Cooler Repair, Same Day Appliance Repair',
  url: canonical,
  description: 'Same-day Wine Enthusiast wine cooler repair across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties. Silent Series (thermoelectric Peltier), Classic Wood Series (premium hardwood cabinets), VinoView Series (luxury display), and entry-tier consumer line. Honest tier-identification and repair-vs-replace math during diagnostic. EPA 608 Universal certified (#1346255700410), BHGS #A49573, CSLB C-20 HVAC. $89 residential diagnostic, applied toward repair.',
  provider: { '@id': canonical + '#business' },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' }, { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' }, { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  brand: { '@type': 'Brand', name: 'Wine Enthusiast', sameAs: 'https://www.wineenthusiast.com/' },
  offers: { '@type': 'Offer', priceSpecification: { '@type': 'PriceSpecification', price: '89.00', priceCurrency: 'USD', description: 'Residential diagnostic fee, applied toward repair' } }
};

const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://samedayappliance.repair/' },
  { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://samedayappliance.repair/brands/' },
  { '@type': 'ListItem', position: 3, name: 'Wine Enthusiast', item: canonical }
]};
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": canonical,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
  }
};
const schemaJsons = [localBusinessSchema, serviceSchema, faqSchema, breadcrumbSchema, speakableSchema];
---

<Layout title={title} description={description} canonical={canonical}>
<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  logoSlug="wine-enthusiast"
  section="brands"
  slug="wine-enthusiast-wine-cooler"
  eyebrow="Wine Cooler · Premium + Mass-Market Dual Tier"
  title="Wine Enthusiast Wine Cooler Repair, Across Southern California"
  subtitle="Silent Series thermoelectric · Classic Wood Series premium hardwood · VinoView luxury display, plus entry-tier consumer. Honest tier identification and repair-vs-replace math during diagnostic. EPA 608 Universal certified, BHGS #A49573. $89 residential diagnostic, waived with repair."
  heroImageTitle="Wine Enthusiast Wine Cooler Repair"
  showBranches={true}
/>

<section class="section">
  <div class="container narrow">
    <p class="section-number">01, About this service</p>
    <h2>The dual-tier wine cooler brand with distinct service equations</h2>
    <p class="intro-speakable">
      Wine Enthusiast Companies started in 1979 as a wine accessories catalog — corkscrews, decanters, glassware, storage
      accessories — and evolved into a wine cooler manufacturer over the following decades. The brand carries a unique
      structural reality in the wine cooler category: it operates simultaneously at two distinct tiers with very different
      service value equations. Premium-tier offerings (Silent Series thermoelectric, Classic Wood Series premium hardwood,
      VinoView Series luxury display) compete with serious wine cooler brands in the $1500-3000 retail range and serve serious
      Beverly Hills and Bel Air wine collectors. Entry-tier mass-market offerings ($300-500 retail) compete with warehouse-club
      and Amazon wine coolers. The brand markets itself as a single Wine Enthusiast experience; the service reality is two
      different conversations.
    </p>
    <p>
      Pricing structure: $89 residential diagnostic, waived when you approve the repair. EPA 608 Universal certified for
      refrigerant work on compressor models, BHGS Registration #A49573, CSLB C-20 HVAC. The first thing we do during the
      diagnostic is identify which tier and which series your specific Wine Enthusiast unit is — that determines the
      repair-vs-replace math and the entire service approach.
    </p>
  </div>
</section>

<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">02, Series and product coverage</p>
    <h2>What we service across the Wine Enthusiast lineup</h2>

    <h3>Silent Series — thermoelectric premium</h3>
    <p>
      Wine Enthusiast's thermoelectric line — uses Peltier solid-state heat pumps instead of conventional compressor
      refrigeration. No compressor, no refrigerant. The trade-off is genuinely quiet operation (the brand name accurately
      describes the experience — Silent Series is the quietest wine cooler in most LA homes) at the cost of thermal capacity
      (works best with smaller cabinets and moderate ambient temperature). Service approach is electrical and thermal — Peltier
      module diagnostics, heat-sink fan motor service, controller board work. Different parts catalog than compressor models.
      Service life typically 10-15 years with good operating environment.
    </p>

    <h3>Classic Wood Series — premium hardwood cabinets</h3>
    <p>
      Real hardwood cabinetry — cherry, walnut, oak depending on the specific model — built to look like furniture rather
      than appliance. Common in LA dining rooms, home libraries, and open-plan kitchen integrations where the wine cooler
      doubles as a furniture piece. Capacity varies by configuration; typical range 30-150 bottles. The cabinet itself is
      durable and outlasts the cooling unit inside (similar to Le Cache philosophy). Service items include cabinet hardware
      (hinges, latches, finish protection during access), gasket replacement, and cooling system service (compressor, fan
      motors, control board). Combined service life expectation 12-18 years with maintenance.
    </p>

    <h3>VinoView Series — luxury display</h3>
    <p>
      Wine Enthusiast's luxury display configurations — large glass front doors, premium lighting, and often specialty shelving
      designed to showcase the wine collection visually. Common in design-forward homes and high-end residential wine bars.
      Capacity varies. Service approach is conventional wine cooler diagnostic with extra care on the glass-front display
      panel and premium lighting components.
    </p>

    <h3>Entry-tier consumer wine coolers</h3>
    <p>
      Mass-market line — distributed through warehouse clubs, Amazon, and big-box retail. Build quality matches the price
      point ($300-500 retail). We service these but frame the repair-vs-replace math honestly during the diagnostic — for
      entry-tier units, replacement usually wins the math decision over significant repair costs because remaining service
      life expectancy is short and the unit's residual value low. The fairest approach is to identify the tier first and tell the
      customer what they have before they commit to parts cost.
    </p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <p class="section-number">03, Common failure patterns</p>
    <h2>What we look at first on a Wine Enthusiast call</h2>
    <ul class="bullet-list">
      <li><strong>Tier identification — first step, every time.</strong> Silent Series, Classic Wood, VinoView, or entry-tier? The diagnostic identifies this by model number and serial-plate verification before anything else, because the service approach diverges meaningfully between tiers and technologies (thermoelectric vs compressor).</li>
      <li><strong>Silent Series — Peltier module degradation after 10+ years.</strong> Thermoelectric cooling efficiency reduces gradually as Peltier modules age. Symptom is cabinet temperature drift — unit can't quite hold setpoint, especially in warmer ambient conditions. Diagnostic is electrical and thermal rather than refrigeration. Replacement Peltier modules sourced through Wine Enthusiast parts.</li>
      <li><strong>Silent Series — heat-sink fan motor wear.</strong> The fan motor moving air across the heat-sink on the warm side of the Peltier module wears with use. Symptom is similar to Peltier degradation but distinguishable on diagnostic. Replacement motors stocked for common configurations.</li>
      <li><strong>Classic Wood + VinoView (compressor models) — condenser fouling.</strong> LA dust environment fous condensers at typical 6-8 week intervals on units in busy kitchens or dining rooms. Symptom is unit running constantly with warm cabinet. About 30% of "not cooling" calls on these series resolve at condenser cleaning, no parts needed.</li>
      <li><strong>Door gasket compression set after 5-7 years.</strong> Common across all tiers. Symptom is icing on the evaporator from moisture infiltration or unit struggling to hold setpoint. Replacement gaskets stocked for common configurations across Silent / Classic Wood / VinoView Series.</li>
      <li><strong>Control board fade after 8-12 years.</strong> Newer units with digital displays and electronic temperature controls show capacitor aging. Symptom is intermittent display issues or setpoint drift. Diagnostic confirms before swap; we don't replace control boards on suspicion.</li>
      <li><strong>Cabinet door alignment drift on Classic Wood.</strong> Heavy hardwood doors cycle thousands of times over the life of the cabinet and hinges develop play. Symptom is door not closing cleanly to gasket, leading to seal failure. Hinge adjustment or replacement restores alignment.</li>
    </ul>
  </div>
</section>

<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">04, Where we work most on Wine Enthusiast</p>
    <h2>The LA Wine Enthusiast footprint our techs know best</h2>
    <p><strong>Beverly Hills wine collector homes — premium tier deployments.</strong> Silent Series, Classic Wood Series, and VinoView Series in serious residential wine collector homes. The serious collectors who chose Wine Enthusiast specifically for quiet operation (Silent Series) or for cabinet aesthetics (Classic Wood, VinoView). Service approach standard residential — careful access, surrounding architecture protection, customer-specific scheduling.</p>
    <p><strong>Bel Air and Pacific Palisades home libraries and dining rooms.</strong> Classic Wood Series and VinoView in design-forward home builds where the wine cooler is part of the room aesthetic. Service work respects the surrounding furnishings.</p>
    <p><strong>Hollywood Hills and Studio City modern homes — Silent Series in kitchen integrations.</strong> Silent Series's quiet operation is valued in open-plan kitchen and living designs where compressor noise would be objectionable. Common LA market segment.</p>
    <p><strong>Entry-tier mass-market deployments across all LA areas.</strong> Apartment kitchens, smaller condo installations, secondary residences. Honest framing on repair-vs-replace math; we don't waste customer money pushing repairs on disposable units.</p>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <p class="section-number">05, Recent repairs</p>
    <h2>What this month looked like on Wine Enthusiast</h2>
    <div class="repair-cards">
      <div class="repair-card">
        <p class="repair-quote">"Silent Series getting warmer over time, can't hold cellar temp anymore."</p>
        <p>Beverly Hills home, Silent Series thermoelectric wine cooler, install year per the homeowner approximately 2014. Diagnostic confirmed Peltier module degradation — cooling output measurably reduced from spec on load test. Sourced replacement Peltier modules and heat-sink fan assembly through Wine Enthusiast parts distribution (5 business days). Returned for install on second visit, replaced affected modules, calibrated thermal output, ran cabinet pull-down test for two hours. The homeowner specifically chose Silent Series for the quiet operation in open-plan living area — repair restored the original quiet operation plus full cooling capacity.</p>
      </div>
      <div class="repair-card">
        <p class="repair-quote">"Classic Wood door isn't sealing properly, condensation on the bottom panel."</p>
        <p>Pacific Palisades home, Classic Wood Series freestanding wine cooler in dining room, install year per the homeowner approximately 2017. Diagnostic confirmed two issues: door gasket compression set on the bottom seal (replaceable) and hinge alignment drift (adjustable). Replaced gasket with OEM Wine Enthusiast part, adjusted bottom hinge for proper door-to-gasket contact, verified seal integrity around the full perimeter. The Classic Wood cabinet itself was in excellent condition — homeowner specifically valued the furniture-grade aesthetics, and careful service approach preserved the finish.</p>
      </div>
      <div class="repair-card">
        <p class="repair-quote">"VinoView display unit stopped cooling, and my visible wine collection is at risk."</p>
        <p>Bel Air home, VinoView Series large glass-front display unit, install year per the homeowner approximately 2018. Diagnostic ran condenser first (heavily fouled — open-plan kitchen environment with visible wine display attracts dust faster than typical wine cooler installations), then verified refrigerant charge (within spec), then re-tested. Coil clean alone dropped cabinet temperature from 65°F to 56°F within two hours. Recommended quarterly cleaning contract (especially relevant for display-style installations); homeowner committed.</p>
      </div>
    </div>
  </div>
</section>

<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06, Why us, specifically</p>
    <h2>What makes us a fit for Wine Enthusiast service</h2>
    <ul class="bullet-list">
      <li><strong>Honest tier identification and repair-vs-replace math.</strong> Silent / Classic Wood / VinoView (premium tier) vs entry-tier — completely different service equations. We identify your unit and frame the math before you commit to anything.</li>
      <li><strong>Thermoelectric Silent Series experience.</strong> Different repair approach than compressor wine coolers — Peltier module diagnostics, heat-sink fan service, controller work. Many appliance shops don't service thermoelectric wine coolers; we do.</li>
      <li><strong>EPA 608 Universal certification (#1346255700410).</strong> Required for refrigerant work on Classic Wood and VinoView (compressor models). Silent Series is electrical-only — no EPA scope, but we have it for the rest of the lineup.</li>
      <li><strong>BHGS Registration #A49573 plus CSLB C-20 HVAC.</strong> California state coverage.</li>
      <li><strong>Wine Enthusiast OEM parts only on premium tier.</strong> No aftermarket substitutions on Silent Series Peltier modules, Classic Wood cabinet hardware, or VinoView display components.</li>
      <li><strong>$89 residential diagnostic, waived with repair.</strong> Tier identification is the first thing we do, and we tell the customer the math honestly before any commitment.</li>
      <li><strong>BBB Accredited Business and $1M general liability insured.</strong></li>
    </ul>
  </div>
</section>

<section class="section">
  <div class="container narrow">
    <p class="section-number">07, Frequently asked questions</p>
    <h2>The questions we get most on Wine Enthusiast calls</h2>
    <div class="faq-list">
      {faqs.map(f => (<details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
  </div>
</section>

<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08, Other wine cooler brands we cover</p>
    <h2>Wine Enthusiast service in context</h2>
    <ul class="cross-links">
      <li><a href="/brands/eurocave/">EuroCave wine cellars</a> — French luxury alternative</li>
      <li><a href="/brands/le-cache/">Le Cache wine cabinets</a> — American hardwood specialist</li>
      <li><a href="/brands/vinotemp/">Vinotemp wine cooler + cellar</a> — California specialty company</li>
      <li><a href="/brands/summit-wine-cooler/">Summit wine cooler</a> — commercial-grade Felix Storch</li>
      <li><a href="/brands/whisperkool/">WhisperKool wine cellar cooling</a></li>
      <li><a href="/brands/cellarpro/">CellarPro wine cellar cooling</a></li>
      <li><a href="/brands/breezaire/">Breezaire wine cellar cooling</a></li>
      <li><a href="/services/wine-cooler-repair/">Wine cooler repair (all brands)</a></li>
    </ul>
  </div>
</section>

<section class="bottom-cta">
  <div class="container narrow">
    <h2>Same-day Wine Enthusiast service across Southern California</h2>
    <p>$89 residential diagnostic, waived with repair. EPA 608 Universal certified, BHGS #A49573, CSLB C-20 HVAC, BBB Accredited.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-red">Call {phone}</a>
      <a href="/contact/" class="btn-outline">Request service →</a>
    </div>
  </div>
</section>
</Layout>

<style>
  .section { padding: 64px 24px; }
  .section-gray { background: var(--gray); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .container.narrow { max-width: 820px; margin: 0 auto; }
  .section-number { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin: 0 0 12px; }
  h2 { font-size: clamp(22px, 3vw, 32px); font-weight: 700; line-height: 1.2; margin: 0 0 20px; color: var(--text); letter-spacing: -.01em; }
  h3 { font-size: 18px; font-weight: 700; margin: 24px 0 10px; color: var(--text); }
  p { font-size: 16px; line-height: 1.7; color: var(--text); margin: 0 0 14px; }
  strong { font-weight: 700; }
  a { color: var(--red); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .bullet-list { list-style: none; padding: 0; margin: 16px 0; }
  .bullet-list li { position: relative; padding: 12px 0 12px 22px; font-size: 15.5px; line-height: 1.65; border-bottom: 1px solid var(--border); }
  .bullet-list li:last-child { border-bottom: none; }
  .bullet-list li::before { content: "▸"; position: absolute; left: 0; color: var(--red); font-weight: 700; }
  .repair-cards { display: grid; gap: 20px; margin-top: 20px; }
  .repair-card { background: #fff; border: 1px solid var(--border); border-radius: 8px; padding: 22px 26px; }
  .repair-quote { font-style: italic; color: var(--red); font-weight: 600; margin: 0 0 12px; font-size: 15px; }
  .repair-card p:last-child { margin-bottom: 0; }
  .faq-list { margin-top: 20px; }
  .faq-item { border-bottom: 1px solid var(--border); padding: 16px 0; }
  .faq-item:last-child { border-bottom: none; }
  .faq-item summary { cursor: pointer; font-weight: 700; font-size: 16px; color: var(--text); padding: 4px 0; }
  .faq-item summary:hover { color: var(--red); }
  .faq-item p { margin: 12px 0 4px; font-size: 15.5px; color: var(--text); }
  .cross-links { list-style: none; padding: 0; margin: 16px 0 0; }
  .cross-links li { padding: 10px 0; border-bottom: 1px solid var(--border); font-size: 15px; }
  .cross-links li:last-child { border-bottom: none; }
  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.85); max-width: 640px; margin: 0 auto 24px; }
  .bottom-cta a { color: #fff; }
  .cta-row { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .btn-red { background: var(--red); color: #fff; padding: 14px 28px; border-radius: 6px; font-weight: 600; text-decoration: none; }
  .btn-outline { border: 1.5px solid rgba(255,255,255,.3); color: #fff; padding: 14px 28px; border-radius: 6px; font-weight: 600; text-decoration: none; }
</style>
