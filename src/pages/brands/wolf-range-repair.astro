---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, real case, FAQ from one array; boilerplate price table, warranty block and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Wolf Range Repair Los Angeles — Same Day";
const description = "Wolf range repair in Los Angeles: DF dual-fuel, GR all-gas and older pilot-light Wolf ranges. Burners, ignition, ovens. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/wolf-range-repair/";

const faqs = [
  { q: "Why does my Wolf burner keep clicking after it lights?", a: "Wolf spark ignition keeps sparking until it senses flame, and re-sparks if the flame goes out. Continuous clicking usually means moisture or grease at the electrode is stopping that sensing — very common right after cleaning — or the ignition switch on that burner's valve has shorted. Drying the burner fixes the first; the second is a switch replacement. The current Wolf switch (813398) supersedes the older 807141." },
  { q: "My Wolf burner won't hold a low simmer. What's wrong?", a: "Wolf sealed burners are dual-stacked: the lower tier is a separate simmer burner with its own orifice. If the simmer flame dies or is uneven while high heat works, the problem is in that lower tier — a partly blocked orifice or ports, or the valve's low setting — not the burner as a whole." },
  { q: "What's the difference between repairing a DF and a GR Wolf range?", a: "The burner tops are the same. The ovens are not: a DF dual-fuel oven is electric, so we check elements, the temperature probe and the oven control; a GR oven is gas, so a no-heat oven usually means an igniter that no longer gets hot enough to open the gas valve, or the valve itself." },
  { q: "Is an old Wolf range with standing pilots worth repairing?", a: "Usually yes. These ranges are mechanically simple and heavily built. Typical repairs are pilot burners, pilot tubing and oven thermocouples. Parts for older units can take time to source, so we identify them first and quote before ordering." },
  { q: "What do Err 00, 01 and 0E mean on a Wolf range?", a: "Err 00 means the control is in service mode, not failed. 01 means the self-clean door lock switch wasn't sensed in time, often a stuck latch. 0E means an oven power relay reads closed when it should be open, a control-level fault. Off-temperature baking usually shows no code at all; that is typically the temperature probe." },
  { q: "How much does Wolf range repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. An igniter typically runs $150–$240 and a Wolf oven temperature probe $180–$280; everything else is quoted in writing after the diagnostic. Repairs carry a 90-day warranty on parts and labor." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [
  {"place": "Santa Barbara", "unit": "older Wolf commercial-style gas range with standing pilots", "symptom": "The gas had been turned off and back on, and the pilot lights would not relight.", "found": "The oven thermocouple was worn out and the four open-top pilot burners and their pilot gas tubing needed replacing. Because of the range’s age, the correct parts had to be identified and sourced before the repair.", "done": "Replaced the oven thermocouple and the four open-top pilot burners with new pilot tubing; the range was put back in service."}
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Wolf Range Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Wolf", "item": "https://samedayappliance.repair/brands/wolf/" },
      { "@type": "ListItem", "position": 4, "name": "Range Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="wolf-range-repair"
    logoSlug="wolf"
    eyebrow={"Wolf · DF dual-fuel · GR gas"}
    title={"Wolf Range Repair in Los Angeles"}
    subtitle={"Burners that click and won’t light, a simmer that dies, ovens that won’t heat — on current DF and GR ranges and older pilot-light Wolfs."}
    heroImageTitle={"Wolf Range Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/wolf/">Wolf</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Range Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">How a Wolf range is built</p>
      <h2>Two burner tiers, spark re-ignition, and two kinds of oven</h2>
      <p>Current Wolf ranges use dual-stacked sealed burners: an upper ring for high heat and a separate lower ring for simmer, each fed through its own orifice. That is why a Wolf burner can roar on high and still hold a melt-butter flame on low — and why a burner problem is usually on one tier only. "Won't simmer" and "won't go high" are different repairs. Spark ignition re-lights a burner automatically if the flame is blown out, so the ignition system has more to sense than on an ordinary stove.</p>
      <p>Underneath, the oven depends on which range you own. A <strong>DF</strong> dual-fuel range has an electric oven — elements, convection, a temperature probe. A <strong>GR</strong> all-gas range has a gas oven with an infrared broiler, lit by an igniter and gas valve. And plenty of Southern California kitchens still have older Wolf commercial-style ranges with standing pilots and open burners, which are a different repair again.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Wolf range you have, and what tends to fail</h2>
      <p>The model and serial label is usually behind the kick panel at the bottom front or on the frame visible with the oven door open. Wolf revised parts across serial ranges, so the serial matters as much as the model.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>DF dual-fuel ranges</h3>
          <p class="model-list">DF304 · DF366 · DF364G · DF364C · DF484CG · DF486G · DF606CG</p>
          <p>Gas burners over an electric convection oven, 30 to 60 inches wide, with griddle (G) or infrared charbroiler (C) options. 48- and 60-inch models have two ovens.</p>
          <p class="fails"><strong>What we see fail:</strong> burner ignition switches and spark electrodes, the spark module, bake and broil elements, the oven temperature probe, the convection fan, self-clean latches.</p>
        </div>
        <div class="model-card">
          <h3>GR all-gas ranges</h3>
          <p class="model-list">GR304 · GR366 · GR364C · GR484CG · GR486G</p>
          <p>Same dual-stacked burner top, with a gas oven and infrared broiler. Common where there is no 240-volt circuit behind the range.</p>
          <p class="fails"><strong>What we see fail:</strong> the burner-side ignition parts above, plus oven ignition: an igniter that no longer gets hot enough to open the oven gas valve, and the valve itself.</p>
        </div>
        <div class="model-card">
          <h3>Older commercial-style Wolf ranges</h3>
          <p class="model-list">Standing-pilot, open-burner Wolf ranges</p>
          <p>Heavy, simple ranges that predate the current sealed-burner designs. No spark module — a small flame at each pilot lights the burners, and a thermocouple proves the oven pilot before gas flows.</p>
          <p class="fails"><strong>What we see fail:</strong> pilots that won't relight after the gas has been shut off, clogged pilot tubing, worn oven thermocouples. Parts take sourcing, but these ranges are very repairable.</p>
        </div>
        <div class="model-card">
          <h3>Rangetops and cooktops</h3>
          <p class="model-list">SRT sealed-burner rangetops · CG gas cooktops</p>
          <p>The same burner and ignition system without an oven underneath, usually paired with Wolf wall ovens.</p>
          <p class="fails"><strong>What we see fail:</strong> ignition switches, electrodes and spark modules. See our <a href="/brands/wolf-cooktop-repair/">Wolf cooktop repair</a> page.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What the range is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>One burner clicks but won't light</td><td>Burner cap seating, wet or dirty electrode, a blocked port, then that burner's electrode and ignition switch.</td></tr>
          <tr><td>No burner clicks at all</td><td>Power to the range and the spark module, which feeds every burner.</td></tr>
          <tr><td>Burner keeps clicking after it lights</td><td>Moisture or grease at the electrode stopping flame sensing, a shorted ignition switch on that valve, then the module.</td></tr>
          <tr><td>Simmer flame goes out, or high flame is weak</td><td>The lower (simmer) or upper orifice and ports of that burner — the two tiers fail separately.</td></tr>
          <tr><td>DF oven won't heat, or bakes off temperature</td><td>Bake element, the temperature probe (RTD), then the oven control relay.</td></tr>
          <tr><td>GR oven slow to heat or won't light</td><td>The oven igniter: a weak igniter glows but never gets hot enough to open the gas valve. Then the valve.</td></tr>
          <tr><td>Burners work, oven and display dead</td><td>Power to the oven circuit: a thermal cutoff, wiring and the oven control.</td></tr>
          <tr><td>Older Wolf: pilots won't stay lit</td><td>Pilot tubing and orifices, pilot adjustment, and the oven thermocouple.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── CODES AND PARTS ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Display codes and parts</p>
      <h2>Wolf range codes, and why we ask for the serial</h2>
      <ul class="scope-list">
        <li><strong>Err 00</strong> — the control is in service (diagnostic) mode, not a failure. If it appears by itself after a power event, cycling the breaker usually clears it.</li>
        <li><strong>01</strong> — the door lock or unlock switch wasn't sensed while the control drove the self-clean latch, often a stuck or heat-warped latch after a cleaning cycle.</li>
        <li><strong>0E</strong> — a power relay on the oven control reads closed when it should be open: the oven heats when it shouldn't or won't switch an element off. A control-level fault, confirmed against the wiring first.</li>
      </ul>
      <p>An oven that runs hot or cold usually shows no code at all; that is the temperature probe drifting, which we measure rather than guess. On parts: the current Wolf burner ignition switch (813398) supersedes the earlier 807141 and is shared across DF, GR and sealed-burner rangetops, and the oven temperature probe (815572) is shared with Wolf wall ovens. Wolf generally supersedes retired part numbers instead of dropping them, which is why even older sealed-burner ranges stay repairable.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Before you call</h2>
      <ul class="scope-list">
        <li><strong>After cleaning, let the burners dry.</strong> Water in the burner base is the most common reason for clicking that won't stop; give it a few hours with the caps off.</li>
        <li><strong>Reseat the caps.</strong> A cap sitting slightly off its base will click and not light, or light unevenly.</li>
        <li><strong>Check power.</strong> Even an all-gas range needs electricity for spark ignition; a DF oven also needs its 240-volt breaker on.</li>
        <li><strong>Older pilot range:</strong> if the gas was shut off, pilots must be relit by hand. If they won't stay lit after that, stop and call.</li>
        <li><strong>Smell gas?</strong> Turn the knobs off, leave the house and call the gas company first.</li>
      </ul>
    </div>
  </section>

  <!-- ── REAL JOBS (Fixar CRM, anonymized) ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">From our job log</p>
      <h2>Recent Wolf range jobs</h2>
      <p>Taken from our job records, with names and addresses removed.</p>
      {cases.map((c) => (
        <div class="case">
          <h3>{c.place} · {c.unit}</h3>
          <dl>
            <dt>What the owner reported</dt><dd>{c.symptom}</dd>
            <dt>What the technician found</dt><dd>{c.found}</dd>
            <dt>What was done</dt><dd>{c.done}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Igniter replacement on a range typically runs $150–$240, and a Wolf oven temperature probe (RTD) $180–$280. Spark modules, valves, elements and controls are quoted in writing after the diagnostic, once we have the model and serial.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Wolf's own service network — if your Wolf range is still inside its factory warranty, call Wolf first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Wolf service</p>
      <h2>Other Wolf repairs</h2>
      <div class="cat-grid">
        <a href="/brands/wolf/" class="cat-card">
          <h3>Wolf appliance repair (all products)</h3>
          <p>Every Wolf cooking line we work on.</p>
        </a>
        <a href="/brands/wolf-oven-repair/" class="cat-card">
          <h3>Wolf oven repair</h3>
          <p>M and E Series wall ovens, steam and speed ovens.</p>
        </a>
        <a href="/brands/wolf-cooktop-repair/" class="cat-card">
          <h3>Wolf cooktop repair</h3>
          <p>Gas and induction cooktops and rangetops.</p>
        </a>
        <a href="/brands/wolf-range-hood-repair/" class="cat-card">
          <h3>Wolf range hood repair</h3>
          <p>Ventilation hoods over Wolf ranges.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Wolf range repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Wolf range down? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
