---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs, anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Miele Oven Repair Los Angeles — Same Day";
const description = "Miele oven repair in Los Angeles: PureLine, ContourLine and VitroLine ovens, combi-steam and speed ovens. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/miele-oven-repair/";

const faqs = [
  { q: "Why won't my Miele oven heat?", a: "On a convection oven the usual causes are a failed bake or broil element, the convection element or fan, or the temperature sensor; less often the electronics that switch them. Check the breaker first, since a Miele wall often has more than one." },
  { q: "My Miele steam oven keeps asking me to descale. Can I ignore it?", a: "Not for long. The oven asks because minerals from the water are building up in the steam generator and lines. Postponing it leads to weak steam and water faults. Run the descaling program with the agent Miele specifies; if faults stay after a full descale, that is when we look at the pump and the steam generator." },
  { q: "The door seal on my Miele oven is coming loose. Can it be clipped back?", a: "Sometimes, if the clips are intact. Often the gasket has hardened or the clips have broken and it needs replacing, which we confirm on the visit. A loose seal lets heat escape and throws off the temperature, so it is worth fixing promptly." },
  { q: "Do you have to take the oven out of the wall?", a: "Usually not. Elements, fans, sensors, seals and door parts are reached from the front or from inside the cavity. When a repair needs the oven out of its opening, the written quote says so before anything is moved." },
  { q: "How much does Miele oven repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "Do you repair Miele speed ovens and microwaves too?", a: "Yes. Speed ovens combine convection with a microwave, and we repair both sections. See also our Miele microwave repair and Miele wall oven repair pages." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [
  {"place": "Santa Barbara", "unit": "Miele built-in oven", "symptom": "The rubber door seal was coming loose, and the owner asked us to look at the oven.", "found": "The door gasket had come away from its mounting and needed replacing rather than re-seating.", "done": "Ordered a replacement Miele door gasket and fitted it when the part arrived."}
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Miele Oven Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Miele", "item": "https://samedayappliance.repair/brands/miele/" },
      { "@type": "ListItem", "position": 4, "name": "Oven Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="miele-oven-repair"
    logoSlug="miele"
    eyebrow={"Miele · PureLine · ContourLine · VitroLine"}
    title={"Miele Oven Repair in Los Angeles"}
    subtitle={"Not heating, slow to preheat, a steam oven asking to descale or a door seal coming loose — diagnosed in place, with the oven left in its cabinet."}
    heroImageTitle={"Miele Oven Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/miele/">Miele</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Oven Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>The design line is the front; the oven type is what matters</h2>
      <p>Miele sells its built-in ovens in design lines — PureLine, ContourLine and VitroLine — so that a convection oven, a combi-steam oven and a speed oven stacked in one wall look like a set. For repair, the design line matters less than what sits behind the door: a convection oven, a combi-steam or steam oven with its own water system, or a speed oven that combines convection with a microwave.</p>
      <p>Each type fails differently. Convection ovens come down to elements, the fan, the temperature sensor and the door. Steam ovens add water — a container or a fixed connection, a pump and a steam generator that collects scale. Speed ovens add high-voltage microwave parts. Telling us the type when you call is the quickest way to get the right parts on the first visit.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Miele oven do you have, and what tends to fail on it</h2>
      <p>The model number is on the rating plate on the edge of the oven cavity or behind the door, visible when the door is open. Model numbers starting with H are ovens and speed ovens; DGC is combi-steam and DG is steam.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Convection ovens</h3>
          <p class="model-list">H 6xxx · H 7xxx</p>
          <p>Built-in single and double wall ovens from the Generation 6000 and current Generation 7000 ranges, many with pyrolytic self-cleaning.</p>
          <p class="fails"><strong>What we see fail:</strong> bake and broil elements, the convection fan motor and its element, the temperature sensor, door seals and hinges, the door lock on self-cleaning models, and the cooling fan.</p>
        </div>
        <div class="model-card">
          <h3>Combi-steam and steam ovens</h3>
          <p class="model-list">DGC · DG</p>
          <p>Ovens that cook with steam, alone or combined with convection. Water comes from a container or, on plumbed versions, a fixed water connection.</p>
          <p class="fails"><strong>What we see fail:</strong> scale in the steam generator and water lines when descaling has been postponed, the water container sensing and the pump, the drain on plumbed models, and the door seal.</p>
        </div>
        <div class="model-card">
          <h3>Speed ovens</h3>
          <p class="model-list">H xxxx BM</p>
          <p>A compact oven that combines convection with a microwave, usually installed above a warming drawer or next to a wall oven.</p>
          <p class="fails"><strong>What we see fail:</strong> door switches, microwave components, the convection element and fan, and the cooling fan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Miele oven is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Won't heat, or preheats very slowly</td><td>Bake and broil elements, the convection element and fan, the temperature sensor, then the electronics that switch them.</td></tr>
          <tr><td>Temperature runs high or low</td><td>The temperature sensor, the door seal and door closing properly, then calibration.</td></tr>
          <tr><td>Door seal loose or heat escaping around the door</td><td>The gasket and its clips, then the hinges that pull the door tight.</td></tr>
          <tr><td>Steam oven asking to descale, or weak steam</td><td>The descaling cycle that has been postponed, the water container seated properly, then the pump and the steam generator.</td></tr>
          <tr><td>Self-clean finished but the door stays locked</td><td>Let it cool fully; then the door lock mechanism and its switch.</td></tr>
          <tr><td>Speed oven: convection works, microwave doesn't heat</td><td>Door switches first, then the high-voltage microwave components — a job for the technician, not a DIY check.</td></tr>
          <tr><td>Fan keeps running after cooking</td><td>Normal for a while: the cooling fan runs on until the oven cools. A constant loud fan points at the cooling fan bearing.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Steam ovens and Los Angeles water</p>
      <h2>Descaling is maintenance, not an optional reminder</h2>
      <p>Southern California tap water is hard, and a Miele steam or combi-steam oven boils it every time you use steam. The minerals stay behind in the steam generator and the lines. That is why the oven counts its use and asks for descaling — and why ignoring the reminder for months eventually turns into weak steam, water errors and a steam generator that no longer heats properly.</p>
      <p>Run the descaling program when the oven asks for it, with the descaling agent Miele specifies. If the oven has already started showing water or steam faults, descaling is still the first step; parts are quoted only if the fault stays after a full descale.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note the oven type and any message</strong> — convection, steam, combi-steam or speed oven, and the exact text on the display.</li>
        <li><strong>Check the breaker.</strong> A wall with two or three Miele units often has more than one breaker; one tripped breaker can take out a single appliance.</li>
        <li><strong>Look at the door seal.</strong> If it has come away from its clips, note where; don't pull it further.</li>
        <li><strong>Steam oven:</strong> make sure the water container is filled and pushed fully home, and check whether a descaling reminder has been postponed.</li>
        <li><strong>Self-cleaning door locked?</strong> Give the oven a few hours to cool completely before calling.</li>
      </ul>
      <p>Please don't open the casing of a speed oven; the microwave section holds high voltage even when unplugged.</p>
    </div>
  </section>

  <!-- ── REAL JOBS (Fixar CRM, anonymized) ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">From our job log</p>
      <h2>Recent Miele oven jobs</h2>
      <p>Taken from our job records, with names and addresses removed.</p>
      {cases.map((c) => (
        <div class="case">
          <h3>{c.place} · {c.unit}</h3>
          <dl>
            <dt>What the owner reported</dt><dd>{c.symptom}</dd>
            <dt>What the technician found</dt><dd>{c.found}</dd>
            <dt>What was done</dt><dd>{c.done}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Miele oven repairs depend on the oven type and the part, so we quote them after the diagnostic. Built-in ovens are usually repaired in place; when one has to come out of the wall, the quote says so up front.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Miele's own service network — if your Miele is still inside its factory warranty, call Miele first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Miele service</p>
      <h2>Other Miele repairs</h2>
      <div class="cat-grid">
        <a href="/brands/miele/" class="cat-card">
          <h3>Miele repair (all products)</h3>
          <p>Every Miele line we work on, in one place.</p>
        </a>
        <a href="/brands/miele-wall-oven-repair/" class="cat-card">
          <h3>Miele wall oven repair</h3>
          <p>Built-in single and double wall ovens.</p>
        </a>
        <a href="/brands/miele-microwave-repair/" class="cat-card">
          <h3>Miele microwave repair</h3>
          <p>Built-in microwaves and speed ovens.</p>
        </a>
        <a href="/brands/miele-dishwasher-repair/" class="cat-card">
          <h3>Miele dishwasher repair</h3>
          <p>G 7000 and G 5000, drain and inlet faults.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele oven repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Miele oven not heating? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
