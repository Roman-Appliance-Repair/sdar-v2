---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, real case, FAQ from one array; boilerplate price table, gasket/humidity essay, warranty block and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Viking Range Repair Los Angeles — Same Day";
const description = "Viking range repair in Los Angeles: Professional 7 and 5 Series, VGR gas and VDR dual-fuel ranges. Ignition, ovens. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/viking-range-repair/";

const faqs = [
  { q: "Why won't my Viking burners stop clicking?", a: "Each knob has an ignition switch, and any switch that reads 'on' makes the spark module spark at every burner. Continuous clicking usually means one switch is wet from a spill or cleaning, or has failed. Drying the range often fixes it; otherwise we find the switch at fault before touching the spark module." },
  { q: "My Viking gas oven takes forever to preheat. What's wrong?", a: "On VGR gas ovens the igniter has to get hot enough to open the oven's gas safety valve. As it ages it still glows but can't open the valve fully, so the oven heats slowly or not at all. Replacing the igniter fixes most of these; if not, the valve is next." },
  { q: "What is the difference between a VGR and a VDR Viking range?", a: "VGR is all gas: gas burners and a gas oven with an infrared broiler. VDR is dual fuel: gas burners over an electric oven. Burner repairs are the same on both; oven repairs are igniters and valves on VGR, elements, sensors and the electronic oven control on VDR." },
  { q: "Is an older Viking range still worth repairing?", a: "Usually. Burners, valves, igniters, hinges and most oven parts are still available for Professional ranges going back many years. Some parts for older models have been superseded or discontinued since the 2013 sale to Middleby, so we confirm a part exists before quoting the repair." },
  { q: "Do you service Viking dual-fuel ovens too?", a: "Yes. On VDR ranges we diagnose the bake and broil elements, the temperature sensor, the convection fan and the electronic oven control, and repair them with the range in place." },
  { q: "How much does Viking range repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. An igniter typically runs $150–$240; other repairs are quoted in writing after the diagnostic and carry a 90-day warranty on parts and labor." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [
  {"place": "Ventura", "unit": "Viking gas range", "symptom": "A burner valve would not open, and the igniters kept clicking even after the burners were lit.", "found": "Diagnosed on the first visit, in about 45 minutes on site.", "done": "Diagnosed — a written repair quote was issued for the owner’s approval before any parts were ordered."}
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Viking Range Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Viking", "item": "https://samedayappliance.repair/brands/viking/" },
      { "@type": "ListItem", "position": 4, "name": "Range Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="viking-range-repair"
    logoSlug="viking"
    eyebrow={"Viking · Professional 7 · 5 Series"}
    title={"Viking Range Repair in Los Angeles"}
    subtitle={"Burners that click and won’t light, igniters that won’t stop, gas ovens slow to heat — on VGR gas and VDR dual-fuel Viking ranges."}
    heroImageTitle={"Viking Range Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/viking/">Viking</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Range Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">How a Viking range is built</p>
      <h2>VGR or VDR: the prefix tells us which oven you have</h2>
      <p>Every Viking range model starts with letters that say what is inside. <strong>VGR</strong> is an all-gas range: gas burners over a gas oven with an infrared broiler. <strong>VDR</strong> is dual fuel: the same gas burners over an electric oven. The number after it is the series. Above the oven, Viking ranges share a family of sealed burners lit by spark ignition, with a low-simmer setting on selected burners.</p>
      <p>That split decides the oven repair. A gas Viking oven that heats slowly or not at all is usually its igniter or gas valve; an electric Viking oven is elements, the temperature sensor and the electronic oven control. The burner side — clicking, not lighting, weak flame — is the same conversation on both.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Viking range you have, and what tends to fail</h2>
      <p>The model and serial plate is usually behind the kick panel at the bottom front of the range, or on the oven frame visible with the door open.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Professional 7 Series</h3>
          <p class="model-list">VGR7… (gas) · VDR7… (dual fuel) · 30 to 60 inches</p>
          <p>The current top line, with Elevation burners and a ProFlow convection baffle in the oven.</p>
          <p class="fails"><strong>What we see fail:</strong> spark ignition parts, oven ignition on gas models, bake elements and temperature sensors on dual-fuel models, convection fans, door hinges.</p>
        </div>
        <div class="model-card">
          <h3>Professional 5 Series</h3>
          <p class="model-list">VGR5… · VDR5… and older VGIC · VGSC · VDSC models</p>
          <p>The long-running Professional line — the one in most Los Angeles kitchens built from the late 1990s on. Older units carry the VGIC, VGSC and VDSC prefixes.</p>
          <p class="fails"><strong>What we see fail:</strong> burners that click and won't light, gas-oven igniters, temperature sensors, the electronic oven control, door hinges and gaskets.</p>
        </div>
        <div class="model-card">
          <h3>3 Series</h3>
          <p class="model-list">RVGR3… · RVDR3…</p>
          <p>Viking's lower-priced pro-style range, with the same gas or dual-fuel split.</p>
          <p class="fails"><strong>What we see fail:</strong> ignition parts and oven heating parts, as on the larger lines.</p>
        </div>
        <div class="model-card">
          <h3>Rangetops and cooktops</h3>
          <p class="model-list">Viking gas rangetops and cooktops</p>
          <p>The same burner and ignition system without an oven below, usually paired with Viking wall ovens.</p>
          <p class="fails"><strong>What we see fail:</strong> ignition switches, electrodes and spark modules. See <a href="/brands/viking-cooktop-repair/">Viking cooktop repair</a>.</p>
        </div>
      </div>
      <p class="footnote">Since Viking became part of Middleby in 2013, some parts for older ranges have been superseded or discontinued. We confirm a part exists before quoting a repair on an older range, and say so plainly when it doesn't.</p>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What the range is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Burner clicks but won't light</td><td>Cap seated so its notch lines up with the electrode, a wet or greasy burner, a blocked port; then that burner's electrode.</td></tr>
          <tr><td>Igniters keep clicking after the flame is lit</td><td>Moisture at the burner, a shorted ignition switch on one valve (all burners click when that knob turns), then the spark module.</td></tr>
          <tr><td>One burner won't open or the flame stays weak</td><td>That burner's valve and orifice, then the burner tube.</td></tr>
          <tr><td>Gas oven heats slowly or not at all</td><td>The oven igniter: an aging igniter glows but never draws enough to open the gas safety valve. Then the valve itself.</td></tr>
          <tr><td>Broiler won't light on a gas model</td><td>The broiler igniter and valve for the infrared broiler.</td></tr>
          <tr><td>Dual-fuel oven won't heat</td><td>Bake element and its terminals, the temperature sensor, then the electronic oven control.</td></tr>
          <tr><td>Oven temperature off, or hot spots</td><td>Temperature sensor drift, the convection fan, the door gasket and hinges letting heat out.</td></tr>
          <tr><td>Door sags or won't close flush</td><td>Door hinges — replaced as a pair; Viking range doors are heavy.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── GAS / IGNITION NOTES ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Ignition and gas notes</p>
      <h2>Why a Viking clicks — and when it is not the module</h2>
      <p>On a Viking, every knob has an ignition switch behind it. Turning any one knob tells the spark module to spark at every burner, which is why all burners click together. The module stops once the knobs are back off. So when clicking won't stop, the question is which knob's switch is still telling the module "on": usually a switch wetted by a spill or cleaning, or one that has failed. Replacing the spark module first is the common, expensive mistake.</p>
      <p>The gas oven works differently. Its igniter has to get hot enough, and draw enough current, to open the oven's safety valve. Igniters weaken with age, so the classic Viking complaint is an oven that takes far too long to preheat or never gets there, with the igniter visibly glowing. That is a parts swap, done with the range in place.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Before you call</h2>
      <ul class="scope-list">
        <li><strong>After cleaning, let it dry.</strong> Lift the caps and give the burner bases a few hours; most "won't stop clicking" calls right after a cleaning end here.</li>
        <li><strong>Reseat each cap</strong> so it sits flat and lines up with its electrode.</li>
        <li><strong>Find the knob.</strong> If clicking starts when you touch one particular knob, tell us which — it points at that switch.</li>
        <li><strong>Check power.</strong> Gas Vikings still need electricity for spark ignition and the oven igniter.</li>
        <li><strong>Smell gas?</strong> Turn the knobs off, leave the house and call the gas company first.</li>
      </ul>
    </div>
  </section>

  <!-- ── REAL JOBS (Fixar CRM, anonymized) ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">From our job log</p>
      <h2>Recent Viking range jobs</h2>
      <p>Taken from our job records, with names and addresses removed.</p>
      {cases.map((c) => (
        <div class="case">
          <h3>{c.place} · {c.unit}</h3>
          <dl>
            <dt>What the owner reported</dt><dd>{c.symptom}</dd>
            <dt>What the technician found</dt><dd>{c.found}</dd>
            <dt>What was done</dt><dd>{c.done}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Igniter replacement on a range typically runs $150–$240. Valves, spark modules, elements, sensors and oven controls are quoted in writing after the diagnostic, once we have the model and serial.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Viking's own service network — if your Viking range is still inside its factory warranty, call Viking first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Viking service</p>
      <h2>Other Viking repairs</h2>
      <div class="cat-grid">
        <a href="/brands/viking/" class="cat-card">
          <h3>Viking appliance repair (all products)</h3>
          <p>Every Viking line we work on.</p>
        </a>
        <a href="/brands/viking-oven-repair/" class="cat-card">
          <h3>Viking oven repair</h3>
          <p>Viking wall ovens: elements, convection, controls.</p>
        </a>
        <a href="/brands/viking-cooktop-repair/" class="cat-card">
          <h3>Viking cooktop repair</h3>
          <p>Gas rangetops and cooktops.</p>
        </a>
        <a href="/brands/viking-range-hood-repair/" class="cat-card">
          <h3>Viking range hood repair</h3>
          <p>Ventilation hoods over Viking ranges.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Viking range repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Viking range down? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
