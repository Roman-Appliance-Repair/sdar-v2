  <Fragment slot="head-scripts">
  <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />{schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}</Fragment>
  <div class="call-banner"><div class="wrap"><span>Gaggenau Vario cooling column warming up? Same-day across all 7 Southern California counties:</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>

  <ServiceHero
    logoSlug="gaggenau"
    section="brands"
    slug="gaggenau-built-in-refrigerator-repair"
    eyebrow={"Gaggenau · Built-In Refrigerator Repair"}
    title={"Gaggenau Built-In Refrigerator Repair Across Southern California"}
    subtitle={description}
    heroImageTitle={"Gaggenau Built-In Refrigerator Repair"}
  />


<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
