  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="call-banner"><div class="wrap"><span>Bakers Pride down? Same-day commercial service:</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>
  <ServiceHero
    section="brands"
    slug="bakers-pride-pizza-oven-repair"
    logoSlug="bakers-pride"
    eyebrow={"Bakers Pride Pizza Oven Repair"}
    title={"Bakers Pride Pizza Oven Repair"}
