---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Miele Appliance Repair Los Angeles — Same Day";
const description = "Miele repair in Los Angeles and SoCal: G 7000 dishwashers, W1 washers, T1 dryers, ovens and MasterCool. $89 diagnostic, waived with repair. Book today.";

// 2026-10-05: hub rewritten to stay about the brand as a whole. Product-level depth
// (symptoms, parts, prices) lives on the product pages linked from the "What we repair"
// block, so the hub stops competing with them for product queries.
// FAQ: visible list and FAQPage JSON-LD are both generated from `faqs`.
const faqs = [
  { q: "Are you part of Miele's service network?", a: "No. We're an independent repair company. If your Miele is still inside its factory warranty, call Miele USA at 1-800-843-7231 first; after the warranty, we're usually the faster call." },
  { q: "Which Miele appliances do you repair?", a: "Dishwashers, W1 washers, T1 dryers, ovens including steam and speed ovens, refrigeration and wine storage, range hoods, microwaves, KM cooktops and CM coffee machines. The main categories each have their own page in the 'What we repair' list." },
  { q: "Do you service 24-inch Miele W1 and T1 laundry?", a: "Yes. W1 washers and T1 heat-pump dryers are the largest share of our Miele work. Most of them are 2019 to 2023 units coming out of the Miele USA warranty." },
  { q: "Does Miele make stoves?", a: "Miele makes ranges (induction and dual-fuel in 30, 36 and 48 inches), KM cooktops, H 7000 ovens, steam ovens and speed ovens. There is no separate 'stove' category: 'Miele stove repair' usually means the range or the cooktop, and we cover both." },
  { q: "How long does a Miele last?", a: "Miele designs to a 20-year service life and rates W1 motors for 10,000 operating hours. We routinely service original-install Miele dishwashers from 2012 and W1 washers from 2015 running on their original pumps and motors." },
  { q: "Do you use genuine Miele parts?", a: "Yes. Miele parts are matched to the machine's control logic, and substitutes can cause faults the machine never had. Common wear parts for G 7000, W1 and T1 are on the truck; less common parts come next-day from Miele USA distribution." },
  { q: "How much does Miele repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. Repairs are quoted in writing after the diagnostic, before work starts, and carry a 90-day warranty on parts and labor. Typical price ranges for each category are on the product pages." },
  { q: "How fast can you come out?", a: "Same day when a technician is free, Monday to Saturday 8am–6pm. Call early, especially for a leaking dishwasher or a washer full of water. Malibu, Hidden Hills and Pacific Palisades usually get next-morning priority." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/miele/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/miele/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/miele/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="miele"
    section="brands"
    eyebrow={"Miele · Dishwashers · Laundry · Kitchen"}
    title={"Miele Appliance Repair in Los Angeles"}
    subtitle={"Dishwashers, 24-inch W1 washers and T1 dryers, ovens, refrigeration, hoods and microwaves — repaired with genuine Miele parts."}
    heroImageTitle={"Miele Appliance Repair in Los Angeles"}
    showBranches={true}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

  <!-- ── WHAT WE REPAIR (route block) ── -->
  <section class="wwr">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Pick your Miele</h2>
      <div class="wwr-grid">
        <a href="/brands/miele-dishwasher-repair/" class="wwr-card"><strong>Miele dishwasher repair</strong><span>Not draining, not cleaning, leak protection tripped.</span></a>
        <a href="/brands/miele-washer-repair/" class="wwr-card"><strong>Miele washer repair</strong><span>W1 washers: drain, door lock, spin.</span></a>
        <a href="/brands/miele-dryer-repair/" class="wwr-card"><strong>Miele dryer repair</strong><span>T1 heat-pump dryers.</span></a>
        <a href="/brands/miele-oven-repair/" class="wwr-card"><strong>Miele oven repair</strong><span>Ovens, steam and speed ovens.</span></a>
        <a href="/brands/miele-wall-oven-repair/" class="wwr-card"><strong>Miele wall oven repair</strong><span>Built-in wall ovens.</span></a>
        <a href="/brands/miele-refrigerator-repair/" class="wwr-card"><strong>Miele refrigerator repair</strong><span>MasterCool and other Miele refrigeration.</span></a>
        <a href="/brands/miele-built-in-refrigerator-repair/" class="wwr-card"><strong>Miele built-in refrigerator repair</strong><span>Panel-ready built-in columns.</span></a>
        <a href="/brands/miele-wine-cooler-repair/" class="wwr-card"><strong>Miele wine cooler repair</strong><span>Wine storage.</span></a>
        <a href="/brands/miele-range-hood-repair/" class="wwr-card"><strong>Miele range hood repair</strong><span>Hoods and ventilation.</span></a>
        <a href="/brands/miele-microwave-repair/" class="wwr-card"><strong>Miele microwave repair</strong><span>Built-in microwaves.</span></a>
        <a href="/brands/miele-professional-dishwasher-repair/" class="wwr-card"><strong>Miele Professional dishwasher repair</strong><span>Professional-line dishwashers.</span></a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">About the brand</p>
      <h2>Miele builds for 20 years. Service should match that standard.</h2>
      <p class="intro-speakable">Miele, a family-owned German company founded in 1899, tests every machine it builds against a 20-year service-life target. That is an engineering target, not a marketing number, and it shapes how motors, seals, bearings and controls are specified: a W1 washer motor is rated for 10,000 operating hours, and G 7000 dishwashers go through a 24-hour endurance test before they ship. It is why a ten-year-old Miele is usually worth repairing, and why parts matter. Miele components are matched to the machine's control logic, so a generic drain pump can trigger fault codes the machine never had. We use genuine Miele parts.</p>
      <p>Across the Miele calls our techs run in Southern California homes, the work clusters in a consistent order. W1 and T1 laundry and G 7000 dishwashers lead and are our core Miele specialty: drain pumps, door locks, AquaStop valves and shock absorbers are the most frequent jobs. H 7000 oven element and temperature-probe service comes next, then MasterCool refrigeration (evaporator fans, door cams, inverter boards), then KM cooktops and CM coffee machines. Each product page above covers its own model lines, symptoms and prices; this page is about the brand as a whole.</p>
      <p>Most of our Miele calls come from districts where Miele was specified for the 24-inch compact laundry footprint, the integrated panel-ready dishwasher or fully integrated MasterCool refrigeration: Bel Air, Beverly Hills, Holmby Hills, West Hollywood, Brentwood, Pacific Palisades and Malibu on LA's Westside; the Pasadena and La Cañada foothills; Newport Beach, Newport Coast and Laguna Beach in Orange County; Westlake Village and Thousand Oaks in the Conejo Valley; Montecito in Santa Barbara County; and the La Jolla and Rancho Santa Fe corridor in San Diego County.</p>
      <p>Miele vacuums are bench work rather than a house call, so we don't send a technician for them. Our sister workshop <a href="https://vacuum.repair/miele/">Vacuum.Repair</a> repairs Complete C3 canisters and Electro+ power brushes by mail, with prepaid shipping both ways.</p>
    </div>
  </section>

  <!-- ── 24-INCH CONTEXT ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Understanding Miele's format</p>
      <h2>Why Miele laundry is 24 inches, not 27</h2>
      <p>The most common source of confusion on Miele laundry calls is format. American washers and dryers are mostly 27 inches wide; that is what Whirlpool, LG, Samsung, GE and Maytag build. Miele W1 washers and T1 dryers are 24 inches, the European residential standard, and that is why they fit the spaces where 27-inch machines won't: stacked closets along the Wilshire Corridor, Century City and Marina del Rey high-rises, Newport Beach and Long Beach towers, and compact laundry rooms in townhomes across the Inland Empire.</p>
      <p>The format has service implications beyond width. Capacity per cycle is smaller (about 4.0 cubic feet for a W1 against 5.0 and more for a 27-inch washer), cycle times are longer (Miele's default cotton program runs around 2 hours 45 minutes for a full load), and the electrical profile is different: T1 dryers are heat-pump dryers that run on a standard 120V 15-amp outlet and need no outside vent, because moisture is condensed and drained instead of blown out.</p>
      <p>For service, the 24-inch format is a reference standard Miele invests in. Parts availability is good and the diagnostic protocols are well documented, but a technician who has only ever worked 27-inch machines can make avoidable mistakes on a W1. The specifics are on our <a href="/brands/miele-washer-repair/">Miele washer</a> and <a href="/brands/miele-dryer-repair/">Miele dryer</a> pages.</p>
    </div>
  </section>

  <!-- ── PLATFORM OVERVIEW ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Platform overview</p>
      <h2>Miele product platforms we service</h2>
      <div class="model-grid">
        <div class="model-card">
          <h3>G 7000 and G 5000 Dishwashers</h3>
          <p class="model-list">G 7966 SCVi AutoDos · G 7316 SCU · G 7104 SCU · G 5056 SCVi</p>
          <p>Miele's current dishwasher flagship. AutoDos automatic detergent dispensing via PowerDisk, AquaStop full leak protection, 3D MultiFlex middle rack, QuickPowerWash 58-minute cycle, AutoOpen drying. Integrated panel-ready and stainless versions. Details on the <a href="/brands/miele-dishwasher-repair/">dishwasher page</a>.</p>
        </div>
        <div class="model-card">
          <h3>W1 Washers (24-inch compact)</h3>
          <p class="model-list">WWB 020 WCS · WWH 860 WCS · WWH 660 WCS · WXI 860 WCS · WXR 860 WCS</p>
          <p>Front-load European compact. TwinDos two-cartridge dispensing with UltraPhase 1 and 2, Honeycomb drum, CapDosing for specialty detergents, 10,000-hour motor rating. Details on the <a href="/brands/miele-washer-repair/">washer page</a>.</p>
        </div>
        <div class="model-card">
          <h3>T1 Heat-Pump Dryers (120V, ventless)</h3>
          <p class="model-list">TXI 680 WP · TXR 860 WP · TWI 180 WP · TWF 160 WP</p>
          <p>Ventless heat-pump drying on a standard 120V outlet. EcoDry heat pump, PerfectDry moisture sensors, FragranceDos capsules, steam refresh. Details on the <a href="/brands/miele-dryer-repair/">dryer page</a>.</p>
        </div>
        <div class="model-card">
          <h3>H 7000 Ovens, Steam and Speed Ovens</h3>
          <p class="model-list">H 7364 BP · H 7164 BP · H 7880 BP · DGC 7000 combi-steam · H 7840 BM speed oven</p>
          <p>H 7000 wall ovens with MasterChef Plus automatic programs, Moisture Plus and SensorTronic touch controls; DG and DGC combi-steam ovens with automatic descaling; M Series and H 7000 BM speed ovens. Details on the <a href="/brands/miele-oven-repair/">oven</a> and <a href="/brands/miele-wall-oven-repair/">wall oven</a> pages.</p>
        </div>
        <div class="model-card">
          <h3>MasterCool Refrigeration and Wine Storage</h3>
          <p class="model-list">KF 2982 Vi · K 2902 Vi · F 2412 Vi · KWT 2672 ViS</p>
          <p>Built-in columns in 30 and 36 inches, 48-inch side-by-side, under-counter wine storage. FlexiFrame, PerfectFresh Pro drawers, inverter compressor architecture, panel-ready fronts. Details on the <a href="/brands/miele-refrigerator-repair/">refrigerator</a>, <a href="/brands/miele-built-in-refrigerator-repair/">built-in refrigerator</a> and <a href="/brands/miele-wine-cooler-repair/">wine cooler</a> pages.</p>
        </div>
        <div class="model-card">
          <h3>KM Cooktops and CM Coffee Machines</h3>
          <p class="model-list">KM 7000 and KM 6800 induction · KM gas · CM 5, CM 6, CM 7 · CVA 7000 built-in</p>
          <p>Induction cooktops with PowerFlex zones and TempControl, KM gas and electric cooktops, freestanding and built-in coffee machines with AromaticSystem and OneTouch. These have no separate page yet; call and name the model, and the technician brings the right parts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── INDEPENDENCE / WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Warranty and how we work</p>
      <h2>Under warranty, call Miele. After that, call us.</h2>
      <p>We're an independent repair company, not part of Miele's own service network, and we don't present ourselves as one. Miele USA's residential warranty runs two years on parts and labor, with a longer limited warranty on the motor and drum of W1 washers and T1 dryers. Inside that window, call Miele USA at <strong>1-800-843-7231</strong> first and they'll dispatch an authorized agent.</p>
      <p>After the warranty is where we work. Most of our Miele calls are units between three and fifteen years old, installed between 2011 and 2023, where the warranty has closed but the appliance has another decade of service life left. Our residential diagnostic is $89, waived with repair, the quote is in writing before work starts, and every repair carries our 90-day warranty on parts and labor. We also pick up warranty-overflow calls when Miele's own network is booked out and the customer can't wait.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Miele service across Southern California</h2>
      <p>Ten branches cover Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties. Miele density is highest in condominiums along the Wilshire Corridor and Century City, where 24-inch laundry fits and 27-inch won't; in luxury single-family homes in Bel Air, Beverly Hills, Brentwood, Pacific Palisades and Malibu, where MasterCool refrigeration and G 7000 dishwashers were specified at build; and in Newport Coast, Westlake Village and Montecito kitchens done by named designers. Tell us your city and model when you call, and we route the nearest technician.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── CREDENTIALS ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Credentials</p>
      <h2>Licensed, insured, EPA-certified</h2>
      <p>Miele MasterCool service means opening sealed refrigeration systems, and that takes EPA 608 refrigerant handling certification — our technicians hold EPA 608 Universal #1346255700410. We're registered with California's Bureau of Household Goods and Services under <strong>BHGS #A49573</strong>, and we carry general liability and workers' comp.</p>
      <p>See the <a href="/credentials/">full credentials page</a> for license verification links.</p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele service questions</h2>
      {faqs.map((f) => (
        <details class="faq faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Miele service?</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card.static { cursor: default; }
  .cat-card.static:hover { transform: none; box-shadow: none; border-color: var(--border); }
  .cat-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 14px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .bottom-cta .hero-ctas { justify-content: center; }

  /* What-we-repair route block (mirrors the symptom-route cards on /commercial/ pages) */
  .wwr { padding: 40px 24px 48px; background: #fff; border-bottom: 1px solid var(--border); }
  .wwr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-top: 18px; }
  .wwr-card { display: block; padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; background: #fff; text-decoration: none; color: inherit; transition: border-color .2s; }
  .wwr-card:hover { border-color: var(--red); }
  .wwr-card strong { display: block; font-size: 15px; color: var(--black); margin-bottom: 4px; }
  .wwr-card span { display: block; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .section a { color: var(--red); }
</style>
</Layout>
