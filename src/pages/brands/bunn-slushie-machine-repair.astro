---
// /brands/bunn-slushie-machine-repair/, first activation of Slushie section (1/5)
// GSC signal: 17 imp last 90d ("bunn slush machine repair" 8 + "bunn slush machine service" 9)
// Bunn-O-Matic Springfield IL 1957, coffee brewer flagship + slushie/frozen beverage secondary line.
// Hestan-style compact commercial combo. $120 commercial diagnostic.

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
