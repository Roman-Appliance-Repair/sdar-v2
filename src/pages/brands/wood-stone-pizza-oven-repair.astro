---
// /brands/wood-stone-pizza-oven-repair/, Cluster 09. Wood Stone, Bellingham WA. Independent since 1989.
// Owner rule (2026-10): GAS-FIRED models only. We do not work on wood-fired ovens.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

const title = "Wood Stone Gas Pizza Oven Repair Los Angeles";
const description = "Gas-fired Wood Stone pizza oven won't light or hold heat? Same-day repair of Wood Stone gas models across LA and SoCal. Gas models only. $120 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/wood-stone-pizza-oven-repair/";

const faqs = [
  { q: "Do you repair Wood Stone pizza ovens?", a: "Yes, the gas-fired Wood Stone models. We service the gas side: burner, ignitor, gas safety valve, thermocouple, regulator, thermostat, controls, door seal, and the rotating-deck drive on Stratos units. We don't work on wood-fired ovens." },
  { q: "Who makes Wood Stone pizza ovens?", a: "Wood Stone Corporation, headquartered and manufacturing in Bellingham, Washington, and operating as an independent company since 1989. Many of its commercial oven lines are offered in gas-fired configurations, and those are the units we repair." },
  { q: "Why won't my Wood Stone gas oven light?", a: "The usual causes are a worn burner ignitor or flame sensor, a weak thermocouple that keeps the gas safety valve closed, or low gas pressure at the regulator. We test each in order before replacing parts. Burner ignitor or gas valve work typically runs labor $325 to $640 plus the part." },
  { q: "Why is my Wood Stone gas oven heating unevenly or running cool?", a: "On a gas Wood Stone oven, uneven or low heat usually comes from a partially clogged burner orifice, thermostat drift, or regulator pressure that's off spec. We check flame pattern and gas pressure at operating temperature and verify the thermostat against an independent reading before quoting. Thermostat replacement typically runs labor $300 to $610 plus the part." },
  { q: "What does Wood Stone gas pizza oven repair cost in LA?", a: "$120 flat commercial diagnostic, waived with repair. Typical labor ranges (parts quoted after diagnosis): thermostat $300–$610, oven thermocouple $325–$640, door gasket / seal $250–$520, burner ignitor $325–$640, gas valve $325–$640, Stratos rotating-deck drive motor $350–$700, control board $350–$750. Repairs carry a 90-day warranty on parts and labor. See our <a href=\"/price-list/commercial-oven-repair-cost/\">commercial oven repair cost guide</a>." },
  { q: "Do you work on wood-fired Wood Stone ovens?", a: "No. We don't work on wood-fired ovens. If your Wood Stone oven runs on gas, we can repair it." }
];

const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", "serviceType": "Wood Stone Pizza Oven Repair", "provider": { "@id": canonical + "#org" }, "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ], "description": "Wood Stone gas-fired commercial pizza oven repair across Los Angeles and Southern California: Mountain series and Fire Deck in gas-fired configuration, Stratos gas rotating deck. Burner, ignition, gas valve, thermocouple, thermostat, controls. Gas models only; no wood-fired ovens. $120 commercial diagnostic waived with repair." },
  { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') } })) },
  { "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" }, { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" }, { "@type": "ListItem", "position": 3, "name": "Wood Stone Pizza Oven Repair", "item": canonical } ] }
] };

// Wave 46 (2026-05-21): canonical org schema — HVAC 777 LLC + 4 credentials + hours.
// Closes Wave 35 / Phase 2b-1 gap for brand-combo and price-list pages.
// SSOT: src/data/credentials-schema.ts + src/data/business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="call-banner"><div class="wrap"><span>Wood Stone gas oven down? Same-day commercial service:</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>
  <ServiceHero
    section="brands"
    slug="wood-stone-pizza-oven-repair"
    eyebrow={"Wood Stone Gas Pizza Oven Repair"}
    title={"Wood Stone Gas Pizza Oven Repair"}
    subtitle={description}
    heroImageTitle={"Wood Stone Gas Pizza Oven Repair"}
  />


<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <span class="breadcrumbs-plain">Wood Stone</span> <span class="crumbs-sep">›</span>
  <span aria-current="page">Pizza Oven Repair</span>
</nav>
  <BrandBranchesGrid />
  <section class="trust-bar"><div class="wrap"><span>Licensed BHGS #A49573 · Insured</span><span>Same-day · 7 Southern California counties</span><span>$120 commercial diagnostic · waived with repair</span></div></section>

  <section class="section"><div class="wrap narrow">
    <h2>Wood Stone gas-fired pizza ovens, Bellingham WA since 1989</h2>
    <p>A gas-fired Wood Stone pizza oven that won't light, won't hold temperature, or cooks unevenly usually traces to one of three patterns our techs at Same Day Appliance Repair diagnose first. (1) The burner ignitor or flame sensor wears out, and the oven fails to light or drops out mid-service. (2) The thermocouple or gas safety valve fails, so gas is cut even though the burner looks fine. (3) Thermostat or control drift, so the oven reads correct but bakes hotter or cooler than set. $120 commercial diagnostic, waived with repair.</p>
    <p>We service the gas-fired Wood Stone models only. We don't work on wood-fired ovens.</p>
    <p>Wood Stone Corporation manufactures commercial pizza ovens in Bellingham, Washington, and has operated as an independent company since 1989. Many of its oven lines are built in gas-fired configurations, and those are the units we repair: burner, gas valve, thermocouple, ignition, thermostat, controls, door seal, and, on rotating-deck units, the deck drive.</p>
  </div></section>

  <section class="section alt"><div class="wrap">
    <h2>Wood Stone gas pizza ovens we service</h2>
    <div class="model-grid">
      <div class="model-card"><h3>Mountain series (Mt Adams), gas-fired</h3><p>Wood Stone's stone-hearth deck ovens in gas-fired configuration. Service: burner and ignitor, thermocouple, gas safety valve, regulator, thermostat and controls, door seal.</p></div>
      <div class="model-card"><h3>Fire Deck, gas</h3><p>Gas-fired Fire Deck deck ovens in various sizes. Same gas-side service pattern: ignition, burner, gas valve, thermocouple, temperature control.</p></div>
      <div class="model-card"><h3>Stratos, gas rotating deck</h3><p>Rotating-deck pizza oven for high-volume operations. Service adds the deck drive motor and rotation controls to the standard gas burner, valve, and ignition work.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="wrap narrow">
    <h2>What fails on a gas Wood Stone oven</h2>
    <ul class="check-list">
      <li><b>Ignition</b>, the burner ignitor or flame sensor wears from repeated high-temperature cycling; the oven clicks but won't light, or lights and drops out.</li>
      <li><b>Thermocouple and gas safety valve</b>, a weak thermocouple closes the safety valve and shuts the gas off; a sticking valve starves the burner.</li>
      <li><b>Burner and orifice</b>, a partially clogged orifice or burner port gives a lazy, uneven flame and slow recovery between bakes.</li>
      <li><b>Thermostat and controls</b>, drift makes the hearth run hotter or cooler than the setting; electronic controls on newer units can fail outright.</li>
      <li><b>Regulator pressure</b>, under-pressure runs cold, over-pressure burns out components; we check it on every gas call.</li>
      <li><b>Door seal and rotating-deck drive</b>, door gaskets wear from constant use, and Stratos drive motors wear on high-volume units.</li>
    </ul>
  </div></section>

  <section class="section"><div class="wrap narrow">
    <h2>What Wood Stone gas pizza oven repair costs in LA</h2>
    <p>$120 flat commercial diagnostic, waived with repair. 90-day warranty on parts and labor.</p>
    <table class="price-table"><thead><tr><th>Repair</th><th>Labor range (parts after diagnosis)</th></tr></thead>
    <tbody><tr><td>Thermostat replacement</td><td>$300–$610</td></tr><tr><td>Oven thermocouple</td><td>$325–$640</td></tr><tr><td>Door gasket / seal</td><td>$250–$520</td></tr><tr><td>Burner ignitor assembly</td><td>$325–$640</td></tr><tr><td>Gas valve</td><td>$325–$640</td></tr><tr><td>Stratos rotating-deck drive motor</td><td>$350–$700</td></tr><tr><td>Control board</td><td>$350–$750</td></tr></tbody></table>
    <p class="small">Final price depends on model and parts. See our <a href="/price-list/commercial-oven-repair-cost/">commercial oven repair cost guide</a>.</p>
  </div></section>

  <section class="section alt"><div class="wrap narrow">
    <h2>Related Wood Stone and pizza oven pages</h2>
    <ul class="related-links">
      <li><a href="/commercial/pizza-oven-repair/"><b>Commercial pizza oven repair Los Angeles</b></a>, service hub</li>
      <li><a href="/commercial/pizza-oven-repair/deck-pizza-oven-repair/">Deck pizza oven repair</a>, gas and electric deck ovens</li>
      <li><a href="/brands/forno-bravo-pizza-oven-repair/">Forno Bravo gas pizza oven repair</a>, gas-fired Forno Bravo ovens</li>
      <li><a href="/brands/bakers-pride-pizza-oven-repair/">Bakers Pride pizza oven repair</a>, gas deck (Y-600)</li>
      <li><a href="/brands/marsal-pizza-oven-repair/">Marsal pizza oven repair</a>, brick-lined gas deck</li>
      <li><a href="/brands/middleby-marshall-pizza-oven-repair/">Middleby Marshall pizza oven repair</a>, chain pizza conveyor</li>
      <li><a href="/brands/lincoln-pizza-oven-repair/">Lincoln Impinger pizza oven repair</a>, conveyor pizza</li>
      <li><a href="/west-hollywood/">West Hollywood service area</a> · <a href="/los-feliz/">Los Feliz service area</a></li>
    </ul>
  </div></section>

  <section class="section"><div class="wrap narrow"><h2>Wood Stone pizza oven repair, frequently asked</h2>{faqs.map(f => <details class="faq"><summary>{f.q}</summary><p set:html={f.a}></p></details>)}</div></section>

  <section id="book" class="cta-bottom"><div class="wrap"><h2>Wood Stone gas oven down? Call now.</h2><p>Same-day emergency response across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties. $120 commercial diagnostic, waived with repair. 90-day warranty on parts and labor.</p></div></section>
</Layout>

