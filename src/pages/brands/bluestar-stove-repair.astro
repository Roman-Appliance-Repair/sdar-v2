---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "BlueStar Range Repair Los Angeles — Same Day";
const description = "BlueStar range repair in Los Angeles: open-burner RNB, RCS and Platinum ranges, burner ignition, ovens, broilers. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/bluestar-stove-repair/";

const faqs = [
  { q: "Why does my BlueStar burner click but not light?", a: "Most often the igniter is wet or dirty after a spill or cleaning, or the burner ports are clogged. Let the range dry for several hours, clear the ports with the range off and cool, and check that the burner sits flat. If it still won't light, the igniter or spark module is tested." },
  { q: "My BlueStar keeps clicking even with the burners off. What's wrong?", a: "Usually moisture or grease in one of the spark switches on the valve stems, which tells the spark module a burner is turned on. Drying out sometimes cures it; otherwise the switch or the module is replaced." },
  { q: "Why won't my BlueStar oven heat?", a: "The oven igniter is the first suspect. It heats the gas safety valve open, and a weak igniter can still glow while the valve stays shut. After that come the safety valve and the thermostat." },
  { q: "Is it a stove or a range?", a: "Same thing. BlueStar calls its freestanding cookers ranges; many owners call them stoves. This page covers BlueStar ranges and their ovens; built-in BlueStar wall ovens have their own page." },
  { q: "How much does BlueStar range repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. An igniter replacement typically runs $150–$240; other repairs are quoted in writing after the diagnostic, and every repair carries a 90-day warranty on parts and labor." },
  { q: "Do you have to pull the range out from the wall?", a: "Not for most repairs. Burner ignition, the oven igniter and the broiler are reached from the top and from inside the oven. Pulling the range out comes up for some valve and wiring work, and we say so before moving it." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "BlueStar Range Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "BlueStar", "item": "https://samedayappliance.repair/brands/bluestar/" },
      { "@type": "ListItem", "position": 4, "name": "Range Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="bluestar-stove-repair"
    logoSlug="bluestar"
    eyebrow={"BlueStar · RNB · RCS · Platinum"}
    title={"BlueStar Range Repair in Los Angeles"}
    subtitle={"Burners that click but won't light, clicking that won't stop, an oven that won't heat or a broiler that stays dark — diagnosed and repaired on site."}
    heroImageTitle={"BlueStar Range Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/bluestar/">BlueStar</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Range Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>Open burners make a BlueStar different to repair</h2>
      <p>BlueStar ranges are built in Reading, Pennsylvania, by Prizer-Painter, and they are closer to restaurant equipment than most home ranges. Owners often call them stoves; BlueStar calls them ranges. The defining feature is the open burner: instead of a sealed cooktop with burners mounted on top, the burners sit open over a removable drip tray, as on a commercial range.</p>
      <p>That design is why BlueStar owners love the flame, and it is also why ignition problems are the most common call. Boil-overs and cleaning water go straight down around the burner and the igniter beneath it, so a burner that clicks without lighting is very often a wet or dirty igniter or a clogged burner, not a failed part. The oven and the infrared broiler have their own ignition, and their own list of usual suspects.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which BlueStar do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on a plate usually found behind the kick panel or on the frame when the oven door is open. Width, fuel type and whether your range has a griddle or charbroiler all help us bring the right parts.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>RNB series</h3>
          <p class="model-list">RNB</p>
          <p>The most common BlueStar range in Los Angeles kitchens: open burners, a large oven and an infrared broiler, in 24- to 60-inch widths.</p>
          <p class="fails"><strong>What we see fail:</strong> burner ignition (igniters, spark module, the switches on the valve stems), clogged burner ports, the oven igniter and thermostat, the broiler, and oven door hinges and springs.</p>
        </div>
        <div class="model-card">
          <h3>RCS Culinary series</h3>
          <p class="model-list">RCS</p>
          <p>A simpler BlueStar range with the same open-burner cooktop and fewer features in the oven.</p>
          <p class="fails"><strong>What we see fail:</strong> the same burner ignition items, the oven igniter and safety valve, and the thermostat.</p>
        </div>
        <div class="model-card">
          <h3>Platinum series</h3>
          <p class="model-list">BSP</p>
          <p>The top BlueStar ranges, with higher-output burners and options such as griddles and charbroilers, and a convection oven.</p>
          <p class="fails"><strong>What we see fail:</strong> burner ignition, the convection fan motor, the oven igniter, the infrared broiler, and griddle and charbroiler burners.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your BlueStar is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Burner clicks but won't light</td><td>A wet or dirty igniter after a spill or cleaning, clogged burner ports, a burner not seated properly, then the igniter and the spark module.</td></tr>
          <tr><td>Clicking that won't stop, even with the burners off</td><td>Moisture or grease in the spark switch on a valve stem, then the spark module.</td></tr>
          <tr><td>Oven won't heat, or heats slowly</td><td>The oven igniter first, then the gas safety valve and the thermostat.</td></tr>
          <tr><td>Oven temperature off</td><td>The thermostat and its sensing bulb, the door closing tight, then the door hinges and seal.</td></tr>
          <tr><td>Infrared broiler won't light</td><td>The broiler igniter and its valve.</td></tr>
          <tr><td>Convection fan not running (Platinum)</td><td>The convection fan motor and its wiring.</td></tr>
          <tr><td>Yellow, lazy or uneven flame</td><td>Burner ports clogged by spills, a burner not seated, then the air shutter and the gas supply.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Ignition</p>
      <h2>Most BlueStar burner problems are cleaning problems</h2>
      <p>Each open burner is lit by a spark igniter, fed by a spark module that fires whenever any burner knob is turned. Water and grease are their enemies. After a boil-over or a thorough cleaning, a damp igniter or spark switch can cause a burner that won't light, or clicking that won't stop. Often the fix is to let the range dry out completely, clear the burner ports, and seat the burner properly.</p>
      <p>When drying out doesn't help, the technician tests the igniter, the switches on the valve stems and the spark module in turn and replaces only the part that fails. The oven is different: its igniter heats the gas safety valve open, so a weak oven igniter shows up as an oven that heats slowly or not at all, even though the igniter still glows.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Let it dry.</strong> If the problem started after cleaning or a spill, leave the range off for several hours and try again.</li>
        <li><strong>Check the burner ports.</strong> With the range off and cool, clear any blocked ports with a straightened paper clip — not a toothpick, which can break off — and make sure the burner sits flat.</li>
        <li><strong>Check the power.</strong> A BlueStar plugs into a regular outlet for ignition and the oven light; a tripped breaker or GFCI means no spark at all.</li>
        <li><strong>Note which burner, and what you hear.</strong> Clicking but no flame, or clicking that won't stop, point at different parts.</li>
        <li><strong>Oven not heating?</strong> Watch through the window: if the igniter glows for a long time before the flame appears, or never lights it, tell us.</li>
      </ul>
      <p>If you smell gas, turn the burners off, close the gas supply valve behind the range if you can reach it, ventilate, and call the gas company before calling us.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>An oven or burner igniter replacement typically runs $150–$240. Other BlueStar repairs depend on the model and the part, so we quote them after the diagnostic rather than guessing over the phone. Most work is done with the range in place; when it has to be pulled out from the wall, we say so first.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of BlueStar's own service network — if your BlueStar is still inside its factory warranty, call BlueStar first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More BlueStar service</p>
      <h2>Other BlueStar repairs</h2>
      <div class="cat-grid">
        <a href="/brands/bluestar/" class="cat-card">
          <h3>BlueStar repair (all products)</h3>
          <p>Every BlueStar line we work on, in one place.</p>
        </a>
        <a href="/brands/bluestar-wall-oven-repair/" class="cat-card">
          <h3>BlueStar wall oven repair</h3>
          <p>Built-in BlueStar wall ovens.</p>
        </a>
        <a href="/brands/bluestar-range-hood-repair/" class="cat-card">
          <h3>BlueStar range hood repair</h3>
          <p>Hoods and ventilation.</p>
        </a>
        <a href="/brands/bluestar-refrigerator-repair/" class="cat-card">
          <h3>BlueStar refrigerator repair</h3>
          <p>BlueStar refrigeration.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>BlueStar range repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>BlueStar won't light? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
