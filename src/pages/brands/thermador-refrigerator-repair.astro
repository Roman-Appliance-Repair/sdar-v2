---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, FAQ from one array; boilerplate price table, warranty block and service-area grid removed. No Fixar case on record for Thermador refrigeration yet.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Thermador Refrigerator Repair Los Angeles — Same Day";
const description = "Thermador refrigerator repair in Los Angeles: Freedom columns, built-in French door models and ice makers. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/thermador-refrigerator-repair/";

const faqs = [
  { q: "One of my Thermador columns is warm but the others are fine. Why?", a: "Each Freedom column is a separate appliance with its own compressor and cooling circuit, so the fault is in that column alone. The usual causes are its evaporator fan, a coil iced over by a defrost fault, or blocked condenser airflow; a sealed-system problem is less common and is confirmed with measurements before it is quoted." },
  { q: "My Thermador shows lights and a normal display but isn't cold. Is the control broken?", a: "Usually not. A working display with a warm cabinet points at the cooling side: the compressor not starting, a fan not running, or, less often, the sealed system. We check those in that order." },
  { q: "Why does my Thermador door alarm keep going off?", a: "Most often the door is not fully closing: hinge or closer adjustment, a heavy custom panel pulling the door out of line, or something inside blocking it. If the door is closing properly and the alarm continues, we check the door switch." },
  { q: "Do you have to take a Thermador column out of the cabinetry?", a: "Rarely. Fans, defrost parts, ice makers, valves, hinges and gaskets are serviced in place. Removal comes up mainly for sealed-system work, and the quote says so before anything is moved." },
  { q: "Do Thermador refrigerators have error codes?", a: "They mostly use door-ajar and high-temperature alarms rather than a numbered code list. The long E-code tables posted online for Thermador refrigerators are not something we have been able to confirm, so we diagnose from the symptoms and measurements instead." },
  { q: "How much does Thermador refrigerator repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. Repairs are quoted in writing after the diagnostic, before work starts, and carry a 90-day warranty on parts and labor." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [

];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Thermador Refrigerator Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Thermador", "item": "https://samedayappliance.repair/brands/thermador/" },
      { "@type": "ListItem", "position": 4, "name": "Refrigerator Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="thermador-refrigerator-repair"
    logoSlug="thermador"
    eyebrow={"Thermador · Freedom Collection"}
    title={"Thermador Refrigerator Repair in Los Angeles"}
    subtitle={"Warm Freedom columns, frost, no ice, door alarms — diagnosed one column at a time, with your panels and cabinetry left in place."}
    heroImageTitle={"Thermador Refrigerator Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/thermador/">Thermador</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Refrigerator Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">How Thermador refrigeration is built</p>
      <h2>Freedom columns: separate appliances that look like one</h2>
      <p>Most Thermador refrigeration we see in Los Angeles is the <strong>Freedom Collection</strong>: refrigerator, freezer and wine columns installed side by side behind custom panels. They read as one wall of cabinetry, but each column is its own appliance with its own compressor, controls and cooling circuit. A warm refrigerator column next to a perfectly cold freezer column is not one fault spreading — it is a fault in that column alone.</p>
      <p>The rest is built-in French-door and bottom-freezer refrigeration, where the fresh-food and freezer sections share one chassis. Either way, the panels and millwork around a Thermador are part of the kitchen, so the default is to repair from the front and inside the cabinet and to leave the unit in its opening.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Thermador you have, and what tends to fail</h2>
      <p>The rating label with model and serial is inside the fresh-food compartment, usually on a side wall near the top. On columns, each one has its own label.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Freedom refrigerator columns</h3>
          <p class="model-list">T18IR · T24IR · T30IR · T36IR</p>
          <p>Panel-ready all-refrigerator columns, 18 to 36 inches wide, in Masterpiece and Professional versions.</p>
          <p class="fails"><strong>What we see fail:</strong> evaporator fan motors, defrost faults that ice the coil, condenser airflow, door hinge and closing problems that break the seal, interior LED strips.</p>
        </div>
        <div class="model-card">
          <h3>Freedom freezer columns</h3>
          <p class="model-list">T18IF · T24IF · T30IF</p>
          <p>The matching all-freezer columns, most with an ice maker at the top of the cavity.</p>
          <p class="fails"><strong>What we see fail:</strong> ice makers and water inlet valves, frozen fill tubes, frost build-up from a door or drawer not sealing, defrost heaters.</p>
        </div>
        <div class="model-card">
          <h3>Wine columns</h3>
          <p class="model-list">T18IW · T24IW</p>
          <p>Wine preservation columns with one or two temperature zones. They run warmer than a refrigerator, so the cooling system works less hard.</p>
          <p class="fails"><strong>What we see fail:</strong> zone temperature drift from a sensor, fan noise, lighting. See <a href="/brands/thermador-wine-cooler-repair/">Thermador wine cooler repair</a>.</p>
        </div>
        <div class="model-card">
          <h3>Built-in French door and bottom-freezer</h3>
          <p class="model-list">T36IT and earlier 36-inch built-ins</p>
          <p>Fresh food and freezer in one chassis. More common in kitchens built before the Freedom columns took over.</p>
          <p class="fails"><strong>What we see fail:</strong> evaporator fans, defrost components, the ice maker and its water valve, door gaskets, drawer slides.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What the refrigerator is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>One column warm, the others fine</td><td>That column only: its evaporator fan, a frosted coil from a defrost fault, its condenser airflow, then its compressor starting.</td></tr>
          <tr><td>Display and lights on, cabinet warm</td><td>The cooling side, not the controls: compressor start, fans, then the sealed system.</td></tr>
          <tr><td>Compressor runs constantly, still warm</td><td>Condenser coil blocked with dust, an evaporator fan that stopped, then a refrigerant problem.</td></tr>
          <tr><td>Door alarm that won't stop, or door won't stay shut</td><td>Hinge and closer adjustment, panel weight and alignment, something blocking the door, then the door switch.</td></tr>
          <tr><td>Frost inside, sweating outside the door</td><td>Gasket and door alignment first; then the defrost system that can't keep up with the extra moisture.</td></tr>
          <tr><td>Water pooling at the bottom of the cavity</td><td>A blocked or frozen defrost drain.</td></tr>
          <tr><td>No ice, or small hollow cubes</td><td>Water supply and filter, a frozen fill tube, the water inlet valve, then the ice maker.</td></tr>
          <tr><td>Condensation where two columns meet</td><td>The gap between columns and how the panels and seals sit there.</td></tr>
        </tbody>
      </table>
      <p class="footnote">Thermador refrigerators mostly signal problems with door-ajar and high-temperature alarms rather than a numbered error code list. The long E-code tables posted online for Thermador refrigerators are not something we have been able to confirm against Thermador documentation.</p>
    </div>
  </section>

  <!-- ── SEALED SYSTEM ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Sealed-system notes</p>
      <h2>When a warm column is a refrigerant problem — and when it isn't</h2>
      <p>Most warm-column calls end at airflow and defrost: a stopped fan, an iced-over coil, a condenser that can't shed heat because it is coated in dust from the kitchen. Those repairs happen in place.</p>
      <p>A sealed-system fault looks different: the compressor runs but the evaporator never gets properly cold, or the compressor won't start even with good start components. That work — finding a leak or replacing a compressor, brazing, evacuating and recharging with the exact refrigerant charge — affects only the column it is in. It is also the one repair where a column may need to come out of its opening, and if that is the case the quote says so before anything is moved.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which column or section is warm</strong>, and the temperature if you have a thermometer.</li>
        <li><strong>Check the door closes on its own</strong> and nothing inside — a shelf, a tall bottle, a drawer — is holding it open.</li>
        <li><strong>Look for an open water valve and a filter change date</strong> if only the ice maker has stopped.</li>
        <li><strong>Check that the column has power</strong> and hasn't been switched off or set to a showroom or vacation mode; the owner's manual shows how.</li>
        <li><strong>Don't chip ice from the coil</strong> or the drain; the liner and coil puncture easily.</li>
      </ul>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Thermador refrigerator repairs are quoted in writing after the diagnostic, once we know which column and which part. If a sealed-system repair or a column removal is needed, it is in the quote before work starts.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Thermador's own service network — if your Thermador refrigerator is still inside its factory warranty, call Thermador first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Thermador service</p>
      <h2>Other Thermador repairs</h2>
      <div class="cat-grid">
        <a href="/brands/thermador/" class="cat-card">
          <h3>Thermador appliance repair (all products)</h3>
          <p>Every Thermador line we work on.</p>
        </a>
        <a href="/brands/thermador-built-in-refrigerator-repair/" class="cat-card">
          <h3>Thermador built-in refrigerator repair</h3>
          <p>Panel-ready built-in installs and cabinetry-safe access.</p>
        </a>
        <a href="/brands/thermador-wine-cooler-repair/" class="cat-card">
          <h3>Thermador wine cooler repair</h3>
          <p>Wine columns and undercounter wine storage.</p>
        </a>
        <a href="/brands/thermador-dishwasher-repair/" class="cat-card">
          <h3>Thermador dishwasher repair</h3>
          <p>Panel-ready and stainless dishwashers.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Thermador refrigerator repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Thermador column running warm? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
