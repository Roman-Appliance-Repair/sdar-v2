---
// /brands/elmira-stove-works-repair/ — Luxury Wave L-3. Elmira Stove Works (Ontario, 1975).
// NEW. Canadian, Plaintree Systems Inc. (2022) subsidiary, ACTIVE production, dedicated
// Parts & Service line, ~300 NA dealers -> parts available, low orphan risk. Northstar
// (1950s retro: ranges, 3 fridges, hoods, microwave, dishwasher panels) + Antique/Heritage
// (Victorian styling, incl. WOOD cookstoves). FOCUS on retro GAS/ELECTRIC ranges + fridges +
// hoods (wood cookstoves noted but NOT emphasized — SCAQMD adjacency + specialist). NO
// sourced failure -> wear items. $89 residential. Verified: elmirastoveworks.com + Plaintree.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

const title = "Elmira Stove Works Repair Los Angeles";
const description = "Elmira Stove Works repair across LA — Northstar 1950s retro ranges, refrigerators, and hoods. Gas and electric retro appliance service, parts from an active Canadian factory. $89 diagnostic.";
const canonical = "https://samedayappliance.repair/brands/elmira-stove-works-repair/";

const faqs = [
  { q: "Who makes Elmira Stove Works, and is it still in business?", a: "Elmira Stove Works is a Canadian retro-appliance maker founded in 1975 in Elmira, Ontario. It's very much still in business — since 2022 it's been a wholly-owned subsidiary of Plaintree Systems Inc., operating from Plaintree's Arnprior, Ontario facility, and it still manufactures its retro lines with a dealer network across North America. That active-manufacturer status is the key fact for repair: because Elmira is still producing and runs a dedicated parts-and-service operation, genuine parts are obtainable rather than orphaned. Our techs source Elmira components through that channel for the Northstar and other retro appliances we service in LA. $89 residential diagnostic, waived with repair." },
  { q: "What Elmira appliances do you service in LA?", a: "We focus on Elmira's modern retro appliances — the Northstar 1950s line, which includes gas and electric ranges, refrigerators, and range hoods styled to the era but built with contemporary gas burners, electric elements, and refrigeration. Those are standard gas-and-electric appliance repairs behind vintage styling: burners, igniters, valves, oven elements and thermostats on the ranges, and the compressor, evaporator fan, and defrost system on the retro refrigerators. Elmira also builds an Antique/Heritage line in Victorian styling; for the gas and electric models in that line the service is the same, and we'll advise honestly on anything outside standard gas-and-electric appliance work when you call with your model." },
  { q: "My Elmira Northstar range oven or burner isn't working — what's the fix?", a: "Behind the 1950s look, a Northstar range is a modern gas or electric range, so the diagnosis is standard. On a gas Northstar our techs test the oven igniter (a weak igniter that won't open the gas valve is the classic no-light), the gas valve, and the thermocouple, and check the oven thermostat with a metered thermometer for off-temperature baking. On an electric Northstar it's the bake element, the temperature sensor, and calibration. The retro styling doesn't change the repair — it's the same serviceable gas-and-element work, with genuine Elmira parts sourced through the factory's parts channel. $89 residential diagnostic, waived with repair." },
  { q: "Can you service an Elmira Northstar retro refrigerator?", a: "Yes. The Northstar refrigerator is a modern fridge in 1950s dress — a real compressor, evaporator fan, and defrost system under the rounded retro cabinet — so our techs service it the way we service any refrigerator: dirty condenser coils, a failed evaporator fan, a defrost fault, a start relay, or a sealed-system issue on the serious end. The vintage look is cosmetic; the cooling is contemporary and diagnosable. Because Elmira is an active manufacturer, the parts are available, so a Northstar fridge that stops cooling is a normal repair, not an orphan-brand dead end." },
  { q: "Is an Elmira worth repairing?", a: "Almost always. Elmira's retro appliances are premium-priced — a retro range or refrigerator runs several thousand dollars — and, crucially, Elmira is still manufacturing with a live parts-and-service operation, so components are obtainable. That combination lands repair-versus-replace firmly on repair: a burner, an igniter, an element, a thermostat, or a fridge fan is a fraction of replacement, and there's no orphan-brand parts problem to worry about. Retro appliances also tend to be chosen for a specific kitchen aesthetic, so keeping the original is usually what owners want. We'll give you the honest number, but on an Elmira the answer is nearly always repair." },
  { q: "How fast can you reach an Elmira in LA?", a: "Same-day in most cases across Los Angeles, the Westside, Orange County, Ventura, San Bernardino, and Riverside — we answer the phone 24/7. Elmira is a niche brand in LA, so a specific genuine part may need to come through the Canadian factory's parts channel, and we'll give you that timeline honestly at the diagnostic; the common gas-and-element and refrigeration wear parts are the obtainable ones. Retro-appliance owners tend to be in design-forward homes across the Westside and the historic neighborhoods, which are well within our densest service areas. $89 residential diagnostic, waived with repair." }
];

const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", "serviceType": "Elmira Stove Works Repair", "provider": { "@id": canonical + "#org" }, "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ], "description": "Elmira Stove Works repair across Los Angeles and SoCal. Northstar 1950s retro gas and electric ranges, refrigerators, and range hoods — igniters, valves, elements, thermostats, and refrigeration service behind vintage styling. Genuine parts from Elmira's active Canadian factory. $89 residential diagnostic, waived with repair." },
  { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '') } })) },
  { "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" }, { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" }, { "@type": "ListItem", "position": 3, "name": "Elmira Stove Works Repair", "item": canonical } ] }
] };

const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="call-banner"><div class="wrap"><span>Elmira needs service? Same-day across LA:</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>
  <ServiceHero
    section="brands"
    slug="elmira-stove-works-repair"
    eyebrow={"Elmira Stove Works Repair"}
    title={"Elmira Stove Works Repair, Los Angeles & SoCal"}
    subtitle={description}
    heroImageTitle={"Elmira Northstar Retro Appliance Repair"}
  />

  <BrandBranchesGrid />
  <section class="trust-bar"><div class="wrap"><span>Licensed BHGS #A49573 · Insured</span><span>Same-day · 5 SoCal counties</span><span>$89 residential diagnostic · waived with repair</span></div></section>

  <section class="section"><div class="wrap narrow">
    <h2>Elmira Stove Works — retro looks, modern parts</h2>
    <p>Elmira Stove Works has built retro appliances in Elmira, Ontario since 1975, and its Northstar line is the 1950s-styled range, refrigerator, and hood you'll find in design-forward LA kitchens that want vintage character without vintage reliability problems. The important thing for repair is that Elmira is still an active manufacturer — a wholly-owned subsidiary of Plaintree Systems since 2022, running a dedicated parts-and-service operation and a North American dealer network. That means genuine parts are obtainable, and a Northstar range or fridge never becomes an orphan you can't get components for. Behind the rounded chrome and the era styling, a Northstar is a modern gas or electric appliance, and our techs service it as exactly that. $89 residential diagnostic, waived with repair, BHGS #A49573, EPA 608 Universal certified (#1346255700410).</p>
    <p>That's the whole trick with a good retro brand: the look is 1950s, but the burners, elements, thermostats, and refrigeration are contemporary and diagnosable. So a Northstar oven that won't light is a standard gas-oven repair, and a Northstar fridge that stops cooling is a standard refrigeration diagnosis — the vintage cabinet doesn't change the fix. With Elmira's factory parts channel open, those repairs are fast and the appliance is worth keeping, which is exactly what retro owners want.</p>
  </div></section>

  <section class="section alt"><div class="wrap">
    <h2>Elmira retro appliances we service</h2>
    <div class="model-grid">
      <div class="model-card"><h3>Northstar gas ranges</h3><p>1950s-styled gas ranges with modern sealed or open burners and gas ovens. Service: oven igniter, gas valve, thermocouple, oven thermostat, burner components.</p></div>
      <div class="model-card"><h3>Northstar electric ranges</h3><p>Electric Northstar ranges — bake element, temperature sensor, oven thermostat, and calibration behind the retro styling.</p></div>
      <div class="model-card"><h3>Northstar refrigerators</h3><p>Retro-cabinet refrigerators with modern cooling — compressor, evaporator fan, defrost system, start relay, door seal. A standard fridge diagnosis under a 1950s shell.</p></div>
      <div class="model-card"><h3>Northstar range hoods</h3><p>Matching retro ventilation — fan motor, switch, and lighting service.</p></div>
      <div class="model-card"><h3>Retro microwaves &amp; panels</h3><p>Elmira's era-styled microwave and the dishwasher-panel options that dress a standard dishwasher in Northstar trim.</p></div>
      <div class="model-card"><h3>Antique / Heritage (gas &amp; electric)</h3><p>Elmira's Victorian-styled line. For the gas and electric models the service is standard gas-and-element work; we'll advise honestly on anything outside that scope when you call with your model.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="wrap narrow">
    <h2>Why Elmira stays worth repairing</h2>
    <p>Two things make an Elmira an easy repair-versus-replace call. First, the appliances are premium — a retro range or refrigerator runs several thousand dollars — so a modest wear-item repair is a small fraction of replacement. Second, and more important than on many niche brands, Elmira is still manufacturing with a live parts operation, so there's no orphan-brand problem where a dead part totals the appliance. A burner, an igniter, an element, a thermostat, or a refrigerator fan is obtainable and worth fitting.</p>
    <p>Retro appliances are also chosen for a specific kitchen look, so replacing one usually means redesigning around a new unit that may not match. Keeping the original is almost always what owners want and what makes sense. Our techs diagnose at the $89 visit, source genuine Elmira parts through the factory channel, and give you the honest timeline — the common wear parts are the fast ones, and a specialty part comes through the Canadian factory with a stated lead time.</p>
  </div></section>

  <section class="section alt"><div class="wrap narrow">
    <h2>Related retro &amp; premium pages</h2>
    <ul class="related-links">
      <li><a href="/brands/big-chill-refrigerator-repair/">Big Chill retro appliance repair Los Angeles</a> — the American retro maker</li>
      <li><a href="/brands/heartland-appliance-repair/">Heartland appliance repair Los Angeles</a> — retro sibling (discontinued, honest parts service)</li>
      <li><a href="/brands/smeg/">Smeg repair Los Angeles</a> — Italian retro styling</li>
      <li><a href="/services/oven-repair/">All oven &amp; range repair in Los Angeles →</a></li>
      <li><a href="/services/refrigerator-repair/">All refrigerator repair in Los Angeles →</a></li>
      <li><a href="/beverly-hills/">Beverly Hills service area</a> · <a href="/pasadena/">Pasadena service area</a></li>
    </ul>
  </div></section>

  <section class="section"><div class="wrap narrow"><h2>Elmira Stove Works repair, frequently asked</h2>{faqs.map(f => <details class="faq"><summary>{f.q}</summary><p set:html={f.a}></p></details>)}</div></section>

  <section id="book" class="cta-bottom"><div class="wrap"><h2>Elmira need service? Call the branch nearest your kitchen.</h2><p>Same-day across LA, the Westside, Orange County, Ventura, San Bernardino, and Riverside. $89 residential diagnostic, waived with repair.</p></div></section>
</Layout>

<style>
  body { color: var(--text); } .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; } .wrap.narrow { max-width: 820px; }
  h1 { font-size: 2.4rem; line-height: 1.15; margin: 12px 0 20px; color: var(--black); } h2 { font-size: 1.8rem; margin: 0 0 16px; color: var(--black); } h3 { font-size: 1.2rem; margin: 0 0 10px; color: var(--black); } p { line-height: 1.65; margin: 0 0 14px; }
  .call-banner { background: var(--red); color: #fff; padding: 10px 0; } .call-banner .wrap { display:flex; gap: 14px; align-items: center; justify-content: center; flex-wrap: wrap; } .call-banner .phone-lg { color:#fff; font-weight: 800; text-decoration: underline; font-size: 1.05rem; }
  .trust-bar { background: var(--red); color: #fff; padding: 14px 0; } .trust-bar .wrap { display: flex; gap: 28px; flex-wrap: wrap; justify-content: center; font-size: 0.95rem; font-weight: 600; }
  .section { padding: 56px 0; } .section.alt { background: var(--gray); }
  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 24px; } .model-card { background: #fff; border: 1px solid var(--border); padding: 20px; border-radius: 6px; }
  .related-links { list-style: none; padding: 0; } .related-links li { padding: 10px 0; border-bottom: 1px solid var(--border); } .related-links a { color: var(--red); font-weight: 600; text-decoration: none; } .related-links a:hover { text-decoration: underline; }
  .faq { background: #fff; border: 1px solid var(--border); padding: 12px 16px; margin-bottom: 8px; border-radius: 4px; } .faq summary { font-weight: 700; cursor: pointer; padding: 4px 0; } .faq p { margin: 8px 0 0; }
  .cta-bottom { background: var(--black); color: #fff; padding: 48px 0; } .cta-bottom h2 { color: #fff; } .cta-bottom p { color: #c9c9c9; }
  @media (max-width: 820px) { h1 { font-size: 1.9rem; } h2 { font-size: 1.45rem; }  .trust-bar .wrap { gap: 14px; font-size: 0.85rem; } }
</style>
