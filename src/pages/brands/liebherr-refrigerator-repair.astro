---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Liebherr Refrigerator Repair Los Angeles — Same Day";
const description = "Liebherr refrigerator repair in Los Angeles: Monolith columns, built-ins and freestanding models with BioFresh. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/liebherr-refrigerator-repair/";

const faqs = [
  { q: "Why is my Liebherr refrigerator warm when the freezer is cold?", a: "Usually the fan or air supply for the refrigerator section has stopped, or the evaporator has iced over because of a defrost fault. We check airflow and defrost first. On a Monolith column pair, only the warm column has a problem." },
  { q: "Why is my BioFresh drawer freezing the vegetables?", a: "BioFresh drawers run just above freezing by design. Check the setting first and make sure food isn't packed against the air openings. If produce still freezes, the drawer's temperature control and sensor are tested." },
  { q: "Why is ice building up on the back wall of my freezer?", a: "On a NoFrost freezer that points at the defrost system — the heater, its sensor or the drain — or at a door that isn't sealing and lets humid air in." },
  { q: "Do you have to pull a built-in Liebherr out of the cabinet?", a: "Rarely. Fans, defrost parts, valves, gaskets and ice makers are serviced with the unit in place. Removal comes up mainly for some sealed-system work, and if it is needed the quote says so first." },
  { q: "How much does Liebherr refrigerator repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, with the part lead time, and carries a 90-day warranty on parts and labor." },
  { q: "Are Liebherr parts hard to get?", a: "Some ship from Europe and take longer than domestic parts. We check availability with your model number and include the lead time in the quote." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Liebherr Refrigerator Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Liebherr", "item": "https://samedayappliance.repair/brands/liebherr/" },
      { "@type": "ListItem", "position": 4, "name": "Refrigerator Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="liebherr-refrigerator-repair"
    logoSlug="liebherr"
    eyebrow={"Liebherr · Monolith · Built-in · BioFresh"}
    title={"Liebherr Refrigerator Repair in Los Angeles"}
    subtitle={"Warm compartment, a BioFresh drawer freezing the produce, ice on the back wall or an ice maker that quit — diagnosed in place, panels left on."}
    heroImageTitle={"Liebherr Refrigerator Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/liebherr/">Liebherr</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Refrigerator Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>A refrigeration specialist, and it shows in the repairs</h2>
      <p>Liebherr is a family-owned German company, and refrigeration is the only kind of home appliance it makes. In Los Angeles kitchens that means three kinds of units: Monolith fully integrated columns, built-in refrigerators and combinations designed to sit behind cabinet panels or in a stainless finish, and freestanding counter-depth models.</p>
      <p>Two features come up again and again on service calls. BioFresh drawers hold fruit, vegetables, meat and fish just above freezing, so a drawer that freezes produce or runs warm is its own diagnosis. And the freezers are mostly NoFrost, which means a fan and a defrost system that, when they fail, show up as a warm unit or ice building on the back wall.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Liebherr do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on the rating plate inside the refrigerator, usually on the side wall near the crisper drawers. Reading them to us lets the technician bring the right parts; some Liebherr parts ship from Europe.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Monolith columns</h3>
          <p>Fully integrated refrigerator, freezer and wine columns, installed alone or side by side behind custom panels. Each column is a separate appliance.</p>
          <p class="fails"><strong>What we see fail:</strong> evaporator fans and defrost faults within one column, ice makers in freezer columns, and door hinges and panel alignment that break the seal.</p>
        </div>
        <div class="model-card">
          <h3>Built-in refrigerators and combinations</h3>
          <p>Panel-ready and stainless built-ins, including refrigerator-freezer combinations with BioFresh drawers. Some combinations cool the refrigerator and freezer with separate circuits.</p>
          <p class="fails"><strong>What we see fail:</strong> condenser airflow through the ventilation grille, BioFresh drawer temperatures, fans and defrost, door gaskets, and the ice maker and water valve.</p>
        </div>
        <div class="model-card">
          <h3>Freestanding and counter-depth</h3>
          <p>Freestanding refrigerators and bottom-freezer combinations.</p>
          <p class="fails"><strong>What we see fail:</strong> dust on the condenser, fans, the defrost drain and door seals.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Liebherr is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Refrigerator section warm, freezer still cold</td><td>That section's fan and air supply, an evaporator iced over from a defrost fault, then the sensor and control.</td></tr>
          <tr><td>Whole unit slowly warming</td><td>Dust on the condenser and a blocked ventilation grille, the condenser fan, the compressor start components, then the electronics.</td></tr>
          <tr><td>BioFresh drawer freezing produce or running warm</td><td>The drawer setting, food blocking the air path, then the drawer's temperature control and sensor.</td></tr>
          <tr><td>Ice on the back wall of a NoFrost freezer</td><td>The defrost heater and its sensor, the drain, and a door that isn't sealing.</td></tr>
          <tr><td>Water under the drawers or on the floor</td><td>A blocked or frozen defrost drain; on ice maker models, the water line and valve.</td></tr>
          <tr><td>Temperature alarm or door alarm</td><td>A door not closing fully — often panel alignment — then the sensor.</td></tr>
          <tr><td>Ice maker stopped, everything else cold</td><td>Water supply and filter, a frozen fill tube, the water inlet valve, then the ice maker.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">BioFresh</p>
      <h2>BioFresh is meant to be colder than the rest of the refrigerator</h2>
      <p>BioFresh drawers run just above freezing, colder than the main compartment, which is what keeps produce, meat and fish fresh longer. That design also explains the most common BioFresh complaint: a setting turned too low, or a drawer packed tight against its air openings, freezes lettuce and herbs while everything else looks fine.</p>
      <p>So the first steps are the setting and the load. If the drawer still freezes produce, or runs warm with the main compartment cold, the drawer's temperature control and sensor are tested. It is a contained repair; the rest of the refrigerator is not involved.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which compartment is warm</strong> and, if you have a thermometer, the temperature in each. On column pairs, note which column.</li>
        <li><strong>Find the ventilation grille</strong> and make sure nothing blocks it. On freestanding models, check the condenser for dust with the power off.</li>
        <li><strong>Check the BioFresh setting</strong> if produce is freezing — a setting change is the first thing to rule out.</li>
        <li><strong>Check the seal.</strong> Close a dollar bill in the door at a few points; if it slides out with no drag, that spot isn't sealing.</li>
        <li><strong>Ice maker only?</strong> Confirm the water supply valve is open and note when the filter was last changed.</li>
      </ul>
      <p>Please don't chip ice off the back wall or use a heat gun inside the cabinet; the evaporator and the liner are easy to puncture.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Liebherr refrigerator repairs depend on the model and the part, so we quote them after the diagnostic. Some parts come from Europe; we tell you the lead time with the quote, and stock-common items are often on the truck.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Liebherr's own service network — if your Liebherr is still inside its factory warranty, call Liebherr first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Liebherr service</p>
      <h2>Other Liebherr repairs</h2>
      <div class="cat-grid">
        <a href="/brands/liebherr/" class="cat-card">
          <h3>Liebherr repair (all products)</h3>
          <p>Every Liebherr line we work on, in one place.</p>
        </a>
        <a href="/brands/liebherr-built-in-refrigerator-repair/" class="cat-card">
          <h3>Liebherr built-in refrigerator repair</h3>
          <p>Panel-ready built-ins and Monolith columns.</p>
        </a>
        <a href="/brands/liebherr-wine-cooler-repair/" class="cat-card">
          <h3>Liebherr wine cooler repair</h3>
          <p>Wine columns and wine storage.</p>
        </a>
        <a href="/services/refrigerator-repair/" class="cat-card">
          <h3>Refrigerator repair (all brands)</h3>
          <p>Every refrigerator brand we service.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Liebherr refrigerator repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Liebherr running warm? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
