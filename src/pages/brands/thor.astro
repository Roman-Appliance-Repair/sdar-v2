// src/pages/brands/thor.astro
// Thor Kitchen brand pillar (residential, value pro-style). Lighter (~2500w).
// Structure cloned from brands/bluestar.astro; schema from Bull/Blaze (mergeCredentials + location array).
// Verified models only (web-checked): gas HRG3080U (30"), HRG3618U (36"), HRG4808U / HRG4808ULP (48",
//   double oven + griddle); dual-fuel HRD3088U / HRD3088ULP (30"), HRD line parallels HRG.
//   Known features: 18,000 BTU burners, cast-iron grates, blue porcelain oven interior, 3500W broil element, convection.
// Value-tier positioning: inexpensive, widely-available parts → repair beats replace.
// Voice: "our techs" / "we". Em-dash budget low.

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const phone = MAIN_PHONE;
const phoneRaw = MAIN_PHONE.replace(/\D/g, '');
const phoneHref = `tel:+1${phoneRaw}`;
const canonical = "https://samedayappliance.repair/brands/thor/";

const title = "Thor Kitchen Range Repair Los Angeles — Same Day";
const description = `Thor Kitchen professional range repair across SoCal. HRG gas and HRD dual-fuel, 30/36/48-inch. Inexpensive parts, fast turnaround. $89 diagnostic. ${phone}.`;

const faqs = [
  {
    q: "What Thor Kitchen appliances do you repair in Los Angeles?",
    a: "The Thor Kitchen pro-style cooking lineup. Gas ranges (HRG3080U 30-inch, HRG3618U 36-inch, HRG4808U and HRG4808ULP 48-inch with the double oven and griddle) and dual-fuel ranges (HRD3088U and HRD3088ULP 30-inch, and the wider HRD line). We also service Thor rangetops, wall ovens, and cooktops. Our techs at Same Day Appliance Repair cover the full Thor Kitchen cooking range across all five SoCal counties."
  },
  {
    q: "Thor Kitchen parts are inexpensive. Does that make repair worth it?",
    a: "Almost always. Thor Kitchen is a value pro-style brand: parts are inexpensive and widely available, not gated behind an authorized-service-only network the way Sub-Zero or Wolf parts are. A failed oven igniter, bake element, or spark module is a low-cost part plus our labor and the $89 diagnostic. Because a Thor range runs a couple thousand dollars new rather than ten-plus, a single-component repair is an easy call over replacement nearly every time, and the fast parts pipeline means we often finish same-day."
  },
  {
    q: "My Thor oven won't heat but the burners work. What is that?",
    a: "Burners lighting while the oven stays cold isolates the fault to the oven side, not the gas cooktop. On Thor gas ranges the usual cause is a weak or failed oven igniter that no longer glows hot enough to open the safety valve, so the oven never lights. On the dual-fuel HRD models with an electric oven, it is more often a failed bake element or an oven temperature sensor reading wrong. Our techs meter it down to the exact part on-site rather than guessing, and all of these are inexpensive Thor parts. $89 diagnostic, waived with repair."
  },
  {
    q: "The blue interior of my Thor oven, is that a coating that can fail?",
    a: "The blue porcelain oven interior is Thor's standard finish and it is durable, but like any porcelain enamel it can chip from a dropped rack or heavy impact. Chips are cosmetic and do not stop the oven from working; we do not recommend a full cavity replacement for cosmetic chipping since that math never favors the repair. If the oven has a functional problem (not heating, uneven baking, door seal), that is a component fault we diagnose and fix separately from the porcelain finish."
  },
  {
    q: "Do you install new Thor Kitchen ranges?",
    a: "No, we repair what is already installed. New range installation is a gas-line trade and custom cabinetry work is a fabrication trade, both outside appliance repair. If your Thor range is under its manufacturer warranty we can assess the failure and tell you whether it is warranty-eligible before any out-of-pocket work, and our own 90-day SDAR labor-and-parts warranty covers the repairs we perform. BHGS #A49573, BBB Accredited Business."
  }
];

const schemaJsons = [
  mergeCredentials({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": canonical + "#business",
    "name": "Same Day Appliance Repair",
    "url": canonical,
    "telephone": phone,
    "priceRange": "$$$",
    "address": {
      "@type": "PostalAddress",

      "addressLocality": "West Hollywood",
      "addressRegion": "CA",
      "postalCode": "90048",
      "addressCountry": "US"
    },
    "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
      ],
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "Thor Kitchen Range Repair",
    "name": "Thor Kitchen Appliance Repair Service",
    "url": canonical,
    "description": "Thor Kitchen professional-style range repair across all five SoCal counties. Gas ranges (HRG3080U 30-inch, HRG3618U 36-inch, HRG4808U and HRG4808ULP 48-inch double oven with griddle) and dual-fuel ranges (HRD3088U and HRD3088ULP 30-inch, plus the wider HRD line). Oven igniter, bake and broil element, oven temperature sensor, spark module, safety valve, and control service. Inexpensive, widely-available OEM parts. BHGS #A49573.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Residential diagnostic fee, applied toward repair"
      }
    },
    "brand": { "@id": canonical + "#brand" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Brand",
    "@id": canonical + "#brand",
    "name": "Thor Kitchen",
    "url": "https://www.thorkitchen.com/",
    "description": "Thor Kitchen is an American value pro-style appliance brand known for affordable professional-look gas and dual-fuel ranges with heavy cast-iron grates, high-BTU burners, and a signature blue porcelain oven interior. Product lines include the HRG gas ranges (30, 36, 48-inch) and the HRD dual-fuel ranges, plus rangetops, wall ovens, and cooktops."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Thor Kitchen", "item": canonical }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": canonical,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---

<Layout title={title} description={description} canonical={canonical}>

<Fragment slot="head-scripts">
  {schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}
</Fragment>

<ServiceHero
  section="brands"
  slug="thor"
  eyebrow="LA · Orange · Ventura · San Bernardino · Riverside Counties"
  title="Thor Kitchen Range Repair Los Angeles"
  subtitle={`HRG gas and HRD dual-fuel professional ranges, 30/36/48-inch. Cast-iron grates, high-BTU burners, blue porcelain ovens. Inexpensive parts, fast same-day turnaround. $89 diagnostic across five SoCal counties. ${phone}`}
  heroImageTitle="Thor Kitchen Range Repair"
  showBranches={true}
/>

<!-- 01 INTRO -->
<section class="section">
  <div class="container narrow">
    <p class="section-number">01, About this service</p>
    <h2 class="section-title">Thor Kitchen is the value pro-style range, and inexpensive parts make repair the easy call.</h2>

    <p class="intro-speakable">Thor Kitchen is an American brand that put the professional-range look, heavy cast-iron grates, high-BTU burners, stainless fronts, and a signature blue porcelain oven interior, at a price a fraction of Wolf or Viking. In our six-county SoCal territory Thor shows up in remodeled and new-build kitchens across the map, from the San Fernando Valley to Orange County and the Inland Empire, chosen by owners who wanted the commercial-style range without the luxury-tier cost. That value positioning is exactly why our techs at Same Day Appliance Repair treat Thor as one of the most repair-friendly brands we service.</p>

    <p>The practical reality on every Thor call is parts economics. <strong>Thor parts are inexpensive and widely available</strong>, not locked behind an authorized-service-only distributor the way luxury-brand parts are. An oven igniter, a bake element, a spark module, or a safety valve is a low-cost part plus our labor, and because a Thor range runs a couple thousand dollars rather than ten-plus, a single-component repair beats replacement nearly every time. We often finish same-day when the symptom can be identified before the visit.</p>

    <p>Every Thor service call gets a $89 residential diagnostic (applied toward the repair when work is approved), OEM Thor parts, and an honest written quote before any work begins.</p>
  </div>
</section>

<!-- 02 RANGES -->
<section class="section section-gray">
  <div class="container">
    <p class="section-number">02, Thor Kitchen range repair</p>
    <h2 class="section-title">HRG gas and HRD dual-fuel, 30 / 36 / 48-inch, one service platform.</h2>

    <p class="lead">Thor's cooking line splits into gas ranges (the HRG series) and dual-fuel ranges (the HRD series, gas cooktop with an electric oven). They share burners, grates, and much of the service tree; the difference is the oven, gas on HRG, electric on HRD, which changes how an "oven won't heat" call is diagnosed.</p>

    <div class="callout-box">
      <h3>Oven won't heat while the burners work (the most common Thor range call)</h3>
      <p>Burners lighting while the oven stays cold isolates the fault to the oven, not the cooktop. On the HRG gas ranges, the usual cause is a weak or failed oven igniter that no longer glows hot enough to open the safety valve, so the oven never lights, an inexpensive part and a common wear item. On the HRD dual-fuel ranges with an electric oven, it is more often a failed bake element (visible break or blister) or an oven temperature sensor reading wrong. Our techs meter it down to the exact part on-site. Same-day when the part is on the truck, which for common Thor igniters and elements it usually is.</p>
    </div>

    <p>Across the Thor range lineup the service tree is predictable and inexpensive:</p>

    <ul class="bullet-list">
      <li><strong>Surface ignition:</strong> clicking without ignition or a dead burner, usually a fouled or cracked igniter or a spark module. Low-cost, quick swap.</li>
      <li><strong>Gas oven not heating (HRG):</strong> oven igniter first (most common), then the safety valve if the igniter tests good.</li>
      <li><strong>Electric oven not heating (HRD):</strong> bake element or oven temperature sensor, isolated by meter.</li>
      <li><strong>Broiler issues:</strong> broil element on the electric oven, or broil igniter on the gas oven.</li>
      <li><strong>Uneven baking:</strong> convection fan motor wear or a drifting oven sensor.</li>
      <li><strong>Control faults:</strong> oven control or thermostat, a single-part swap far cheaper than a luxury-brand board.</li>
    </ul>
  </div>
</section>

<!-- 03 MODELS -->
<section class="section">
  <div class="container">
    <p class="section-number">03, Models we service most often</p>
    <h2 class="section-title">Thor Kitchen model families in regular SoCal rotation.</h2>

    <p class="lead">A representative sample of the Thor ranges our techs service routinely. We identify the exact model from the tag before ordering parts, since gas (HRG) and dual-fuel (HRD) share a look but take different oven parts.</p>

    <div class="model-grid">
      <div class="model-card">
        <h3>Gas Ranges (HRG)</h3>
        <p class="model-list">HRG3080U · HRG3618U · HRG4808U · HRG4808ULP</p>
        <p>30 / 36 / 48-inch professional gas ranges. The 48-inch HRG4808U carries a double oven and a griddle. High-BTU burners, cast-iron grates. Oven igniter and safety valve are the common oven-side service items.</p>
      </div>
      <div class="model-card">
        <h3>Dual-Fuel Ranges (HRD)</h3>
        <p class="model-list">HRD3088U · HRD3088ULP</p>
        <p>30-inch dual-fuel (gas cooktop, electric convection oven), plus the wider HRD line. Blue porcelain oven interior, 3500W broil element. Bake element and oven sensor are the common oven-side service items.</p>
      </div>
      <div class="model-card">
        <h3>Cooktops, Rangetops, Wall Ovens</h3>
        <p class="model-list">HRT series · professional rangetops · wall ovens</p>
        <p>Thor rangetops and wall ovens share the range service tree, surface igniters and spark modules on the gas side, elements and sensors on the electric-oven side.</p>
      </div>
    </div>
  </div>
</section>

<!-- 04 PRICING -->
<section class="section section-gray">
  <div class="container">
    <p class="section-number">04, Pricing</p>
    <h2 class="section-title">What Thor Kitchen repair costs in Southern California.</h2>

    <p class="lead">Diagnostic is $89, applied toward the repair when you approve the work. Thor sits in the value repair tier: parts are inexpensive and widely available, so most repairs are labor-driven and finish fast. Ranges below include labor.</p>

    <div class="pricing-grid">
      <div class="price-card">
        <div class="price-label">Diagnostic</div>
        <div class="price-amount">$89</div>
        <div class="price-desc">Waived when you approve repair</div>
      </div>
      <div class="price-card">
        <div class="price-label">Standard band</div>
        <div class="price-amount">$150–$300</div>
        <div class="price-desc">Oven igniter · bake / broil element · surface igniter · oven sensor</div>
      </div>
      <div class="price-card">
        <div class="price-label">Major component</div>
        <div class="price-amount">$250–$440</div>
        <div class="price-desc">Safety valve · convection fan motor · oven control / thermostat</div>
      </div>
    </div>

    <p class="price-note">Repair-versus-replace on Thor favors repair for almost any single-component failure. A Thor range runs roughly $1,800 to $4,000 new, so a $200 to $400 repair on a working unit is an easy call, and the inexpensive, ungated parts supply is what keeps it economical. The exception is major structural damage or a stacked multi-component failure on an older unit, where we lay out the full number at diagnostic. We document the math before authorization, every time.</p>
  </div>
</section>

<!-- 05 RECENT REPAIRS -->
<section class="section">
  <div class="container">
    <p class="section-number">05, Recent repairs</p>
    <h2 class="section-title">Thor Kitchen jobs from across the territory.</h2>

    <p class="lead">Two representative service calls, model, symptom, diagnosis, repair, and cost. Names and addresses omitted; the scenarios are typical of what we see on Thor service.</p>

    <div class="repair-grid">
      <div class="repair-card">
        <h3>Thor HRG3080U 30-inch gas range, Rancho Cucamonga</h3>
        <p><strong>Symptom:</strong> Cooktop burners lit fine, but the oven would not light or heat. Unit about 5 years old.</p>
        <p><strong>Diagnosis:</strong> Burners working isolated the fault to the gas oven. The oven igniter glowed weakly and never reached the temperature needed to open the safety valve, so gas never released, a textbook worn-igniter pattern.</p>
        <p><strong>Repair:</strong> Oven igniter replaced with an inexpensive OEM Thor part carried on the truck. Verified the igniter reached full glow, the valve opened, and the oven lit and held setpoint.</p>
        <p><strong>Cost & time:</strong> $195 total. Same-day, completed on the diagnostic visit in about an hour.</p>
      </div>
      <div class="repair-card">
        <h3>Thor HRD3088U 30-inch dual-fuel range, Irvine</h3>
        <p><strong>Symptom:</strong> Gas burners normal, electric oven would not heat on bake. Unit about 4 years old.</p>
        <p><strong>Diagnosis:</strong> Electric oven side. Meter check found an open bake element; the oven sensor and control tested within spec, isolating the failure to the element.</p>
        <p><strong>Repair:</strong> Bake element replaced with the OEM Thor part. Verified bake and convection reached and held setpoint on a test cycle.</p>
        <p><strong>Cost & time:</strong> $235 total. Same-day, 70 minutes on-site.</p>
      </div>
    </div>
  </div>
</section>

<!-- 06 SERVICE AREAS -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">06, Where we go</p>
    <h2 class="section-title">Thor Kitchen service across Greater Los Angeles.</h2>

    <p>Thor installs spread across the full territory rather than clustering in a single luxury pocket, which fits the brand's value positioning. We see the HRG gas and HRD dual-fuel ranges in remodeled and new-build kitchens through the San Fernando Valley, the San Gabriel Valley, Orange County, and the Inland Empire, where owners chose the pro-range look at a reachable price. The 8-branch dispatch grid in the hero shows the closest territory; our techs arrive with common Thor oven igniters, bake elements, and surface igniters on the truck for same-day completion when the symptom can be identified by phone first.</p>
  </div>
</section>

<!-- 07 RELATED -->
<section class="section">
  <div class="container">
    <p class="section-number">07, Related service</p>
    <h2 class="section-title">Thor Kitchen across the repair catalog.</h2>

    <div class="related-grid">
      <a href="/services/range-repair/" class="related-card">
        <h3>Range Repair Service Hub</h3>
        <p>Cross-brand range service, Thor alongside Wolf, Thermador, Viking, Bertazzoni, BlueStar, ZLINE. Gas and dual-fuel diagnostics.</p>
      </a>
      <a href="/services/oven-repair/" class="related-card">
        <h3>Oven Repair Service Hub</h3>
        <p>Oven igniters, bake and broil elements, sensors, and controls across gas and dual-fuel ovens. Compare Thor against the broader oven profile.</p>
      </a>
      <a href="/brands/zline/" class="related-card">
        <h3>ZLINE Repair</h3>
        <p>Sibling value pro-style brand. Professional and Autograph ranges plus the ZLINE range hood lineup. Similar parts economics.</p>
      </a>
      <a href="/brands/bertazzoni/" class="related-card">
        <h3>Bertazzoni Range Repair</h3>
        <p>Italian pro-style ranges, a step up in tier. Compare against Thor on build, parts, and service economics.</p>
      </a>
      <a href="/brands/" class="related-card">
        <h3>All Brands We Service</h3>
        <p>The full brand hub, luxury, mid-tier, and value cooking and refrigeration brands across the SoCal territory.</p>
      </a>
    </div>
  </div>
</section>

<!-- 08 FAQ -->
<section class="section section-gray">
  <div class="container narrow">
    <p class="section-number">08, FAQ</p>
    <h2 class="section-title">Thor Kitchen appliance repair, common questions.</h2>

    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </div>
</section>

<!-- 09 BOTTOM CTA -->
<section class="bottom-cta">
  <div class="container">
    <h2>Thor Kitchen range down? Same-day service across Southern California.</h2>
    <p>$89 diagnostic, applied toward the repair. HRG gas and HRD dual-fuel professional ranges, 30/36/48-inch. Inexpensive OEM parts, fast same-day turnaround. Phones answered 24/7. BHGS #A49573 and BBB Accredited Business.</p>
    <div class="cta-row">
      <a href={phoneHref} class="btn-primary">☎ Call {phone}</a>
      <a href="/contact/" class="btn-secondary">Book Online</a>
    </div>
  </div>
</section>

</Layout>

<style>
