  .section a { color: var(--red); font-weight: 600; text-decoration: none; }
  .section a:hover { text-decoration: underline; }

  .callout-box { background: #fff8e7; border: 1px solid #f0d070; border-left: 4px solid #d4a020; border-radius: 8px; padding: 22px 26px; margin: 24px 0; }
