---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs, anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Dacor Oven Repair Los Angeles — Same Day";
const description = "Dacor oven repair in Los Angeles: wall ovens and range ovens, gas and electric, Renaissance to current lines. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/dacor-oven-repair/";

const faqs = [
  { q: "My gas Dacor oven only gets to about 130–150°F. Why?", a: "That is the classic sign of a weak oven igniter. The igniter still glows, but it no longer draws enough current to keep the gas safety valve open, so the burner runs briefly or not at all. Replacing the igniter usually fixes it; we confirm by measuring before replacing." },
  { q: "My Dacor convection oven isn't circulating air. What fails?", a: "The convection fan motor or the convection element behind it. If the oven bakes normally in regular mode but convection is weak or cold, those two parts are where we start." },
  { q: "Can you still get parts for an older Dacor oven?", a: "For most heating parts, yes. Some electronic boards for older wall ovens are discontinued, so we check availability with the model number before booking the repair rather than after." },
  { q: "Do you have to take a Dacor wall oven out of the wall?", a: "Usually not. Elements, fans, sensors, igniters and door parts are reached from the front or from inside the oven. When a repair needs the oven out of its opening, the written quote says so before anything is moved." },
  { q: "How much does Dacor oven repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. A gas oven igniter replacement typically runs $150–$240; other repairs are quoted in writing after the diagnostic, and every repair carries a 90-day warranty on parts and labor." },
  { q: "My Dacor is still under warranty. Should I call you?", a: "Call Dacor first while the factory warranty applies. We are an independent repair company; after the warranty, we are usually the faster call." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [
  {"place": "Castaic", "unit": "Dacor 36-inch range", "symptom": "The oven would not get above about 135°F.", "found": "The oven igniter had weakened and was no longer letting the burner run properly. On this range it is awkward to reach, and part of the oven had to be dismantled to get to it.", "done": "Replaced the oven igniter; the oven heated normally and the repair was completed on the visit."}
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Dacor Oven Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Dacor", "item": "https://samedayappliance.repair/brands/dacor/" },
      { "@type": "ListItem", "position": 4, "name": "Oven Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="dacor-oven-repair"
    logoSlug="dacor"
    eyebrow={"Dacor · Wall ovens · Range ovens"}
    title={"Dacor Oven Repair in Los Angeles"}
    subtitle={"Oven won't heat or stalls at a low temperature, convection fan quiet, temperature off or a touch panel that stopped responding — diagnosed in place."}
    heroImageTitle={"Dacor Oven Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/dacor/">Dacor</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Oven Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>Gas or electric, wall oven or range: that decides where we look</h2>
      <p>Dacor started in Southern California in the 1960s and has been part of Samsung since 2016, so the ovens in Los Angeles kitchens span several generations: older Renaissance and Epicure wall ovens, Discovery and Discovery iQ models with touchscreen controls, and the current lines built under Samsung. Many of them are still running long after the remodel they were bought for.</p>
      <p>For repair, two questions narrow it down fast. Is the oven gas or electric? And is it a wall oven or the oven of a range? A gas oven that stalls at a low temperature is an ignition story; an electric oven that won't heat is an element, sensor or control story. Telling us which you have, and the model number, gets the right parts on the first visit.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Dacor oven do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on a label visible when the oven door is open — on the frame around the opening or on the edge of the cavity. On ranges it may also be behind the storage drawer or the kick panel.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Older wall ovens</h3>
          <p class="model-list">Renaissance · Epicure · Millennia</p>
          <p>Electric wall ovens from before the Samsung years, single and double, many with convection and self-clean.</p>
          <p class="fails"><strong>What we see fail:</strong> bake and broil elements, the convection fan and its element, the cooling fan, the self-clean door lock, the temperature sensor and relay boards. Some electronic parts are discontinued, so we check availability before booking.</p>
        </div>
        <div class="model-card">
          <h3>Discovery and Discovery iQ wall ovens</h3>
          <p>Wall ovens with touchscreen controls; the iQ models added Wi-Fi and a tablet-style display.</p>
          <p class="fails"><strong>What we see fail:</strong> the same heating parts, plus the touch interface and the control electronics.</p>
        </div>
        <div class="model-card">
          <h3>Current Dacor wall ovens</h3>
          <p>Wall ovens and combination units from the Samsung era, including steam-assisted models.</p>
          <p class="fails"><strong>What we see fail:</strong> elements, the convection fan, sensors, door hinges and seals, and the control panel.</p>
        </div>
        <div class="model-card">
          <h3>Range ovens</h3>
          <p>The ovens inside Dacor gas and dual-fuel ranges, including 30- and 36-inch models.</p>
          <p class="fails"><strong>What we see fail:</strong> on gas ovens, the oven igniter first — a weak igniter is the classic cause of an oven that heats a little and stalls — then the bake and broil burners and the safety valve; on dual-fuel ranges, the electric elements and sensor.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Dacor oven is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Gas oven heats a little, then stalls well below the set temperature</td><td>The oven igniter: a weak igniter can glow without drawing enough current to open the gas safety valve reliably. Then the valve and the control.</td></tr>
          <tr><td>Electric oven doesn't heat at all</td><td>Bake and broil elements, a tripped thermal cutout, then the relay or control that switches them.</td></tr>
          <tr><td>Convection mode doesn't circulate or heat</td><td>The convection fan motor and the convection element behind it.</td></tr>
          <tr><td>Temperature runs high or low</td><td>The temperature sensor, the door seal and hinges, then calibration.</td></tr>
          <tr><td>Self-clean finished but the door stays locked</td><td>Let it cool fully; then the door lock motor and its switch.</td></tr>
          <tr><td>Touch panel dead or not responding</td><td>Power and the breaker first, then the touch interface and the control board.</td></tr>
          <tr><td>Loud fan noise during or after baking</td><td>The cooling fan and its bearing; a fan that runs on after cooking is normal for a while.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Gas range ovens</p>
      <h2>On a gas oven, the igniter is part of the safety system</h2>
      <p>Most gas ovens, Dacor included, light the bake burner with a hot-surface igniter. The igniter doesn't just light the gas: the current flowing through it is what opens the oven's gas safety valve. As an igniter ages it still glows, but it draws less current, and the valve opens late, briefly or not at all.</p>
      <p>That produces a very specific complaint: the oven warms up a bit, then hangs well below the set temperature, or takes forever to preheat. The cure is a new igniter, not a control board. On some Dacor ranges the igniter is awkward to reach and part of the oven has to be dismantled to get to it — a job for a technician, with the gas shut off first.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note gas or electric, wall oven or range,</strong> and read us the model number from the label inside the door.</li>
        <li><strong>Check the breaker</strong> — and on a gas range, that the range is plugged in. The igniter and controls need power even on a gas oven.</li>
        <li><strong>Watch the bake burner on a gas oven.</strong> If the igniter glows for a long time before the flame appears, or never lights it, tell us.</li>
        <li><strong>Put an oven thermometer in the middle</strong> if the temperature seems off, and note what it reads after twenty minutes.</li>
        <li><strong>Self-clean door locked?</strong> Give the oven a few hours to cool completely before calling.</li>
      </ul>
      <p>If you smell gas, turn the oven off, close the gas supply valve if you can reach it, ventilate, and call the gas company before calling us.</p>
    </div>
  </section>

  <!-- ── REAL JOBS (Fixar CRM, anonymized) ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">From our job log</p>
      <h2>Recent Dacor oven jobs</h2>
      <p>Taken from our job records, with names and addresses removed.</p>
      {cases.map((c) => (
        <div class="case">
          <h3>{c.place} · {c.unit}</h3>
          <dl>
            <dt>What the owner reported</dt><dd>{c.symptom}</dd>
            <dt>What the technician found</dt><dd>{c.found}</dd>
            <dt>What was done</dt><dd>{c.done}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>A gas oven igniter replacement typically runs $150–$240. Other Dacor oven repairs depend on the model and the part, so we quote them after the diagnostic rather than guessing over the phone. Wall ovens are usually repaired in place; when one has to come out of the wall, the quote says so up front.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Dacor's own service network — if your Dacor is still inside its factory warranty, call Dacor first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Dacor service</p>
      <h2>Other Dacor repairs</h2>
      <div class="cat-grid">
        <a href="/brands/dacor/" class="cat-card">
          <h3>Dacor repair (all products)</h3>
          <p>Every Dacor line we work on, in one place.</p>
        </a>
        <a href="/brands/dacor-refrigerator-repair/" class="cat-card">
          <h3>Dacor refrigerator repair</h3>
          <p>Built-in and column refrigeration.</p>
        </a>
        <a href="/brands/dacor-dishwasher-repair/" class="cat-card">
          <h3>Dacor dishwasher repair</h3>
          <p>Panel-ready and stainless dishwashers.</p>
        </a>
        <a href="/brands/dacor-microwave-repair/" class="cat-card">
          <h3>Dacor microwave repair</h3>
          <p>Built-in microwaves and drawers.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Dacor oven repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Dacor oven not heating? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
