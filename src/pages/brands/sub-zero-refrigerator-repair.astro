---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, real cases, FAQ from one array; boilerplate price table and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Sub-Zero Refrigerator Repair Los Angeles — Same Day";
const description = "Sub-Zero refrigerator repair in Los Angeles: Classic built-ins, PRO 48 and Designer columns, ice makers. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/sub-zero-refrigerator-repair/";

const faqs = [
  { q: "Why is my Sub-Zero refrigerator side warm when the freezer is still cold?", a: "On a dual-refrigeration Sub-Zero the two compartments have separate cooling circuits, so the problem is almost always on the refrigerator circuit alone. The usual causes are the fresh-food evaporator fan, an evaporator that has iced over because of a defrost fault, or the start components on that circuit's compressor. We test that circuit and leave the working freezer side alone." },
  { q: "My Sub-Zero got very loud after a fan was replaced. Is that normal?", a: "A condenser fan should be audible but not droning. Noise after a fan replacement usually comes from the mounting: a blade close to the shroud, a missing or hardened rubber isolator, or the fan housing touching a panel. Built-in installs can also amplify the sound through the cabinetry above the grille. It is a mounting and vibration check, and if we did the original repair it falls under our 90-day warranty." },
  { q: "Does a warm Sub-Zero mean the compressor is dead?", a: "Usually not. Most warm-compartment calls are airflow or defrost problems — a stopped fan, a frosted coil, a dusty condenser. Sealed-system work is needed when the circuit has lost refrigerant or the compressor has failed, and we confirm that with measurements before quoting it. Sub-Zero's warranty on sealed-system parts runs well past the general warranty, so check your serial number with Sub-Zero first if the unit is young." },
  { q: "Do you have to pull my built-in Sub-Zero out of the cabinetry?", a: "Rarely. On Classic built-ins the condenser, condenser fan and compressor area are reached from the front through the top grille, and fans, defrost parts, gaskets and ice makers are serviced from inside the cabinet. Removal comes up mainly for some sealed-system repairs, and if it is needed the quote says so before work starts." },
  { q: "How much does Sub-Zero refrigerator repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. A routine condenser cleaning typically runs $180–$280. Other repairs are quoted in writing after the diagnostic, before any work starts, and carry a 90-day warranty on parts and labor." },
  { q: "What should I check before calling?", a: "Note which compartment is warm, look at the condenser coil behind the top grille for dust (with the unit switched off), listen for whether the condenser fan is running, and make sure the doors are sealing. If only the ice maker stopped, confirm the water supply valve is open." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [
  {"place": "Beverly Hills", "unit": "Sub-Zero built-in, machine compartment at the top", "symptom": "The refrigerator had stopped cooling.", "found": "The condenser fan motor in the top machine compartment had failed and the condenser coil was loaded with dust, so the unit could not shed heat.", "done": "Replaced the condenser fan motor and cleaned the condenser; cooling came back. Weeks later the owner reported that the new fan droned loudly — the enclosure above the unit was amplifying it — so we went back under our 90-day warranty, at no charge, to check the fan mounting, blade clearance and rubber isolators."}
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Sub-Zero Refrigerator Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Sub-Zero", "item": "https://samedayappliance.repair/brands/sub-zero/" },
      { "@type": "ListItem", "position": 4, "name": "Refrigerator Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="sub-zero-refrigerator-repair"
    logoSlug="sub-zero"
    eyebrow={"Sub-Zero · Classic · Designer · PRO"}
    title={"Sub-Zero Refrigerator Repair in Los Angeles"}
    subtitle={"Warm refrigerator side, frosted coil, loud condenser fan or a freezer drifting up — diagnosed circuit by circuit, with the unit left in its cabinetry."}
    heroImageTitle={"Sub-Zero Refrigerator Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/sub-zero/">Sub-Zero</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Refrigerator Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>The first question on a Sub-Zero: which compartment is warm?</h2>
      <p>Most full-size Sub-Zero refrigerators use what the company calls dual refrigeration: the fresh-food side and the freezer side each have their own sealed cooling circuit, with their own evaporator and fan. That design is why a Sub-Zero holds temperature and humidity so well, and it is also why the symptom tells us so much. A warm refrigerator side with a cold freezer points at one circuit; both sides warming together points at something they share — usually the condenser and its fan in the machine compartment, or power and controls.</p>
      <p>On Classic built-ins the machine compartment sits at the top, behind the grille, which means the condenser, condenser fan and compressor area can be reached from the front with the unit still in its cabinetry. That is also where the most avoidable Sub-Zero failure starts: a condenser coil packed with dust makes everything up there run hot and hard.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Sub-Zero do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on a tag inside the refrigerator, usually near the top of the fresh-food compartment. Reading them to us on the phone lets the technician bring the right parts on the first visit.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Classic built-ins</h3>
          <p class="model-list">BI-36U · BI-36UFD · BI-36R · BI-42SD · BI-48SD · CL3650U · CL4250SD · CL4850SD</p>
          <p>The grille-on-top built-ins: over-and-under, French door, side-by-side and single-compartment versions in 30–48 inch widths. Older units carry BI model numbers; newer Classic models use the CL prefix.</p>
          <p class="fails"><strong>What we see fail:</strong> dusty condenser and tired condenser fan motors, evaporator fans on one compartment, defrost faults that ice a coil, door gaskets and hinge wear, ice maker and water valve problems on the freezer side.</p>
        </div>
        <div class="model-card">
          <h3>Designer (integrated) columns</h3>
          <p class="model-list">IC-30R · IC-36R · IC-30FI · IC-24FI · IT-30R · DEC3050R</p>
          <p>Fully panel-ready refrigerator and freezer columns that disappear into the cabinetry. Each column is a separate appliance with a single cooling circuit, so a warm refrigerator column and a cold freezer column next to it are two unrelated stories.</p>
          <p class="fails"><strong>What we see fail:</strong> evaporator fan and defrost faults, ice makers in freezer columns, door closers and panel alignment that break the seal, condensation where two columns meet.</p>
        </div>
        <div class="model-card">
          <h3>PRO 48 and PRO 36</h3>
          <p class="model-list">PRO4850 · PRO4850G · PRO3650 · PRO3650G</p>
          <p>Stainless pro-style models, often paired with a Wolf range. Heavy doors and, on the G versions, a glass refrigerator door.</p>
          <p class="fails"><strong>What we see fail:</strong> the same airflow and defrost items as the Classic line, plus more wear on hinges and gaskets because of door weight.</p>
        </div>
        <div class="model-card">
          <h3>Undercounter and drawers</h3>
          <p class="model-list">UC-24R · UC-24BG · ID-24R · ID-30R</p>
          <p>Island and bar refrigeration. Compact machine compartments that choke quickly when the front grille is blocked or the toe-kick collects dust.</p>
          <p class="fails"><strong>What we see fail:</strong> condenser airflow, drawer slides and gaskets, fan motors.</p>
        </div>
      </div>
      <p class="footnote">Pre-2000s Sub-Zero units (older 500- and 600-series built-ins) can still often be repaired, but some parts are discontinued. We check availability before booking the repair, not after.</p>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Sub-Zero is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Refrigerator side warm, freezer still cold</td><td>That circuit only: the fresh-food evaporator fan, a frosted-over evaporator from a defrost fault, then the start components on that circuit's compressor.</td></tr>
          <tr><td>Freezer warm or soft ice cream, refrigerator fine</td><td>Freezer evaporator fan, defrost heater and defrost thermostat, a door or drawer not sealing on the freezer side.</td></tr>
          <tr><td>Both sides slowly warming</td><td>Shared items: condenser coil packed with dust, condenser fan not spinning, power supply, then the control.</td></tr>
          <tr><td>Loud drone, hum or rattle from the top grille</td><td>Condenser fan motor and blade, fan mounting and rubber isolators, anything touching the shroud; compressor mounts after that.</td></tr>
          <tr><td>Frost on the back wall, or a coil that never clears</td><td>Defrost system — heater, defrost thermostat or sensor — and the drain that carries defrost water away.</td></tr>
          <tr><td>Water under the crispers or on the floor</td><td>A blocked or frozen defrost drain; on dispenser models, the water line and fill tube.</td></tr>
          <tr><td>Door sweating, frost along the gasket</td><td>Gasket condition, door alignment and hinge or closer wear. On columns, the panel can pull a door out of square.</td></tr>
          <tr><td>Ice maker stopped, everything else cold</td><td>Water supply and filter, a frozen fill tube, the water inlet valve, then the ice maker module itself.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── SEALED SYSTEM ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Sealed-system notes</p>
      <h2>Most warm Sub-Zeros are not a sealed-system failure</h2>
      <p>Owners often assume a warm Sub-Zero means the compressor is gone. In practice, most warm-compartment calls end at airflow and defrost: a fan that stopped, a coil buried in frost, a condenser that cannot shed heat. Those are component repairs done in one or two visits.</p>
      <p>Signs that point toward the sealed system instead: the compressor runs constantly while the evaporator stays only partly frosted after a defrost, or an evaporator that should be cold is warm with its fan running. Sealed-system work means finding the leak or the failed compressor, brazing, evacuating the circuit and weighing in the exact refrigerant charge. On a dual-refrigeration Sub-Zero, that work touches one circuit; the other keeps its factory charge.</p>
      <p>Sub-Zero's own warranty covers sealed-system parts for considerably longer than the rest of the refrigerator. If your unit is young enough that the sealed system may still be covered, have the serial number ready and check with Sub-Zero before paying anyone for compressor work.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which side is warm</strong> and, if you have a thermometer, the temperature in each compartment. It changes which parts we bring.</li>
        <li><strong>Look behind the top grille</strong> on a Classic built-in (it lifts or swings up). If the condenser coil is grey with dust, that alone can explain a warm unit. Switch the unit off before brushing it, and keep your hands off the fan.</li>
        <li><strong>Listen at the grille.</strong> A running compressor with a silent condenser fan, or a fan that changes pitch and rattles, is worth telling us.</li>
        <li><strong>Check the seal.</strong> Close a dollar bill in the door at a few points around the gasket; if it slides out with no drag, that spot is not sealing. Make sure nothing inside is holding a door or drawer open.</li>
        <li><strong>Ice maker only?</strong> Confirm the water supply valve is open and note when the filter was last changed.</li>
      </ul>
      <p>Please don't chip ice off the evaporator or use a heat gun inside the cabinet; the coil and the plastic liner are easy to puncture.</p>
    </div>
  </section>

  <!-- ── REAL JOBS (Fixar CRM, anonymized) ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">From our job log</p>
      <h2>Recent Sub-Zero refrigerator jobs</h2>
      <p>Taken from our job records, with names and addresses removed.</p>
      {cases.map((c) => (
        <div class="case">
          <h3>{c.place} · {c.unit}</h3>
          <dl>
            <dt>What the owner reported</dt><dd>{c.symptom}</dd>
            <dt>What the technician found</dt><dd>{c.found}</dd>
            <dt>What was done</dt><dd>{c.done}</dd>
          </dl>
        </div>
      ))}
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>A routine Sub-Zero condenser cleaning typically runs $180–$280. Repairs beyond that depend on the part and the model, so we quote them after the diagnostic rather than guessing over the phone. Classic built-ins are almost always repaired in place through the top grille; when a column or built-in has to come out of its opening, the quote says so up front.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Sub-Zero's own service network — if your Sub-Zero is still inside its factory warranty, call Sub-Zero first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Sub-Zero service</p>
      <h2>Other Sub-Zero repairs</h2>
      <div class="cat-grid">
        <a href="/brands/sub-zero/" class="cat-card">
          <h3>Sub-Zero repair (all products)</h3>
          <p>Every Sub-Zero line we work on, in one place.</p>
        </a>
        <a href="/brands/sub-zero-built-in-refrigerator-repair/" class="cat-card">
          <h3>Sub-Zero built-in refrigerator repair</h3>
          <p>Panel-ready installs, column pairs and cabinetry-safe access.</p>
        </a>
        <a href="/brands/sub-zero-wine-cooler-repair/" class="cat-card">
          <h3>Sub-Zero wine cooler repair</h3>
          <p>Wine columns and undercounter wine storage.</p>
        </a>
        <a href="/brands/sub-zero-ice-maker-repair/" class="cat-card">
          <h3>Sub-Zero ice maker repair</h3>
          <p>Built-in ice makers and freezer-side ice production.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Sub-Zero refrigerator repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Sub-Zero running warm? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
