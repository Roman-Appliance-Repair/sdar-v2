---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

const title = "GE Café Range Hood Repair Los Angeles — Same Day";
const description = "GE Cafe range hood repair across Southern California, CVM / CVW under-cabinet + chimney. Matte finish + customizable hardware. SmartHQ. $89 dx.";
const canonical = "https://samedayappliance.repair/brands/ge-cafe-range-hood-repair/";

const faqs = [
  {
    q: "What's the Cafe distinction from Profile or Monogram?",
    a: "GE Cafe is the premium-prosumer tier ($2,500-$8,000; industrial-aesthetic + customizable hardware) between feature-focused <a href='/brands/ge-profile-range-hood-repair/'>GE Profile</a> ($1,500-$5,000 SmartHQ/Air Fry) and ultra-luxury <a href='/brands/ge-monogram-range-hood-repair/'>GE Monogram</a> ($5,000-$25,000 Statement Collection). Cafe signature: Matte White / Matte Black / Platinum Glass finish program + customizable brass / chrome / matte-black hardware handles that owners can swap without a service call."
  },
  {
    q: "What Cafe range hood models are common in LA?",
    a: "<b>CVM / CVW under-cabinet + chimney wall hoods</b> 30-36 inch in Matte Black / Matte White / Platinum Glass / Stainless finishes + customizable hardware handles. 400-650 CFM tier. SmartHQ Wi-Fi integration shared with Profile platform."
  },
  {
    q: "Matte finish care during service?",
    a: "Matte finishes (Matte White, Matte Black) require soft-cloth + mild-soap cleaning, abrasive cleaners damage the matte coat. During service we mask and cover Matte surfaces near interior work. Panel replacement 2-4 week lead through GE Appliances parts channel if finish damage requires replacement."
  },
  {
    q: "What does GE Cafe range hood repair cost in LA?",
    a: "Residential diagnostic $89 waived with repair. Typical Cafe bands: variable-speed motor $260–$400; control-board $400–$580; SmartHQ WiFi module $240–$380; LED driver $140–$240; grease-filter latch $120–$200; customizable hardware parts $60–$240 (owner-installable); Matte panel replacement quoted individually 2-4 week lead."
  },

  {
    q: "Why isn't my GE Café range hood fan working?",
    a: "When a GE Café range hood fan won't run or has lost a speed, the most common cause is the variable-speed blower motor ($260–$400). If the fan is dead on all speeds and the controls don't respond, the control board ($400–$580) is the next suspect, and a tripped breaker or loose connection is worth ruling out first. Our techs at Same Day Appliance Repair test the motor, the speed control, and the board, and clean the blower wheel and grease filters since heavy grease loading can bog the motor. A worn grease-filter latch ($120–$200) is a common smaller fix. $89 residential diagnostic, waived with repair."
  },
  {
    q: "Why are the lights out on my GE Café range hood?",
    a: "Dark task lights on a GE Café range hood are usually the LED driver ($140–$240), the small power module that runs the LED strip — when it fails the lights go out while the fan still works. A failed LED module or a loose harness connection can also be the cause. Our techs at Same Day Appliance Repair check the driver, the LED modules, and the wiring before quoting, since it's often a driver swap rather than a full light assembly, and we protect Café's matte finish during the work. $89 residential diagnostic, waived with repair."
  },
    {
      q: "Where can I find the official GE manual or warrantyinformation?",
      a: `Our technicians work independently of GE's factory service network - we're often faster and available same-day in Southern California.`
    },
  ];

const schemaJsons = [
  { "@context": "https://schema.org", "@type": "Service", "serviceType": "GE Cafe Range Hood Repair",
    "provider": { "@id": canonical + "#org" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "description": "GE Cafe range hood repair across LA, CVM / CVW under-cabinet + chimney wall. Matte finish + customizable hardware. SmartHQ Wi-Fi. $89 residential diagnostic waived with repair.",
    "offers": { "@type": "Offer", "priceSpecification": { "@type": "PriceSpecification", "price": "89.00", "priceCurrency": "USD", "description": "Residential diagnostic fee, waived with repair" } }
  },
  { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "GE Cafe", "item": "https://samedayappliance.repair/brands/ge-cafe/" },
      { "@type": "ListItem", "position": 4, "name": "GE Cafe Range Hood Repair", "item": canonical }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — HVAC 777 LLC + 4 credentials + hours.
// Closes Wave 35 / Phase 2b-1 gap for brand-combo and price-list pages.
// SSOT: src/data/credentials-schema.ts + src/data/business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
  <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />{schemaJsons.map((schema) => (<script type="application/ld+json" set:html={JSON.stringify(schema)} />))}</Fragment>
  <div class="call-banner"><div class="wrap"><span>GE Cafe range hood service?</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>

  <ServiceHero
    section="brands"
    slug="ge-cafe-range-hood-repair"
    logoSlug="cafe"
    eyebrow={"GE Cafe · Range Hood Repair"}
    title={"GE Cafe Range Hood Repair"}
    subtitle={description}
    heroImageTitle={"GE Cafe Range Hood Repair"}
  />

  <BrandBranchesGrid />

  <section class="trust-bar"><div class="wrap"><span>BHGS #A49573 · Insured</span><span>Same-day in 7 Southern California counties</span><span>Residential diagnostic $89 · waived with repair</span></div></section>

  <section class="section"><div class="wrap">
    <p><strong>When a GE Café range hood fails in an LA home, our techs at Same Day Appliance Repair trace it to a few patterns: a variable-speed blower motor that's lost a speed or stopped ($260–$400); a control-board fault ($400–$580); SmartHQ Wi-Fi connectivity (usually network-side before a $240–$380 module); an LED task-lighting driver behind dark lights ($140–$240); and a grease-filter latch ($120–$200).</strong> Café's customizable hardware and matte finishes are coordinated-design service items unique to the tier. We service GE Café range hoods across Silver Lake, the Hollywood Hills, Brentwood, and Newport Beach. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410), BBB Accredited.</p>
    <h2>What GE Cafe range hood repair costs in LA</h2>
    <table class="price-table">
      <tr><th>Service</th><th>Typical Range</th><th>Notes</th></tr>
      <tr><td>Residential diagnostic</td><td>$89</td><td>Waived with repair</td></tr>
      <tr><td>Variable-speed motor</td><td>$260 – $400</td><td>10-12 year service</td></tr>
      <tr><td>Control-board</td><td>$400 – $580</td><td>Main control</td></tr>
      <tr><td>SmartHQ WiFi module</td><td>$240 – $380</td><td>Smart connectivity</td></tr>
      <tr><td>LED driver</td><td>$140 – $240</td><td>Task lighting</td></tr>
      <tr><td>Customizable hardware</td><td>$60 – $240</td><td>Owner-installable</td></tr>
      <tr><td>Matte panel replacement</td><td>Quoted individually</td><td>2-4 week lead</td></tr>
    </table>
    <p class="small">Related: <a href="/brands/ge-cafe/">GE Cafe brand hub</a> · <a href="/brands/ge-profile-range-hood-repair/">GE Profile</a> · <a href="/brands/ge-monogram-range-hood-repair/">GE Monogram</a> · <a href="/services/range-hood-repair/">Range hood repair (service hub)</a> · <a href="/commercial/exhaust-hood-repair/">Commercial exhaust hood repair</a>.</p>
  </div></section>

  <section class="section alt"><div class="wrap narrow">
    <h2>GE Cafe range hood repair, frequently asked</h2>
    {faqs.map(f => (<details class="faq"><summary>{f.q}</summary><p set:html={f.a}></p></details>))}
  </div></section>

  <section id="book" class="cta-bottom"><div class="wrap">
    <h2>GE Cafe range hood service? Call the branch closest to your home.</h2>
    <p>Same-day appliance repair in Los Angeles, Orange County, Ventura County. Residential diagnostic $89, waived with repair.</p>
  </div></section>
</Layout>

<style>
  body { color: var(--text); } .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; } .wrap.narrow { max-width: 820px; }
  h1 { font-size: 2.4rem; line-height: 1.15; margin: 12px 0 20px; color: var(--black); }
  h2 { font-size: 1.8rem; margin: 0 0 16px; color: var(--black); }
  p { line-height: 1.65; margin: 0 0 14px; }
  .call-banner { background: var(--red); color: #fff; padding: 10px 0; }
  .call-banner .wrap { display:flex; gap: 14px; align-items: center; justify-content: center; flex-wrap: wrap; }
  .call-banner .phone-lg { color:#fff; font-weight: 800; text-decoration: underline; font-size: 1.05rem; }
  .hero { background: var(--black); color: #fff; padding: 42px 0 56px; } .hero h1 { color: #fff; }
  .hero .lede { font-size: 1.06rem; color: #d7d7d7; max-width: 680px; }
  .hero .crumb { color: #9a9a9a; font-size: 0.85rem; margin-bottom: 6px; } .hero .crumb a { color: #c9c9c9; text-decoration: none; }
  .hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 18px 0 24px; }
  .btn { display: inline-block; padding: 12px 20px; border-radius: 4px; text-decoration: none; font-weight: 700; }
  .btn-primary { background: var(--red); color: #fff; } .btn-ghost { background: transparent; color: #fff; border: 1px solid #fff; }
  .hero-facts { list-style: none; padding: 0; margin: 0; color: #c9c9c9; font-size: 0.95rem; }
  .hero-facts li { padding: 6px 0; border-top: 1px solid #222; } .hero-facts li:first-child { border-top: 0; }
  .trust-bar { background: var(--red); color: #fff; padding: 14px 0; }
  .trust-bar .wrap { display: flex; gap: 28px; flex-wrap: wrap; justify-content: center; font-size: 0.95rem; font-weight: 600; }
  .section { padding: 56px 0; } .section.alt { background: var(--gray); }
  .price-table { width: 100%; border-collapse: collapse; margin-top: 14px; background: #fff; }
  .price-table th, .price-table td { text-align: left; padding: 11px 12px; border-bottom: 1px solid var(--border); }
  .price-table th { background: var(--black); color: #fff; font-weight: 700; font-size: 0.95rem; }
  .small { color: var(--muted); font-size: 0.92rem; margin-top: 12px; }
  .faq { background: #fff; border: 1px solid var(--border); padding: 12px 16px; margin-bottom: 8px; border-radius: 4px; }
  .faq summary { font-weight: 700; cursor: pointer; padding: 4px 0; } .faq p { margin: 8px 0 0; }
  .cta-bottom { background: var(--black); color: #fff; padding: 48px 0; } .cta-bottom h2 { color: #fff; } .cta-bottom p { color: #c9c9c9; }
  @media (max-width: 820px) { h1 { font-size: 1.9rem; }  .trust-bar .wrap { gap: 14px; font-size: 0.85rem; } }
</style>
