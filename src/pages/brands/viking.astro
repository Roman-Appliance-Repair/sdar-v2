---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Viking Appliance Repair Los Angeles — Same Day";
const description = "Viking appliance repair in Los Angeles: ranges, cooktops, wall ovens, built-in refrigeration and outdoor grills. Same day. $89 diagnostic, waived with repair.";

// 2026-10-05: hub rewritten to stay about the brand as a whole. Product-level depth
// (symptoms, parts, prices) lives on the product pages linked from the "What we repair"
// block, so the hub stops competing with them for product queries.
// FAQ: visible list and FAQPage JSON-LD are both generated from `faqs`.
const faqs = [
  { q: "Are you part of Viking's service network?", a: "No. We're an independent repair company. If your Viking is still inside its factory warranty, contact Viking first; after the warranty, we're usually the faster call." },
  { q: "Which Viking appliances do you repair?", a: "Ranges and stoves, cooktops and rangetops, wall ovens, built-in and freestanding refrigeration, wine storage, ice makers, outdoor refrigeration and gas grills, range hoods and trash compactors. Each has its own page in the 'What we repair' list." },
  { q: "Can you handle a whole Viking kitchen in one visit?", a: "Often, yes. Tell us every appliance that needs attention when you book, and we send a technician prepared for all of them." },
  { q: "Is an older Viking still worth repairing?", a: "Usually. Most parts for Professional ranges and Viking refrigeration are still available or superseded by current numbers. Some older parts are discontinued, so we confirm availability before quoting." },
  { q: "How much does Viking repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. Repairs are quoted in writing after the diagnostic, before work starts, and carry a 90-day warranty on parts and labor." },
  { q: "How fast can you come out?", a: "Same day when a technician is free, Monday to Saturday 8am–6pm. Call early for the best chance." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/viking/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/viking/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
    "openingHoursSpecification": [ { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" }, { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" } ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/viking/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="viking"
    section="brands"
    eyebrow={"Viking · Ranges · Refrigeration · Outdoor"}
    title={"Viking Appliance Repair in Los Angeles"}
    subtitle={"Professional ranges, cooktops, wall ovens, built-in refrigeration, wine storage and outdoor grills — one company for the whole Viking kitchen."}
    heroImageTitle={"Viking Appliance Repair in Los Angeles"}
    showBranches={true}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

  <!-- ── WHAT WE REPAIR (route block) ── -->
  <section class="wwr">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Pick your Viking</h2>
      <div class="wwr-grid">
        <a href="/brands/viking-range-repair/" class="wwr-card"><strong>Viking range repair</strong><span>VGR gas and VDR dual-fuel ranges.</span></a>
        <a href="/brands/viking-stove-repair/" class="wwr-card"><strong>Viking stove repair</strong><span>Burners and ovens on Viking stoves.</span></a>
        <a href="/brands/viking-cooktop-repair/" class="wwr-card"><strong>Viking cooktop repair</strong><span>Gas rangetops and cooktops.</span></a>
        <a href="/brands/viking-oven-repair/" class="wwr-card"><strong>Viking oven repair</strong><span>Viking ovens: elements, convection, controls.</span></a>
        <a href="/brands/viking-wall-oven-repair/" class="wwr-card"><strong>Viking wall oven repair</strong><span>Single and double wall ovens.</span></a>
        <a href="/brands/viking-refrigerator-repair/" class="wwr-card"><strong>Viking refrigerator repair</strong><span>Warm sections, frost, ice and water.</span></a>
        <a href="/brands/viking-built-in-refrigerator-repair/" class="wwr-card"><strong>Viking built-in refrigerator repair</strong><span>Built-in and panel-ready refrigeration.</span></a>
        <a href="/brands/viking-wine-cooler-repair/" class="wwr-card"><strong>Viking wine cooler repair</strong><span>Wine storage and beverage centers.</span></a>
        <a href="/brands/viking-ice-maker-repair/" class="wwr-card"><strong>Viking ice maker repair</strong><span>Undercounter ice machines.</span></a>
        <a href="/brands/viking-outdoor-refrigerator-repair/" class="wwr-card"><strong>Viking outdoor refrigerator repair</strong><span>Outdoor undercounter refrigeration.</span></a>
        <a href="/brands/viking-bbq-grill-repair/" class="wwr-card"><strong>Viking BBQ grill repair</strong><span>Outdoor gas grills: burners and ignition.</span></a>
        <a href="/brands/viking-range-hood-repair/" class="wwr-card"><strong>Viking range hood repair</strong><span>Hoods and ventilation.</span></a>
        <a href="/brands/viking-trash-compactor-repair/" class="wwr-card"><strong>Viking trash compactor repair</strong><span>Built-in compactors.</span></a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">About the brand</p>
      <h2>The company that brought the pro range home</h2>
      <p class="intro-speakable">Viking began in 1987 with the idea of a commercial-style range built for a home kitchen, and grew into a full suite: Professional ranges and rangetops, wall ovens, built-in refrigeration, wine storage, ventilation and outdoor grills. Since 2013 Viking has been part of Middleby.</p>
      <p>In Southern California we see whole Viking kitchens — range, refrigerator, hood, sometimes an outdoor grill — so one visit often covers more than one appliance. Model numbers tell a lot: on ranges, VGR means all gas and VDR means dual fuel. Each product page above covers its own model lines, symptoms and what you can check yourself.</p>
    </div>
  </section>

  <!-- ── PARTS ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Parts on older Vikings</p>
      <h2>Older Vikings are repairable — we check the part first</h2>
      <p>Many Viking appliances in Los Angeles homes are 10 to 20 years old. Most parts are still available or have been superseded by a current number, but some older components have been discontinued. We confirm a part exists before quoting the repair, and say so plainly when it doesn't.</p>
    </div>
  </section>

  <!-- ── INDEPENDENCE / WARRANTY ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Warranty and how we work</p>
      <h2>Under warranty, call Viking. After that, call us.</h2>
      <p>We're an independent repair company, not part of Viking's own service network, and we don't present ourselves as one. If your Viking is still inside its factory warranty, contact Viking first. After that, our residential diagnostic is $89, waived with repair, the quote is in writing before work starts, and every repair carries our 90-day warranty on parts and labor.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Viking service across Southern California</h2>
      <p>Ten branches cover Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties, including the outdoor kitchens where Viking grills are common. Tell us your city and model when you call, and we route the nearest technician.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Viking service questions</h2>
      {faqs.map((f) => (
        <details class="faq faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Viking service?</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card.static { cursor: default; }
  .cat-card.static:hover { transform: none; box-shadow: none; border-color: var(--border); }
  .cat-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 14px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .bottom-cta .hero-ctas { justify-content: center; }

  /* What-we-repair route block (mirrors the symptom-route cards on /commercial/ pages) */
  .wwr { padding: 40px 24px 48px; background: #fff; border-bottom: 1px solid var(--border); }
  .wwr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-top: 18px; }
  .wwr-card { display: block; padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; background: #fff; text-decoration: none; color: inherit; transition: border-color .2s; }
  .wwr-card:hover { border-color: var(--red); }
  .wwr-card strong { display: block; font-size: 15px; color: var(--black); margin-bottom: 4px; }
  .wwr-card span { display: block; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .section a { color: var(--red); }
</style>
</Layout>
