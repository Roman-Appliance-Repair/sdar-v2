---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, FAQ from one array; boilerplate price table, warranty block and service-area grid removed. No Fixar case: the one Thermador oven job on record has no findings yet.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Thermador Oven Repair Los Angeles — Same Day";
const description = "Thermador oven repair in Los Angeles: Masterpiece and Professional wall ovens, steam and speed ovens. Same-day visits. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/thermador-oven-repair/";

const faqs = [
  { q: "My Thermador oven won't preheat past a low temperature. What's wrong?", a: "Usually one of three things: a bake element that has failed, a temperature sensor reading falsely high so the control cuts power early, or a relay on the control that has stopped switching. We watch a full heat-up with our own thermocouple to tell which one it is before ordering a part." },
  { q: "What do E1, E2, E3, E4 and E5 mean on a Thermador oven?", a: "E1 disables self-clean, usually the door lock motor. E2 shuts down heat and microwave on speed-oven combinations, a control or communication fault. E3 and E4 turn off heat in one cavity, a temperature sensor or heating circuit. E5 is like E2 after microwave over-temperature protection. Older ovens use F-codes instead: F2 over-temperature, F3/F4 sensor, F9 door latch, Fd relay board." },
  { q: "Are Masterpiece and Professional ovens repaired differently?", a: "Not really. The heating elements, convection system and door hardware are closely related across both lines; the differences are mostly handles, bezels and trim. We still need the model and FD number, because parts change across production runs." },
  { q: "My Thermador oven door slams shut instead of closing softly.", a: "The soft-close hinges have worn. They carry a damper that eventually stops slowing the door, and the door may also sag and leak heat. Both hinges are replaced together, with the door rehung and the seal checked." },
  { q: "My Thermador steam oven says to refill water, but the tank is full.", a: "Scale from hard water builds up on the tank's water-level sensing, so it reads empty. Cleaning and descaling clears many of these; if the message comes back quickly, we check the sensing and the pump." },
  { q: "How much does Thermador oven repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair itself is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [

];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Thermador Oven Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Thermador", "item": "https://samedayappliance.repair/brands/thermador/" },
      { "@type": "ListItem", "position": 4, "name": "Oven Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="thermador-oven-repair"
    logoSlug="thermador"
    eyebrow={"Thermador · Masterpiece · Professional"}
    title={"Thermador Oven Repair in Los Angeles"}
    subtitle={"Wall ovens that won’t preheat, run off temperature or stay locked after self-clean, plus steam and speed ovens — repaired in place."}
    heroImageTitle={"Thermador Oven Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/thermador/">Thermador</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Oven Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Which Thermador oven</p>
      <h2>Masterpiece or Professional, single, double, steam or speed</h2>
      <p>Thermador builds its wall ovens in two design lines — <strong>Masterpiece</strong> and <strong>Professional</strong> — and in single, double and combination versions: a steam oven or a speed oven stacked with a conventional oven. The two lines look very different, but the heating, convection and door hardware underneath are closely related, so the diagnosis is the same; what changes is trim, handles and some control parts.</p>
      <p>Thermador is part of BSH, the group behind Bosch and Gaggenau, and its ovens share that engineering style: a soft-closing door, true convection with a fan and its own element, and on newer ovens Home Connect. Most repairs are done with the oven in its cabinet opening, working from the front and inside the cavity.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Thermador ovens we work on, and what tends to fail</h2>
      <p>The model and serial label (often shown as E-Nr and FD numbers) is on the oven frame, visible with the door open. The FD number tells the production run, which decides some parts.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>Masterpiece wall ovens</h3>
          <p class="model-list">ME301WS · ME302WS · MED301WS · MED302WS</p>
          <p>Single and double 30-inch electric wall ovens with the Masterpiece frameless look.</p>
          <p class="fails"><strong>What we see fail:</strong> bake and broil elements, the convection fan motor and convection element, the temperature sensor, the self-clean door lock, soft-close hinges, door gaskets.</p>
        </div>
        <div class="model-card">
          <h3>Professional wall ovens</h3>
          <p class="model-list">POD301W · POD302W</p>
          <p>Pro-style handles and bezel, designed to sit with a Pro Grand range or rangetop. Mechanically close to the Masterpiece line.</p>
          <p class="fails"><strong>What we see fail:</strong> the same heating and door items as the Masterpiece ovens; handles and trim are line-specific.</p>
        </div>
        <div class="model-card">
          <h3>Steam and combination ovens</h3>
          <p class="model-list">Masterpiece and Professional steam &amp; convection</p>
          <p>A convection oven with a water tank, pump and steam generator, alone or stacked with a conventional oven.</p>
          <p class="fails"><strong>What we see fail:</strong> water-tank and descale messages that won't clear, scale in the steam path, the water-level sensing, steam generator faults.</p>
        </div>
        <div class="model-card">
          <h3>Speed ovens and range ovens</h3>
          <p class="model-list">MC30WS speed oven · Pro Grand · Pro Harmony</p>
          <p>The speed oven combines microwave and convection heat. Ovens inside Pro Grand and Pro Harmony ranges are covered on our <a href="/brands/thermador-range-repair/">Thermador range repair</a> page.</p>
          <p class="fails"><strong>What we see fail:</strong> on speed ovens, the microwave side (magnetron, high-voltage parts, door interlock switches) while convection still works.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What the oven is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Won't preheat past a low temperature</td><td>Bake element, a temperature sensor reading falsely high so the control cuts power early, then the relay on the control.</td></tr>
          <tr><td>Bakes unevenly or runs off temperature</td><td>Temperature sensor drift, the convection fan and its element, then the door gasket.</td></tr>
          <tr><td>Grinding or humming from the back of the cavity</td><td>Convection fan motor bearings.</td></tr>
          <tr><td>Door slams instead of easing shut, or sags</td><td>Soft-close hinges — replaced as a pair, since they wear together.</td></tr>
          <tr><td>Self-clean won't start, or door stays locked</td><td>The door lock motor and its switches.</td></tr>
          <tr><td>Steam oven asks for water with a full tank</td><td>Scale on the tank's water-level sensing; a descale and cleaning fixes many, a failed sensor or pump does not.</td></tr>
          <tr><td>Speed oven: convection works, microwave doesn't</td><td>Door interlock switches, then the microwave high-voltage circuit and magnetron.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── CODES ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Display codes</p>
      <h2>Thermador oven codes worth knowing</h2>
      <ul class="scope-list">
        <li><strong>E1</strong> — self-clean disabled, usually the door lock motor.</li>
        <li><strong>E2</strong> — on speed-oven combinations, shuts off heat and microwave: a master control or communication fault.</li>
        <li><strong>E3 / E4</strong> — heat turned off in the affected cavity only: temperature sensor or heating circuit open.</li>
        <li><strong>E5</strong> — like E2, but after microwave over-temperature protection.</li>
        <li><strong>Older ovens and ranges use F-codes:</strong> F2 over-temperature, F3/F4 temperature sensor, F9 self-clean door latch, Fd relay board.</li>
      </ul>
      <p>Many of these codes trace to a sensor or a harness connection rather than the control board, so we test before replacing anything. Long sequential code lists posted online for Thermador refrigerators do not apply to ovens — check the model number before trusting a code table.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Before you call</h2>
      <ul class="scope-list">
        <li><strong>Turn the oven off at the breaker for a minute</strong> and try again. Write down any code and which cavity showed it.</li>
        <li><strong>Check for a lock or Sabbath setting</strong> if the display ignores you; both are explained in the owner's manual.</li>
        <li><strong>Close a sheet of paper in the door</strong> at a few points. If it slides out freely, the gasket or hinges are letting heat out.</li>
        <li><strong>Steam oven:</strong> empty, rinse and refill the tank and run descaling if the oven requests it.</li>
        <li><strong>Speed oven:</strong> if the microwave side is dead but the light and fan work, stop using it and call — the high-voltage parts are not a do-it-yourself job.</li>
      </ul>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Thermador oven repairs are quoted in writing after the diagnostic, once we have the model and FD number; parts differ across production runs, and we would rather quote the right one than guess on the phone. Wall ovens stay in their opening for almost every repair.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Thermador's own service network — if your Thermador oven is still inside its factory warranty, call Thermador first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Thermador service</p>
      <h2>Other Thermador repairs</h2>
      <div class="cat-grid">
        <a href="/brands/thermador/" class="cat-card">
          <h3>Thermador appliance repair (all products)</h3>
          <p>Every Thermador line we work on.</p>
        </a>
        <a href="/brands/thermador-range-repair/" class="cat-card">
          <h3>Thermador range repair</h3>
          <p>Pro Grand and Pro Harmony ranges and their ovens.</p>
        </a>
        <a href="/brands/thermador-cooktop-repair/" class="cat-card">
          <h3>Thermador cooktop repair</h3>
          <p>Star Burner gas and induction cooktops.</p>
        </a>
        <a href="/brands/thermador-microwave-repair/" class="cat-card">
          <h3>Thermador microwave repair</h3>
          <p>Built-in and drawer microwaves.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Thermador oven repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Thermador oven not heating? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
