<ServiceHero
  section="brands"
  slug="zline"
  eyebrow="LA · Orange · Ventura · San Bernardino · Riverside Counties"
  title="ZLINE Range & Range Hood Repair Los Angeles"
  subtitle={`Professional RA dual-fuel · SGR gas · Autograph RAZ + Paramount SGRZ · KB and KECOM range hoods. Inexpensive OEM parts via ZLINE direct, fast same-day turnaround. $89 diagnostic across five SoCal counties. ${phone}`}
  heroImageTitle="ZLINE Range & Range Hood Repair"
