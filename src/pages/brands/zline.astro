  {
    "@context": "https://schema.org",
    "@type": "Brand",
    "@id": canonical + "#brand",
    "name": "ZLINE",
    "alternateName": "ZLINE Kitchen and Bath",
    "url": "https://zlinekitchen.com/",
    "description": "ZLINE Kitchen and Bath is an American attainable-luxury appliance brand known for professional-style ranges, dual-fuel ranges, and a large range hood lineup. Product lines include the Professional series (RA dual fuel, SGR gas), the Autograph Edition (RAZ ranges and Paramount SGRZ gas with metallic accent trim), and range hoods (KB convertible, KECOM professional wall mount, 587/597, 8654, island and under-cabinet models). ZLINE operates a direct OEM parts supply."
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
