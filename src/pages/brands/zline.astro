      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  }),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": canonical + "#service",
    "serviceType": "ZLINE Range and Range Hood Repair",
    "name": "ZLINE Appliance Repair Service",
    "url": canonical,
    "description": "ZLINE range, dual-fuel range, gas range, wall oven, cooktop, and range hood repair across all five SoCal counties. Professional series ranges (RA30, RA36, RA48 dual fuel; SGR gas), Autograph Edition (RAZ-30/36/48 with gold, champagne-bronze, and matte-white accents; Paramount SGRZ-36 gas), and the ZLINE range hood lineup (KB convertible, professional KECOM-30/36/42/48 at 400 and 700 CFM, 587/597 wall series, 8654, island and under-cabinet variants). Oven igniter, bake and broil element, oven sensor, spark module, control board, hood blower motor, baffle filter, and speed-control service. Inexpensive OEM parts via ZLINE direct supply. BHGS #A49573.",
    "provider": { "@id": canonical + "#business" },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ],
    "offers": {
      "@type": "Offer",
