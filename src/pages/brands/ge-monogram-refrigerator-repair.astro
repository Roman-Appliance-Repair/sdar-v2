---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Monogram Refrigerator Repair Los Angeles — Same Day";
const description = "GE Monogram refrigerator repair in Los Angeles: 42 and 48-inch built-ins, French door and column models. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/ge-monogram-refrigerator-repair/";

const faqs = [
  { q: "Is a Monogram refrigerator the same as a GE Monogram?", a: "Yes. Monogram is the luxury line of GE Appliances; older units carry the GE Monogram badge and newer ones just Monogram. The refrigerators, parts and repairs are the same." },
  { q: "Why is my Monogram fresh-food side warm when the freezer is cold?", a: "Usually the fan or air path that feeds the fresh-food section has stopped, or the evaporator has iced over because of a defrost fault. We check airflow and defrost first, then the sensor and control." },
  { q: "My Monogram ice maker stopped. Is it the ice maker?", a: "Not always. Check that the water supply is open, the ice maker is switched on and the filter isn't overdue. A frozen fill tube and a failed water inlet valve are common causes; the ice maker itself is replaced only after those are ruled out." },
  { q: "Do you have to pull my built-in Monogram out of the cabinetry?", a: "Rarely. The condenser and its fan are reached through the top grille, and fans, defrost parts, valves, gaskets and ice makers are serviced from inside the cabinet. Removal comes up mainly for some sealed-system work, and the quote says so first." },
  { q: "How much does Monogram refrigerator repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "What should I check before calling?", a: "Note which section is warm, look at the condenser coil behind the top grille for dust (with the power off), listen for the condenser fan, and check that the doors seal. If only the ice maker stopped, confirm the water supply and the ice maker switch." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "GE Monogram Refrigerator Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Monogram", "item": "https://samedayappliance.repair/brands/ge-monogram/" },
      { "@type": "ListItem", "position": 4, "name": "Refrigerator Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="ge-monogram-refrigerator-repair"
    logoSlug="ge-monogram"
    eyebrow={"Monogram · Built-in · French door · Columns"}
    title={"GE Monogram Refrigerator Repair in Los Angeles"}
    subtitle={"Warm fresh-food side, frost building up, an ice maker that quit or a door that won't seal — diagnosed in place, with the unit left in its cabinetry."}
    heroImageTitle={"GE Monogram Refrigerator Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/ge-monogram/">Monogram</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Refrigerator Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>Monogram, GE Monogram: the same refrigerator</h2>
      <p>Monogram is the luxury line of GE Appliances, and most owners still call it GE Monogram — the badge changed, the refrigerators didn't. The core of the line is built-in refrigeration: 42- and 48-inch side-by-side and bottom-freezer built-ins, 36-inch French-door built-ins, and fully integrated refrigerator and freezer columns.</p>
      <p>On the full-size built-ins the machine compartment sits at the top, behind the grille. The condenser, its fan and the compressor area are reached from the front with the unit still in its opening, and a condenser packed with dust up there is the most avoidable reason a Monogram starts running warm. Because the line comes from GE Appliances' US parts network, most Monogram parts are easier to get than those for European built-ins.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Monogram refrigerator do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on a label inside the refrigerator, usually on the side wall of the fresh-food section near the top. Reading them to us lets the technician bring the right parts on the first visit.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>42- and 48-inch built-in side-by-side</h3>
          <p class="model-list">ZISS420 · ZISS480 · ZISP420 · ZISP480</p>
          <p>The grille-on-top built-ins, in stainless (ZISS) or panel-ready (ZISP) versions, with ice and water through the door on dispenser models.</p>
          <p class="fails"><strong>What we see fail:</strong> a dusty condenser and tired condenser fan behind the top grille, evaporator fans, defrost faults that ice the coil, the dispenser and ice maker, water valves, and door closers and gaskets.</p>
        </div>
        <div class="model-card">
          <h3>Built-in bottom-freezer and French door</h3>
          <p class="model-list">ZIC · ZIP</p>
          <p>Built-in refrigerators with the freezer drawer at the bottom, including 36-inch French-door models.</p>
          <p class="fails"><strong>What we see fail:</strong> freezer-side defrost and the defrost drain, the ice maker, evaporator fans, drawer slides, and door gaskets and hinges.</p>
        </div>
        <div class="model-card">
          <h3>Integrated columns</h3>
          <p class="model-list">ZIR · ZIF</p>
          <p>Fully panel-ready refrigerator (ZIR) and freezer (ZIF) columns in several widths, installed alone or as pairs. Each column is a separate appliance.</p>
          <p class="fails"><strong>What we see fail:</strong> airflow and defrost faults within one column, ice makers in freezer columns, and door closers and panel alignment that break the seal.</p>
        </div>
      </div>
      <p class="footnote">Older Monogram built-ins can usually still be repaired, but some control boards and dispenser parts have been discontinued. We check availability before booking the repair, not after.</p>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Monogram is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Fresh-food side warm, freezer still cold</td><td>The fan and the air path that feed the fresh-food section, an evaporator iced over by a defrost fault, then the sensor and control.</td></tr>
          <tr><td>Both sections slowly warming</td><td>Condenser coil and condenser fan behind the top grille, the compressor start components, then power and the main control.</td></tr>
          <tr><td>Ice maker stopped, everything else cold</td><td>Water supply and filter, a frozen fill tube, the water inlet valve, then the ice maker itself.</td></tr>
          <tr><td>Water under the crispers or on the floor</td><td>A blocked or frozen defrost drain; on dispenser models, the water line and the valve.</td></tr>
          <tr><td>Frost on the back wall, or a coil that never clears</td><td>The defrost heater, its sensor or thermostat, and the drain.</td></tr>
          <tr><td>Loud drone or rattle from the top grille</td><td>Condenser fan motor and blade, the fan mounting, anything touching the shroud; compressor mounts after that.</td></tr>
          <tr><td>Door won't close by itself or sweats along the edge</td><td>Door closers, hinge alignment under a heavy panel, then the gasket.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">The top machine compartment</p>
      <h2>Most warm Monograms are an airflow problem, not a compressor</h2>
      <p>Owners often assume a warm built-in means the compressor is gone. On a Monogram most warm-compartment calls end earlier: a condenser fan that stopped, a condenser coil buried in dust so the system can't shed heat, an evaporator fan that quit, or a coil iced over because the defrost system failed. Those are component repairs, usually finished in one or two visits.</p>
      <p>Signs that point at the sealed system instead — the compressor running constantly while the evaporator stays only partly cold, with the fans and condenser confirmed working — get measured before anything is quoted. Sealed-system work means finding the leak or the failed compressor, brazing, evacuating and recharging; if it comes to that, the quote explains it before you decide.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which section is warm</strong> and, if you have a thermometer, the temperature in each. It changes which parts we bring.</li>
        <li><strong>Look behind the top grille.</strong> If the condenser coil is grey with dust, that alone can explain a warm unit. Switch the refrigerator off at the breaker before brushing it, and keep your hands off the fan.</li>
        <li><strong>Listen at the grille.</strong> A compressor running with a silent condenser fan is worth telling us.</li>
        <li><strong>Check the seal.</strong> Close a dollar bill in the door at a few points; if it slides out with no drag, that spot isn't sealing. Make sure nothing inside holds a door or drawer open.</li>
        <li><strong>Ice maker only?</strong> Confirm the water supply valve is open, the ice maker switch is on, and note when the filter was last changed.</li>
      </ul>
      <p>Please don't chip ice off the evaporator or use a heat gun inside the cabinet; the coil and the plastic liner are easy to puncture.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Monogram refrigerator repairs depend on the model and the part, so we quote them after the diagnostic rather than guessing over the phone. Built-ins are almost always repaired in place through the top grille or from inside the cabinet; when a unit has to come out of its opening, the quote says so up front.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Monogram's own service network — if your Monogram is still inside its factory warranty, call Monogram first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Monogram service</p>
      <h2>Other Monogram repairs</h2>
      <div class="cat-grid">
        <a href="/brands/ge-monogram/" class="cat-card">
          <h3>Monogram repair (all products)</h3>
          <p>Every Monogram line we work on, in one place.</p>
        </a>
        <a href="/brands/ge-monogram-built-in-refrigerator-repair/" class="cat-card">
          <h3>GE Monogram built-in refrigerator repair</h3>
          <p>Panel-ready built-in installs.</p>
        </a>
        <a href="/brands/ge-monogram-ice-maker-repair/" class="cat-card">
          <h3>GE Monogram ice maker repair</h3>
          <p>Ice makers and dispensers.</p>
        </a>
        <a href="/brands/ge-monogram-wall-oven-repair/" class="cat-card">
          <h3>GE Monogram wall oven repair</h3>
          <p>Built-in wall ovens.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>GE Monogram refrigerator repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Monogram running warm? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
