---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Gaggenau Oven Repair Los Angeles — Same Day";
const description = "Gaggenau oven repair in Los Angeles: 400 and 200 series ovens, combi-steam ovens and 36-inch EB ovens. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/gaggenau-oven-repair/";

const faqs = [
  { q: "Why won't my Gaggenau oven heat?", a: "The usual causes are a failed heating element, the convection fan or its element, or the temperature sensor; less often the control module. Check the breaker first — a Gaggenau column often has several." },
  { q: "My Gaggenau combi-steam oven keeps asking to descale. Can I put it off?", a: "Not for long. The reminder means minerals are building up in the steam generator and lines. Postponing it leads to weak steam and water faults. Run the descaling program; if faults stay after a full descale, we look at the water supply, drain, pump and steam generator." },
  { q: "The side-hinged door on my Gaggenau oven doesn't close tight. Is that repairable?", a: "Yes. The hinges can be adjusted or replaced, and the door seal replaced if it is worn. A door that doesn't close tight lets heat out and throws the temperature off, so it is worth fixing." },
  { q: "Do you have to take the oven out of the column?", a: "Usually not. Elements, fans, sensors, seals and hinges are reached from the front or from inside the cavity. When a repair needs a unit out of its opening, the written quote says so before anything is moved." },
  { q: "How much does Gaggenau oven repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, with the part lead time, and carries a 90-day warranty on parts and labor." },
  { q: "Are Gaggenau parts hard to get?", a: "Some come from Europe and take longer than domestic parts. We check availability and lead time with your model number and include it in the quote." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Gaggenau Oven Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Gaggenau", "item": "https://samedayappliance.repair/brands/gaggenau/" },
      { "@type": "ListItem", "position": 4, "name": "Oven Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="gaggenau-oven-repair"
    logoSlug="gaggenau"
    eyebrow={"Gaggenau · 400 series · 200 series · Combi-steam"}
    title={"Gaggenau Oven Repair in Los Angeles"}
    subtitle={"Not heating, convection fan quiet, a combi-steam oven with water faults or a side-hinged door that no longer closes tight — diagnosed in place."}
    heroImageTitle={"Gaggenau Oven Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/gaggenau/">Gaggenau</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Oven Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>A Gaggenau oven is usually one of several on the wall</h2>
      <p>Gaggenau belongs to BSH, the group behind Bosch and Thermador, and sits at the top of it. Its ovens are built to be installed in columns: a 400 series oven next to a combi-steam oven, sometimes a speed oven and a warming drawer, all with the same stainless and glass front. Many 400 series ovens have side-hinged doors that open like a cabinet rather than dropping down.</p>
      <p>For repair, what matters is the type behind the front. A conventional or convection oven comes down to elements, the fan, the temperature sensor and the door. A combi-steam oven adds a water system — a tank or a fixed water and drain connection — and a steam generator that collects scale from Los Angeles water. Telling us which unit on the wall has the problem, and its model number, is the fastest way to the right parts.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Gaggenau oven do you have, and what tends to fail on it</h2>
      <p>The model number is on the rating plate visible when the door is open, on the frame or the edge of the cavity. Ovens start with BO or BOP, combi-steam ovens with BS, and the 36-inch ovens with EB.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>400 series ovens</h3>
          <p class="model-list">BO 4xx</p>
          <p>The flagship built-in ovens, typically with side-hinged doors and installed flush in a column.</p>
          <p class="fails"><strong>What we see fail:</strong> heating elements, the convection fan motor, the temperature sensor, door hinges and seals on the side-opening doors, the door lock on self-cleaning models, and control modules.</p>
        </div>
        <div class="model-card">
          <h3>200 series ovens</h3>
          <p class="model-list">BO 2xx · BOP 2xx</p>
          <p>Built-in ovens in the 200 series design, installed alone or in a column with other 200 series units.</p>
          <p class="fails"><strong>What we see fail:</strong> elements, the convection fan, the temperature sensor, door hinges and seals, and the cooling fan.</p>
        </div>
        <div class="model-card">
          <h3>Combi-steam ovens</h3>
          <p class="model-list">BS 4xx · BS 2xx</p>
          <p>Steam and convection in one cavity, with either a water tank or a fixed water and drain connection.</p>
          <p class="fails"><strong>What we see fail:</strong> scale in the steam generator and lines when descaling has been put off, the water pump and tank sensing, the drain on plumbed installs, and the door seal.</p>
        </div>
        <div class="model-card">
          <h3>36-inch EB ovens</h3>
          <p class="model-list">EB 333 · EB 388</p>
          <p>The wide 36-inch Gaggenau oven, a centerpiece in some kitchens.</p>
          <p class="fails"><strong>What we see fail:</strong> elements, the convection fan, the temperature sensor and the large door's hinges and seal.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Gaggenau oven is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Won't heat, or preheats very slowly</td><td>Heating elements, the convection fan and its element, the temperature sensor, then the electronics that switch them.</td></tr>
          <tr><td>Temperature runs high or low</td><td>The temperature sensor, the door seal and the door closing tight, then calibration.</td></tr>
          <tr><td>Side-hinged door no longer closes tight or drops</td><td>The hinges and their adjustment, then the door seal.</td></tr>
          <tr><td>Combi-steam oven shows a water or descaling message</td><td>The descaling cycle, the tank seated and filled, or the water supply on plumbed models; then the pump and the steam generator.</td></tr>
          <tr><td>Water left in the cavity or under the oven</td><td>The drain path on plumbed combi-steam ovens, the door seal, then the steam generator's lines.</td></tr>
          <tr><td>Self-clean finished but the door stays locked</td><td>Let it cool fully; then the door lock and its switch.</td></tr>
          <tr><td>Display or controls not responding</td><td>Power and the breaker first, then the control module.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Combi-steam ovens</p>
      <h2>In a combi-steam oven, water is the wear item</h2>
      <p>A Gaggenau combi-steam oven boils water every time it uses steam, and Southern California water leaves minerals behind in the steam generator and the lines. The oven asks for descaling for that reason. Put off long enough, scale turns into weak steam, water errors and a steam generator that no longer heats properly.</p>
      <p>On plumbed installations there is a second path to check: the fixed water connection and the drain. A kinked supply line or a slow drain produces faults that look like a failed part. So the order is always descaling, water supply and drain, and only then the pump and the steam generator — with parts quoted only for what still fails.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which unit on the wall has the problem</strong> and read us its model number from the plate inside the door.</li>
        <li><strong>Check the breaker.</strong> A Gaggenau column usually has several breakers, and one tripped breaker can take out a single unit.</li>
        <li><strong>Combi-steam oven:</strong> make sure the tank is filled and seated, or on plumbed models that the water supply valve is open; check whether a descaling reminder has been postponed.</li>
        <li><strong>Side-hinged door:</strong> note whether it sags or rubs when closing; don't force it.</li>
        <li><strong>Self-cleaning door locked?</strong> Give the oven a few hours to cool completely before calling.</li>
      </ul>
      <p>Please don't lift a side-hinged oven door off its hinges yourself; it is heavy, and the hinge adjustment is easy to lose.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Gaggenau oven repairs depend on the model and the part, so we quote them after the diagnostic. Some Gaggenau parts come from Europe and take longer to arrive; we tell you the lead time with the quote, not after the order.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Gaggenau's own service network — if your Gaggenau is still inside its factory warranty, call Gaggenau first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Gaggenau service</p>
      <h2>Other Gaggenau repairs</h2>
      <div class="cat-grid">
        <a href="/brands/gaggenau/" class="cat-card">
          <h3>Gaggenau repair (all products)</h3>
          <p>Every Gaggenau line we work on, in one place.</p>
        </a>
        <a href="/brands/gaggenau-wall-oven-repair/" class="cat-card">
          <h3>Gaggenau wall oven repair</h3>
          <p>Built-in wall ovens in columns.</p>
        </a>
        <a href="/brands/gaggenau-stove-repair/" class="cat-card">
          <h3>Gaggenau stove repair</h3>
          <p>Cooktops and Vario modules.</p>
        </a>
        <a href="/brands/gaggenau-dishwasher-repair/" class="cat-card">
          <h3>Gaggenau dishwasher repair</h3>
          <p>Fully integrated dishwashers.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Gaggenau oven repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Gaggenau oven not heating? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
