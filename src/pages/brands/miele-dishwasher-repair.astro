---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Miele Dishwasher Repair Los Angeles — Same Day";
const description = "Miele dishwasher repair in Los Angeles: G 7000 and G 5000, AutoDos, drain and water inlet faults. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/miele-dishwasher-repair/";

const faqs = [
  { q: "What does F11 mean on a Miele dishwasher?", a: "F11 is a drainage fault: the machine could not pump the water out. The most common causes are a clogged filter combination and a jammed non-return valve in the sump, then a kinked or blocked drain hose. The drain pump is checked last, once the rest of the path is clear. Cleaning the filter yourself is a good first step." },
  { q: "My Miele shows a Waterproof system or F70 message. Can I just reset it?", a: "It will usually trip again. The message means water reached the base pan under the machine, so something is leaking — a door seal, a hose connection inside the cabinet or the sump. We find the leak first, dry the base and then reset the system." },
  { q: "AutoDos stopped dosing. Do I need a new AutoDos unit?", a: "Usually not. Start by taking the PowerDisk out, wiping the holder and the dispensing outlet, and reseating it. Hardened detergent residue at the outlet is common. The AutoDos unit itself is replaced only when it still fails with a seated, non-empty PowerDisk." },
  { q: "Do you have to take a panel-ready Miele out of the cabinet?", a: "Rarely. Pumps, valves and the heating circuit are reached from the toe-kick and from inside the tub, so most repairs are done in place. When the machine has to come out, the written quote says so before anything is moved, and the panel goes back aligned." },
  { q: "How much does Miele dishwasher repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair itself is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "Do you also repair Miele Professional dishwashers?", a: "Yes. Miele Professional PG and PFD machines are a different platform from the residential G series and have their own page, Miele Professional dishwasher repair." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Miele Dishwasher Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Miele", "item": "https://samedayappliance.repair/brands/miele/" },
      { "@type": "ListItem", "position": 4, "name": "Dishwasher Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="miele-dishwasher-repair"
    logoSlug="miele"
    eyebrow={"Miele · G 7000 · G 5000 · Futura"}
    title={"Miele Dishwasher Repair in Los Angeles"}
    subtitle={"Won't drain, won't fill, leak protection tripped or AutoDos not dosing — traced from the fault code back, with the cabinet panel left on."}
    heroImageTitle={"Miele Dishwasher Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/miele/">Miele</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Dishwasher Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>On a Miele, the fault code is where the diagnosis starts</h2>
      <p>Miele dishwashers report most faults on the display, as an F-code on older machines or a plain message such as “Drainage fault” or “Water inlet fault” on newer ones. That points us at one circuit before a single panel comes off. The catch is that the code names the circuit, not the part. An F11 drain fault is more often a clogged filter combination or a jammed non-return valve in the sump than a dead drain pump, and replacing the pump on the strength of the code alone is the most common wasted repair we see on this brand.</p>
      <p>Most Miele dishwashers in Los Angeles are fully integrated behind a cabinet panel. The pumps, valves and heater are reached from the toe-kick and from inside the tub, so the machine usually stays in its opening. When it has to come out, the written quote says so before anything is moved.</p>
      <p>This page covers residential Miele dishwashers. Miele Professional undercounter machines are a different platform with their own page: <a href="/brands/miele-professional-dishwasher-repair/">Miele Professional dishwasher repair</a>.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Miele dishwasher do you have, and what tends to fail on it</h2>
      <p>The model number is printed on a label on the edge of the door, visible when the door is open. The letters after it tell the installation type: SCU has a stainless front, SCi has a visible control panel above a custom front, and SCVi is fully integrated, with the controls on the top edge of the door.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>G 7000 series</h3>
          <p class="model-list">G 7xxx SCU · SCi · SCVi</p>
          <p>The current flagship generation. AutoDos doses detergent automatically from a PowerDisk cartridge, AutoOpen cracks the door at the end of the cycle to help drying, and on handleless fully integrated models Knock2open opens the door with two knocks on the panel.</p>
          <p class="fails"><strong>What we see fail:</strong> drain faults that start at the filter combination and non-return valve, AutoDos not dosing (PowerDisk seating, detergent residue at the outlet), the AutoOpen and Knock2open door mechanisms, water inlet faults and leak-protection trips.</p>
        </div>
        <div class="model-card">
          <h3>G 5000 series</h3>
          <p class="model-list">G 5xxx SCU · SCi · SCVi</p>
          <p>The broader current line: the same wash system and integrated installation, with detergent added by hand rather than through AutoDos. AutoOpen drying is on many models.</p>
          <p class="fails"><strong>What we see fail:</strong> the drain path and drain pump, the water inlet valve and hose, the heating circuit, and door springs and hinges on machines carrying a heavy custom panel.</p>
        </div>
        <div class="model-card">
          <h3>Older Futura and earlier generations</h3>
          <p>Machines from the 2000s and 2010s, often sold in the US under the Futura name, are still running in a lot of Los Angeles kitchens. Most parts are still available; some control boards are not, and we check availability before booking the repair rather than after.</p>
          <p class="fails"><strong>What we see fail:</strong> drain pumps, circulation pumps, inlet valves, door seals and door latches.</p>
        </div>
      </div>
      <p class="footnote">Miele Professional machines (PG and PFD models) are covered on the <a href="/brands/miele-professional-dishwasher-repair/">Miele Professional dishwasher</a> page.</p>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Miele dishwasher is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>F11 or “Drainage fault”, water left in the bottom</td><td>The filter combination, the non-return valve in the sump, the drain hose and its connection under the sink, then the drain pump itself.</td></tr>
          <tr><td>F12–F14 or “Water inlet fault”, machine won't fill</td><td>The supply valve under the sink, the mesh filter where the inlet hose connects, a kinked hose, then the inlet valve.</td></tr>
          <tr><td>F70 or a Waterproof system message, machine won't run</td><td>A real leak into the base pan: the door seal, a hose connection inside the cabinet, the sump. The leak is found before the system is reset.</td></tr>
          <tr><td>F24, dishes come out cold</td><td>The heating circuit: the heater and the relay on the control board that switches it.</td></tr>
          <tr><td>AutoDos message, or detergent not being used</td><td>PowerDisk seating and detergent residue at the dispensing outlet, then the AutoDos unit.</td></tr>
          <tr><td>Dishes wet at the end of the cycle</td><td>Rinse aid level and setting, the AutoOpen mechanism, then the heating circuit.</td></tr>
          <tr><td>Gritty or cloudy dishes</td><td>Filters and spray arms, rinse aid, and the water softener setting and salt level on models with a salt reservoir.</td></tr>
          <tr><td>Door falls open or won't open with a knock</td><td>Door springs balanced to the weight of the panel, then the Knock2open mechanism on handleless models.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Leak protection</p>
      <h2>Why a Miele refuses to run after a leak</h2>
      <p>Miele's Waterproof system watches for water where it shouldn't be. The inlet hose has its own safety valve at the tap end, and a float switch sits in the base pan under the machine. If water reaches the base, the machine shuts off the water supply, runs the drain pump and refuses to start a program.</p>
      <p>That is the system working, not failing. Resetting it without finding the water only buys one more cycle before it trips again, and each trip can put more water into the cabinet floor. We look for the source first — door seal, a hose clamp inside the cabinet, the sump — then dry the base and reset.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Write down the exact code or message.</strong> F11 and “Drainage fault” send us to different parts than F14 or a Waterproof message.</li>
        <li><strong>Clean the filter combination.</strong> With the machine off, twist out the filter in the bottom of the tub, rinse it under the tap and check the flat filter around it for glass or seeds.</li>
        <li><strong>Check the drain connection.</strong> Look for a kink in the drain hose under the sink. If a garbage disposer was just installed, the knockout plug inside its dishwasher inlet may still be in place.</li>
        <li><strong>Make sure the water is on.</strong> The supply valve under the sink is easy to close by accident when storing things in that cabinet.</li>
        <li><strong>AutoDos models:</strong> take the PowerDisk out, wipe the holder and the outlet with a damp cloth, and put it back in.</li>
      </ul>
      <p>If the display shows a Waterproof or F70 message, please don't keep restarting the machine; turn it off and tell us when you call.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Miele dishwasher repairs depend on the generation and the part, so we quote them after the diagnostic rather than guessing over the phone. Integrated machines are almost always repaired in place; when one has to come out of its opening, the quote says so up front.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Miele's own service network — if your Miele is still inside its factory warranty, call Miele first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Miele service</p>
      <h2>Other Miele repairs</h2>
      <div class="cat-grid">
        <a href="/brands/miele/" class="cat-card">
          <h3>Miele repair (all products)</h3>
          <p>Every Miele line we work on, in one place.</p>
        </a>
        <a href="/brands/miele-professional-dishwasher-repair/" class="cat-card">
          <h3>Miele Professional dishwasher repair</h3>
          <p>PG and PFD professional machines.</p>
        </a>
        <a href="/brands/miele-washer-repair/" class="cat-card">
          <h3>Miele washer repair</h3>
          <p>W1 front-loaders, TwinDos, drain and door lock faults.</p>
        </a>
        <a href="/brands/miele-oven-repair/" class="cat-card">
          <h3>Miele oven repair</h3>
          <p>Ovens, combi-steam and speed ovens.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele dishwasher repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Miele dishwasher stopped mid-cycle? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
