---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Miele Washer Repair Los Angeles — Same Day";
const description = "Miele washer repair in Los Angeles: W1 front-loaders with TwinDos, drain faults, door locks and spin noise. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/miele-washer-repair/";

const faqs = [
  { q: "Why won't my Miele washer open the door after the cycle?", a: "The door stays locked while the washer believes there is water in the drum. Most of the time the cause is a drain problem — a full drain filter or a blocked drain hose — and the door releases once the water is out. If the drum is empty and the door still won't release, the door lock or its signal is next." },
  { q: "Where is the drain filter on a Miele W1?", a: "Behind the small flap at the bottom front of the machine. Put a shallow tray and towels down first, because the water in the machine comes out through it, then unscrew the filter slowly, clean it and screw it back firmly so it doesn't leak." },
  { q: "TwinDos stopped dosing. Is the washer broken?", a: "Usually not. Check that both cartridges are seated, not empty and not thickened from sitting half-used. If the washer still won't dose with fresh cartridges, the dosing pump or line gets tested. The washer keeps working if you add detergent by hand." },
  { q: "Is a Miele washer worth repairing?", a: "In most cases, yes: drain, door lock, inlet and dosing repairs are component jobs. The one we discuss openly is a drum bearing on an older machine, where the repair is bigger and we give you the numbers before you decide." },
  { q: "How much does Miele washer repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "Do you repair stacked Miele washer and dryer pairs?", a: "Yes. Most repairs on a stacked W1 and T1 are done in place. If the dryer has to come off the washer, we say so before starting and reinstall it with the stacking kit." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Miele Washer Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Miele", "item": "https://samedayappliance.repair/brands/miele/" },
      { "@type": "ListItem", "position": 4, "name": "Washer Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="miele-washer-repair"
    logoSlug="miele"
    eyebrow={"Miele · W1 · TwinDos"}
    title={"Miele Washer Repair in Los Angeles"}
    subtitle={"Water left in the drum, a door that won't unlock, TwinDos not dosing or a hard bang on spin — diagnosed on site, starting with the drain filter."}
    heroImageTitle={"Miele Washer Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/miele/">Miele</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Washer Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>Most Miele washer calls start at the drain filter</h2>
      <p>Miele W1 washers are 24-inch European front-loaders, often stacked with a T1 dryer in a closet or a hallway laundry. Two parts of the design shape most service calls. The first is the drain filter behind a small flap at the bottom front: it catches coins, hair clips and lint before they reach the drain pump, and when it fills up the machine can't empty. The second is TwinDos, which doses liquid detergent automatically from two cartridges in the drawer.</p>
      <p>A door that won't unlock at the end of a cycle is a good example of why the order matters. The door stays locked while the machine thinks there is water in the drum, so a lot of “door lock” calls end at the drain path rather than at the lock itself.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Miele washer do you have, and what tends to fail on it</h2>
      <p>The model number is on the type plate visible when the door is open, around the door opening. Tell us whether the drawer has TwinDos cartridges and whether the washer is stacked; both change how the technician works.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>W1 with TwinDos</h3>
          <p class="model-list">WWH 860 · WXI 860 · WXR 860</p>
          <p>W1 models that dose detergent automatically from the TwinDos cartridges, with touch controls on the higher models.</p>
          <p class="fails"><strong>What we see fail:</strong> TwinDos lines and pumps clogged by detergent that thickened in a half-used cartridge, drain filter blockages, door locks, inlet valves, and drum bearings on high-mileage machines.</p>
        </div>
        <div class="model-card">
          <h3>W1 without TwinDos</h3>
          <p class="model-list">WWB 020 · WWD 320</p>
          <p>The same drum and chassis with detergent added by hand or as Miele capsules.</p>
          <p class="fails"><strong>What we see fail:</strong> the drain filter and drain pump, inlet valves, door locks, and shock absorbers on machines that have been running unbalanced loads.</p>
        </div>
        <div class="model-card">
          <h3>Older Miele washers</h3>
          <p>Earlier Touchtronic machines are still in plenty of Los Angeles homes. Mechanical parts are generally available; some electronics are not, and we check before booking the repair.</p>
          <p class="fails"><strong>What we see fail:</strong> drain pumps, door locks, drum bearings and dampers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Miele washer is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Water left in the drum, drain fault on the display</td><td>The drain filter behind the bottom flap, the drain hose and standpipe, then the drain pump.</td></tr>
          <tr><td>Door won't unlock after the cycle</td><td>Water still in the drum (the drain path above), then the door lock, then the signal from the control.</td></tr>
          <tr><td>Won't fill, water inlet fault</td><td>The taps behind the machine, the mesh filters in the inlet hose connections, then the inlet valves.</td></tr>
          <tr><td>Bangs or walks during spin</td><td>Leveling feet and a stable floor, a single heavy item that couldn't balance, then the shock absorbers and springs.</td></tr>
          <tr><td>Roar or grinding that gets louder at high spin</td><td>Drum bearings — confirmed by hand with the drum empty before anything is quoted.</td></tr>
          <tr><td>TwinDos not dosing, or detergent left in the cartridge</td><td>Cartridges seated and not empty, detergent that has thickened in a cartridge left half-used, then the dosing pump.</td></tr>
          <tr><td>Water on the floor</td><td>The drain filter cap not fully tightened after cleaning, the door seal with something caught in it, then the hoses.</td></tr>
          <tr><td>Musty smell</td><td>Lint and sludge in the drain filter, the door seal fold, and a habit of only washing cold.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">TwinDos</p>
      <h2>When TwinDos stops dosing, the cartridge is usually the reason</h2>
      <p>TwinDos draws detergent from two cartridges in the drawer through small pumps and lines. The electronics rarely fail. What fails is the liquid: a cartridge left half-used for months can thicken, and a thick detergent starves the pump and leaves a film in the lines.</p>
      <p>So the first steps cost nothing: confirm both cartridges are seated, not empty and within their date, and clean the cartridge compartment. If the washer still doesn't dose with fresh cartridges, the dosing pump or its line gets tested and replaced. Either way the washer still washes normally if you add detergent by hand in the meantime.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Clean the drain filter.</strong> Open the flap at the bottom front, put a shallow tray and towels down — water will come out — then unscrew the filter slowly, clear it and screw it back in firmly.</li>
        <li><strong>Check the taps.</strong> Both water taps behind the machine should be fully open, and the inlet hoses free of kinks.</li>
        <li><strong>Check the level.</strong> If the washer walks on spin, push diagonally on the top corners: a rocking machine needs its feet adjusted.</li>
        <li><strong>Look at TwinDos.</strong> Reseat both cartridges and note how full they are.</li>
        <li><strong>Write down the message.</strong> The exact wording on the display tells us which parts to bring.</li>
      </ul>
      <p>If the drum is full of water and the door is locked, please don't try to force the door open; draining through the filter flap is the safe way to empty it.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Miele washer repairs depend on the model and the part, so we quote them after the diagnostic. Stacked pairs are serviced in place in most cases; when the dryer has to come off the washer for a repair, we tell you before we start.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Miele's own service network — if your Miele is still inside its factory warranty, call Miele first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Miele service</p>
      <h2>Other Miele repairs</h2>
      <div class="cat-grid">
        <a href="/brands/miele/" class="cat-card">
          <h3>Miele repair (all products)</h3>
          <p>Every Miele line we work on, in one place.</p>
        </a>
        <a href="/brands/miele-dryer-repair/" class="cat-card">
          <h3>Miele dryer repair</h3>
          <p>T1 heat-pump dryers that take too long or stop drying.</p>
        </a>
        <a href="/brands/miele-dishwasher-repair/" class="cat-card">
          <h3>Miele dishwasher repair</h3>
          <p>G 7000 and G 5000, drain and inlet faults.</p>
        </a>
        <a href="/brands/miele-refrigerator-repair/" class="cat-card">
          <h3>Miele refrigerator repair</h3>
          <p>MasterCool built-ins and integrated columns.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele washer repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Miele washer full of water? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
