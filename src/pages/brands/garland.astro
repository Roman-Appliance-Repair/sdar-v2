const title = "Garland Commercial Cooking Repair Los Angeles — Same Day";
const description = "Garland Sentry, Master Series, MCO convection, GD charbroiler service across LA. Ali Group family. $120 commercial diagnostic.";
const canonical = "https://samedayappliance.repair/brands/garland/";

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/garland/#business",
    "name": "Same Day Appliance Repair, Garland Commercial Cooking Service",
    "image": "https://samedayappliance.repair/images/same-day-appliance-repair.png",
    "url": canonical,
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "CSLB C-20 HVAC", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Contractors State License Board" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "BBB Accredited Business", "recognizedBy": { "@type": "Organization", "name": "Better Business Bureau" } }
    ],
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
    ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "Brand",
    "@id": "https://samedayappliance.repair/brands/garland/#brand",
    "name": "Garland",
    "alternateName": "The Garland Group",
    "url": "https://www.garland-group.com/",
    "description": "Garland has manufactured commercial cooking equipment since 1864 — among the oldest continuously-operating commercial range makers in North America. Headquartered in Mississauga, Ontario, Canada (historically Freeland, Pennsylvania). Acquired by Welbilt Inc.; Welbilt acquired by Ali Group in July 2022. Now part of Ali Group's foodservice portfolio alongside Frymaster, Manitowoc, Beverage-Air, Champion, CMA, Convotherm, Lincoln, and US Range (Garland's direct sibling brand). Product families: Master Series and Sentry heavy-duty ranges, MCO Master Series convection ovens, GS infrared and GD radiant charbroilers, ED and gas griddles, Premier and Sunbeam fryers, Hotel Pan Holding cabinets, salamander broilers."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Garland", "item": canonical }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": canonical,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who owns Garland today?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Garland is part of Ali Group's foodservice family. Ali Group completed the Welbilt Inc. acquisition in July 2022, and Garland (a Welbilt brand) moved with that transaction. Manufacturing continues at the Mississauga, Ontario, Canada plant — the same plant that has been making Garland equipment since the 20th century, with the brand itself founded in 1864. Sibling Ali Group brands now include Frymaster fryers, Manitowoc ice machines, Beverage-Air refrigeration, Champion and CMA dishwashers, Convotherm combi ovens, Lincoln conveyor pizza ovens, Kolpak walk-ins, and US Range — Garland's direct sibling brand that shares parts pipeline and service architecture. Pitco (the other major commercial fryer brand) is part of Middleby Corporation via a different acquisition chain — NOT part of Ali Group. For LA operators running multi-brand Ali kitchens, all the Ali siblings are under one service relationship; Pitco we cover separately through the Middleby parts pipeline."
        }
      },
      {
        "@type": "Question",
        "name": "What's the difference between Master Series, Sentry, and Restaurant Series?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All three are Garland heavy-duty range lines but they sit at different duty tiers. Master Series is the highest output — hotel banquet kitchens, very high-volume operations, the M-series electric and the heaviest US Range gas. Sentry G-series is restaurant-tier — premium steakhouses and high-end restaurants, G24/G36/G48/G60 widths depending on burner count. Restaurant Series is entry-to-mid commercial. The shorthand: M-series is electric, G-series is gas, US Range is the Garland sibling running parallel product lines. We service all of them; deeper range coverage lives on our /brands/garland-range-repair/ combo."
        }
      },
      {
        "@type": "Question",
        "name": "Does Garland make convection ovens as well as ranges?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The MCO Master Series convection line is significant Garland equipment in LA mid-segment restaurants and catering operations. MCO-GS-10S is the single full-size gas convection (10 standard pans); MCO-GS-20 is the double-stack (20 pans, high-volume banquet); MCO-ES is the single electric. Sunfire Series covers the half-size convection footprint for smaller cafes. MCO is the value-positioned convection choice when Rational SCC budget isn't justified — about 40 to 60 percent below combi-oven pricing at similar bake capacity. We see MCO across DTLA hotel banquet prep, Pasadena restaurant kitchens, and Patina catering operations."
        }
      },
      {
        "@type": "Question",
        "name": "What's SIT and why does it appear on Garland service calls?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "SIT is Sicurezza Italiana Tecnologica — the Italian gas safety control assembly Garland uses across most of its gas-fired equipment. SIT thermocouple, safety valve, and pilot assembly form an integrated module. When a Garland range or convection oven has ignition issues, no-pilot-light symptoms, or burner cutout under load, the diagnosis almost always lands on SIT components. Garland's own service training materials specifically address SIT removal and replacement — it's that common. We carry SIT thermocouples ($45 to $95 part) and safety valves ($180 to $280) on the van for same-call resolution."
        }
      },
      {
        "@type": "Question",
        "name": "Are Garland Charbroilers the same product as the ranges?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Separate product, frequently co-installed. The GS-series infrared charbroilers are steakhouse-standard equipment — Mastro's, Ruth's Chris, Wolfgang's, STK, Capital Grille and the LA steakhouse cluster run them. The GD-series radiant gas charbroilers cover mid-segment and casual-dining grill operations. Most LA Garland-equipped steakhouse kitchens run both a heavy-duty range and a Charbroilers line, so we frequently service both together on one dispatch. Detailed Charbroilers GS coverage lives on our /brands/garland-range-repair/ combo; this pillar covers GD radiant and salamander broilers."
        }
      },
      {
        "@type": "Question",
        "name": "What does Garland repair cost in LA?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "$120 flat commercial diagnostic, waived when you approve the repair. Most Garland service calls land between $340 and $750 parts-and-labor. SIT thermocouple replacement runs $200 to $340. Gas valve and SIT control swap $280 to $480. MCO convection blower motor $400 to $700. Charbroiler GS infrared burner element $320 to $560 (upper end of typical call). G-series heavy-duty burner refurbish $420 to $720. Control board failures are rare on Garland but expensive when they happen — $700 to $1,200. We quote parts and labor separately on every call so you see exactly what you're paying for."
        }
      },
      {
        "@type": "Question",
        "name": "Will you service used Garland bought at restaurant auction?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. LA's restaurant turnover rate produces a steady stream of used Garland equipment hitting auction and liquidation channels. We don't sell Garland; we service it regardless of how you acquired it. SIT control assemblies, Master Series burner setups, and the MCO convection blower architecture are well-documented in Garland's legacy parts catalog — even 15-year-old units typically retain serviceability. The economics usually work out: an $850 repair on a $2,500 used Sentry that lists at $9K new is a clear win. We give the honest assessment after the $120 diagnostic, and we'll tell you straight if a unit isn't worth the repair."
        }
      },
      {
        "@type": "Question",
        "name": "Why won't my Garland range burner or oven stay lit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The most common cause our techs find is the SIT thermocouple, the flame-safety device on Garland's gas lineup that senses the pilot or burner flame and shuts the gas off if it weakens, so a worn one makes the burner or oven die out shortly after lighting; replacement runs $200 to $340. The next causes are a gas valve or SIT control out of spec ($280 to $480) and a clogged burner orifice that weakens the flame enough to trip the safety. We carry SIT control components on the truck, so most of these close same-visit, and we test the flame and the thermocouple signal before deciding which it is. Same Day Appliance Repair, $120 commercial diagnostic, waived with repair."
        }
      },
      {
        "@type": "Question",
        "name": "There is no Garland service center in LA, who do I call?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Us. Garland's factory-service network lists training centers in Mayfield Heights, Ohio and Irving, Texas, but there's no LA-area Garland authorized service presence, which is a real gap for LA operators. We built our Garland practice to be the LA-area authority by default: we cover the full lineup, not just ranges, but MCO convection, GS/GD charbroilers, griddles, fryers, salamanders, and Hotel Pan Holding, we run the Ali Group sibling-call so one account also covers Frymaster, Manitowoc, Beverage-Air, and Champion, and we stock SIT control components on the truck so most calls resolve same-visit. Same Day Appliance Repair, $120 commercial diagnostic, waived with repair."
        }
      }
    ]
  }
];
