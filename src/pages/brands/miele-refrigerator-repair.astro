---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Miele Refrigerator Repair Los Angeles — Same Day";
const description = "Miele refrigerator repair in Los Angeles: MasterCool built-ins, integrated columns, PerfectFresh drawers. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/miele-refrigerator-repair/";

const faqs = [
  { q: "My Miele refrigerator is warm but the freezer is fine. What fails?", a: "On a column pair, only the warm unit has a problem. On a combination, the usual causes are the evaporator fan for that compartment or an evaporator iced over by a defrost fault. We test that compartment's airflow and defrost first." },
  { q: "Why is my PerfectFresh drawer freezing the vegetables?", a: "PerfectFresh drawers are designed to run just above freezing. Check the drawer setting first and make sure food isn't packed against the air openings. If produce still freezes, the drawer's temperature sensing is tested." },
  { q: "Do you have to pull a built-in Miele out of the cabinet?", a: "Rarely. Fans, defrost parts, valves, gaskets and ice makers are serviced with the unit in place. Removal comes up mainly for some sealed-system work, and if it is needed the quote says so before work starts." },
  { q: "Does a warm Miele mean the compressor has failed?", a: "Usually not. Most warm-compartment calls are airflow or defrost: a stopped fan, a frosted coil, a blocked ventilation grille. The sealed system is diagnosed with measurements before any compressor work is quoted." },
  { q: "How much does Miele refrigerator repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "What should I check before calling?", a: "Which unit and compartment is warm, whether the ventilation grille is blocked, whether the doors seal along the gasket, the PerfectFresh setting if produce is freezing, and the water supply if only the ice maker stopped." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Miele Refrigerator Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Miele", "item": "https://samedayappliance.repair/brands/miele/" },
      { "@type": "ListItem", "position": 4, "name": "Refrigerator Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="miele-refrigerator-repair"
    logoSlug="miele"
    eyebrow={"Miele · MasterCool · Integrated columns"}
    title={"Miele Refrigerator Repair in Los Angeles"}
    subtitle={"Warm compartment, ice building up, a drawer freezing the produce or an ice maker that quit — diagnosed in place, with the panels left on."}
    heroImageTitle={"Miele Refrigerator Repair in Los Angeles"}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/miele/">Miele</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Refrigerator Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>First question: which Miele, and which compartment?</h2>
      <p>Miele refrigeration in Los Angeles kitchens comes in two main forms. MasterCool is Miele's large built-in line — refrigerators, freezers and combinations, stainless or panel-ready. The integrated models are designed to sit fully behind cabinet doors, often as a pair of columns side by side. Many of them have PerfectFresh drawers that hold produce just above freezing at high humidity.</p>
      <p>A column pair is two separate appliances. A warm refrigerator column next to a cold freezer column is a problem in one unit, not both, and the technician treats it that way. On a combination unit, which compartment is warm, and whether the other is still cold, tells us where to start before any tools come out.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Miele refrigerator do you have, and what tends to fail on it</h2>
      <p>The model and serial number are on the rating plate inside the refrigerator, usually on the side wall near the crisper drawers. The prefix tells the type: K is a refrigerator, F a freezer, KF a combination and KWT a wine unit; Vi marks a fully integrated model.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>MasterCool built-ins</h3>
          <p class="model-list">K · F · KF · KWT … Vi</p>
          <p>Large built-in refrigerators, freezers and combinations, installed flush with the cabinetry and often panel-ready.</p>
          <p class="fails"><strong>What we see fail:</strong> condenser airflow through the ventilation grille, evaporator fans, defrost faults that ice a coil, door gaskets and hinges under heavy panels, ice makers and water valves on freezer models.</p>
        </div>
        <div class="model-card">
          <h3>Integrated columns and niche refrigerators</h3>
          <p>Narrower units built into a cabinet niche behind custom doors, frequently installed as refrigerator and freezer pairs.</p>
          <p class="fails"><strong>What we see fail:</strong> the same airflow and defrost items, door alignment where the cabinet door and the appliance door are coupled, and ice makers in the freezer unit.</p>
        </div>
        <div class="model-card">
          <h3>Freestanding bottom-freezers</h3>
          <p class="model-list">KFN</p>
          <p>Freestanding combinations with the freezer at the bottom.</p>
          <p class="fails"><strong>What we see fail:</strong> fans, defrost and drain, and door seals.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Miele refrigerator is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Refrigerator warm, freezer still cold</td><td>That compartment's air supply: the evaporator fan, an evaporator iced over from a defrost fault, then the sensor and control.</td></tr>
          <tr><td>Whole unit slowly warming</td><td>Dust at the condenser and its ventilation grille, the condenser fan, the compressor start components, then power and control.</td></tr>
          <tr><td>PerfectFresh drawer freezing produce, or not cold enough</td><td>The drawer setting, food blocking the air path to the drawer, then the drawer's temperature sensing.</td></tr>
          <tr><td>Ice on the back wall or a coil that never clears</td><td>The defrost system and the drain that carries defrost water away; a door that isn't sealing feeds the same problem.</td></tr>
          <tr><td>Water under the drawers</td><td>A blocked or frozen defrost drain.</td></tr>
          <tr><td>Temperature alarm beeping</td><td>A door not closing fully — often a panel that has shifted — then the sensor.</td></tr>
          <tr><td>Ice maker stopped, everything else cold</td><td>Water supply and filter, a frozen fill tube, the water inlet valve, then the ice maker.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Built-in installation</p>
      <h2>A built-in refrigerator still needs to breathe</h2>
      <p>A built-in Miele is surrounded by cabinetry, so the heat it removes from the food has to leave through a ventilation grille — at the base or above the unit, depending on the model. If that grille is blocked by a kick plate, a decorative cover or years of dust, the compressor runs longer and hotter and the cabinet slowly loses temperature.</p>
      <p>Doors are the other built-in issue. A heavy custom panel works the hinges hard, and a door that sits slightly out of square stops sealing at one corner. Frost along one edge of the gasket, or a temperature alarm with no other symptom, often traces back to alignment rather than to the cooling system.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Note which unit and which compartment is warm</strong> and, if you have a thermometer, the temperature in each. It changes which parts we bring.</li>
        <li><strong>Find the ventilation grille</strong> and make sure nothing is blocking it. If it is grey with dust, vacuum the grille surface only.</li>
        <li><strong>Check the door seal.</strong> Close a dollar bill in the door at a few points; if it slides out without drag, that spot isn't sealing. Make sure nothing inside holds a door or drawer open.</li>
        <li><strong>Look at the PerfectFresh setting</strong> if produce is freezing — a setting change is the first thing to rule out.</li>
        <li><strong>Ice maker only?</strong> Confirm the water supply valve is open and note when the filter was last changed.</li>
      </ul>
      <p>Please don't chip ice off the evaporator or use a heat gun inside the cabinet; the coil and the liner are easy to puncture.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Miele refrigerator repairs depend on the model and the part, so we quote them after the diagnostic. Fans, defrost parts, valves, gaskets and ice makers are repaired with the unit in its niche; when a repair needs the unit out, the quote says so first.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. We are an independent repair company, not part of Miele's own service network — if your Miele is still inside its factory warranty, call Miele first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Miele service</p>
      <h2>Other Miele repairs</h2>
      <div class="cat-grid">
        <a href="/brands/miele/" class="cat-card">
          <h3>Miele repair (all products)</h3>
          <p>Every Miele line we work on, in one place.</p>
        </a>
        <a href="/brands/miele-built-in-refrigerator-repair/" class="cat-card">
          <h3>Miele built-in refrigerator repair</h3>
          <p>Panel-ready built-in installs.</p>
        </a>
        <a href="/brands/miele-wine-cooler-repair/" class="cat-card">
          <h3>Miele wine cooler repair</h3>
          <p>Wine units and wine columns.</p>
        </a>
        <a href="/brands/miele-dishwasher-repair/" class="cat-card">
          <h3>Miele dishwasher repair</h3>
          <p>G 7000 and G 5000, drain and inlet faults.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele refrigerator repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Miele refrigerator running warm? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
