---
// /brands/marsal-pizza-oven-repair/, Cluster 09. Marsal & Sons gas deck pizza ovens (brick-lined decks, MB and SD series).
// Created 2026-10 (seo/pizza). 301 target of legacy /marsal-pizza-ovens-repair/. Gas models only.
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

const title = "Marsal Pizza Oven Repair Los Angeles — Same Day";
const description = "Marsal gas deck pizza oven won't light, hold temperature, or bake evenly? Same-day repair of Marsal MB and SD series decks across LA and SoCal. $120 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/marsal-pizza-oven-repair/";

const faqs = [
  { q: "Do you repair Marsal pizza ovens?", a: "Yes. We repair Marsal &amp; Sons gas deck pizza ovens, including the MB and SD series brick-lined decks, in single and stacked configurations. Pilot and thermocouple, gas safety valve, thermostat, burner and orifice, ignition, door hinges and springs, and cracked deck stones. $120 commercial diagnostic, waived with repair." },
  { q: "Why won't my Marsal deck oven stay lit?", a: "On a Marsal gas deck, a pilot that lights and then goes out almost always points to the thermocouple or the gas safety valve. The thermocouple sits in the pilot flame and holds the safety valve open; when it weakens from years of heat, the valve drops out and shuts off the gas. A dirty pilot orifice that gives a small, lazy flame causes the same symptom. Thermocouple or gas valve replacement typically runs labor $325 to $640 plus the part." },
  { q: "Why is my Marsal deck baking unevenly or running cool?", a: "Usually thermostat calibration drift, a partially clogged burner orifice, or a cracked deck stone. A drifted thermostat reads correct but bakes 25 to 40°F off, which customers notice on the crust. A clogged orifice gives a weak, uneven flame under one side of the deck. A cracked stone creates hot and cold spots. We check the deck with an independent thermometer, look at the flame pattern, and inspect the stones before quoting." },
  { q: "Can you replace cracked Marsal deck stones?", a: "Yes. Brick-lined decks crack from years of thermal cycling or from a cold-water spill on a hot deck. Once a stone is split it needs replacing, not patching. We replace the deck stones and bring the oven up to temperature slowly so the new stones cure properly. Deck stone replacement typically runs labor $250 to $520 plus the stones, priced after diagnosis by deck size." },
  { q: "What does Marsal pizza oven repair cost in LA?", a: "$120 flat commercial diagnostic, waived with repair. Typical labor ranges (parts quoted after diagnosis): door hinge / spring / gasket $250–$520, thermostat $300–$610, pilot and thermocouple $325–$640, burner ignitor $325–$640, gas valve calibration $250–$465, gas valve replacement $325–$640, deck stone replacement $250–$520. Repairs carry a 90-day warranty on parts and labor. See our <a href=\"/price-list/commercial-oven-repair-cost/\">commercial oven repair cost guide</a>." },
  { q: "Do you work on wood-fired Marsal ovens?", a: "No. We work on Marsal gas deck ovens only. We don't work on wood-fired ovens." },
  { q: "How fast can you get to a Marsal oven that's down during service?", a: "Same-day across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties when a technician is available. Phones are answered 24/7; visits run Monday to Saturday, 8am to 6pm. A call after 6pm or on Sunday is booked into the first open slot of the next working day." }
];

const schema = { "@context": "https://schema.org", "@graph": [
  { "@type": "Service", "serviceType": "Marsal Pizza Deck Oven Repair", "provider": { "@id": canonical + "#org" }, "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ], "description": "Marsal & Sons gas deck pizza oven repair across Los Angeles and Southern California: MB and SD series brick-lined gas decks. Pilot and thermocouple, gas safety valve, thermostat calibration, burner and orifice, ignition, door hinges and springs, deck stone replacement. Gas models only. $120 commercial diagnostic waived with repair. 90-day warranty on parts and labor." },
  { "@type": "FAQPage", "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&') } })) },
  { "@type": "BreadcrumbList", "itemListElement": [ { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" }, { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" }, { "@type": "ListItem", "position": 3, "name": "Marsal Pizza Oven Repair", "item": canonical } ] }
] };

// Canonical org schema — HVAC 777 LLC + credentials + hours (same pattern as the other Cluster 09 brand pages).
// SSOT: src/data/credentials-schema.ts + src/data/business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="call-banner"><div class="wrap"><span>Marsal deck down? Same-day commercial service:</span><a href={`tel:${MAIN_PHONE_TEL}`} class="phone-lg">{MAIN_PHONE}</a></div></div>
  <ServiceHero
    section="brands"
    slug="marsal-pizza-oven-repair"
    logoSlug="marsal"
    eyebrow={"Marsal Pizza Oven Repair"}
    title={"Marsal Pizza Oven Repair"}
    subtitle={description}
    heroImageTitle={"Marsal Pizza Oven Repair"}
  />


<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <span class="breadcrumbs-plain">Marsal</span> <span class="crumbs-sep">›</span>
  <span aria-current="page">Pizza Oven Repair</span>
</nav>
  <BrandBranchesGrid />
  <section class="trust-bar"><div class="wrap"><span>Licensed BHGS #A49573 · Insured</span><span>Same-day · 7 Southern California counties</span><span>$120 commercial diagnostic · waived with repair</span></div></section>

  <section class="section"><div class="wrap narrow">
    <h2>Marsal gas deck pizza ovens, brick-lined decks for independent pizzerias</h2>
    <p>A Marsal deck oven that won't stay lit, won't hold temperature, or bakes unevenly usually traces to one of three patterns our techs at Same Day Appliance Repair diagnose first. (1) A weak thermocouple or a failing gas safety valve, so the pilot drops out and the burner shuts off. (2) Thermostat calibration drift or a partially clogged burner orifice, so the deck runs cooler than the dial says. (3) A cracked deck stone, which creates hot and cold spots across the bake. $120 flat commercial diagnostic, waived with repair.</p>
    <p>Marsal &amp; Sons builds gas deck pizza ovens with brick-lined baking decks, sold in single-deck and stacked configurations. The MB and SD series are the units we see most in LA pizzerias and Italian restaurants. We service Marsal gas deck ovens. We don't work on wood-fired ovens.</p>
  </div></section>

  <section class="section alt"><div class="wrap">
    <h2>Marsal pizza ovens we service</h2>
    <div class="model-grid">
      <div class="model-card"><h3>MB series, gas deck</h3><p>Brick-lined gas deck ovens in single and stacked configurations. Service: pilot and thermocouple, gas safety valve, thermostat, burner and orifice, ignition, door hinges and springs, deck stones.</p></div>
      <div class="model-card"><h3>SD series, gas deck</h3><p>Gas deck ovens with brick-lined decks. Same service pattern as the MB series, with deck stone replacement when a stone cracks from thermal cycling.</p></div>
      <div class="model-card"><h3>Stacked decks</h3><p>On double and triple stacks, each deck has its own burner and thermostat. We diagnose each deck separately so one bad deck doesn't get blamed on the others.</p></div>
    </div>
  </div></section>

  <section class="section"><div class="wrap narrow">
    <h2>What fails on a Marsal gas deck oven</h2>
    <ul class="check-list">
      <li><b>Pilot and thermocouple</b>, the pilot lights and goes out, or the burner won't come on. The thermocouple weakens with heat and lets the safety valve drop out.</li>
      <li><b>Gas safety valve</b>, a sticking or failed valve starves the burner or won't hold open. We test it before replacing.</li>
      <li><b>Thermostat calibration</b>, the deck reads correct but bakes 25 to 40°F off. We check against an independent thermometer and recalibrate or replace.</li>
      <li><b>Burner and orifice</b>, a partially clogged orifice gives a weak, uneven flame under part of the deck and slow recovery between bakes.</li>
      <li><b>Ignition</b>, worn ignition components make lighting the oven unreliable at the start of the day.</li>
      <li><b>Door hinges and springs</b>, constant opening at peak service wears hinges and springs until the door won't close tight and heat escapes.</li>
      <li><b>Cracked deck stones</b>, we replace cracked stones and cure the new ones properly on the first heat-up.</li>
    </ul>
    <p>Every gas call includes a regulator pressure check, because under-pressure runs cold and over-pressure burns out components.</p>
  </div></section>

  <section class="section alt"><div class="wrap narrow">
    <h2>What Marsal pizza oven repair typically costs</h2>
    <p>$120 flat commercial diagnostic, waived with repair. 90-day warranty on parts and labor.</p>
    <table class="price-table"><thead><tr><th>Repair</th><th>Labor range (parts after diagnosis)</th></tr></thead>
    <tbody><tr><td>Door hinge / spring / gasket service</td><td>$250–$520</td></tr><tr><td>Thermostat replacement</td><td>$300–$610</td></tr><tr><td>Pilot and thermocouple</td><td>$325–$640</td></tr><tr><td>Burner ignitor assembly</td><td>$325–$640</td></tr><tr><td>Gas valve calibration</td><td>$250–$465</td></tr><tr><td>Gas valve replacement</td><td>$325–$640</td></tr><tr><td>Deck stone replacement</td><td>$250–$520</td></tr></tbody></table>
    <p class="small">Final price depends on deck size and parts. See our <a href="/price-list/commercial-oven-repair-cost/">commercial oven repair cost guide</a>.</p>
  </div></section>

  <section class="section"><div class="wrap narrow">
    <h2>Related pizza oven pages</h2>
    <ul class="related-links">
      <li><a href="/commercial/pizza-oven-repair/"><b>Commercial pizza oven repair Los Angeles</b></a>, service hub</li>
      <li><a href="/commercial/pizza-oven-repair/deck-pizza-oven-repair/"><b>Deck pizza oven repair</b></a>, gas and electric deck ovens</li>
      <li><a href="/brands/bakers-pride-pizza-oven-repair/">Bakers Pride pizza oven repair</a>, Y-600 gas deck</li>
      <li><a href="/brands/peerless-pizza-oven-repair/">Peerless pizza oven repair</a>, legacy gas deck ovens</li>
      <li><a href="/brands/blodgett-oven-repair/">Blodgett oven repair</a>, 1048/1060 pizza decks</li>
      <li><a href="/brands/wood-stone-pizza-oven-repair/">Wood Stone gas pizza oven repair</a>, gas-fired Wood Stone models</li>
    </ul>
  </div></section>

  <section class="section alt"><div class="wrap narrow"><h2>Marsal pizza oven repair, frequently asked</h2>{faqs.map(f => <details class="faq"><summary>{f.q}</summary><p set:html={f.a}></p></details>)}</div></section>

  <section id="book" class="cta-bottom"><div class="wrap"><h2>Marsal deck down? Call now.</h2><p>Same-day response across Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside, and San Diego counties. $120 commercial diagnostic, waived with repair. 90-day warranty on parts and labor.</p></div></section>
</Layout>

