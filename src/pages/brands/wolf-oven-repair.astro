---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite: brand-specific content, FAQ from one array; boilerplate price table, warranty block and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart. Cases come from real Fixar CRM jobs,
// anonymized to city level; job numbers are kept out of the page on purpose.

const title = "Wolf Oven Repair Los Angeles — Same Day";
const description = "Wolf oven repair in Los Angeles: M and E Series wall ovens, convection steam and speed ovens, DF and GR range ovens. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/wolf-oven-repair/";

const faqs = [
  { q: "Why does my Wolf oven brown one side more than the other on convection?", a: "M Series and E Series Wolf wall ovens use two convection fans and elements. When one side stops working, the oven still heats and still runs its fans, but airflow and heat come mostly from one side, so food browns unevenly. We check each fan and each convection element separately; plain bake usually stays even, which is a useful clue." },
  { q: "What do Wolf oven codes like 4021 or 4421 mean?", a: "They name the circuit the control could not find a load on: 4021/4022 is the bake element, 4121/4122 and 4321/4322 the right and left convection elements, 4221/4222 the broil element and 4421/4422 the cooling fan, with the last digit marking upper or lower cavity. 3B20, 3C20 and 3D20 point at supply voltage or frequency. The fault can be the part, its wiring or the relay that drives it, so we test before replacing." },
  { q: "Can you repair a Wolf wall oven without taking it out of the cabinet?", a: "In almost every case, yes. Elements, convection fans, the temperature probe, hinges, gaskets and the door latch are serviced from the front or from inside the cavity. If a particular repair needs the oven pulled from its opening, the written quote says so before any work starts." },
  { q: "My Wolf steam oven keeps asking for water or descaling. Is it broken?", a: "Often it is not. Hard Southern California water leaves scale on the water-level sensing and in the steam path, and the oven reads that as empty or overdue for descaling. A full descale cycle clears many of these; when it doesn't, we check the sensing, the pump and the steam generator." },
  { q: "How much does Wolf oven repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. Replacing a Wolf temperature probe typically runs $180–$280; other repairs are quoted in writing after the diagnostic. Every repair carries a 90-day warranty on parts and labor." },
  { q: "Do you also fix the oven in a Wolf range?", a: "Yes. The electric oven in a DF dual-fuel range uses elements and a temperature probe much like a wall oven; the gas oven in a GR range lights with an igniter and gas valve. Range ovens are covered on our Wolf range repair page." }
];

const cases: { place: string; unit: string; symptom: string; found: string; done: string }[] = [

];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Wolf Oven Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Wolf", "item": "https://samedayappliance.repair/brands/wolf/" },
      { "@type": "ListItem", "position": 4, "name": "Oven Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="wolf-oven-repair"
    logoSlug="wolf"
    eyebrow={"Wolf · M Series · E Series · Steam"}
    title={"Wolf Oven Repair in Los Angeles"}
    subtitle={"Wall ovens that won’t reach temperature, one-sided convection, self-clean lockouts, steam oven water faults — repaired in place, without pulling the oven."}
    heroImageTitle={"Wolf Oven Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/wolf/">Wolf</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Oven Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Which Wolf oven</p>
      <h2>"Wolf oven" covers four different machines</h2>
      <p>When someone calls about a Wolf oven, it is one of four things: a built-in wall oven (M Series or E Series), a convection steam oven, a speed oven, or the oven cavity of a Wolf range. They share a name and a look, but they heat differently and fail differently — an electric wall oven runs on elements and a temperature probe, a steam oven adds a water system, and the oven in an all-gas Wolf range lights a burner. Telling us which one you have, and the model number from the label on the oven frame behind the door, is the fastest way to a one-visit repair.</p>
      <p>The good news: most Wolf oven repairs happen with the oven in place. Elements, convection fans, the temperature probe, door hinges and gaskets are all reached from the front or from inside the cavity, so the cabinet opening around a wall oven is rarely disturbed.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Wolf oven lines we work on, and what tends to fail</h2>
      <div class="model-grid">
        <div class="model-card">
          <h3>M Series wall ovens</h3>
          <p class="model-list">SO30PM · SO30TM · SO30CM · DO30PM · DO30TM · DO30CM</p>
          <p>Wolf's top wall-oven line, single (SO) and double (DO), in Professional, Transitional and Contemporary styling. Dual VertiCross convection uses two fans, so a convection fault often shows up as one side of the cavity browning differently.</p>
          <p class="fails"><strong>What we see fail:</strong> a convection fan or convection element on one side, the temperature probe, bake and broil elements, self-clean door latches, door hinges.</p>
        </div>
        <div class="model-card">
          <h3>E Series wall ovens</h3>
          <p class="model-list">SO30TE · SO30PE · DO30TE · DO30PE</p>
          <p>The other current Wolf wall-oven family, built alongside the M Series with simpler controls and dual convection.</p>
          <p class="fails"><strong>What we see fail:</strong> the same mechanical items as the M Series — elements, probe, convection fan, latch and hinges — plus control faults that show as a numbered code.</p>
        </div>
        <div class="model-card">
          <h3>Convection steam ovens</h3>
          <p class="model-list">CSO24 · CSO30 (TM, TE, CM, PM styles)</p>
          <p>A convection oven with a steam system fed from a removable water reservoir, so it has a pump, a steam generator and water-level sensing that an ordinary oven does not.</p>
          <p class="fails"><strong>What we see fail:</strong> water and descale messages that won't clear, scale on the water-level sensing, steam generator faults, door seals.</p>
        </div>
        <div class="model-card">
          <h3>Speed ovens and range ovens</h3>
          <p class="model-list">Wolf speed ovens · DF dual-fuel ranges · GR all-gas ranges</p>
          <p>Speed ovens combine microwave and convection heat. A DF range has an electric oven; a GR range has a gas oven with an infrared broiler. Range ovens are covered in depth on our <a href="/brands/wolf-range-repair/">Wolf range repair</a> page.</p>
          <p class="fails"><strong>What we see fail:</strong> on speed ovens, the microwave side while convection still works; on gas range ovens, ignition rather than elements.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What the oven is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Slow preheat, never reaches the set temperature</td><td>Bake element output, the temperature probe (RTD), then the door seal. We confirm with our own thermocouple before ordering anything.</td></tr>
          <tr><td>One side browns darker in convection</td><td>One of the two convection fans or convection elements on M Series and E Series ovens — the other side keeps working, which is why the oven seems "mostly fine".</td></tr>
          <tr><td>Broil does nothing, bake works</td><td>Broil element, then the relay that switches it.</td></tr>
          <tr><td>Door locked after self-clean, or self-clean won't start</td><td>Door latch motor and its switches.</td></tr>
          <tr><td>Cooling fan runs a long time or sounds rough</td><td>Cooling fan motor; if it keeps running long after a cool cavity, the temperature probe reading.</td></tr>
          <tr><td>Steam oven keeps asking for water or descaling</td><td>Scale on the water-level sensing and in the steam path; a full descale often clears it, a failed sensor or generator does not.</td></tr>
          <tr><td>A four-digit code on the display</td><td>The code tells us which circuit the control lost — see the table below.</td></tr>
          <tr><td>All-gas range oven won't light</td><td>Oven igniter and gas valve on the GR range — a different repair from a wall oven.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── ERROR CODES ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Fault codes</p>
      <h2>Wolf wall oven codes we see most</h2>
      <p>Current Wolf wall ovens report a missing load or a supply problem as a four-digit code. The last digit usually tells upper/single (1) from lower (2) cavity on a double oven.</p>
      <table class="sym-table">
        <thead><tr><th>Code</th><th>What it points to</th></tr></thead>
        <tbody>
          <tr><td>3B20 / 3C20</td><td>Supply voltage too low or too high — a house wiring or utility issue before it is an oven issue.</td></tr>
          <tr><td>3D20</td><td>Supply frequency out of range, usually seen on generator power.</td></tr>
          <tr><td>4021 / 4022</td><td>Bake element load missing: element, its wiring, or the relay that drives it.</td></tr>
          <tr><td>4121 / 4122 and 4321 / 4322</td><td>Right and left convection element loads missing — one side of the dual convection system.</td></tr>
          <tr><td>4221 / 4222</td><td>Broil element load missing.</td></tr>
          <tr><td>4421 / 4422</td><td>Cooling fan load missing.</td></tr>
        </tbody>
      </table>
      <p>If a code returns after switching the oven off at the breaker for a full minute, it is a real fault rather than a glitch. Write the code down exactly, including whether it was the upper or lower oven.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Before you call</h2>
      <ul class="scope-list">
        <li><strong>Reset at the breaker</strong> for a full minute. A control that has locked up after a power dip often comes back; a code that returns is worth writing down.</li>
        <li><strong>Check the mode.</strong> An oven that ignores most buttons may simply be in Sabbath mode or have the control lock on — both are in the owner's manual.</li>
        <li><strong>Test convection both ways.</strong> If plain bake is even and convection is not, tell us; it narrows the fault to one fan or element.</li>
        <li><strong>Steam oven:</strong> make sure the reservoir is fully seated and filled, and run the descale program if the oven asks for it before calling.</li>
        <li><strong>Gas range oven:</strong> if you smell gas, turn the oven off, leave the kitchen and call the gas company before anyone else.</li>
      </ul>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Replacing a Wolf oven temperature probe (RTD) typically runs $180–$280. Elements, fans, latches and controls depend on the model and are quoted in writing after the diagnostic. Wall ovens stay in their opening for almost every repair; if one has to come out, the quote says so first.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Wolf's own service network — if your Wolf oven is still inside its factory warranty, call Wolf first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Wolf service</p>
      <h2>Other Wolf repairs</h2>
      <div class="cat-grid">
        <a href="/brands/wolf/" class="cat-card">
          <h3>Wolf appliance repair (all products)</h3>
          <p>Every Wolf cooking line we work on.</p>
        </a>
        <a href="/brands/wolf-range-repair/" class="cat-card">
          <h3>Wolf range repair</h3>
          <p>DF dual-fuel and GR gas ranges: burners, ignition, range ovens.</p>
        </a>
        <a href="/brands/wolf-wall-oven-repair/" class="cat-card">
          <h3>Wolf wall oven repair</h3>
          <p>Built-in single and double wall oven installs.</p>
        </a>
        <a href="/brands/wolf-cooktop-repair/" class="cat-card">
          <h3>Wolf cooktop repair</h3>
          <p>Gas and induction cooktops.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Wolf oven repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Wolf oven not heating? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
