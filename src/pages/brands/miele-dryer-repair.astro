---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { mergeCredentials } from '../../data/credentials-schema';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';
import { OPENING_HOURS_SCHEMA } from '../../data/business-hours';

// 2026-10-05 rewrite (batch 2): brand-specific content, FAQ from one array; templated price table,
// fault-code dumps and service-area grid removed.
// FAQ: the visible <details> list and the FAQPage JSON-LD are both built from `faqs`
// below, so the two can never drift apart.

const title = "Miele Dryer Repair Los Angeles — Same Day";
const description = "Miele dryer repair in Los Angeles: T1 heat-pump dryers that dry slowly, show Clean airways or won't turn. Same day. $89 diagnostic, waived with repair.";
const canonical = "https://samedayappliance.repair/brands/miele-dryer-repair/";

const faqs = [
  { q: "Why does my Miele heat-pump dryer take so long?", a: "Most often because the airflow is restricted: lint in the filters at the door opening, a clogged plinth filter at the bottom, lint in the heat exchanger area, or a closet that traps warm air. Clean the filters, run a cycle with the closet open, and if it is still slow we check the heat exchanger area, sensors and the heat pump." },
  { q: "What does “Clean airways” mean on a Miele dryer?", a: "The dryer has detected that air isn't moving through it freely. Clean both lint filters and the plinth filter behind the bottom flap. If the message comes back with clean filters, lint has built up further in, around the heat exchanger, and that is a service visit." },
  { q: "Does a Miele T1 need a vent?", a: "No. A heat-pump dryer is ventless: the moisture is condensed and collected in the container in the top drawer or sent down a drain hose. It does need air around the machine, because it warms the room it sits in." },
  { q: "Why is there water on the floor near my Miele dryer?", a: "Usually the condensate container isn't pushed fully home or a drain hose has come loose or kinked. If both are fine, the condensate pump or one of its hoses is the next check." },
  { q: "How much does Miele dryer repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before any work starts, and carries a 90-day warranty on parts and labor." },
  { q: "Can the heat pump in a Miele dryer be repaired?", a: "The heat-pump circuit rarely fails, so we confirm it with temperature readings before blaming it. When it has failed, we explain what the sealed-system repair involves and what it costs before you decide whether it makes sense for your machine." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Miele Dryer Repair",
    "provider": { "@type": "LocalBusiness", "name": "Same Day Appliance Repair", "telephone": "+13238704790", "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "postalCode": "90048", "addressCountry": "US" } },
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "offers": {
      "@type": "Offer",
      "priceSpecification": {
        "@type": "PriceSpecification",
        "price": "89.00",
        "priceCurrency": "USD",
        "description": "Diagnostic fee, waived with repair"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Miele", "item": "https://samedayappliance.repair/brands/miele/" },
      { "@type": "ListItem", "position": 4, "name": "Dryer Repair" }
    ]
  }
];

// Wave 46 (2026-05-21): canonical org schema — SSOT src/data/credentials-schema.ts + business-hours.ts.
const wave46OrgSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': canonical + '#org',
  name: 'Same Day Appliance Repair',
  url: canonical,
  priceRange: '$$',
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Los Angeles County' },
    { '@type': 'AdministrativeArea', name: 'Orange County' },
    { '@type': 'AdministrativeArea', name: 'Ventura County' },
    { '@type': 'AdministrativeArea', name: 'Santa Barbara County' }, { '@type': 'AdministrativeArea', name: 'San Bernardino County' },
    { '@type': 'AdministrativeArea', name: 'Riverside County' }, { '@type': 'AdministrativeArea', name: 'San Diego County' }
  ],
  location: BRANCH_LOCATIONS_GEO_NEUTRAL
});
---
<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head-scripts">
    <script type="application/ld+json" set:html={JSON.stringify(wave46OrgSchema)} />
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    section="brands"
    slug="miele-dryer-repair"
    logoSlug="miele"
    eyebrow={"Miele · T1 heat-pump"}
    title={"Miele Dryer Repair in Los Angeles"}
    subtitle={"Clothes still damp, cycles getting longer, a condensate or airway message — most T1 problems start with airflow, and that's where we start too."}
    heroImageTitle={"Miele Dryer Repair in Los Angeles"}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

<nav class="crumbs" aria-label="Breadcrumb">
  <a href="/">Home</a> <span class="crumbs-sep">›</span>
  <a href="/brands/">Brands</a> <span class="crumbs-sep">›</span>
  <a href="/brands/miele/">Miele</a> <span class="crumbs-sep">›</span>
  <span aria-current="page">Dryer Repair</span>
</nav>

  <!-- ── INTRO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Before anything else</p>
      <h2>A heat-pump dryer lives or dies by its airflow</h2>
      <p>Miele T1 heat-pump dryers don't vent outside. Instead of a heating element and an exhaust duct, they use a small sealed heat-pump circuit to warm the air and to condense the moisture out of it, and the water goes into the condensate container in the top drawer or down a drain hose. That makes them gentle on clothes and economical, and it is why they fit in closets where a vented dryer can't go.</p>
      <p>It also means the dryer depends on air moving freely through its filters and heat exchanger. When lint builds up in the lint filters at the door opening or in the plinth filter behind the flap at the bottom, drying slows down a little every week until the display asks you to clean the airways. Most of our “it doesn't dry anymore” calls on T1 dryers turn out to be airflow, not a failed part.</p>
    </div>
  </section>

  <!-- ── MODEL LINES ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Model lines</p>
      <h2>Which Miele dryer do you have, and what tends to fail on it</h2>
      <p>The model number is on the type plate around the door opening. Heat-pump models end in WP; tell us if yours is stacked on a W1 washer and whether it drains into the container or a hose.</p>
      <div class="model-grid">
        <div class="model-card">
          <h3>T1 heat-pump dryers</h3>
          <p class="model-list">TWF 160 WP · TWI 180 WP · TXR 860 WP</p>
          <p>The current T1 range, from the basic models to the top ones with touch controls and FragranceDos.</p>
          <p class="fails"><strong>What we see fail:</strong> lint packed into the plinth filter and the heat exchanger area behind it, the condensate pump and its hose, door seals, and on older units the drum belt and support rollers.</p>
        </div>
        <div class="model-card">
          <h3>Older Miele dryers</h3>
          <p>Earlier vented and condenser dryers that predate the T1. Many are still worth repairing; some electronics are no longer available, and we check before booking the repair.</p>
          <p class="fails"><strong>What we see fail:</strong> heating elements and thermal cutouts on vented models, belts and rollers, and a clogged condenser on condenser models.</p>
        </div>
        <div class="model-card">
          <h3>Stacked W1 and T1 pairs</h3>
          <p>Most Miele dryers we see are stacked on a W1 washer in a closet. A heat-pump dryer warms the room it sits in, so a closet with solid doors and no gap for air can stretch every cycle.</p>
          <p class="fails"><strong>What we see fail:</strong> nothing in the dryer itself — the fix is airflow around the machine, which we check before suspecting a part.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SYMPTOM → CAUSE ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Symptom to likely cause</p>
      <h2>What your Miele dryer is doing, and where we look first</h2>
      <table class="sym-table">
        <thead><tr><th>What you notice</th><th>Where the technician looks first</th></tr></thead>
        <tbody>
          <tr><td>Clothes still damp, cycles longer every week</td><td>Lint filters, the plinth filter, the heat exchanger area behind it, air around the machine in a closet, then the drying sensors.</td></tr>
          <tr><td>“Clean airways” on the display</td><td>The lint filters and the plinth filter first; if the message returns with clean filters, the heat exchanger area and the sensors.</td></tr>
          <tr><td>Condensate container message keeps coming back</td><td>Container seated properly, a kinked or raised drain hose on plumbed installs, then the condensate pump.</td></tr>
          <tr><td>Water on the floor</td><td>The drain hose connection, the container not pushed fully home, then the condensate pump and its hoses.</td></tr>
          <tr><td>Drum doesn't turn, motor hums</td><td>Drum belt, support rollers, then the motor.</td></tr>
          <tr><td>Squeal, rattle or scraping</td><td>Support rollers and drum seals, a coin or button in the airway, then the fan.</td></tr>
          <tr><td>Won't start</td><td>Door closing properly and the door switch, power to the machine, then the control.</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- ── TECHNICAL ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">The heat-pump circuit</p>
      <h2>Why we don't start with the heat pump</h2>
      <p>The heat pump in a T1 is a small sealed refrigerant circuit with its own compressor. It is the part owners worry about, and it is the part that fails least. A dryer that runs, warms the air a little and simply takes too long is almost always choked by lint or starved of room air.</p>
      <p>So the diagnostic goes in order: filters and heat exchanger area, air around the machine, drainage of condensate, sensors — and only then the heat-pump circuit, confirmed with temperature readings before anything is quoted. If the sealed circuit itself has failed, we tell you plainly what the repair involves before you decide.</p>
    </div>
  </section>

  <!-- ── BEFORE YOU CALL ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">What you can check first</p>
      <h2>Five minutes before you call</h2>
      <ul class="scope-list">
        <li><strong>Clean both lint filters.</strong> Pull them out of the door opening, remove the lint, and if they look greasy or clogged, rinse them under warm water and let them dry.</li>
        <li><strong>Clean the plinth filter.</strong> Open the flap at the bottom front, take out the plinth filter, rinse it, squeeze it out and put it back. Gently remove loose lint from the area behind it without bending anything.</li>
        <li><strong>Empty the condensate container</strong> and push it fully back in. On plumbed installs, check the drain hose for kinks.</li>
        <li><strong>Give it air.</strong> If the dryer is in a closet, leave the doors open for one cycle and see whether the time drops.</li>
        <li><strong>Note the message and the program.</strong> The exact text on the display and how long the cycle ran helps us bring the right parts.</li>
      </ul>
      <p>Please don't poke the heat exchanger fins with tools or a vacuum nozzle; they bend easily, and bent fins block the airflow you are trying to clear.</p>
    </div>
  </section>

  <!-- ── VISIT, PRICE, WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">How the visit works</p>
      <h2>Diagnostic, written quote, then the repair</h2>
      <p>Miele dryer repairs are quoted after the diagnostic. A good share of T1 calls end with a thorough airway cleaning and no parts at all, and that is the first thing we rule out.</p>
      <p>The residential diagnostic is <strong>$89, waived with repair</strong>. You get a written quote for parts and labor before any work starts, and every repair carries our <strong>90-day warranty on parts and labor</strong>. BHGS #A49573, EPA 608 Universal certified (#1346255700410). We are an independent repair company, not part of Miele's own service network — if your Miele is still inside its factory warranty, call Miele first; after that, we are the faster call.</p>
    </div>
  </section>

  <!-- ── RELATED ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">More Miele service</p>
      <h2>Other Miele repairs</h2>
      <div class="cat-grid">
        <a href="/brands/miele/" class="cat-card">
          <h3>Miele repair (all products)</h3>
          <p>Every Miele line we work on, in one place.</p>
        </a>
        <a href="/brands/miele-washer-repair/" class="cat-card">
          <h3>Miele washer repair</h3>
          <p>W1 front-loaders, TwinDos, drain and door lock faults.</p>
        </a>
        <a href="/brands/miele-dishwasher-repair/" class="cat-card">
          <h3>Miele dishwasher repair</h3>
          <p>G 7000 and G 5000, drain and inlet faults.</p>
        </a>
        <a href="/brands/miele-refrigerator-repair/" class="cat-card">
          <h3>Miele refrigerator repair</h3>
          <p>MasterCool built-ins and integrated columns.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Miele dryer repair: questions owners ask</h2>
      {faqs.map((f) => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Miele dryer taking forever? Call the branch nearest you.</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  .section { padding: 64px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 800px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }
  .section a { color: var(--red); font-weight: 600; }
  .footnote { font-size: 14px; color: var(--muted); font-style: italic; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 10px; }
  .model-card p.fails { margin-bottom: 0; font-size: 14px; }

  .sym-table { width: 100%; border-collapse: collapse; margin: 24px 0 12px; background: #fff; border: 1px solid var(--border); }
  .sym-table th { background: var(--black); color: #fff; padding: 12px 16px; text-align: left; font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; }
  .sym-table td { padding: 12px 16px; border-top: 1px solid var(--border); font-size: 15px; vertical-align: top; }
  .sym-table td:first-child { font-weight: 600; color: var(--black); width: 34%; }
  @media (max-width: 640px) {
    .sym-table, .sym-table tbody, .sym-table tr, .sym-table td { display: block; width: 100%; }
    .sym-table thead { display: none; }
    .sym-table tr { border-top: 1px solid var(--border); padding: 8px 0; }
    .sym-table td { border-top: 0; padding: 6px 14px; }
    .sym-table td:first-child { width: 100%; }
  }

  .scope-list { margin: 16px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); font-size: 15px; }

  .case { padding: 20px 22px; background: #fff; border: 1px solid var(--border); border-left: 3px solid var(--red); border-radius: 6px; margin-bottom: 16px; }
  .case h3 { font-size: 17px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .case dl { margin: 0; }
  .case dt { font-size: 12px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin-top: 8px; }
  .case dd { margin: 2px 0 0; font-size: 15px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 24px; }
  .cat-card { display: block; padding: 20px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: border-color .2s; }
  .section a.cat-card { color: inherit; font-weight: 400; }
  .cat-card:hover { border-color: var(--red); }
  .cat-card h3 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 13px; color: var(--muted); margin-bottom: 0; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 0; }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
</style>
</Layout>
