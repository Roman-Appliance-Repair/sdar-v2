---
// src/pages/brands/pitco.astro
// Wave 59 — Pitco Frialator broad pillar. Pillar #9 of 10 commercial brands.
// Companion combo: /brands/pitco-fryer-repair/ (fryer-laser-focused, ownership-corrected
// per Wave 59-Pitco-prep cleanup commit ed3f189 + downstream sweep).
//
// Ownership (verified Wave 59-Pitco-prep cleanup, manufacturer pitco.com + Built in
// America blog): Pitco Frialator is part of The Middleby Corporation. Acquisition chain:
// J.C. Pitman founded 1918 → Blodgett Co. acquired Pitco 1981 → Middleby acquired
// Blodgett ~early 2000s → Pitco has been Middleby ever since. NEVER part of Welbilt
// or Ali Group. "Frialator" 1959 invention (active product branding; @pitcofrialator
// social media). Bow NH primary + Concord NH 2021 expansion.
//
// Lead positioning: broadest US install base across LA hotel banquet + stadium concessions
// + independent restaurants + ethnic concepts + casual dining. Middleby family multi-brand
// single-call (Pitco + Blodgett + TurboChef + Imperial + Wells + MagiKitch'n + Southbend
// + Ultrafryer + Anets through one service account). Cross-corporate vs Frymaster
// (Ali Group via Welbilt 2022) — different parts pipelines, different sibling brands.
//
// Wave 58 temporary /brands/pitco/ redirect removed in same commit. Em-dash budget ≤6.
// 5 schema entities (HomeAndConstructionBusiness + Brand + FAQPage + BreadcrumbList
// + WebPage SpeakableSpecification).

import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Pitco Fryer Repair Los Angeles — Same Day";
const description = "Pitco fryer service across LA — Solstice Supreme, SG14, Frialator legacy, SoloFilter. Middleby family. $120 commercial diagnostic.";
const canonical = "https://samedayappliance.repair/brands/pitco/";

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "@id": "https://samedayappliance.repair/brands/pitco/#business",
    "name": "Same Day Appliance Repair, Pitco Fryer Service",
    "image": "https://samedayappliance.repair/images/same-day-appliance-repair.png",
    "url": canonical,
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }
    ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "CSLB C-20 HVAC", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Contractors State License Board" } },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "BBB Accredited Business", "recognizedBy": { "@type": "Organization", "name": "Better Business Bureau" } }
    ],
    "openingHoursSpecification": [
      { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "20:00" },
      { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
    ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "Brand",
    "@id": "https://samedayappliance.repair/brands/pitco/#brand",
    "name": "Pitco Frialator",
    "alternateName": ["Pitco", "Pitco Frialator", "Frialator"],
    "url": "https://www.pitco.com/",
    "description": "Pitco Frialator is one of the broadest US commercial fryer brands by installed base. J.C. Pitman founded the company in 1918, manufacturing from New Hampshire ever since. The Pitco Frialator was invented and patented in 1959 — that 1959 design became the brand's signature product architecture, and 'Pitco Frialator' remains the active trade naming (social-media handles read @pitcofrialator). Manufacturing operates from Bow, New Hampshire (primary, decades-long) and Concord, New Hampshire (2021 expansion). On ownership: Pitco is part of The Middleby Corporation family of foodservice brands. Acquisition chain: Blodgett Co. acquired Pitco 1981; Middleby acquired Blodgett in the early 2000s, bringing Pitco into the Middleby family where it has remained for roughly two decades. Pitco is NOT part of Welbilt and NOT part of Ali Group — frequent SERP confusion conflates Pitco with the Welbilt → Ali Group July 2022 acquisition list (Frymaster, Garland, Manitowoc, Lincoln, Convotherm, Merrychef, Kolpak), but Pitco was never in that portfolio. Middleby siblings include Ultrafryer, Anets (fryers), Blodgett (ovens), Southbend (ranges), Imperial Commercial Cooking, Viking Commercial, TurboChef rapid-cook, MagiKitch'n outdoor, and Wells holding equipment. Product families span Solstice Supreme and Solstice (gas + electric flagship and mid-tier with FilterMate auto-filtration), TorQ and ROV (newer current-catalog lines), SG and SE legacy series (SG14 is the highest single-model search term), SSH high-efficiency, SFSG open-pot, Compa compact, Multi-Battery configurations, Megafry high-capacity, Countertop, Rack fryers, plus PG/PE pasta cookers and RTG rethermalizers as specialty lines. Filtration: SoloFilter single-vat, FilterMaxx multi-vat platform, PRM portable, Fat Vat oil management."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://samedayappliance.repair/" },
      { "@type": "ListItem", "position": 2, "name": "Brands", "item": "https://samedayappliance.repair/brands/" },
      { "@type": "ListItem", "position": 3, "name": "Pitco Frialator", "item": canonical }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": canonical,
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is Pitco part of Middleby, Welbilt, or Ali Group?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Middleby. Pitco Frialator is part of The Middleby Corporation family of foodservice brands. The acquisition chain runs through Blodgett: Blodgett Co. acquired Pitco in 1981, and Middleby acquired Blodgett in the early 2000s, bringing Pitco into the Middleby family where it has remained ever since (roughly two decades and counting). Pitco is NOT part of Welbilt and NOT part of Ali Group. The Welbilt → Ali Group July 2022 acquisition is a common SERP confusion point — that transaction moved Frymaster, Garland, Manitowoc, Lincoln, Convotherm, Merrychef, Kolpak, Master-Bilt, Nor-Lake, Delfield, and Beverage-Air into Ali Group NA. Pitco was never in the Welbilt portfolio, so the 2022 transition does not apply to Pitco. Pitco's Middleby siblings are Ultrafryer and Anets (fryers), Blodgett (ovens), Southbend (ranges), Imperial Commercial Cooking, Viking Commercial, TurboChef rapid-cook, MagiKitch'n outdoor, and Wells holding equipment. We service the Middleby family across the multi-brand single-call workflow."
        }
      },
      {
        "@type": "Question",
        "name": "What's the difference between Pitco Solstice Supreme and Frymaster FilterQuick?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Different auto-filtration mechanisms and different corporate families. Pitco Solstice Supreme uses FilterMate, a pump-and-paper auto-filter with an O-ring sealed manifold. Frymaster FilterQuick (FQE electric, FQG gas) uses a different manifold-based auto-filter architecture. The mechanisms work differently, fail differently, and stock different parts. Corporate framing matters too: Pitco is part of The Middleby Corporation family (via the Blodgett 1981 acquisition chain), and Frymaster is part of Ali Group family (via the July 2022 Welbilt acquisition). They are cross-corporate competitors, not Ali Group siblings as some older SERP content claims. Different parts pipelines: Pitco runs through Middleby distribution, Frymaster runs through Ali Group NA at Winston-Salem. For LA buyers: McDonald's franchises specify Frymaster (non-negotiable); independent operators and most non-McDonald's chains tend toward Pitco Solstice for the broadest US install base and the FilterMate maturity (20+ years field experience). We service both lines with equivalent parts infrastructure across the two corporate pipelines."
        }
      },
      {
        "@type": "Question",
        "name": "How do I tell if my Pitco SG14 needs a gas valve or just a thermocouple?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The diagnostic flow follows pilot behavior. If the pilot lights and stays lit but the main burner doesn't fire (or fires weakly), the thermocouple is the most likely failure — replacement runs $180 to $320. If the pilot won't light at all or lights and then drops out within seconds, the thermopile or thermocouple is the first suspect. If the pilot lights and stays lit and the main burner fires but oil temperature is unstable or never reaches setpoint, the gas valve modulation circuit is the likely culprit — replacement runs $300 to $520. The SG14 is the most-searched Pitco model for service queries (TP 200/mo on 'pitco sg14' alone) because it's the workhorse mid-volume gas fryer across LA mid-tier restaurants — when one goes down the operator usually searches by exact model number. Our techs carry SG14-spec thermocouples, thermopiles, and gas valve assemblies on the truck for same-visit resolution on the common failures."
        }
      },
      {
        "@type": "Question",
        "name": "What's the 'Frialator' on my Pitco? Is it different from regular Pitco?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Same brand, two names. 'Pitco Frialator' is the full formal trade name; 'Pitco' is the shorter informal usage. The 'Frialator' part comes from a 1959 invention — Pitco invented and patented the Frialator fryer design in 1959, and that signature product architecture became the brand identity. The name persists in product literature, parts catalogs, social media handles (@pitcofrialator on Facebook and Instagram, @pitco_frialator on X), and the legal entity name (Pitco Frialator, Inc.). Operators who came up in the 1970s through 1990s commonly call the brand 'Frialator' as primary identity; younger operators usually default to 'Pitco'. Both refer to the same brand. When you call us, either name routes correctly. Parts catalogs are interchangeable — a 'Frialator SG14 thermocouple' and a 'Pitco SG14 thermocouple' are the same OEM part."
        }
      },
      {
        "@type": "Question",
        "name": "Can I still get parts for my 1990s Pitco 35C+ or VF Series legacy fryer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes for most common wear parts; uncertain for some specialty components. Pitco's parts availability through Middleby Corporation distribution is unusually strong for older units — Blodgett and Pitco both have long product cycles, and Middleby has maintained the parts catalog across the 1981 Blodgett acquisition and the early 2000s Middleby acquisition. Common 35C+ and VF Series components (thermocouples, burner ignitors, gas valves, pilot assemblies, oil temperature probes, door gaskets) typically remain stocked through current Middleby distribution channels. Specialty components (specific control board generations, older filter pump motors on pre-Solstice configurations) sometimes ship from secondary parts sources with 5 to 10 day lead times. For 25-plus-year-old units, the repair-vs-replace conversation usually depends on what fails: a thermocouple swap on a 1990s Pitco runs $200 to $340 (worth doing); a sealed-system or full control board failure on the same unit may push the math toward replacement. We diagnose first, quote both options, and let you decide."
        }
      },
      {
        "@type": "Question",
        "name": "Pitco Solstice Supreme touch screen unresponsive — full display swap or sensor strip?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Diagnose the sensor strip first. The Solstice Supreme touch interface uses a capacitive sensor strip behind the front display glass — heat exposure, steam, and screen-cleaning chemistry can damage the sensor strip while the underlying display and processor are fine. Our diagnostic flow tests the sensor strip independently of the display module. When the sensor strip is the actual failure, replacement runs $300 to $500 (sensor strip part plus 45 to 60 minutes of labor). When the full display module has failed, replacement runs $700 to $1,100. The 'just replace the whole module for $1,400 to $1,800' quote that customers sometimes receive from other LA service providers is sometimes correct, but more often the sensor strip diagnostic catches the actual failure at a fraction of the cost. Similar misdiagnosis pattern shows up on TorQ and ROV current-catalog touch controls. We test the strip first, quote the full module only if the strip diagnostic clears."
        }
      },
      {
        "@type": "Question",
        "name": "What does Pitco commercial fryer repair cost in LA, and is repair cheaper than replacement?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "$120 flat commercial diagnostic, waived with repair. Typical Pitco service ranges: thermocouple $180 to $320, oil temperature probe $200 to $340, burner ignitor assembly $220 to $380, gas regulator calibration $220 to $380, FilterMate filter paper + O-ring $180 to $320, SoloFilter / FilterMaxx O-ring service $220 to $380, door gasket / hinge $180 to $320, electric contactor (SE Series) $180 to $280, touch sensor strip (Solstice Supreme / TorQ) $300 to $500, gas valve replacement $300 to $520, heating element (SE Series) $320 to $520, FilterMate pump motor $380 to $640, oil return valve $300 to $480, wash pump rebuild $450 to $720, full touch display module $700 to $1,100, control board $700 to $1,250. Most Pitco calls land $350 to $800. New Solstice Supreme 14 runs $12,000 to $18,000 installed; new SG14 runs $4,500 to $6,500. Repair math almost always favors repair through year 12 to 15 of service life. Cascading failures (control board + FilterMate pump + thermocouples in quick succession) sometimes flip the math toward replacement. We give honest assessments at the diagnostic."
        }
      },
      {
        "@type": "Question",
        "name": "My Pitco fryer won't heat or won't hold oil temperature. What's the first thing to check?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Start with the pilot and ignition. On a gas Pitco (SG14, Solstice) a fryer that won't heat is usually a pilot or thermocouple fault — if the pilot lights but the main burner won't fire, the thermocouple is the most likely failure ($180 to $320); if the pilot won't light or drops out, the thermopile is the suspect. If the burner fires but the oil temperature is unstable or never reaches setpoint, the gas-valve modulation circuit ($300 to $520) or a drifting oil-temperature probe ($200 to $340) is the cause. On an electric SE-series Pitco the equivalent failures are the heating element ($320 to $520) and contactor ($180 to $280). Our techs follow the pilot-behavior diagnostic and carry SG14 thermocouples, thermopiles, and gas valves on the truck. Most Pitco calls land $350 to $800; the $120 commercial diagnostic is waived when you approve the repair."
        }
      },
      {
        "@type": "Question",
        "name": "Why is my Pitco FilterMate leaking or no longer filtering the oil?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On a Pitco Solstice Supreme the FilterMate pump-and-paper system is the usual source of leaks and poor filtration. The most common fix is the filter paper and the O-ring sealed manifold — out-of-spec paper or a worn O-ring lets oil bypass or leak, $180 to $320 for paper plus O-ring service. Next are the oil return valve ($300 to $480) and, on higher-hour units, the FilterMate pump motor (year 5 to 8, $380 to $640). A wash-pump rebuild runs $450 to $720 when the pump itself is worn. Our techs check the paper, O-ring, suction path, and pump amperage under load before quoting, and use OEM Pitco parts so the seal tolerances match. The $120 commercial diagnostic is waived when you approve the repair."
        }
      }
    ]
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="pitco"
    section="brands"
    eyebrow="Commercial Kitchen · Pitco Frialator Troubleshooting · Middleby (since 1981) · Same Day"
    title="Pitco Commercial Fryer Repair Los Angeles"
    subtitle="Solstice Supreme with FilterMate, SG14 and SE14 workhorses, TorQ and ROV current catalog, plus Frialator legacy across the LA install base. Hotel banquet kitchens, stadium concessions, independent restaurants, ethnic concepts, casual dining. Middleby Corporation family parts pipeline, full SoCal coverage."
    heroImageTitle="Pitco Frialator Fryer Repair"
    showBranches={true}
  />

  <!-- ── INTRO (Speakable target) — LEAD WITH BROADEST INSTALL + MIDDLEBY CORRECTION ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Why Pitco owners in LA call us first</p>
      <h2>Pitco has the deepest fryer install base in LA. We service the full Pitco range across every segment that runs it.</h2>
      <p><strong>The most common Pitco fryer repairs we run in LA are gas-side ignition and temperature faults (thermocouple $180–$320, gas-valve modulation $300–$520, oil-temperature probe $200–$340), FilterMate auto-filtration service (filter paper + O-ring $180–$320, pump motor $380–$640), and Solstice Supreme touch-control issues (sensor strip $300–$500 before any $700–$1,100 full display).</strong> On electric SE-series units add heating element ($320–$520) and contactor ($180–$280). The SG14 gas open-pot is the single most-searched Pitco model, and our techs carry SG14 thermocouples, thermopiles, and gas valves on the truck. Pitco is a Middleby brand (via Blodgett, 1981 — not Ali Group). Most Pitco calls land $350–$800; the $120 commercial diagnostic is waived when you approve the repair.</p>
      <p class="intro-speakable">Pitco Frialator is the most-common commercial fryer brand on our LA service route. Hotel banquet prep kitchens at Westside luxury properties, stadium concession commissaries at Dodger Stadium and Crypto.com Arena, independent restaurants from Sunset Strip through DTLA through K-Town, ethnic-cuisine kitchens running Asian wok-fryers and Latin fish-and-chips operations, mid-tier chain restaurants, casual dining banquet rooms — Pitco appears in roughly 35 to 45 percent of our LA commercial fryer service calls. The Solstice Supreme with FilterMate is the flagship; the SG14 is the workhorse mid-volume gas open-pot, the most-searched single Pitco model by name; the SE14 is the electric equivalent; and the Frialator legacy line stretches back through generations of LA install activity.</p>
      <p>One important fact-accuracy point upfront: <strong>Pitco is part of The Middleby Corporation family of foodservice brands</strong>, not Ali Group or Welbilt. SERP content from various sources still claims Pitco is Ali Group via the July 2022 Welbilt acquisition — that claim is structurally wrong. The Welbilt → Ali Group transition moved Frymaster, Garland, Manitowoc, Lincoln, Convotherm, Kolpak, and other Welbilt brands. Pitco was never in that portfolio. Pitco entered the Middleby family in 1981 when Blodgett Co. acquired Pitco, and Middleby has owned Pitco (via Blodgett) since acquiring Blodgett in the early 2000s. Roughly two decades of Middleby ownership and counting. The distinction matters for parts pipelines and sibling-brand single-call coverage.</p>
      <p>The diagnostic is $120, commercial tier, waived when you approve the repair. We quote parts and labor before the work starts. No surprise pricing, no shop minimums on weekends. Phones answer Mon-Sat 8am-8pm, dispatch typically same-day across the Westside, Hollywood, downtown, Pasadena, and the Conejo Valley. Inland Empire and Riverside County typically next-day.</p>
    </div>
  </section>

  <!-- ── PITCO LINEAGE ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">The brand</p>
      <h2>J.C. Pitman 1918, Frialator 1959, Blodgett 1981, Middleby today — a century-plus brand history</h2>
      <p class="lead">Three ownership eras across a century-plus. Each one shaped a different part of the equipment running in LA kitchens today.</p>

      <h3 class="line-h3">1918 to 1981 — J.C. Pitman & Sons, Frialator invention</h3>
      <p>J.C. Pitman founded the company in 1918 as J.C. Pitman and Sons' Hotel and Restaurant Equipment Manufacturers in New Hampshire. In 1959, Pitco invented and patented the Frialator fryer design — a specific architecture for commercial deep-frying that became the brand's signature product line. The "Frialator" name entered the commercial foodservice trade vocabulary and persists today as the active product branding (formal name Pitco Frialator; social-media handles @pitcofrialator on Facebook/Instagram, @pitco_frialator on X). 1918 + 1959 establishes Pitco as one of the longest continuously-operating US commercial fryer brands.</p>

      <h3 class="line-h3">1981 to ~2001 — Blodgett ownership era</h3>
      <p>Blodgett Co. acquired Pitco in 1981. Blodgett was already a major commercial oven manufacturer; the Pitco acquisition added a complete fryer line to the Blodgett portfolio. The Pitco product line expanded across SG gas atmospheric, SE electric, SSH high-efficiency, SFSG open-pot specialty, and the foundation Solstice platform that would later become Solstice Supreme. Bow NH remained primary manufacturing through this era.</p>

      <h3 class="line-h3">~2001 to today — Middleby Corporation family</h3>
      <p>Middleby acquired Blodgett in the early 2000s, and Pitco came with that acquisition. Pitco has been part of The Middleby Corporation family ever since — roughly two decades and counting. Middleby's family today includes Ultrafryer and Anets (fryers — Pitco's competing-line siblings), Blodgett (ovens — Pitco's original 1981 acquirer, now Middleby sister brand), Southbend (ranges), Imperial Commercial Cooking (ranges + ovens + griddles), Viking Commercial, TurboChef, MagiKitch'n, Wells, and dozens of additional commercial brands. Pitco operates from Bow, New Hampshire (primary, decades-long) and a Concord, New Hampshire expansion facility announced 2021 (per Concord Monitor 2021-10-13).</p>
    </div>
  </section>

  <!-- ── WHY LA INDEPENDENTS SPECIFY PITCO ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">LA segment fit</p>
      <h2>Why Pitco appears across the broadest range of LA commercial kitchens</h2>
      <p>Of all the major commercial fryer brands we service across the SoCal route, Pitco appears in the broadest segment range. Frymaster dominates McDonald's franchise operations (50+ year OEM lock); Vulcan covers the ITW Food Equipment Group commercial market; Henny Penny owns the pressure-fryer specialty niche. Pitco fills almost everything else.</p>

      <p><strong>Hotel banquet + stadium concession + LAX flight catering.</strong> Westside luxury hotels (Beverly Hilton, JW Marriott LA Live, Conrad LA, Hotel Bel-Air) run Pitco Solstice Supreme + Multi-Battery configurations for banquet prep. Stadium concession commissaries (LA Memorial Coliseum, Crypto.com Arena, Dodger Stadium, Rose Bowl), LAX flight catering kitchens, and studio commissaries in Burbank, Hollywood, and Culver City run Pitco Megafry high-capacity + Multi-Battery configurations for event-scale throughput volume.</p>

      <p><strong>Independent restaurants — the single biggest LA segment.</strong> Sunset Strip operators, DTLA restaurant clusters, Mid-City + West Hollywood independents, Mid-Wilshire mid-tier operations all run Pitco SG14 or Solstice Supreme as standard install. SG14 in particular is the LA mid-volume restaurant workhorse — most-searched Pitco model by name (TP 200/mo on "pitco sg14" alone).</p>

      <p><strong>Ethnic cuisine kitchens.</strong> Pitco SFSG open-pot architecture handles sediment-heavy frying better than tube-fired alternatives. K-Town fried chicken, Asian seafood, Latin fish-and-chips, Indian samosa, DTLA pho and ramen shops — SFSG survives sediment-heavy work where tube-fired fryers clog faster.</p>

      <p><strong>Mid-tier chains + specialty applications.</strong> Popeyes, Raising Cane's, casual dining chains run Pitco when chain spec doesn't dictate Frymaster. Italian restaurants run dedicated Pitco PG/PE pasta cookers; hospital cook-chill kitchens (Cedars-Sinai, UCLA Medical) run Pitco RTG rethermalizers for meal-reheating workflows. Pitco's specialty product lines fill niches single-purpose competitors don't.</p>
    </div>
  </section>

  <!-- ── FULL PRODUCT RANGE ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">What we service</p>
      <h2>The full Pitco lineup — current catalog plus legacy install base</h2>
      <p>Pitco keeps parts availability strong across product generations. We routinely service current production; we also keep 15-to-25-year-old SG and SE units running through the Middleby parts catalog. For dishwasher-style technical depth on specific model failure patterns, our companion <a href="/brands/pitco-fryer-repair/">Pitco fryer service page</a> goes deeper on model-by-model detail.</p>

      <h3 class="line-h3">Current catalog flagships — Solstice Supreme + Solstice</h3>
      <p><strong>Solstice Supreme</strong> is the gas flagship with integrated FilterMate auto-filtration, energy-efficient tube-design heat exchanger, and Pitco's best controls and build quality. Sizes from 14-lb through Multi-Battery configurations cover the full volume range. Standard at LA high-volume QSR, fast-casual chains, busy casual dining, and hotel banquet operations. <strong>Solstice</strong> (without Supreme) is the mid-tier sibling — same fundamental platform, simpler controls, lower acquisition cost.</p>

      <h3 class="line-h3">Current catalog newer lines — TorQ + ROV</h3>
      <p>The newer Pitco product families on the current catalog. <strong>TorQ</strong> is the modern flagship with updated touch controls and refined Solstice-style architecture. <strong>ROV</strong> is the newer mid-tier platform. Install base in LA is growing; we're now seeing both lines at recent restaurant build-outs and chain refresh installations. The diagnostic patterns parallel Solstice Supreme (same FilterMate-class filtration mechanism, similar control architecture), so service is straightforward for techs already trained on the broader Pitco platform.</p>

      <h3 class="line-h3">Workhorse gas open-pot — SG series (SG14 / SG18 / SG24)</h3>
      <p>The SG series is the broadest single Pitco line by LA install density. <strong>SG14</strong> is the highest-search Pitco model by name (TP 200/mo on "pitco sg14" alone) because it's the LA mid-volume restaurant workhorse — when one goes down the operator searches by exact model number. SG18 and SG24 cover larger-volume installs. Tube-design gas open-pot architecture, manual filtration paired with external filter cart, common across LA mid-tier restaurants. Service centers on thermocouple, burner ignitor, gas valve, oil temperature probe — all on-truck parts for same-visit resolution.</p>

      <h3 class="line-h3">Electric equivalents — SE series (SE14 / SE18 / SE24)</h3>
      <p>The SE series mirrors SG architecture with electric heating elements instead of gas burners. Common in LA kitchens without commercial gas hookup, or by operator preference for all-electric operation. Service swaps gas-side components for heating element + contactor work. SE14 in particular appears across LA bar kitchens and secondary-fryer configurations where gas runs are restricted.</p>

      <h3 class="line-h3">High-efficiency gas — SSH series</h3>
      <p>SSH is Pitco's high-efficiency gas line with extended heat-exchanger design for reduced energy consumption. CARB Title 20 compliant and eligible for California Energy Commission rebate programs plus Southern California Edison and LADWP commercial efficiency rebates. Common in operations targeting utility-bill reduction or pursuing California Energy Commission rebate qualification.</p>

      <h3 class="line-h3">Open-pot specialty — SFSG series</h3>
      <p>SFSG is the open-pot gas configuration for seafood, batter-heavy frying, ethnic-cuisine kitchens, and any operation where sediment-heavy fry work would clog tube-fired alternatives faster. The open-pot architecture survives heavy-sediment workflows better than tube-fired fryers. Common across K-Town fried chicken, Asian seafood restaurants, Latin fish-and-chips operations, and Indian/Pakistani samosa kitchens.</p>

      <h3 class="line-h3">Compact + high-capacity — Compa, Megafry, Multi-Battery</h3>
      <p><strong>Compa</strong> covers compact-footprint fryers for tight LA kitchen installs, bar kitchens, secondary fryer configs. <strong>Megafry</strong> is the high-capacity opposite — large oil capacity for stadium concessions, LAX flight catering, hotel banquet prep. <strong>Multi-Battery</strong> covers paired, triple, or quad fryer arrangements for high-volume parallel fry stations.</p>

      <h3 class="line-h3">Specialty + filtration suite + legacy</h3>
      <p><strong>PG/PE pasta cookers</strong> serve Italian restaurants and pasta-program operations. <strong>RTG rethermalizers</strong> serve hospital cook-chill kitchens (Cedars-Sinai, UCLA Medical, Kaiser) and banquet prep. <strong>Filtration suite:</strong> FilterMate (integrated to Solstice Supreme + TorQ — pump-and-paper with O-ring sealed manifold), SoloFilter (single-vat external), FilterMaxx (multi-vat platform), PRM (portable filter), Fat Vat (oil management). Filtration service is one of the largest segments of our Pitco repair volume; most failures resolve at O-ring or paper level vs full-system replacement. <strong>Legacy 35C+ and VF series</strong> from the 1980s-1990s still appear in long-tenure LA operations — parts availability through Middleby distribution remains strong for common wear components.</p>
    </div>
  </section>

  <!-- ── "PITCO FRIALATOR" — DEDICATED H2 FOR TP 1,700 PARENT TOPIC ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Brand naming clarity</p>
      <h2>"Pitco Frialator" — the 1959 invention that became the brand name</h2>
      <p>"Pitco Frialator" is one of the most-searched Pitco-related terms (parent-topic search activity roughly 1,700/mo on "pitco frialator" alone). The term carries that weight because of two factors: a 1959 product invention, and active product branding that persists today.</p>

      <p>The Pitco Frialator was invented and patented in 1959 — that specific design became the brand's signature product architecture and established Pitco's reputation as a commercial fryer specialist. Operators who came up through the 1960s through 1990s typically refer to the brand as "Frialator" or "Pitco Frialator" as primary identity. Younger operators default to "Pitco." Both refer to the same brand. Social-media handles read @pitcofrialator on Facebook and Instagram, @pitco_frialator on X. The legal entity name is Pitco Frialator, Inc. Parts catalogs use both names interchangeably — a "Frialator SG14 thermocouple" and a "Pitco SG14 thermocouple" are the same OEM part.</p>

      <p>What that means practically for LA service: when operators search for "pitco frialator" parts or service, they're searching for the same brand as "pitco" — no separate Frialator company exists. We respond to both naming conventions and route service correctly regardless of how the brand is referenced. Operators with 1980s and 1990s units tend to use "Frialator" as primary naming; we treat that as a useful signal that the unit may be a legacy generation worth diagnosing carefully before the repair-vs-replace conversation.</p>
    </div>
  </section>

