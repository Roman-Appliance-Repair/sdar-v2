---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Thermador Appliance Repair Los Angeles — Same Day";
const description = "Thermador repair in Los Angeles and SoCal: Star Burner cooktops, Pro Grand ranges, wall ovens, Freedom columns. $89 diagnostic, waived with repair.";

// 2026-10-05: hub rewritten to stay about the brand as a whole. Product-level depth
// (symptoms, parts, prices) lives on the product pages linked from the "What we repair"
// block, so the hub stops competing with them for product queries.
// FAQ: visible list and FAQPage JSON-LD are both generated from `faqs`.
const faqs = [
  { q: "Are you part of Thermador's service network?", a: "No. We're an independent repair company, not on Thermador's factory-certified contractor list. If your Thermador is still inside its factory warranty, call Thermador at 1-800-735-4328 first; after the warranty, we're usually the faster call." },
  { q: "Which Thermador appliances do you repair?", a: "Star Burner cooktops and rangetops, Pro Grand and Pro Harmony ranges, Masterpiece and Professional wall ovens including steam and speed ovens, Freedom Collection refrigerator, freezer and wine columns, built-in refrigerators, Sapphire, Emerald and Topaz dishwashers, range hoods and microwaves. Each has its own page in the 'What we repair' list." },
  { q: "Does Thermador make washers, dryers or grills?", a: "Thermador has never made residential laundry, and its outdoor grills and wall heaters were discontinued in the 1990s. We repair grills from other makers on our BBQ grill repair page." },
  { q: "Can you repair a Freedom column without pulling it out?", a: "For most repairs, yes. Evaporator fans, defrost parts, condenser fans, control boards, ice maker harnesses, gaskets and hinges are done in place through the toe-kick and access panels. Removal comes up mainly for sealed-system work or a seized compressor, and the quote says so first." },
  { q: "Why won't my Thermador Star Burner light?", a: "Usually an ignition fault. Several burners not sparking at once points to the ignition module; one burner clicking but not lighting is more often the spark electrode or a grease-clogged star port, and the ports clog faster than round burners. Our techs clean the ports first, then test the electrode and module. Details on the cooktop page." },
  { q: "Why is my Thermador oven off temperature?", a: "Usually drift, not a dead oven: the temperature sensor goes out of calibration and feeds the control board a wrong reading, or a worn door gasket leaks heat and bakes unevenly. We verify cavity temperature against the setpoint, test the sensor and check the gasket before touching the board." },
  { q: "Do you carry Thermador parts?", a: "Common wear parts are on the truck: ignition modules, spark electrodes, door gaskets, convection fan motors, Sapphire wash pumps, latch assemblies, Freedom Induction touch modules. Compressors, main control boards and Freedom Collection evaporators come next-day from BSH parts distribution, and we quote the lead time before we start." },
  { q: "How much does Thermador repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before work starts, and carries a 90-day warranty on parts and labor. Typical price ranges for each category are on the product pages." },
  { q: "How fast can you come out?", a: "Same day when a technician is free, Monday to Saturday 8am–6pm. Call early, and tell us if it's a Freedom column with food at risk; those get pushed to the same day whenever a technician can reach you before 6pm." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/thermador/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/thermador/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
      ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/thermador/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="thermador"
    section="brands"
    eyebrow={"Thermador · Cooking · Refrigeration · Dishwashers"}
    title={"Thermador Appliance Repair in Los Angeles"}
    subtitle={"Star Burner cooktops, Pro Grand ranges, Masterpiece wall ovens, Freedom columns and dishwashers — repaired by technicians who work on Thermador every week."}
    heroImageTitle={"Thermador Appliance Repair in Los Angeles"}
    showBranches={true}
    trustBarItems={['🏅 BHGS #A49573', '🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

  <!-- ── WHAT WE REPAIR (route block) ── -->
  <section class="wwr">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Pick your Thermador</h2>
      <div class="wwr-grid">
        <a href="/brands/thermador-cooktop-repair/" class="wwr-card"><strong>Thermador cooktop repair</strong><span>Star Burner gas and induction cooktops.</span></a>
        <a href="/brands/thermador-range-repair/" class="wwr-card"><strong>Thermador range repair</strong><span>Pro Grand and Pro Harmony ranges.</span></a>
        <a href="/brands/thermador-stove-repair/" class="wwr-card"><strong>Thermador stove repair</strong><span>Burners that won’t light, ovens that won’t heat.</span></a>
        <a href="/brands/thermador-oven-repair/" class="wwr-card"><strong>Thermador oven repair</strong><span>Masterpiece and Professional wall ovens, steam and speed ovens.</span></a>
        <a href="/brands/thermador-refrigerator-repair/" class="wwr-card"><strong>Thermador refrigerator repair</strong><span>Freedom columns and built-in French door.</span></a>
        <a href="/brands/thermador-built-in-refrigerator-repair/" class="wwr-card"><strong>Thermador built-in refrigerator repair</strong><span>Panel-ready built-in installs.</span></a>
        <a href="/brands/thermador-wine-cooler-repair/" class="wwr-card"><strong>Thermador wine cooler repair</strong><span>Wine columns.</span></a>
        <a href="/brands/thermador-dishwasher-repair/" class="wwr-card"><strong>Thermador dishwasher repair</strong><span>Panel-ready and stainless dishwashers.</span></a>
        <a href="/brands/thermador-range-hood-repair/" class="wwr-card"><strong>Thermador range hood repair</strong><span>Hoods and ventilation.</span></a>
        <a href="/brands/thermador-microwave-repair/" class="wwr-card"><strong>Thermador microwave repair</strong><span>Built-in and drawer microwaves.</span></a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">About the brand</p>
      <h2>Thermador is a BSH-engineered kitchen system. We treat it that way.</h2>
      <p class="intro-speakable">Thermador was founded in Los Angeles in 1916 and is now part of BSH Home Appliances, the German group behind Bosch and Gaggenau. In the field that means Thermador service lives on three platforms: Star Burner gas combustion on cooktops, rangetops and Pro Grand ranges; Freedom Collection modular built-in refrigeration; and the BSH wash-motor architecture shared across Sapphire, Emerald and Topaz dishwashers. Masterpiece and Professional wall ovens, steam and speed ovens, Freedom Induction cooktops and range hoods round out the line.</p>
      <p>Thermador kitchens tend to stay in place for a long time, and most of what we see is drift rather than sudden death. Across the Thermador calls our techs run in Southern California homes, the work clusters in a consistent order: Star Burner ignition first (burners slow to light, spark modules and electrodes, grease-clogged star ports), then oven temperature drift and control-board faults, then dishwasher wash-pump service on Sapphire and Emerald units, then door gaskets and seals. Freedom Collection refrigeration faults, mostly evaporator fans, defrost parts and ice makers, come less often but are the most urgent, because a column losing cold is a column full of food. Each product page above goes into the model lines, symptoms and prices; this page is about the brand as a whole.</p>
      <p>Most Thermador owners in our service area live in Bel Air, Beverly Hills, Holmby Hills, Brentwood, Malibu and Pacific Palisades on LA's Westside; Newport Beach, Newport Coast and Irvine in Orange County; Thousand Oaks, Westlake Village and the Conejo Valley in Ventura County; Montecito and Hope Ranch in Santa Barbara County; Rancho Santa Fe and La Jolla in San Diego County; and the Temecula and Rancho Cucamonga estate corridors in the Inland Empire. These are long-ownership kitchens, often specified by a designer, where a matched Thermador suite is expected to run for twenty years.</p>
    </div>
  </section>

  <!-- ── PLATFORM OVERVIEW ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Platform overview</p>
      <h2>Thermador product platforms we service</h2>
      <div class="model-grid">
        <div class="model-card">
          <h3>Pro Grand and Pro Harmony Ranges</h3>
          <p class="model-list">PRG366WH · PRD486WDHU · PRG486WDG · PRD366WHU · PRG304WH</p>
          <p>36 and 48-inch dual-fuel and all-gas pro ranges with Star Burners, ExtraLow simmer, convection ovens and, on Pro Grand, steam and warming drawers. Details on the <a href="/brands/thermador-range-repair/">range</a> and <a href="/brands/thermador-stove-repair/">stove</a> pages.</p>
        </div>
        <div class="model-card">
          <h3>Star Burner and Freedom Induction Cooktops</h3>
          <p class="model-list">SGSX365TS · SGSXP365TS · PCG366W rangetop · CIT36YWBB Freedom Induction · CET366YB</p>
          <p>Star Burner gas cooktops and rangetops, Freedom Induction full-surface cooktops with pan detection, Masterpiece electric glass. Details on the <a href="/brands/thermador-cooktop-repair/">cooktop page</a>.</p>
        </div>
        <div class="model-card">
          <h3>Masterpiece and Professional Wall Ovens</h3>
          <p class="model-list">POD301W · POD302W · PODS301W steam · MC30WS combi-steam speed · MED302WS</p>
          <p>Single, double and triple wall ovens, combi-steam ovens, speed ovens with the microwave function built in. Convection fan motors, door gaskets, control boards and temperature sensors are the usual work. Details on the <a href="/brands/thermador-oven-repair/">oven</a> and <a href="/brands/thermador-wall-oven-repair/">wall oven</a> pages.</p>
        </div>
        <div class="model-card">
          <h3>Freedom Collection Refrigeration</h3>
          <p class="model-list">T36IR905SP · T30IR905SP · T18IF905SP · T24IW905SP wine · T36BT915NS French door</p>
          <p>Panel-ready refrigerator, freezer and wine columns in 18, 24, 30 and 36 inches, plus built-in French door and bottom-freezer models. Repaired in place through the toe-kick and front access wherever possible. Details on the <a href="/brands/thermador-refrigerator-repair/">refrigerator</a>, <a href="/brands/thermador-built-in-refrigerator-repair/">built-in refrigerator</a> and <a href="/brands/thermador-wine-cooler-repair/">wine cooler</a> pages.</p>
        </div>
        <div class="model-card">
          <h3>Sapphire, Emerald and Topaz Dishwashers</h3>
          <p class="model-list">DWHD770WFP Sapphire · DWHD660WFM Emerald · DWHD560CFP Topaz · panel-ready WPR variants</p>
          <p>Star Speed wash, Chef's Tool Drawer, quiet cycles down to 38 dBA. Wash pumps, drain pumps, control boards and door latches are the usual work. Details on the <a href="/brands/thermador-dishwasher-repair/">dishwasher page</a>.</p>
        </div>
        <div class="model-card">
          <h3>Range Hoods and Microwaves</h3>
          <p class="model-list">HMWB36WS · HPCN48WS Professional · VCI248DS insert · MD30WS drawer microwave</p>
          <p>Wall and island hoods, Professional chimney hoods, inserts with remote blowers, drawer and built-in microwaves. Details on the <a href="/brands/thermador-range-hood-repair/">range hood</a> and <a href="/brands/thermador-microwave-repair/">microwave</a> pages.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── SCOPE ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Scope</p>
      <h2>What Thermador doesn't make, and where to go instead</h2>
      <p>A few product lines come up in searches because Thermador made them years ago. To be upfront about what we can and can't service on the brand's current platform:</p>
      <ul class="scope-list">
        <li><strong>BBQ and outdoor grills.</strong> Thermador discontinued outdoor cooking in the 1990s. For grill repair see our <a href="/services/bbq-grill-repair/">BBQ grill repair page</a>; we service Viking, Wolf, Hestan, Lynx, Weber, DCS, Fire Magic and other outdoor brands.</li>
        <li><strong>Wall heaters.</strong> Also a 1990s discontinuation; we don't service them.</li>
        <li><strong>Washers and dryers.</strong> Thermador has never made residential laundry. If you have a matched Thermador kitchen and want a laundry brand we also service, Miele and Bosch are the usual pairings.</li>
        <li><strong>Standalone countertop microwaves.</strong> Thermador's microwave function lives in built-in and drawer microwaves and inside the MC30WS and MED30WS speed ovens, covered on our <a href="/brands/thermador-microwave-repair/">microwave</a> and <a href="/brands/thermador-oven-repair/">oven</a> pages.</li>
      </ul>
    </div>
  </section>

  <!-- ── BUILT-IN ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Built-in service</p>
      <h2>Freedom Collection and the cabinetry problem</h2>
      <p>A Freedom column is not a freestanding appliance. A 36-inch all-refrigerator column sits inside custom walnut or rift white oak millwork that was specified, fabricated and installed by the general contractor during the original build, and the panels, handles and trim were fitted to that opening. Pulling the column out to work on it puts that millwork at risk, and the trim carpenter who built it may be long gone.</p>
      <p>Our approach is to repair in place. Evaporator fan, defrost thermostat and heater, condenser fan, control board, ice maker harness, door gaskets and hinges are all done through the toe-kick, the rear access panel and the inside of the unit without moving the column. When a repair genuinely needs the unit out of its opening, mainly sealed-system refrigerant work or a seized compressor, the written quote says so before anything is touched, we photograph the millwork before disassembly, and we reseat the column to its original flush spec afterwards. Wall ovens get the same treatment: most work happens from the front with the door off.</p>
    </div>
  </section>

  <!-- ── INDEPENDENCE / WARRANTY ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Warranty and how we work</p>
      <h2>Under warranty, call Thermador. After that, call us.</h2>
      <p>We're an independent repair company, not on Thermador's factory-certified contractor list, and we don't present ourselves as one. Thermador's residential warranty runs two years on parts and labor on most of the line. Inside that window, call Thermador customer service at <strong>1-800-735-4328</strong> first and they'll dispatch a certified contractor at no parts cost to you.</p>
      <p>After the warranty is where we work. Most of our Thermador calls are kitchens between three and fifteen years old, where the warranty has closed but the suite has another decade of service life left. Our residential diagnostic is $89, waived with repair, the quote is in writing before work starts, and every repair carries our 90-day warranty on parts and labor. Common wear parts (ignition modules, spark electrodes, door gaskets, convection fan motors, Sapphire wash pumps, latch assemblies) are on the truck; compressors, main control boards and Freedom evaporators come next-day from BSH parts distribution, and we quote the lead time before we start.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Thermador service across Southern California</h2>
      <p>Ten branches cover Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties. Thermador owners are concentrated in the Westside and foothill districts of LA, Newport Coast and Pelican Hill in Orange County, the Conejo Valley estate corridor in Ventura County, Montecito, Rancho Santa Fe and the Temecula wine-country corridor; those neighborhoods get same-day routing whenever a technician can reach you before 6pm. Tell us your city and model when you call, and we route the nearest technician.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── CREDENTIALS ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Credentials</p>
      <h2>Licensed, insured, background-checked</h2>
      <p>Every technician on our routes is background-checked and works under our registration with California's Bureau of Household Goods and Services, <strong>BHGS #A49573</strong>. Thermador's Freedom columns and wine columns are sealed-system machines, so that side of the line also takes EPA 608 refrigerant handling certification — our technicians hold EPA 608 Universal #1346255700410. We carry general liability and workers' comp.</p>
      <p>See the <a href="/credentials/">full credentials page</a> for license verification links.</p>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Thermador service questions</h2>
      {faqs.map((f) => (
        <details class="faq faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Thermador service?</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 28px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .model-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin: 28px 0 20px; }
  .model-card { padding: 24px; background: #fff; border: 1px solid var(--border); border-radius: 8px; }
  .model-card h3 { font-size: 17px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .model-list { font-size: 13px; color: var(--red); margin-bottom: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.02em; }
  .model-card p { font-size: 14px; color: var(--text); margin-bottom: 0; }
  .model-card a { color: var(--red); }
  .scope-list { margin: 20px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); }
  .scope-list a { color: var(--red); text-decoration: underline; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 8px; }
  .faq ul { margin: 12px 0 8px 20px; }
  .faq li { font-size: 14px; color: var(--text); margin-bottom: 4px; }
  .faq a { color: var(--red); }

