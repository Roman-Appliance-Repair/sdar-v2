---
import { CSLB_CREDENTIALS } from '../../data/credentials-schema';
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import BrandBranchesGrid from '../../components/BrandBranchesGrid.astro';
import { MAIN_PHONE, MAIN_PHONE_TEL } from '../../data/branches';
import { BRANCH_LOCATIONS_GEO_NEUTRAL } from '../../lib/build-location-array';

const title = "Thermador Appliance Repair Los Angeles — Same Day";
const description = "Thermador appliance repair in Los Angeles: cooktops, ranges, wall ovens, Freedom refrigeration and dishwashers. Same day. $89 diagnostic, waived with repair.";

// 2026-10-05: hub rewritten to stay about the brand as a whole. Product-level depth
// (symptoms, parts, prices) lives on the product pages linked from the "What we repair"
// block, so the hub stops competing with them for product queries.
// FAQ: visible list and FAQPage JSON-LD are both generated from `faqs`.
const faqs = [
  { q: "Are you part of Thermador's service network?", a: "No. We're an independent repair company. If your Thermador is still inside its factory warranty, call Thermador at 1-800-735-4328 first; after the warranty, we're usually the faster call." },
  { q: "Which Thermador appliances do you repair?", a: "Cooktops and rangetops, Pro Grand and Pro Harmony ranges, wall ovens including steam and speed ovens, Freedom Collection refrigerator, freezer and wine columns, built-in refrigerators, dishwashers, range hoods and microwaves. Each has its own page in the 'What we repair' list." },
  { q: "Does Thermador make washers, dryers or grills?", a: "Thermador has never made residential laundry, and its outdoor grills and wall heaters were discontinued long ago. We repair grills from other makers on our BBQ grill repair page." },
  { q: "Can you repair a Freedom column without pulling it out?", a: "For most repairs, yes — fans, defrost parts, ice makers, valves, hinges and gaskets are done in place. Removal comes up mainly for sealed-system work, and the quote says so first." },
  { q: "How much does Thermador repair cost?", a: "The residential diagnostic is $89 and is waived when you go ahead with the repair. The repair is quoted in writing after the diagnostic, before work starts, and carries a 90-day warranty on parts and labor." },
  { q: "How fast can you come out?", a: "Same day when a technician is free, Monday to Saturday 8am–6pm. Call early, and tell us if it's a refrigerator with food at risk." }
];

const schemaJsons = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "address": { "@type": "PostalAddress", "addressLocality": "West Hollywood", "addressRegion": "CA", "addressCountry": "US" },
    "@id": "https://samedayappliance.repair/brands/thermador/#business",
    "name": "Same Day Appliance Repair",
    "image": "https://samedayappliance.repair/logo.webp",
    "url": "https://samedayappliance.repair/brands/thermador/",
    "telephone": MAIN_PHONE_TEL,
    "priceRange": "$$$",
    "areaServed": [
      { "@type": "AdministrativeArea", "name": "Los Angeles County" },
      { "@type": "AdministrativeArea", "name": "Orange County" },
      { "@type": "AdministrativeArea", "name": "Ventura County" },
      { "@type": "AdministrativeArea", "name": "Santa Barbara County" }, { "@type": "AdministrativeArea", "name": "San Bernardino County" },
      { "@type": "AdministrativeArea", "name": "Riverside County" }, { "@type": "AdministrativeArea", "name": "San Diego County" }
    ],
    "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"], "opens": "08:00", "closes": "18:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Sunday", "opens": "00:00", "closes": "00:00" }
      ],
    "legalName": "HVAC 777 LLC",
    "hasCredential": [ { "@type": "EducationalOccupationalCredential", "credentialCategory": "BHGS Registration #A49573", "recognizedBy": { "@type": "GovernmentOrganization", "name": "California Bureau of Household Goods and Services" } }, { "@type": "EducationalOccupationalCredential", "credentialCategory": "EPA 608 Universal Certification #1346255700410", "recognizedBy": { "@type": "GovernmentOrganization", "name": "U.S. Environmental Protection Agency" } }, ...CSLB_CREDENTIALS ],
  "location": BRANCH_LOCATIONS_GEO_NEUTRAL

  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://samedayappliance.repair/brands/thermador/",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": [".intro-speakable", ".faq-item:first-of-type"]
    }
  }
];
---
<Layout title={title} description={description}>
  <Fragment slot="head-scripts">
    {schemaJsons.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </Fragment>

  <ServiceHero
    slug="thermador"
    section="brands"
    eyebrow={"Thermador · Cooking · Refrigeration · Dishwashers"}
    title={"Thermador Appliance Repair in Los Angeles"}
    subtitle={"Star Burner cooktops, Pro Grand ranges, Masterpiece wall ovens, Freedom columns and dishwashers — repaired by technicians who work on Thermador every week."}
    heroImageTitle={"Thermador Appliance Repair in Los Angeles"}
    showBranches={true}
    trustBarItems={['🛡️ Fully Insured', '⚡ Same Day Available', '🔩 OEM Parts on Truck', '🔧 90-Day Warranty on Parts and Labor', '💬 $89 Diagnostic — Waived With Repair']}
  />

  <!-- ── WHAT WE REPAIR (route block) ── -->
  <section class="wwr">
    <div class="container">
      <p class="eyebrow-sub">What we repair</p>
      <h2>Pick your Thermador</h2>
      <div class="wwr-grid">
        <a href="/brands/thermador-cooktop-repair/" class="wwr-card"><strong>Thermador cooktop repair</strong><span>Star Burner gas and induction cooktops.</span></a>
        <a href="/brands/thermador-range-repair/" class="wwr-card"><strong>Thermador range repair</strong><span>Pro Grand and Pro Harmony ranges.</span></a>
        <a href="/brands/thermador-stove-repair/" class="wwr-card"><strong>Thermador stove repair</strong><span>Burners that won’t light, ovens that won’t heat.</span></a>
        <a href="/brands/thermador-oven-repair/" class="wwr-card"><strong>Thermador oven repair</strong><span>Masterpiece and Professional wall ovens, steam and speed ovens.</span></a>
        <a href="/brands/thermador-refrigerator-repair/" class="wwr-card"><strong>Thermador refrigerator repair</strong><span>Freedom columns and built-in French door.</span></a>
        <a href="/brands/thermador-built-in-refrigerator-repair/" class="wwr-card"><strong>Thermador built-in refrigerator repair</strong><span>Panel-ready built-in installs.</span></a>
        <a href="/brands/thermador-wine-cooler-repair/" class="wwr-card"><strong>Thermador wine cooler repair</strong><span>Wine columns.</span></a>
        <a href="/brands/thermador-dishwasher-repair/" class="wwr-card"><strong>Thermador dishwasher repair</strong><span>Panel-ready and stainless dishwashers.</span></a>
        <a href="/brands/thermador-range-hood-repair/" class="wwr-card"><strong>Thermador range hood repair</strong><span>Hoods and ventilation.</span></a>
        <a href="/brands/thermador-microwave-repair/" class="wwr-card"><strong>Thermador microwave repair</strong><span>Built-in and drawer microwaves.</span></a>
      </div>
    </div>
  </section>

  <!-- ── ABOUT ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">About the brand</p>
      <h2>A Los Angeles brand, engineered by BSH</h2>
      <p class="intro-speakable">Thermador was founded in Los Angeles in 1916 and is now part of BSH Home Appliances, the group behind Bosch and Gaggenau. Today's line covers Star Burner gas cooktops and rangetops, Pro Grand and Pro Harmony ranges, Masterpiece and Professional wall ovens, Freedom Collection column refrigeration, and dishwashers.</p>
      <p>Thermador kitchens tend to stay in place for a long time, and most of what we see is wear rather than sudden death: burners that are slow to light, ovens that drift off temperature, columns that ice over. Each product page above goes into the model lines, symptoms and what you can check yourself.</p>
    </div>
  </section>

  <!-- ── SCOPE ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Scope</p>
      <h2>What Thermador doesn't make</h2>
      <ul class="scope-list">
        <li><strong>Washers and dryers</strong> — Thermador has never made residential laundry.</li>
        <li><strong>Outdoor grills and wall heaters</strong> were discontinued long ago. For grills see <a href="/services/bbq-grill-repair/">BBQ grill repair</a>.</li>
      </ul>
    </div>
  </section>

  <!-- ── BUILT-IN ── -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow-sub">Built-in kitchens</p>
      <h2>Repairs that leave the cabinetry alone</h2>
      <p>Freedom columns and Thermador wall ovens sit inside custom millwork. The default is to repair them in place, from the front and inside the unit. When a repair genuinely needs a unit out of its opening — mainly sealed-system work on a column — the written quote says so before anything is moved.</p>
    </div>
  </section>

  <!-- ── INDEPENDENCE / WARRANTY ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">Warranty and how we work</p>
      <h2>Under warranty, call Thermador. After that, call us.</h2>
      <p>We're an independent repair company, not part of Thermador's own service network, and we don't present ourselves as one. If your appliance is still inside its factory warranty, call Thermador at <strong>1-800-735-4328</strong> first. After that, our residential diagnostic is $89, waived with repair, the quote is in writing before work starts, and every repair carries our 90-day warranty on parts and labor.</p>
    </div>
  </section>

  <!-- ── SERVICE AREAS ── -->
  <section class="section">
    <div class="container">
      <p class="eyebrow-sub">Where we work</p>
      <h2>Thermador service across Southern California</h2>
      <p>Ten branches cover Los Angeles, Orange, Ventura, Santa Barbara, San Bernardino, Riverside and San Diego counties. Tell us your city and model when you call, and we route the nearest technician.</p>
      <BrandBranchesGrid showHeader={false} />
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow-sub">FAQ</p>
      <h2>Thermador service questions</h2>
      {faqs.map((f) => (
        <details class="faq faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ── BOTTOM CTA ── -->
  <section class="bottom-cta">
    <div class="container">
      <h2>Ready to schedule Thermador service?</h2>
      <p>Same-day visits when a technician is free. $89 diagnostic, waived with repair. Written quote before we start.</p>
      <div class="hero-ctas">
        <a href={`tel:${MAIN_PHONE_TEL}`} class="btn-primary">☎ Call {MAIN_PHONE}</a>
        <a href="/contact/" class="btn-outline">Book Online</a>
      </div>
    </div>
  </section>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: var(--text); line-height: 1.6; }

  .hero { background: var(--black); color: #fff; padding: 80px 24px 72px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; max-width: 1100px; margin: 0 auto; align-items: center; }
  .hero-eyebrow { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 16px; font-weight: 600; }
  .hero h1 { font-size: clamp(28px, 4vw, 46px); font-weight: 700; color: #fff; margin-bottom: 20px; line-height: 1.15; font-family: 'Playfair Display', Georgia, serif; }
  .hero-sub { font-size: 17px; color: rgba(255,255,255,.72); margin-bottom: 28px; }
  .hero-ctas { display: flex; gap: 12px; margin-bottom: 28px; flex-wrap: wrap; }
  .btn-primary { display: inline-block; padding: 14px 28px; background: var(--red); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: background .2s; }
  .btn-primary:hover { background: #a50d25; }
  .btn-outline { display: inline-block; padding: 14px 28px; border: 1.5px solid rgba(255,255,255,.35); color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px; transition: all .2s; }
  .btn-outline:hover { background: rgba(255,255,255,.08); border-color: #fff; }
  .hero-img-wrap { aspect-ratio: 4/3; background: #1a1a1a; border-radius: 4px; display: flex; align-items: center; justify-content: center; }
  .hero-img-placeholder { color: rgba(255,255,255,.35); font-size: 14px; text-align: center; }
  @media (max-width: 768px) { .hero-inner { grid-template-columns: 1fr; } .hero-img-wrap { display: none; } }

  .trust-bar { background: var(--red); color: #fff; padding: 16px 24px; }
  .trust-bar-inner { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .trust-item { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .trust-icon { font-size: 16px; }

  .section { padding: 72px 24px; }
  .section-alt { background: var(--gray); }
  .container { max-width: 1100px; margin: 0 auto; }
  .container.narrow { max-width: 780px; }
  .eyebrow-sub { font-size: 13px; color: var(--red); text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px; font-weight: 600; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; margin-bottom: 20px; line-height: 1.2; font-family: 'Playfair Display', Georgia, serif; }
  .section p { margin-bottom: 16px; color: var(--text); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 32px; }
  .cat-card { display: block; padding: 28px; background: #fff; border: 1px solid var(--border); border-radius: 8px; text-decoration: none; color: inherit; transition: all .2s; }
  .cat-card:hover { border-color: var(--red); transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.08); }
  .cat-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 10px; color: var(--black); font-family: 'Playfair Display', Georgia, serif; }
  .cat-card p { font-size: 14px; color: var(--muted); margin-bottom: 16px; }
  .cat-cta { font-size: 13px; color: var(--red); font-weight: 600; }

  .scope-list { margin: 20px 0; padding-left: 20px; }
  .scope-list li { margin-bottom: 12px; color: var(--text); }
  .scope-list a { color: var(--red); text-decoration: underline; }

  .faq { margin-bottom: 12px; border: 1px solid var(--border); border-radius: 6px; padding: 16px 20px; background: #fff; }
  .faq summary { font-weight: 600; cursor: pointer; font-size: 16px; color: var(--black); }
  .faq[open] summary { margin-bottom: 12px; }
  .faq p { font-size: 15px; color: var(--text); margin-bottom: 8px; }
  .faq ul { margin: 12px 0 8px 20px; }
  .faq li { font-size: 14px; color: var(--text); margin-bottom: 4px; }
  .faq a { color: var(--red); }

  .bottom-cta { background: var(--black); color: #fff; padding: 64px 24px; text-align: center; }
  .bottom-cta h2 { color: #fff; }
  .bottom-cta p { color: rgba(255,255,255,.72); margin-bottom: 24px; }
  .bottom-cta .hero-ctas { justify-content: center; }

  /* What-we-repair route block (mirrors the symptom-route cards on /commercial/ pages) */
  .wwr { padding: 40px 24px 48px; background: #fff; border-bottom: 1px solid var(--border); }
  .wwr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-top: 18px; }
  .wwr-card { display: block; padding: 14px 16px; border: 1px solid var(--border); border-radius: 8px; background: #fff; text-decoration: none; color: inherit; transition: border-color .2s; }
  .wwr-card:hover { border-color: var(--red); }
  .wwr-card strong { display: block; font-size: 15px; color: var(--black); margin-bottom: 4px; }
  .wwr-card span { display: block; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .section a { color: var(--red); }
</style>
</Layout>
