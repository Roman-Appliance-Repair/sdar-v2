---
import CityLayoutV2 from '../layouts/CityLayoutV2.astro';
import HeroSection from '../components/cities/v2/HeroSection.astro';
import TrustBadgesRow from '../components/cities/v2/TrustBadgesRow.astro';
import IntroNarrative from '../components/cities/v2/IntroNarrative.astro';
import ServicesGrid from '../components/cities/v2/ServicesGrid.astro';
import LuxurySpecialists from '../components/cities/v2/LuxurySpecialists.astro';
import CommercialSection from '../components/cities/v2/CommercialSection.astro';
import OutdoorSection from '../components/cities/v2/OutdoorSection.astro';
import ServiceArea from '../components/cities/v2/ServiceArea.astro';
import RecentRepairs from '../components/cities/v2/RecentRepairs.astro';
import WhyCallsUsBack from '../components/cities/v2/WhyCallsUsBack.astro';
import ReviewsBlock from '../components/cities/v2/ReviewsBlock.astro';
import PricingCards from '../components/cities/v2/PricingCards.astro';
import FAQAccordion from '../components/cities/v2/FAQAccordion.astro';
import AlsoServingNearby from '../components/cities/v2/AlsoServingNearby.astro';
import FinalCTA from '../components/cities/v2/FinalCTA.astro';
import { CITIES } from '../data/cities';
import { BRANCHES } from '../data/branches';
import { OPENING_HOURS_SCHEMA } from '../data/business-hours';
import { getLuxuryBrands } from '../data/luxury-rollout';

import { mergeCredentials } from '../data/credentials-schema';
const citySlug = 'san-marino';
const city = CITIES.find((c) => c.slug === citySlug)!;
const branch = BRANCHES.find((b) => b.slug === city.primaryBranch)!;

const cityName = 'San Marino';
const zips = ['91108'];

const phoneRaw = `+1${branch.phone.replace(/\D/g, '')}`;

const title = `Appliance Repair San Marino CA — Same Day Service`;
const description = `Same-day appliance repair in San Marino, CA 91108. Huntington Drive, Virginia Road, Lorain Road. Licensed, OEM parts.`;
const canonical = 'https://samedayappliance.repair/san-marino/';

const localBusinessSchema = mergeCredentials({
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: branch.gbpName,
  image: 'https://samedayappliance.repair/logo.webp',
  url: canonical,
  telephone: phoneRaw,
  email: branch.email,
  areaServed: [
    { '@type': 'City', name: 'San Marino', sameAs: 'https://en.wikipedia.org/wiki/San_Marino,_California' }
  ],
  openingHoursSpecification: OPENING_HOURS_SCHEMA,
  priceRange: '$$$',

});

const introParagraphs = [
  "<strong>When an appliance fails in San Marino, our techs at Same Day Appliance Repair trace it to a handful of patterns: SGVMWD hard-water scale blocking Sub-Zero ice maker inlet valves, weak Wolf dual-fuel oven igniters with corroded star-burner electrodes, Miele dishwasher F70 drain faults on panel-ready units, and Samsung ice makers scaled down over months. We dispatch same-day across the Huntington Drive corridor, Virginia Road, Lorain Road, and the Oak Knoll area. $89 residential diagnostic, waived with repair. BHGS #A49573, EPA 608 Universal certified (#1346255700410).</strong>",
  "San Marino is entirely residential — no commercial strips, no apartment buildings, no industrial zones. Just homes, and the kinds of homes that come with serious kitchens. The Mediterranean and Colonial Revival estates along Huntington Drive, Virginia Road, and Lorain Road have been updated and renovated over decades, and their kitchens reflect that investment: Sub-Zero column refrigerators, Wolf dual-fuel ranges, Thermador steam ovens, Miele and Gaggenau dishwashers and appliance suites.",
  "Our technicians work in San Marino regularly. We carry OEM parts for Sub-Zero, Wolf, Thermador, Miele, and Gaggenau on every service vehicle and are trained on their specific systems and failure modes. Many San Marino calls are coordinated through housekeepers or household staff — we work with them professionally, arrive as scheduled, and provide service documentation when needed.",
  "Hard water is a real factor in San Marino. The city is served by the San Gabriel Valley Municipal Water District, drawing from the mineral-rich San Gabriel Valley groundwater basin. Ice maker inlet valves, dishwasher spray arms, and washing machine inlet screens scale up faster here than in softer-water areas. We test for this on every relevant San Marino call.",
  `Diagnostic fee: <strong>$89</strong> — waived with repair. Written estimate before we start. <strong>90-day warranty</strong> on all parts and labor. OEM parts only — never aftermarket substitutes. Call <a href="tel:${phoneRaw}">${branch.phone}</a>.`
];

const luxuryNarrative = {
  eyebrow: 'WHAT WE SERVICE IN SAN MARINO KITCHENS',
  headline: "Sub-Zero, Wolf, Thermador, Miele, Gaggenau — San Marino's Standard Five",
  paragraphs: [
    "Each of these platforms fails in its own way, and knowing the difference is the job. Sub-Zero's dual-evaporator architecture and sealed system requirements. Wolf's star burner configuration and dual-fuel oven precision. Thermador's ProGrand range specifics and Freedom induction. Miele's dishwasher and laundry electronic control platforms. Gaggenau's steam combi oven systems. Our techs service all five in homes throughout the San Gabriel Valley and the Westside — not as occasional calls, but as a consistent part of the week.",
    "That volume is why the parts are already on the truck. We carry OEM components for all five on every San Marino vehicle, and because SGVMWD water works on water-path parts harder here than in softer-water cities, the inlet valves and filters we replace most often ride along too. The standard side of the kitchen — Samsung, LG, GE, Whirlpool, Bosch, KitchenAid — is covered on the same visit."
  ]
};

// Commercial (added 2026-08-08, last of the 99 pillars without it): San Marino has no
// restaurant district and the block must not pretend one exists — the honest frame is
// institutional light-commercial (school food service, club/event kitchens, the
// institutional corridor around the Huntington). $120 lives ONLY in this block's fee.
const commercialParagraphs = [
  "San Marino has no restaurant row — the city was deliberately built without one — so its commercial appliance work comes from institutions instead. School kitchens and cafeteria lines, the club and event kitchens that cater the city's calendar, and the food service around the Huntington's institutional corridor all run commercial refrigeration, ice machines, and warewashers, held to residential-neighborhood noise and scheduling expectations while they do it. The pattern here is small fleets with no backup: one walk-in, one ice machine, one dish machine, each of them load-bearing on the day it fails. We slot those calls same-day and arrive with the common start components, controls, and gaskets already on the truck — for a school kitchen mid-service or a club the week of an event, a two-visit repair is the real failure."
];

const commercialBrandGroups = [
  {
    label: 'Refrigeration & cooking',
    pills: [
      { name: 'True', href: '/commercial/refrigeration/brands/true/' },
      { name: 'Traulsen', href: '/commercial/refrigeration/brands/traulsen/' },
      { name: 'Turbo Air', href: '/commercial/refrigeration/brands/turbo-air/' },
      { name: 'Vulcan', href: '/brands/vulcan/' }
    ]
  },
  {
    label: 'Ice machines',
    pills: [
      { name: 'Hoshizaki', href: '/commercial/ice-machines/brands/hoshizaki/' },
      { name: 'Manitowoc', href: '/commercial/ice-machines/brands/manitowoc/' },
      { name: 'Scotsman', href: '/commercial/ice-machines/brands/scotsman/' }
    ]
  }
];

// icon must be a key of CommercialSection's ICONS map — it does ICONS[e.icon] with no
// fallback, so a wrong key renders an empty <path> silently. Valid keys:
// snowflake, pizza-oven, fryer, oven, droplet, laundry.
const commercialEquipment = [
  { name: 'Commercial refrigeration', href: '/commercial/refrigeration/', icon: 'snowflake' },
  { name: 'Ice machines', href: '/commercial/ice-machines/', icon: 'snowflake' },
  { name: 'Walk-in coolers', href: '/commercial/refrigeration/walk-in-cooler-repair/', icon: 'snowflake' },
  { name: 'Walk-in freezers', href: '/commercial/refrigeration/walk-in-freezer-repair/', icon: 'snowflake' },
  { name: 'Commercial ovens', href: '/commercial/oven-repair/', icon: 'oven' },
  { name: 'Ranges & stoves', href: '/commercial/stove-repair/', icon: 'oven' },
  { name: 'Dishwashers', href: '/commercial/dishwasher-repair/', icon: 'droplet' },
  { name: 'Fryers', href: '/commercial/fryer-repair/', icon: 'fryer' },
  { name: 'Commercial laundry', href: '/commercial/laundry-repair/', icon: 'laundry' }
];

// NO premium outdoor brand pills anywhere in wave 5: not one of these 28 pages names a
// single outdoor brand (Lynx/DCS/Twin Eagles/Alfresco/Coyote/Bull = 0 occurrences across
// the whole set). The $$$ pages have heavy premium evidence but all of it is indoor estate
// brands. Pills would assert an outdoor install base no page here claims. Pasadena precedent.
const outdoorParagraphs = [
  "San Marino's outdoor equipment is quieter than its kitchens and it fails in a quieter way. The properties here are large and the gardens are the point, so what sits outside is usually a built-in grill on a terrace and a refrigerator or ice maker to go with it — used for entertaining rather than for Tuesday dinner, which means it spends most of the year switched on and doing nothing. That idleness is the problem, combined with the same mineral-heavy San Gabriel Valley water the house runs on. Standing water scales an inlet valve and a fill tube while nobody is watching, and a condenser under a mature garden canopy packs with litter over the same months. Then a party gets scheduled and neither works. Our techs would rather service this equipment in the quiet months than the week of, and on a San Marino terrace the fix is almost always the water path or the airflow rather than the machine."
];

const outdoorLinks = [
  { name: 'BBQ grill repair', href: '/services/bbq-grill-repair/' },
  { name: 'Outdoor kitchen repair', href: '/outdoor/kitchen-repair/' },
  { name: 'Outdoor refrigerator repair', href: '/services/outdoor-refrigerator-repair/' },
  { name: 'Patio heater repair', href: '/outdoor/patio-heater-repair/' },
  { name: 'Gas fireplace repair', href: '/outdoor/fireplace-repair/' }
];

const services = [
  { icon: '🧊', name: 'Refrigerator Repair', slug: 'refrigerator', issues: 'Hard water ice maker · Built-in columns · Not cooling · Sealed system', brands: 'Sub-Zero · Wolf · True · Monogram · Samsung · LG' },
  { icon: '🔥', name: 'Oven, Range & Steam Oven', slug: 'oven', issues: 'Dual-fuel · Steam combi · Temperature off · Igniter · Calibration', brands: 'Wolf · Gaggenau · Thermador · Miele · Viking · La Cornue' },
  { icon: '🍽️', name: 'Dishwasher Repair', slug: 'dishwasher', issues: 'Hard water spray arm scale · Panel-ready · Miele errors · Error codes', brands: 'Miele · Gaggenau · Thermador · Bosch · Cove · KitchenAid' },
  { icon: '🫧', name: 'Washer & Dryer Repair', slug: 'washer', issues: 'Miele T1 heat pump · Hard water inlet · European models', brands: 'Miele · Gaggenau · LG · Samsung · Bosch · Speed Queen' },
  { icon: '🍷', name: 'Wine Cellar & Cooler Repair', slug: 'wine-cooler', issues: 'Temperature off · Humidity control · WhisperKOOL · Sub-Zero wine', brands: 'Sub-Zero · EuroCave · True · WhisperKOOL · Liebherr · U-Line' },
  { icon: '🔆', name: 'Cooktop & Range Hood', slug: 'cooktop', issues: 'Thermador Freedom induction · Wolf star burner · Hood systems', brands: 'Wolf · Thermador · Gaggenau · Miele · Viking · Dacor' },
  { icon: '🧊', name: 'Ice Machine & Ice Maker', slug: 'ice-maker', issues: 'SGVMWD hard water scale · Low production · Inlet valve · Built-in', brands: 'Sub-Zero · True · Scotsman · U-Line · GE Monogram' },
  { icon: '❄️', name: 'Freezer Repair', slug: 'freezer', issues: 'Built-in columns · Not freezing · Sealed system · Frost buildup', brands: 'Sub-Zero · True · GE Monogram · Thermador · Viking' }
];

const neighborhoods = [
  { name: 'Huntington Drive corridor', zip: '91108', featured: true },
  { name: 'Virginia Road', zip: '91108', featured: true },
  { name: 'Lorain Road', zip: '91108', featured: true },
  { name: 'San Marino Avenue', zip: '91108' },
  { name: 'Rosemead Boulevard', zip: '91108' },
  { name: 'Huntington Library adjacent', zip: '91108' },
  { name: 'Oak Knoll area', zip: '91108' },
  { name: 'Lacy Park neighborhood', zip: '91108' }
];


const whyReasons = [
  {
    iconKey: 'parts' as const,
    title: 'Luxury Brand Depth',
    body: 'Sub-Zero, Wolf, Thermador, Miele, Gaggenau — we carry OEM parts for all of these on every San Marino vehicle. We know their failure modes, service procedures, and part sourcing. Not a general company that "also does" luxury brands.'
  },
  {
    iconKey: 'team' as const,
    title: 'Household Staff Coordination',
    body: 'Many San Marino households have housekeepers or household staff who manage service calls. We coordinate with them professionally, arrive on schedule, work cleanly, and provide documentation. The homeowner stays uninvolved if preferred.'
  },
  {
    iconKey: 'shield' as const,
    title: 'SGVMWD Hard Water Aware',
    body: 'San Gabriel Valley groundwater is mineral-rich. Ice makers and dishwashers scale up faster in San Marino than in softer-water cities. We test inlet valves and check for mineral deposits on every relevant call — it consistently matters here.'
  },
  {
    iconKey: 'clock' as const,
    title: '90-Day Warranty, OEM Only',
    body: 'Every repair backed by 90 days on parts and labor. Genuine OEM parts only — critical for luxury appliance warranty compliance. $89 diagnostic waived with repair. Written estimate, transparent pricing. California licensed.'
  }
];

const pricingTiers = [
  { appliance: 'Sub-Zero / Wolf / Gaggenau', range: '$300–$800+', note: 'OEM parts · Built-in · SGVMWD hard water check', featured: true },
  { appliance: 'Thermador / Miele / Viking', range: '$250–$600+', note: 'OEM parts · Panel-ready · Steam oven · Heat pump dryer' },
  { appliance: 'Refrigerator (standard)', range: '$150–$450', note: 'Fan motor, SGVMWD hard water inlet valve, filter' },
  { appliance: 'Dishwasher', range: '$150–$400', note: 'Hard water scale · Miele electronics · Panel cabinetry' },
  { appliance: 'Washer / Dryer', range: '$150–$450', note: 'Miele heat pump · Hard water screens · European models' },
  { appliance: 'Diagnostic Fee', range: '$89', note: 'Waived when you proceed with the repair' }
];

const faqs = [
  {
    question: 'Do you offer same-day appliance repair in San Marino, CA?',
    answer: 'Yes. Our technicians cover all of San Marino 91108 — Huntington Drive corridor, Virginia Road, Lorain Road, San Marino Avenue, Rosemead Boulevard, and every residential street in the city. Same-day visits when a technician is available — call early for the best chance.'
  },
  {
    question: 'Do you repair Sub-Zero, Wolf, Thermador, and Miele appliances in San Marino?',
    answer: "Yes. San Marino's estate homes and larger residences consistently have Sub-Zero refrigerators, Wolf ranges, Thermador appliances, Miele dishwashers, and Gaggenau equipment. Our technicians are trained on these brands, carry OEM parts on every service vehicle, and are experienced with the built-in and custom cabinetry configurations common in San Marino kitchens."
  },
  {
    question: 'Does hard water in San Marino affect appliances?',
    answer: 'Yes. San Marino is served by the San Gabriel Valley Municipal Water District, which delivers mineral-rich groundwater from the San Gabriel Valley basin. Ice maker inlet valves, dishwasher spray arms, and washing machine inlet screens accumulate scale faster than in softer-water cities. We test and check for mineral deposits proactively on every San Marino call involving ice makers and dishwashers.'
  },
  {
    question: 'Can you coordinate with household staff and property managers in San Marino?',
    answer: 'Yes. Many San Marino households have housekeepers, household staff, or property managers who coordinate service calls. We work with them professionally, arrive as scheduled, work cleanly and quietly, and can provide service documentation as needed.'
  },
  {
    question: 'What is your diagnostic fee in San Marino?',
    answer: 'Our diagnostic fee is $89, waived when you proceed with the repair. We give you a complete written estimate before starting any work. Luxury brand repairs may run higher due to OEM part pricing — always disclosed upfront, never a surprise on the invoice.'
  },
  {
    question: 'What warranty do you offer on appliance repairs in San Marino?',
    answer: 'All repairs come with a 90-day warranty on parts and labor. We use genuine OEM parts only. If the same issue returns within 90 days, we come back at no charge.'
  },
  {
    question: 'Do you also serve Pasadena, Arcadia, and South Pasadena?',
    answer: "Yes. Our San Marino service extends to Pasadena, Arcadia, South Pasadena, Alhambra, Temple City, and San Gabriel. We're the closest team for all 91108 calls."
  },
  {
    question: "What's the most common appliance repair our techs see in San Marino?",
    answer: "The most common San Marino calls our techs at Same Day Appliance Repair handle are luxury built-ins affected by SGVMWD hard water — Sub-Zero ice maker inlet valves scaled shut and Miele dishwasher F70 drain faults from mineral deposits on panel-ready units — alongside weak Wolf dual-fuel oven igniters with corroded star-burner electrodes and Samsung ice makers scaled down over months. We check for mineral scale on every relevant call. $89 residential diagnostic, waived with repair."
  },
  {
    question: 'Are your San Marino appliance repairs licensed and insured?',
    answer: 'Yes. Our techs at Same Day Appliance Repair are BHGS #A49573 registered, EPA 608 Universal certified (#1346255700410), with a 90-day warranty on parts and labor for every San Marino repair in 91108. We carry OEM parts for Sub-Zero, Wolf, Thermador, Miele, and Gaggenau on every vehicle, coordinate with household staff, and provide service documentation. $89 residential diagnostic, waived with repair.'
  }
];

---

<CityLayoutV2
  title={title}
  description={description}
  canonical={canonical}
  localBusinessSchema={localBusinessSchema}
>
  <HeroSection
    citySlug={citySlug}
    headlineTop="Appliance Repair"
    headlineCity="San Marino, CA"
    subheadline="San Marino's estate kitchens are among the finest in the San Gabriel Valley — Sub-Zero, Wolf, Thermador, Miele, Gaggenau. Our technicians work here regularly. Same-day service, OEM parts, 90-day warranty. Household staff coordination welcome."
    zips={zips}
    tier={1}
  />

  <TrustBadgesRow />

  <IntroNarrative
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance Repair in San Marino — What This City Requires"
    paragraphs={introParagraphs}
    bookingTitle="San Marino Service Team"
    bookingSub="91108 · Estate-ready · Same day"
  />

  <LuxurySpecialists
    citySlug={citySlug}
    cityName={cityName}
    eyebrow={luxuryNarrative.eyebrow}
    headline={luxuryNarrative.headline}
    paragraphs={luxuryNarrative.paragraphs}
    brands={getLuxuryBrands(citySlug)}
  />

  <ServicesGrid
    cityName={cityName}
    headline="What We Repair in San Marino"
    subhead="Built-ins, luxury brands, estate kitchens · SGVMWD hard water aware · 91108"
    services={services}
  />

  <CommercialSection
    cityName={cityName}
    eyebrow="INSTITUTIONAL & CLUB KITCHENS"
    headline="Commercial Service in a City Without a Commercial Strip"
    paragraphs={commercialParagraphs}
    brandGroups={commercialBrandGroups}
    equipmentCards={commercialEquipment}
    bridgeLink={{ text: 'Commercial ice machine repair', href: '/commercial/ice-machines/' }}
    fee={{ label: 'Commercial diagnostic', amount: '$120', note: 'waived when you approve the repair' }}
  />

  <OutdoorSection
    cityName={cityName}
    headline="San Marino Gardens and the Hard Water Outside"
    paragraphs={outdoorParagraphs}
    serviceChips={outdoorLinks}
    fee={{ label: 'Diagnostic', amount: '$89', note: 'waived with repair' }}
  />

  <ServiceArea
    cityName={cityName}
    headline="All of San Marino — 91108"
    subheadline="Every street in the city — from Huntington Drive to the Pasadena border"
    zips={zips}
    neighborhoods={neighborhoods}
    keyStreets={['Huntington Dr', 'Gainsborough Rd', 'Sherwood Rd', 'Melrose Ave', 'Monterey Rd', 'Michigan Ave']}
    bgImage="/images/cities/san-marino/neighborhood.webp"
  />

  <RecentRepairs citySlug={citySlug} cityName={cityName} headline="Recent Jobs in San Marino" />

  <WhyCallsUsBack
    cityName={cityName}
    headline="Why San Marino Chooses Us"
    reasons={whyReasons}
  />

  <ReviewsBlock citySlug={citySlug} cityName={cityName} />

  <PricingCards
    cityName={cityName}
    headline="Appliance Repair Costs in San Marino"
    subhead="Written estimate before we start. $89 diagnostic — waived with repair. OEM parts only."
    tiers={pricingTiers}
    footnote={false}
  />

  <FAQAccordion
    cityName={cityName}
    headline="Questions San Marino Clients Ask"
    faqs={faqs}
  />

  <AlsoServingNearby
    citySlug={citySlug}
    headline="Also Serving Nearby Areas"
  />

  <FinalCTA
    citySlug={citySlug}
    cityName={cityName}
    headline="Appliance issue in San Marino?"
    body="Sub-Zero · Wolf · Thermador · Miele · Gaggenau · Estate coordination · SGVMWD hard water specialists. $89 diagnostic waived with repair. 90-day warranty."
  />
</CityLayoutV2>
