# ============================================================
# Local development secrets for Cloudflare Pages Functions
# ============================================================
# 1. Copy this file to `.dev.vars` (same folder, same name minus .example)
# 2. Fill in the real values below
# 3. NEVER commit .dev.vars (already in .gitignore)
#
# To run locally with Functions:
#   npm run build
#   npx wrangler pages dev ./dist --compatibility-date=2024-01-01
#
# `npm run dev` alone does NOT run Functions — use wrangler.
# ============================================================

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram — same group as lgdryer (per current setup)
# Get TOKEN from @BotFather
# Get CHAT_ID by: send message to group → open
#   https://api.telegram.org/bot<TOKEN>/getUpdates → look for "chat":{"id":-100...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend — https://resend.com/api-keys
# RESEND_FROM must be on a domain you've verified in Resend
RESEND_API_KEY=re_...
RESEND_FROM="Same Day Appliance Repair <noreply@samedayappliance.repair>"
RESEND_TO=abysov@gmail.com

# ── Live chat (chat-v2) ─────────────────────────────────────────────────────
# The chat bot IS @sdar_dispatch_bot (checked on production 2026-09-07 via
# /api/chat/admin getme). CUP long-polls that same token from Railway, so this
# site must NOT set a webhook on it — one getUpdates consumer per token, and CUP
# deletes webhooks on every boot. CUP forwards the group's replies to
# /api/chat/webhook instead, signed with CHAT_WEBHOOK_SECRET.
CHAT_TG_BOT_TOKEN=
# Dispatcher group — LSA Call Bot. Ordinary supergroup, NOT a forum.
TG_GROUP_ID=
# Owner's Telegram user id. Gets a DM when a lead card fails to post.
TG_OWNER_ID=
# Guards POST /api/chat/admin (getme / chatinfo / setwebhook). Any long random
# string; without it the endpoint refuses every request.
CHAT_ADMIN_TOKEN=
# Shared with CUP (same value in Railway). /api/chat/webhook rejects every
# request whose x-chat-secret does not match, and 503s if this is unset.
CHAT_WEBHOOK_SECRET=

# R2 (photo uploads) — bucket sdar-chat-uploads, reached over the S3 API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sdar-chat-uploads
R2_PUBLIC_URL=

# KV namespace SDAR_CHAT is a binding, not a variable — set it in the Pages
# project settings (or with --kv on `wrangler pages dev`).
